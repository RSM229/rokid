<view class="mp-mask {{visible ? 'show' : ''}}" bindtap="onClose"></view>
<view class="mp-sheet {{visible ? 'show' : ''}}">
  <view class="mp-handle"></view>
  <view class="mp-title">{{title}}</view>
  <scroll-view scroll-y class="mp-list">
    <view
      wx:for="{{models}}"
      wx:key="id"
      class="mp-item {{value === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <view class="mp-left">
        <text class="mp-provider">{{item.providerName}}</text>
        <view class="mp-id-row">
          <text class="mp-id">{{item.model || item.id}}</text>
          <view class="mp-copy" catchtap="onCopy" data-model="{{item.model || item.id}}">⧉</view>
        </view>
        <view class="mp-badges" wx:if="{{item.badges.length}}">
          <text wx:for="{{item.badges}}" wx:for-item="b" wx:key="*this" class="mp-badge">{{b}}</text>
        </view>
        <text class="mp-name">{{item.name}}</text>
      </view>
      <view class="mp-right">
        <view wx:for="{{item.capabilities}}" wx:for-item="c" wx:key="*this" class="mp-cap">{{c}}</view>
      </view>
      <view wx:if="{{value === item.id}}" class="mp-check">✓</view>
    </view>
  </scroll-view>
</view>
