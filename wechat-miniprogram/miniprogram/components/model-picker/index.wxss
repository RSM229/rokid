.mp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease;
  z-index: 90;
}
.mp-mask.show {
  opacity: 1;
  visibility: visible;
}

.mp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 91;
  padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.12);
}
.mp-sheet.show {
  transform: translateY(0);
}

.mp-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d9dde2;
  margin: 8rpx auto 4rpx;
}
.mp-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 8rpx 4rpx 16rpx;
}

.mp-list {
  max-height: 62vh;
}

.mp-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 16rpx;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
}
.mp-item.active {
  background: #f0f7f4;
  border-color: #13795b;
}
.mp-left {
  flex: 1;
  min-width: 0;
}
.mp-provider {
  font-size: 24rpx;
  color: #8a9099;
  letter-spacing: 1rpx;
}
.mp-id-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}
.mp-id {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}
.mp-copy {
  font-size: 28rpx;
  color: #13795b;
  padding: 2rpx 10rpx;
  border: 2rpx solid #cfe5dc;
  border-radius: 8rpx;
  line-height: 1.2;
}
.mp-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}
.mp-badge {
  font-size: 20rpx;
  color: #13795b;
  background: #e3f2ec;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.mp-name {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.mp-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 38%;
}
.mp-cap {
  font-size: 22rpx;
  color: #4b5563;
  background: #f1f3f5;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  text-align: right;
}

.mp-check {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  color: #13795b;
  font-size: 30rpx;
  font-weight: 700;
}
