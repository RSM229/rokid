/* 全屏图片预览（带上一张/下一张）—— 所有 wx.previewImage 的统一替代 */
.iv-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 990; background: rgba(6, 14, 26, 0.92);
}
.iv-modal {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 991; background: #03070d;
}

/* 底栏：计数 + 关闭。
   固定在底部：顶部会被页面自定义导航栏（glass-nav-bar，z-index 1000）和
   微信胶囊遮挡，关闭键必须放到导航栏之外才看得见、点得到（2026-11-18 真机）。 */
.iv-head {
  position: fixed; left: 0; right: 0; top: auto; bottom: 0;
  z-index: 995; display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 40rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: linear-gradient(0deg, rgba(0,0,0,0.62), rgba(0,0,0,0));
}
.iv-count { color: #fff; font-size: 28rpx; font-weight: 500; opacity: 0.95; }
/* 底栏圆钮结构来自本地真机修复；字号 56rpx 吸收 origin/main 的字号阶梯（原 44rpx） */
.iv-close {
  color: #fff; font-size: 56rpx; line-height: 1; width: 88rpx; height: 88rpx;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.16); border: 1rpx solid rgba(255,255,255,0.3);
}
.iv-close:active { background: rgba(255,255,255,0.32); }

/* 左右滑动区 */
.iv-swiper { width: 100%; height: 100%; }
.iv-slide { display: flex; align-items: center; justify-content: center; }
.iv-image { width: 100%; height: 100%; }

/* 上一张 / 下一张 按钮：垂直居中左右两侧，半透明圆钮 */
.iv-nav {
  position: fixed; top: 50%; transform: translateY(-50%);
  z-index: 993; width: 84rpx; height: 84rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; color: #fff; line-height: 1;
  background: rgba(255,255,255,0.16); border: 1rpx solid rgba(255,255,255,0.28);
}
.iv-nav:active { background: #ffffff; }
.iv-prev { left: 24rpx; }
.iv-next { right: 24rpx; }

/* 底部提示（首次打开时短暂出现）；抬到底栏上方，避免被关闭按钮压住 */
.iv-hint {
  position: fixed; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  z-index: 994; text-align: center; color: #fff; font-size: 26rpx; opacity: 0.85;
}