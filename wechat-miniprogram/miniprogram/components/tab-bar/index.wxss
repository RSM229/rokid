/* 常驻玻璃底栏（与 glass-nav-bar 同设计语言） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0%, rgba(var(--wash-rgb, 234,243,255), 0.44) 100%);
  backdrop-filter: blur(46rpx) saturate(1.9);
  -webkit-backdrop-filter: blur(46rpx) saturate(1.9);
  border-top: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.80), 0 -8rpx 30rpx rgba(var(--shadow-rgb, 20,70,140), 0.12);
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
  padding: 8rpx 0;
  border-radius: 22rpx;
  transition: transform 0.12s ease, background 0.2s ease;
}
.tab-item:active {
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.30);
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  opacity: 0.55;
  transition: opacity 0.2s;
}
.tab-label {
  font-size: 20rpx;
  color: #8a9bb0;
  transition: color 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, rgba(var(--brand-l-rgb, 59,140,255), 0.18), rgba(var(--brand-d-rgb, 11,95,208), 0.18));
  border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.40);
  box-shadow: 0 4rpx 16rpx rgba(var(--brand-rgb, 22,119,255), 0.20), inset 0 2rpx 0 rgba(255, 255, 255, 0.65);
}
.tab-item.active .tab-label {
  color: var(--brand, #1677ff);
  font-weight: 700;
}
.tab-item.active .tab-icon {
  opacity: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(var(--brand-rgb, 22,119,255), 0.35));
}
.tab-item.active::before {
  content: '';
  position: absolute;
  top: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0));
}
