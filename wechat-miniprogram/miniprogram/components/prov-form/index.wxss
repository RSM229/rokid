.prov-form { display: flex; flex-direction: column; gap: 20rpx; }
.pf-section { display: flex; flex-direction: column; gap: 16rpx; }
.pf-sec-title {
  font-size: 26rpx; font-weight: 600; color: var(--brand-l, #3b8cff);
  letter-spacing: 2rpx; margin-top: 8rpx;
}
.pf-field { display: flex; flex-direction: column; gap: 8rpx; }
.pf-label { font-size: 26rpx; color: var(--ink, #12253d); font-weight: 500; }
.pf-req { color: #b93838; }
.pf-input, .pf-textarea, .pf-picker {
  box-sizing: border-box; width: 100%;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(var(--brand-rgb, 22, 119, 255), 0.25);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx; color: var(--ink, #12253d);
}
.pf-input, .pf-picker { height: 84rpx; line-height: 84rpx; }
.pf-textarea { height: 200rpx; padding: 20rpx 24rpx; line-height: 1.5; }
.pf-picker-empty { color: #a3b1c2; }
.pf-error { font-size: 22rpx; color: #b93838; }
.pf-signoffs { display: flex; flex-direction: column; gap: 12rpx; margin-top: 8rpx; }
.pf-signoff {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 26rpx; color: var(--ink, #12253d);
  padding: 16rpx 24rpx;
  border: 1rpx dashed rgba(var(--brand-rgb, 22, 119, 255), 0.3);
  border-radius: 16rpx;
}
.pf-signoff-tip { font-size: 22rpx; color: #a3b1c2; }
/* 系统生成字段：只读展示 */
.pf-system {
  display: flex; align-items: center; justify-content: space-between;
  box-sizing: border-box; width: 100%; height: 84rpx;
  background: rgba(var(--brand-rgb, 22, 119, 255), 0.06);
  border: 1rpx dashed rgba(var(--brand-rgb, 22, 119, 255), 0.3);
  border-radius: 16rpx; padding: 0 24rpx;
}
.pf-system-val { font-size: 28rpx; color: var(--ink, #12253d); }
.pf-system-tag {
  font-size: 20rpx; color: #fff; background: #8a97a8;
  border-radius: 8rpx; padding: 2rpx 12rpx;
}
/* 照片字段：预览 + 拍照/选图 */
.pf-image { display: flex; flex-direction: column; gap: 12rpx; }
.pf-img {
  width: 200rpx; height: 200rpx; border-radius: 16rpx;
  background: rgba(var(--brand-rgb, 22, 119, 255), 0.06);
  border: 1rpx solid rgba(var(--brand-rgb, 22, 119, 255), 0.25);
}
.pf-img-loading { font-size: 24rpx; color: #a3b1c2; }
.pf-img-btn {
  align-self: flex-start; font-size: 26rpx; color: var(--brand-l, #3b8cff);
  background: rgba(var(--brand-rgb, 22, 119, 255), 0.08);
  border: 1rpx solid rgba(var(--brand-rgb, 22, 119, 255), 0.3);
  border-radius: 14rpx; padding: 0 28rpx; height: 72rpx; line-height: 72rpx;
}
.pf-img-btn.ghost { color: #8a97a8; background: transparent; border-color: rgba(138, 151, 168, 0.4); }
