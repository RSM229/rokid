<view class="prov-form">
  <view wx:for="{{schema.sections}}" wx:key="title" wx:for-item="sec" class="pf-section">
    <view class="pf-sec-title">{{sec.title}}</view>
    <view wx:for="{{sec.fields}}" wx:key="key" wx:for-item="f" class="pf-field">
      <view class="pf-label">{{f.label}}<text class="pf-req" wx:if="{{f.required}}"> *</text></view>

      <!-- 系统生成字段：只读展示，由后端自动填充 -->
      <view wx:if="{{f.system}}" class="pf-system">
        <text class="pf-system-val">{{value[f.key] || '保存时自动填充'}}</text>
        <text class="pf-system-tag">系统生成</text>
      </view>

      <input
        wx:if="{{f.type === 'text' || f.type === 'datetime'}}"
        class="pf-input"
        value="{{value[f.key]}}"
        placeholder="{{f.placeholder || (f.type === 'datetime' ? 'YYYY-MM-DD HH:mm' : '请输入')}}"
        data-key="{{f.key}}"
        bindinput="onInput" />
      <textarea
        wx:elif="{{f.type === 'textarea'}}"
        class="pf-textarea"
        value="{{value[f.key]}}"
        placeholder="{{f.placeholder || '请输入'}}"
        data-key="{{f.key}}"
        bindinput="onInput" />
      <input
        wx:elif="{{f.type === 'number'}}"
        class="pf-input"
        type="digit"
        value="{{value[f.key]}}"
        placeholder="{{f.placeholder || '请输入数字'}}"
        data-key="{{f.key}}"
        bindinput="onInput" />
      <picker
        wx:elif="{{f.type === 'date'}}"
        mode="date"
        value="{{value[f.key]}}"
        data-key="{{f.key}}"
        bindchange="onPicker">
        <view class="pf-picker {{value[f.key] ? '' : 'pf-picker-empty'}}">{{value[f.key] || '请选择日期'}}</view>
      </picker>
      <picker
        wx:elif="{{f.type === 'time'}}"
        mode="time"
        value="{{value[f.key]}}"
        data-key="{{f.key}}"
        bindchange="onPicker">
        <view class="pf-picker {{value[f.key] ? '' : 'pf-picker-empty'}}">{{value[f.key] || '请选择时间'}}</view>
      </picker>
      <picker
        wx:elif="{{f.type === 'select'}}"
        mode="selector"
        range="{{f.options}}"
        data-key="{{f.key}}"
        bindchange="onSelect">
        <view class="pf-picker {{value[f.key] ? '' : 'pf-picker-empty'}}">{{value[f.key] || '请选择'}}</view>
      </picker>

      <view class="pf-error" wx:if="{{errors[f.key]}}">{{errors[f.key]}}</view>
    </view>
  </view>

  <view class="pf-signoffs" wx:if="{{schema.signoffs && schema.signoffs.length}}">
    <view class="pf-sec-title">签认</view>
    <view wx:for="{{schema.signoffs}}" wx:key="role" class="pf-signoff">
      <text>{{item.role}}<text class="pf-req" wx:if="{{item.required}}"> *</text></text>
      <text class="pf-signoff-tip">保存后在文书详情中本人签认</text>
    </view>
  </view>
</view>
