/* iOS 材料式导航栏（2026-11-21）
   原来是一整条深蓝实心块，25 个页面共用，视觉重心全跑到最上面。
   按 iOS 的做法：导航栏是「材质」不是色块 —— 浅色底 + 一根细线，
   靠这条线把顶栏与内容分层；品牌色只留给图标与主操作。 */
.gnb {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1rpx solid rgba(17, 19, 26, 0.08);
}
.gnb-inner {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
}
.gnb-title-wrap {
  display: flex;
  align-items: center;
  max-width: 70%;
  justify-content: center;
}
.gnb-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #11131a;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gnb-left {
  position: absolute;
  left: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: transparent;
}
.gnb-left:active {
  background: rgba(17, 19, 26, 0.06);
}
.gnb-right {
  position: absolute;
  right: 28rpx;
  display: flex;
  align-items: center;
  height: 56rpx;
}
.gnb-icon {
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.gnb-ic-menu {
  width: 36rpx;
  height: 30rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M128%20224h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32%22/%3E%3C/svg%3E");
}
.gnb-ic-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #33405a;
  border-bottom: 4rpx solid #33405a;
  transform: rotate(45deg);
}
