.guide-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, #0a2e5c 0%, #103a73 100%);
  color: #fff;
  box-sizing: border-box;
}
.skip-btn {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  z-index: 2;
}
.guide-swiper {
  flex: 1;
}
.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  text-align: center;
}
.slide-icon {
  font-size: 140rpx;
  margin-bottom: 48rpx;
}
.slide-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}
.slide-desc {
  font-size: 30rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
}
.dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
}
.dot.on {
  background: #fff;
  width: 36rpx;
  border-radius: 8rpx;
}
.actions {
  padding: 0 64rpx 80rpx;
}
.primary-btn {
  background: #1677ff;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}
.ghost-btn {
  background: transparent;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 48rpx;
  font-size: 32rpx;
}
.help-root {
  height: 100vh;
  background: #f5f7fa;
  padding: 32rpx;
  box-sizing: border-box;
}
.help-sec {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.help-h {
  font-size: 32rpx;
  font-weight: 700;
  color: #0a2e5c;
  margin-bottom: 16rpx;
}
.help-li {
  font-size: 28rpx;
  color: #4a5c74;
  line-height: 1.7;
  margin-bottom: 8rpx;
}
.help-links {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 8rpx 0 24rpx;
}
.link-btn {
  background: #1677ff;
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
}
.help-foot {
  font-size: 24rpx;
  color: #98a4b3;
  text-align: center;
  padding: 16rpx 0 40rpx;
}
