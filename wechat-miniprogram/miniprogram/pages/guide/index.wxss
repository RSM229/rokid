/* 引导页：与登录页统一平面风格（2026-11-21 重做）
   改造前是深蓝渐变底 + 白字 + emoji 大图标，和登录页的浅底光晕风格割裂。
   现在沿用登录页的四件套：浅底 + 两团径向光晕 + 横版品牌元素 + 胶囊按钮。 */

page {
  height: 100%;
  background: #f7f9fc;
}

.guide-root {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f9fc;
  color: #11131a;
  box-sizing: border-box;
  overflow: hidden;
}

/* 背景光晕：与登录页同款，两团径向渐变，成本极低 */
.guide-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.guide-glow-a {
  width: 560rpx;
  height: 560rpx;
  left: -160rpx;
  top: -180rpx;
  background: radial-gradient(circle, rgba(96, 148, 255, 0.28), rgba(96, 148, 255, 0));
}
.guide-glow-b {
  width: 520rpx;
  height: 520rpx;
  right: -180rpx;
  bottom: -140rpx;
  background: radial-gradient(circle, rgba(70, 224, 171, 0.22), rgba(70, 224, 171, 0));
}

/* 跳过：右上角裸文字，不用按钮样式 */
.skip-btn {
  position: absolute;
  top: 40rpx;
  right: 36rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #8a94a6;
  z-index: 2;
}

.guide-swiper {
  flex: 1;
  position: relative;
  z-index: 1;
}

.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  text-align: center;
}

/* 图标：白底圆角方块 + 一根细线，emoji 落在里面；不再是裸 emoji 大字 */
.slide-icon {
  width: 168rpx;
  height: 168rpx;
  line-height: 168rpx;
  margin-bottom: 40rpx;
  font-size: 76rpx;
  border-radius: 44rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 19, 26, 0.08);
  box-shadow: 0 2rpx 12rpx rgba(22, 38, 74, 0.06);
}

.slide-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #11131a;
  margin-bottom: 24rpx;
}

.slide-desc {
  font-size: 28rpx;
  line-height: 1.7;
  color: #8a94a6;
}

/* 指示器：未选中是灰点，选中拉长成品牌色胶囊（比原来纯白点更清楚） */
.dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 0;
  position: relative;
  z-index: 1;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #c3ccda;
  transition: width 0.2s ease, background 0.2s ease;
}
.dot.on {
  width: 40rpx;
  background: #0a6dff;
}

/* 底部操作区：主按钮用登录页的大圆角胶囊按钮 */
.actions {
  padding: 0 56rpx calc(80rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

.primary-btn {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 52rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #ffffff;
  background: linear-gradient(160deg, #2b96ff, #0a6dff 55%, #0053d8);
  box-shadow: 0 18rpx 36rpx -18rpx rgba(0, 86, 216, 0.9);
}
.primary-btn::after {
  border: none;
}

/* 次要按钮：白底 + 一根线（对照登录页的 ghost 风格） */
.ghost-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(17, 19, 26, 0.08);
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #33405a;
  background: #ffffff;
}
.ghost-btn::after {
  border: none;
}

/* ===== 帮助页（mode==='help'）：同一套平面语言 ===== */
.help-root {
  height: 100vh;
  background: #f7f9fc;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.help-sec {
  background: #ffffff;
  border: 1rpx solid rgba(17, 19, 26, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(22, 38, 74, 0.05);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.help-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #11131a;
  margin-bottom: 16rpx;
}

.help-li {
  font-size: 26rpx;
  color: #8a94a6;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.help-links {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 8rpx 0 28rpx;
}

.link-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  background: linear-gradient(160deg, #2b96ff, #0a6dff 55%, #0053d8);
}
.link-btn::after {
  border: none;
}

.help-foot {
  font-size: 22rpx;
  color: #a8b2c1;
  text-align: center;
  padding: 16rpx 0 24rpx;
}
