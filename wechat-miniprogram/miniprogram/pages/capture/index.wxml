<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="现场采集" left="back" />
  <!-- 2026-11-16：隐患识别已移出底部 tab（改由工作台模型下拉进入），不再高亮任何 tab -->
  <tab-bar active="" />

  <block wx:if="{{!aiMode}}">
    <view class="camera-wrap">
      <camera
        wx:if="{{cameraActive}}"
        class="camera"
        device-position="{{cameraPosition}}"
        flash="auto"
        bindinitdone="onCameraReady"
        binderror="onCameraError"
      ></camera>
      <view wx:if="{{cameraActive}}" class="camera-status">{{recording ? '正在录像' : (paused ? '已暂停 · 已录 ' + segments.length + ' 段' : (cameraReady ? '摄像头已就绪' : '正在初始化摄像头'))}}</view>
      <view wx:else class="camera-consent">
        <view>摄像头只在现场拍照或录像时开启</view>
        <button class="primary" size="mini" bindtap="activateCamera">开启摄像头</button>
      </view>
    </view>

    <view class="capture-actions">
      <button size="mini" bindtap="switchCamera">翻转</button>
      <button class="shot" bindtap="takePhoto">拍照</button>
      <button wx:if="{{!recording && !paused}}" size="mini" bindtap="startRecord">录像</button>
      <button wx:elif="{{recording}}" size="mini" bindtap="pauseRecord">暂停</button>
      <button wx:else size="mini" bindtap="resumeRecord">继续</button>
      <button wx:if="{{recording || paused}}" class="danger" size="mini" bindtap="stopRecord">结束</button>
      <button size="mini" bindtap="chooseMedia">相册</button>
    </view>
    <view wx:if="{{paused || recording}}" class="record-meta">
      <text wx:if="{{segments.length}}">已录 {{segments.length}} 段 · 累计 {{durationSeconds}} 秒</text>
      <text wx:else>录制中…</text>
    </view>
    <view wx:if="{{mergeReady}}" class="merge-fallback">
      <button class="queue" loading="{{merging}}" bindtap="retryMerge">重试合并视频</button>
      <button wx:if="{{segments.length}}" class="queue" bindtap="uploadSegments">分段上传（{{segments.length}} 段）</button>
    </view>

    <view wx:if="{{mediaPath}}" class="card preview-card">
      <image wx:if="{{mediaType === 'image'}}" class="preview" src="{{previewUrl}}" mode="aspectFit"></image>
      <video wx:else class="preview" src="{{previewUrl}}" controls></video>
      <button size="mini" bindtap="{{workMode ? 'clearWork' : 'clearMedia'}}">重新选择</button>
    </view>

    <view wx:if="{{workMode && !mediaPath}}" class="card work-hint">请先拍照或从相册导入现场照片</view>

    <view wx:if="{{!workMode || mediaPath}}" class="card">
      <view class="section-title">取证信息</view>
      <input class="field" value="{{section}}" data-field="section" placeholder="施工区域/楼栋楼层" bindinput="onInput" />
      <view class="location-row">
        <input class="field location-field" value="{{location}}" data-field="location" placeholder="具体位置或坐标" bindinput="onInput" />
        <button size="mini" bindtap="locate">定位</button>
      </view>
      <input class="field" value="{{weather}}" data-field="weather" placeholder="天气" bindinput="onInput" />
      <textarea class="field textarea" value="{{workContent}}" data-field="workContent" placeholder="施工内容/取证说明" bindinput="onInput"></textarea>
      <view class="switch-row">
        <text>上传后进行隐患识别</text>
        <switch color="{{themeBrand}}" checked="{{triggerDetection}}" bindchange="onDetectionChange" />
      </view>
      <view wx:if="{{businessType}}" class="muted">关联：{{businessType}} #{{businessId}}</view>
    </view>

    <button class="primary upload" loading="{{uploading}}" disabled="{{!mediaPath || uploading}}" bindtap="upload">{{workMode ? '保存工作记录' : '上传并固化取证'}}</button>
    <button wx:if="{{queueCount && !workMode}}" class="queue" loading="{{uploading}}" bindtap="retryQueue">重试上传（{{queueCount}}）</button>

    <view wx:if="{{workMode && workRecordId}}" class="card result-card">
      <view class="section-title">保存成功</view>
      <view>工作记录编号：#{{workRecordId}}</view>
      <view wx:if="{{workPhotoUrl}}" class="muted">取证照片已带水印保存</view>
      <view class="work-record-actions">
        <button size="mini" bindtap="clearWork">继续记录</button>
        <button class="primary" size="mini" bindtap="goWorkList">查看工作记录</button>
      </view>
    </view>

    <view wx:if="{{result}}" class="card result-card">
      <view class="section-title">保存成功</view>
      <view>媒体编号：{{result.id}}</view>
      <view class="hash">SHA256：{{result.file_hash}}</view>
      <view wx:if="{{result.detection}}">识别：{{result.detection.risk_status || '未发现明确隐患'}} {{result.detection.top1_risk}}</view>
      <button wx:if="{{result.hazard_id}}" size="mini" bindtap="openHazard">查看隐患 #{{result.hazard_id}}</button>
    </view>
  </block>

  <view wx:else class="ai-wrap">
    <block wx:if="{{aiBatchMode}}">
      <view class="ai-batch-frame">
        <view wx:if="{{!aiImages.length}}" class="ai-batch-empty">未选择照片，点「继续添加」导入</view>
        <view class="ai-batch-grid">
          <view wx:for="{{aiImages}}" wx:key="path" class="ai-batch-cell">
            <image class="ai-batch-thumb" src="{{item.path}}" mode="aspectFill"></image>
            <view class="ai-batch-remove" data-index="{{index}}" catchtap="removeAiImage">×</view>
            <view wx:if="{{item.uploading}}" class="ai-batch-mask">识别中…</view>
            <view wx:if="{{item.result}}" class="ai-batch-result">
              <view class="ai-batch-risk {{item.result.detection && item.result.detection.risk_status === '存在隐患' ? 'risk-found' : ''}}">{{item.result.detection ? (item.result.detection.risk_status || '未发现明确隐患') : '未识别'}}</view>
              <view wx:if="{{item.result.detection && item.result.detection.top1_risk}}" class="ai-batch-top">{{item.result.detection.top1_risk}}</view>
              <button wx:if="{{item.result.hazard_id}}" size="mini" data-id="{{item.result.hazard_id}}" bindtap="openHazardById">查看 #{{item.result.hazard_id}}</button>
            </view>
            <view wx:if="{{item.error}}" class="ai-batch-err">{{item.error}}</view>
          </view>
        </view>
      </view>
      <view class="ai-batch-actions">
        <button bindtap="chooseAiImages">继续添加</button>
        <button class="primary" loading="{{uploading}}" disabled="{{!aiImages.length || uploading}}" bindtap="uploadAiBatch">开始识别</button>
        <button bindtap="clearAiBatch">退出</button>
      </view>

      <!-- 批量识别结果汇总：发现的问题、整改要求、检查依据 -->
      <view wx:if="{{aiBatchMode && aiBatchDone && aiImages.length}}" class="ai-report card">
        <view class="section-title">识别结果详情</view>
        <block wx:for="{{aiImages}}" wx:for-item="img" wx:key="path">
          <view wx:if="{{img.result && img.result.detection}}" class="ai-report-item">
            <view class="ai-report-head">
              <image class="ai-report-thumb" src="{{img.path}}" mode="aspectFill"></image>
              <view class="ai-report-meta">
                <view class="ai-report-status {{img.result.detection.risk_status === '存在隐患' ? 'risk-found' : ''}}">{{img.result.detection.risk_status || '未发现明确隐患'}}</view>
                <view wx:if="{{img.result.detection.risk_category}}" class="ai-report-category">{{img.result.detection.risk_category}}</view>
                <view wx:if="{{img.result.detection.top1_risk}}" class="ai-report-top">{{img.result.detection.top1_risk}}</view>
              </view>
            </view>

            <view wx:if="{{img.result.detection.evidence && img.result.detection.evidence.length}}" class="ai-report-section">
              <view class="ai-report-label">发现的问题</view>
              <view wx:for="{{img.result.detection.evidence}}" wx:for-index="idx" wx:key="*this" class="ai-report-line">{{idx + 1}}. {{item}}</view>
            </view>

            <view wx:if="{{img.result.detection.recheck_suggestion && img.result.detection.recheck_suggestion.length}}" class="ai-report-section">
              <view class="ai-report-label">整改要求</view>
              <view wx:for="{{img.result.detection.recheck_suggestion}}" wx:for-index="idx" wx:key="*this" class="ai-report-line">{{idx + 1}}. {{item}}</view>
            </view>

            <view wx:if="{{img.result.detection.matched_regulations && img.result.detection.matched_regulations.length}}" class="ai-report-section">
              <view class="ai-report-label">检查依据</view>
              <view wx:for="{{img.result.detection.matched_regulations}}" wx:for-index="idx" wx:key="chunk_id" class="ai-report-line">
                <view class="ai-report-reg-title">{{idx + 1}}. {{item.title}}</view>
                <view wx:if="{{item.content_snippet}}" class="ai-report-reg-snippet">{{item.content_snippet}}</view>
              </view>
            </view>

            <button wx:if="{{img.result.hazard_id}}" size="mini" class="ai-report-link" data-id="{{img.result.hazard_id}}" bindtap="openHazardById">查看隐患 #{{img.result.hazard_id}}</button>
          </view>
        </block>
      </view>
    </block>

    <block wx:else>
      <view class="ai-frame">
        <camera
          wx:if="{{cameraActive && !mediaPath}}"
          class="ai-camera"
          device-position="{{cameraPosition}}"
          flash="off"
          bindinitdone="onCameraReady"
          binderror="onCameraError"
        ></camera>
        <image
          wx:if="{{mediaPath}}"
          class="ai-photo"
          src="{{previewUrl}}"
          mode="aspectFill"
        ></image>
        <view wx:if="{{!cameraActive && !mediaPath}}" class="camera-consent">
          <view>开启摄像头进行现场隐患识别</view>
          <button class="primary" size="mini" bindtap="activateCamera">开启摄像头</button>
        </view>
        <view wx:if="{{!mediaPath}}" class="ai-add" bindtap="chooseAiImages">＋</view>
      </view>

      <view wx:if="{{!mediaPath}}" class="ai-shoot">
        <button class="ai-shot" disabled="{{!cameraReady || uploading}}" bindtap="takePhoto">拍摄识别</button>
        <view class="ai-shoot-tip">对准现场点击拍摄，或点右上角＋批量导入多张</view>
      </view>

      <view wx:elif="{{!result}}" class="ai-start-row">
        <button class="primary ai-start" loading="{{uploading}}" disabled="{{uploading}}" bindtap="upload">开始识别</button>
        <button size="mini" bindtap="clearMedia">重新拍摄</button>
      </view>

      <view wx:else class="card result-card ai-result">
        <view class="section-title">识别结果</view>
        <view class="ai-result-summary">
          <view class="{{result.detection && result.detection.risk_status === '存在隐患' ? 'risk-found' : ''}}">风险状态：{{result.detection ? (result.detection.risk_status || '未发现明确隐患') : '识别中'}}</view>
          <view wx:if="{{result.detection && result.detection.risk_category}}">风险类别：{{result.detection.risk_category}}</view>
          <view wx:if="{{result.detection && result.detection.top1_risk}}" class="risk-top">主要风险：{{result.detection.top1_risk}}</view>
        </view>

        <view wx:if="{{result.detection && result.detection.evidence && result.detection.evidence.length}}" class="ai-report-section">
          <view class="ai-report-label">发现的问题</view>
          <view wx:for="{{result.detection.evidence}}" wx:for-index="idx" wx:key="*this" class="ai-report-line">{{idx + 1}}. {{item}}</view>
        </view>

        <view wx:if="{{result.detection && result.detection.recheck_suggestion && result.detection.recheck_suggestion.length}}" class="ai-report-section">
          <view class="ai-report-label">整改要求</view>
          <view wx:for="{{result.detection.recheck_suggestion}}" wx:for-index="idx" wx:key="*this" class="ai-report-line">{{idx + 1}}. {{item}}</view>
        </view>

        <view wx:if="{{result.detection && result.detection.matched_regulations && result.detection.matched_regulations.length}}" class="ai-report-section">
          <view class="ai-report-label">检查依据</view>
          <view wx:for="{{result.detection.matched_regulations}}" wx:for-index="idx" wx:key="chunk_id" class="ai-report-line">
            <view class="ai-report-reg-title">{{idx + 1}}. {{item.title}}</view>
            <view wx:if="{{item.content_snippet}}" class="ai-report-reg-snippet">{{item.content_snippet}}</view>
          </view>
        </view>

        <view class="ai-result-actions">
          <button wx:if="{{result.hazard_id}}" size="mini" bindtap="openHazard">查看隐患 #{{result.hazard_id}}</button>
          <button size="mini" bindtap="clearMedia">继续识别</button>
        </view>
      </view>
    </block>
  </view>
</view>