/* 玻璃拟态改造（浅色版） */
.camera-wrap { position: relative; overflow: hidden; border-radius: 28rpx; background: rgba(var(--deep-rgb, 10,46,92), 0.9); border: 2rpx solid rgba(255,255,255,0.35); box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.camera { width: 100%; height: 560rpx; }
.camera-consent { display: flex; height: 560rpx; flex-direction: column; align-items: center; justify-content: center; gap: 26rpx; color: var(--wash, var(--wash, #e8f2ff)); }
.camera-status { position: absolute; left: 20rpx; bottom: 18rpx; padding: 8rpx 16rpx; border-radius: 20rpx; color: #fff; background: rgba(0,0,0,.45); font-size: 23rpx; }
.capture-actions { display: flex; justify-content: center; align-items: center; gap: 12rpx; margin: 22rpx 0; }
.capture-actions button { margin: 0; }
.merge-fallback { display: flex; gap: 16rpx; padding: 0 32rpx; }
.merge-fallback .queue { flex: 1; margin: 0; }
.record-meta { text-align: center; font-size: 24rpx; color: var(--muted, #5b7290); margin-bottom: 12rpx; }
.shot { width: 120rpx; height: 120rpx; padding: 0; border: 10rpx solid var(--wash, var(--wash, #e8f2ff)); border-radius: 60rpx; line-height: 100rpx; color: #fff; background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); }
.preview-card { text-align: center; }
.preview { width: 100%; height: 420rpx; margin-bottom: 16rpx; border-radius: 16rpx; background: #0f1815; }
.section-title { margin-bottom: 14rpx; font-size: 30rpx; font-weight: 650; }
.location-row { display: flex; align-items: center; gap: 12rpx; }
.location-field { flex: 1; }
.location-row button { margin: 20rpx 0 0; }
.textarea { width: 100%; min-height: 120rpx; box-sizing: border-box; }
.switch-row { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; }
.work-hint { color: var(--brand, #2f3237); background: rgba(var(--wash-rgb, 234,243,255), 0.55); font-size: 26rpx; line-height: 1.6; }
.upload { margin-top: 24rpx; }
.queue { margin-top: 14rpx; color: #8b641c; background: rgba(255,246,221,0.75); }
.result-card { margin-top: 24rpx; line-height: 1.8; }
.hash { overflow-wrap: anywhere; color: #6b7a8f; font-size: 22rpx; }
.work-record-actions { display: flex; gap: 20rpx; margin-top: 18rpx; }
.work-record-actions button { flex: 1; margin: 0; }
.ai-wrap { padding-bottom: 40rpx; }
.ai-frame { position: relative; overflow: hidden; height: 72vh; border-radius: 28rpx; background: rgba(var(--deep-rgb, 10,46,92), 0.9); border: 2rpx solid rgba(255,255,255,0.35); box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.ai-frame .camera-consent { height: 100%; }
.ai-camera { width: 100%; height: 100%; }
.ai-photo { width: 100%; height: 100%; display: block; background: #0f1815; }
.ai-shoot { display: flex; flex-direction: column; align-items: center; gap: 20rpx; margin-top: 40rpx; }
.ai-shot { width: 140rpx; height: 140rpx; padding: 0; border: 10rpx solid var(--wash, var(--wash, #e8f2ff)); border-radius: 70rpx; line-height: 120rpx; color: #fff; font-size: 28rpx; background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); }
.ai-shot[disabled] { opacity: .5; }
.ai-shoot-tip { color: #6b7a8f; font-size: 24rpx; }
.ai-add { position: absolute; right: 24rpx; top: 24rpx; width: 76rpx; height: 76rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 44rpx; font-weight: 400; line-height: 1; background: rgba(var(--brand-rgb, 47,50,55), .92); box-shadow: 0 4rpx 12rpx rgba(0,0,0,.3); }
.ai-start-row { display: flex; justify-content: center; align-items: center; gap: 20rpx; margin-top: 40rpx; }
.ai-start-row button { margin: 0; }
.ai-start { width: 260rpx; }
.ai-result { display: flex; flex-direction: column; align-items: center; gap: 12rpx; text-align: center; }
.ai-result-summary { width: 100%; text-align: left; margin-bottom: 10rpx; }
.risk-found { color: #c0392b; font-weight: 650; }
.risk-top { color: #8b641c; }
.ai-result-actions { display: flex; justify-content: center; gap: 20rpx; margin-top: 12rpx; }
.ai-result-actions button { margin: 0; }

/* AI 隐患识别·多图批量 */
.ai-batch-frame { background: rgba(var(--deep-rgb, 10,46,92), 0.06); border: 2rpx dashed rgba(var(--brand-rgb, 47,50,55), .35); border-radius: 24rpx; padding: 20rpx; min-height: 360rpx; }
.ai-batch-empty { text-align: center; color: var(--muted, #6b7a8f); font-size: 26rpx; padding: 120rpx 0; }
.ai-batch-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.ai-batch-cell { position: relative; width: calc((100% - 32rpx) / 3); height: 220rpx; border-radius: 16rpx; overflow: hidden; background: #0f1815; }
.ai-batch-thumb { width: 100%; height: 100%; display: block; }
.ai-batch-remove { position: absolute; right: 6rpx; top: 6rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 30rpx; line-height: 40rpx; text-align: center; }
.ai-batch-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.45); color: #fff; font-size: 24rpx; }
.ai-batch-result { position: absolute; left: 0; right: 0; bottom: 0; padding: 8rpx 10rpx; background: rgba(0,0,0,.62); color: #fff; font-size: 22rpx; display: flex; flex-direction: column; gap: 4rpx; }
.ai-batch-risk { font-weight: 650; }
.ai-batch-top { color: #ffd479; font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ai-batch-err { position: absolute; left: 0; right: 0; bottom: 0; padding: 8rpx 10rpx; background: rgba(192,57,43,.85); color: #fff; font-size: 20rpx; }
.ai-batch-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.ai-batch-actions button { flex: 1; margin: 0; }

/* 识别结果详情报告 */
.ai-report { margin-top: 28rpx; }
.ai-report-item { margin-bottom: 28rpx; padding-bottom: 28rpx; border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.ai-report-item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
.ai-report-head { display: flex; gap: 18rpx; margin-bottom: 18rpx; }
.ai-report-thumb { width: 130rpx; height: 130rpx; border-radius: 16rpx; background: #0f1815; flex-shrink: 0; }
.ai-report-meta { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.ai-report-status { font-size: 28rpx; font-weight: 650; }
.ai-report-category { color: #6b7a8f; font-size: 24rpx; }
.ai-report-top { color: #8b641c; font-size: 25rpx; line-height: 1.45; }
.ai-report-section { margin-top: 18rpx; }
.ai-report-label { font-size: 26rpx; font-weight: 650; color: var(--deep, #33405a); margin-bottom: 10rpx; }
.ai-report-line { font-size: 25rpx; line-height: 1.65; color: var(--ink-2, #243b55); margin-bottom: 8rpx; }
.ai-report-reg-title { font-weight: 550; }
.ai-report-reg-snippet { color: #6b7a8f; font-size: 23rpx; line-height: 1.55; margin-top: 4rpx; }
.ai-report-link { margin: 18rpx 0 0; }
