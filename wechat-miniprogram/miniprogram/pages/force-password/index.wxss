.page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8a8f8c;
}

.notice {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(230, 162, 60, 0.12);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a6d3b;
}

.form {
  background: #ffffff;
  border: 2rpx solid rgba(var(--brand-rgb, 22, 119, 255), 0.14);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.4), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20, 70, 140), 0.16);
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--deep-rgb, 10, 46, 92), 0.08);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #e74c3c;
}

.input {
  width: 100%;
  height: 72rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.error {
  color: #e74c3c;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--brand-l, #2b96ff), var(--brand-d, #0060df));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: rgba(255, 255, 255, 0.5);
  color: #555;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 8rpx;
}

.btn-plain::after {
  border: none;
}

.btn-link {
  text-align: center;
  font-size: 26rpx;
  color: #8a8f8c;
  padding: 24rpx 0;
  margin-top: 8rpx;
}
