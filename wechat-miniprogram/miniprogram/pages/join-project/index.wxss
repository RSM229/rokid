/* 玻璃拟态改造（浅色版） */
.page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8a8f8c;
}

.form {
  background: #ffffff;
  border: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16);
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  margin-bottom: 32rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #e74c3c;
}

.input {
  width: 100%;
  height: 72rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.notice {
  margin: 8rpx 0 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(47,50,55,0.06);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #666;
}

.error {
  color: #e74c3c;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.success {
  color: #1a8a3c;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(26,138,60,0.08);
  border-radius: 12rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 32rpx;
}

.btn-primary::after {
  border: none;
}
