<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="规范资料库" left="back" />
  <tab-bar active="" />

  <view class="kb-entry" bindtap="goMyKb">
    <view class="kb-entry-text">
      <text class="kb-entry-title">我的资料库 / 共享资料库</text>
      <text class="kb-entry-sub">多库管理 · 成员协作 · 上传文档/录音 · 按库问答</text>
    </view>
    <text class="kb-entry-arrow">›</text>
  </view>

  <view class="mode-tabs">
    <view class="{{mode === 'search' ? 'active' : ''}}" data-mode="search" bindtap="onModeChange">知识检索</view>
    <view class="{{mode === 'graph' ? 'active' : ''}}" data-mode="graph" bindtap="onModeChange">知识图谱</view>
    <view class="{{mode === 'acceptance' ? 'active' : ''}}" data-mode="acceptance" bindtap="onModeChange">验收指引</view>
  </view>

  <!-- ========== Tab 1: 知识检索 ========== -->
  <block wx:if="{{mode === 'search'}}">
    <view class="search-box">
      <view class="search-top">
        <input class="search-field" value="{{keyword}}" data-field="keyword" placeholder="搜索规范/知识..." bindinput="onInput" confirm-type="search" bindconfirm="search" />
        <button class="btn-primary btn-search" loading="{{searching}}" bindtap="search">搜索</button>
      </view>
      <view class="filter-row">
        <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="filter-tag">分类：{{categories[categoryIndex]}} ▾</view>
        </picker>
      </view>
    </view>

    <view wx:if="{{searchHint}}" class="tip">{{searchHint}}</view>

    <view wx:for="{{searchResults}}" wx:key="filename" class="doc-card" bindtap="openDoc" data-filename="{{item.filename}}" data-category="{{item.category}}">
      <view class="doc-top">
        <view class="doc-title">{{item.name || item.title}}</view>
        <view class="doc-tag">{{item.category}}</view>
      </view>
      <view wx:if="{{item.source_file}}" class="doc-sub">{{item.source_file}}</view>
      <view class="doc-btns">
        <text class="link-green" catchtap="openDoc" data-filename="{{item.filename}}" data-category="{{item.category}}">查看详情</text>
        <text class="link-gray" catchtap="downloadFile" data-filename="{{item.filename}}" data-category="{{item.category}}">下载</text>
      </view>
    </view>

    <view wx:if="{{!searching && searchResults.length === 0 && searchHint}}" class="empty">
      <text class="empty-icon">📄</text>
      <text class="empty-text">{{searchHint || '输入关键词搜索规范文档'}}</text>
    </view>
  </block>

  <!-- ========== Tab 2: 知识图谱 ========== -->
  <block wx:if="{{mode === 'graph'}}">
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-num">{{kgStats.total_entities || 0}}</text>
        <text class="stat-lbl">实体总数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{kgStats.total_relations || 0}}</text>
        <text class="stat-lbl">关系总数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{kgEntityTypeCount}}</text>
        <text class="stat-lbl">实体类型</text>
      </view>
    </view>

  </block>

  <!-- ========== Tab 3: 验收指引 ========== -->
  <block wx:if="{{mode === 'acceptance'}}">
    <view class="search-box">
      <view class="search-top">
        <input class="search-field" value="{{acceptanceKeyword}}" placeholder="如：主体结构验收" bindinput="onAcceptanceInput" confirm-type="search" bindconfirm="searchAcceptance" />
        <button class="btn-primary btn-search" loading="{{acceptanceSearching}}" bindtap="searchAcceptance">查询</button>
      </view>
    </view>
    <view class="toolbar">
      <text class="tip">AI 自动生成验收流程指引，点击快捷输入：</text>
    </view>
    <view class="sug-grid">
      <view wx:for="{{acceptanceSuggestions}}" wx:key="*this" class="sug-tag" data-keyword="{{item}}" bindtap="useAcceptanceSuggestion">{{item}}</view>
    </view>

    <view wx:if="{{acceptanceHint}}" class="tip">{{acceptanceHint}}</view>

    <block wx:if="{{acceptanceGuide}}">
      <view class="section-card">
        <view class="sec-head">
          <text class="sec-title">{{acceptanceGuide.title || '验收流程指引'}}</text>
        </view>
        <view wx:if="{{acceptanceGuide.acceptance_type}}" class="sec-desc">验收类型：{{acceptanceGuide.acceptance_type}}</view>

        <view wx:if="{{acceptanceGuide.steps && acceptanceGuide.steps.length}}" class="guide-block">
          <view class="guide-title">验收流程</view>
          <view wx:for="{{acceptanceGuide.steps}}" wx:key="*this" class="guide-step">
            <view class="step-num">{{index + 1}}</view>
            <text class="step-text">{{item}}</text>
          </view>
        </view>

        <view wx:if="{{acceptanceGuide.key_points && acceptanceGuide.key_points.length}}" class="guide-block">
          <view class="guide-title">必查要点</view>
          <view wx:for="{{acceptanceGuide.key_points}}" wx:key="*this" class="guide-point">▫ {{item}}</view>
        </view>

        <view wx:if="{{acceptanceGuide.common_violations && acceptanceGuide.common_violations.length}}" class="guide-block">
          <view class="guide-title">常见违规</view>
          <view wx:for="{{acceptanceGuide.common_violations}}" wx:key="*this" class="guide-point warn">⚠ {{item}}</view>
        </view>

        <view wx:if="{{acceptanceGuide.regulation_basis && acceptanceGuide.regulation_basis.length}}" class="guide-block">
          <view class="guide-title">规范依据</view>
          <view wx:for="{{acceptanceGuide.regulation_basis}}" wx:key="*this" class="guide-point" data-text="{{item}}" bindtap="copyText">「{{item}}」 点击复制</view>
        </view>
      </view>
    </block>

    <view wx:if="{{!acceptanceSearching && !acceptanceGuide}}" class="empty">
      <text class="empty-icon">📋</text>
      <text class="empty-text">输入验收项目名称，AI 智能生成验收流程指引</text>
    </view>
  </block>

</view>
