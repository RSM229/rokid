<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="测量设备" left="back" />
  <tab-bar active="" />

  <view class="toolbar">
    <picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="type-filter">{{statusOptions[statusIndex]}} ▾</view>
    </picker>
    <button class="btn-primary" bindtap="create">+ 新建设备</button>
  </view>

  <!-- 检定到期提醒：30 天内到期的设备 -->
  <view class="pending" wx:if="{{expiring.length}}">
    <view class="pending-head">检定到期提醒（{{expiring.length}}）</view>
    <view wx:for="{{expiring}}" wx:key="id" class="pending-item">
      <view class="pending-topic">{{item.name}}</view>
      <view class="pending-meta">
        <text wx:if="{{item.model_no}}" class="pending-model">{{item.model_no}}</text>
        <text wx:if="{{item.calib_due}}" class="pending-due">有效期至 {{item.calib_due}}</text>
        <text class="pending-days {{item.urgency}}">{{item.days_left}} 天</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading && !list.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">还没有设备，点上方「新建设备」</view>
  <view wx:for="{{list}}" wx:key="id" class="card eq" data-id="{{item.id}}" bindtap="edit">
    <view class="eq-head">
      <text class="eq-name">{{item.name}}</text>
      <text class="eq-badge {{item.statusClass}}">{{item.status}}</text>
    </view>
    <view class="eq-meta">
      <text wx:if="{{item.model_no}}">型号 {{item.model_no}}</text>
      <text wx:if="{{item.serial_no}}">出厂编号 {{item.serial_no}}</text>
      <text wx:if="{{item.unit}}">{{item.unit}}</text>
    </view>
    <view class="eq-meta">
      <text wx:if="{{item.calib_date}}">检定 {{item.calib_date}}</text>
      <text wx:if="{{item.calib_due}}">有效期至 {{item.calib_due}}</text>
    </view>
    <view wx:if="{{item.remark}}" class="eq-remark">{{item.remark}}</view>
    <text class="eq-del" catchtap="del" data-id="{{item.id}}">删除</text>
  </view>

  <!-- 新建/编辑设备 弹层表单 -->
  <view class="overlay" wx:if="{{showForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeForm"></view>
    <view class="overlay-panel work-form-panel">
      <view class="panel-header">
        <text class="panel-title">{{form.id ? '编辑设备' : '新建设备'}}</text>
      </view>
      <view class="form-group"><text class="form-label">设备名称 *</text><input class="form-input" value="{{form.name}}" data-field="name" bindinput="onFormInput" placeholder="请输入设备名称" /></view>
      <view class="form-group"><text class="form-label">型号</text><input class="form-input" value="{{form.model_no}}" data-field="model_no" bindinput="onFormInput" placeholder="请输入型号（可选）" /></view>
      <view class="form-group"><text class="form-label">出厂编号</text><input class="form-input" value="{{form.serial_no}}" data-field="serial_no" bindinput="onFormInput" placeholder="请输入出厂编号（可选）" /></view>
      <view class="form-group"><text class="form-label">检定单位</text><input class="form-input" value="{{form.unit}}" data-field="unit" bindinput="onFormInput" placeholder="请输入检定单位（可选）" /></view>
      <view class="form-group">
        <text class="form-label">检定日期</text>
        <picker mode="date" value="{{form.calib_date}}" data-field="calib_date" bindchange="onFormDateChange">
          <view class="form-input picker-value">{{form.calib_date || '请选择日期'}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">有效期至</text>
        <picker mode="date" value="{{form.calib_due}}" data-field="calib_due" bindchange="onFormDateChange">
          <view class="form-input picker-value">{{form.calib_due || '请选择日期'}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">状态</text>
        <picker mode="selector" range="{{formStatuses}}" value="{{formStatusIndex}}" bindchange="onFormStatusChange">
          <view class="form-input picker-value">{{formStatuses[formStatusIndex]}}</view>
        </picker>
      </view>
      <view class="form-group"><text class="form-label">备注</text><textarea class="form-textarea" value="{{form.remark}}" data-field="remark" bindinput="onFormInput" placeholder="备注（可选）" auto-height /></view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="closeForm">取消</button>
        <button class="btn-submit" loading="{{saving}}" bindtap="submitForm">保存</button>
      </view>
    </view>
  </view>
</view>
