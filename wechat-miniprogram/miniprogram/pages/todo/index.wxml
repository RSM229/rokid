<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="待办事项" left="back" />
  <!-- 2026-11-16：待办事项已成为底部第 1 个 tab（原「隐患识别」入口），补回常驻底栏 -->
  <tab-bar active="todo" />

  <view class="inbox-head">
    <text class="inbox-title">待办协作中心</text>
    <text class="inbox-caption">打开或标记已读不会完成事项，红点只统计仍需你处理的工作。</text>
  </view>

  <scroll-view scroll-x class="view-tabs" show-scrollbar="false">
    <view wx:for="{{views}}" wx:key="key" data-view="{{item.key}}" class="view-tab {{view === item.key ? 'active' : ''}}" bindtap="selectView">
      <text>{{item.label}}</text>
      <text wx:if="{{item.count}}" class="count">{{item.count > 99 ? '99+' : item.count}}</text>
    </view>
  </scroll-view>

  <view wx:if="{{view === 'tasks'}}" class="filter-row">
    <picker mode="selector" range="{{statuses}}" value="{{statusIndex}}" bindchange="onFilterChange">
      <view class="filter"><text class="filter-key">状态</text><text>{{statuses[statusIndex]}}</text><text class="filter-caret">⌄</text></view>
    </picker>
    <text class="list-count">共 {{tasks.length}} 项</text>
  </view>

  <view wx:if="{{view === 'cc' || view === 'sent' || view === 'done'}}" class="filter-row">
    <picker mode="selector" range="{{collabStatuses}}" value="{{collabStatusIndex}}" bindchange="onCollabStatusChange">
      <view class="filter"><text class="filter-key">状态</text><text>{{collabStatuses[collabStatusIndex]}}</text><text class="filter-caret">⌄</text></view>
    </picker>
    <text class="list-count">{{items.length}}{{hasMore ? '+' : ''}} 项</text>
  </view>

  <view wx:if="{{view !== 'tasks' && loading && !items.length}}" class="empty">正在加载待办事项…</view>
  <view wx:elif="{{view !== 'tasks' && !loading && !items.length && !(view === 'action' && tasks.length)}}" class="empty">{{view === 'action' ? '当前没有待处理事项' : view === 'cc' ? '当前没有抄送事项' : view === 'done' ? '还没有处理记录' : '当前没有发出的事项'}}</view>

  <view wx:if="{{view !== 'tasks'}}" wx:for="{{items}}" wx:key="id" class="card task-row" data-id="{{item.id}}" bindtap="openDetail">
    <view class="task-head">
      <view class="task-title">{{item.title}}</view>
      <view class="state state-{{item.status}}">{{item.status_label || item.status}}</view>
    </view>
    <view class="task-sub">
      <text>{{item.object_type === 'work_record' ? '工作记录' : '工作文书'}}</text>
      <text class="dot">·</text>
      <text wx:if="{{item.mode_label}}">{{item.mode_label}}</text>
      <text wx:if="{{item.mode_label}}" class="dot">·</text>
      <text>{{item.action_label || (item.mode === 'cc' ? '抄送跟踪' : '请处理')}}</text>
      <text wx:if="{{item.source}}" class="dot">·</text>
      <text wx:if="{{item.source}}">{{item.source}}</text>
    </view>
    <view wx:if="{{item.description}}" class="description">{{item.description}}</view>
    <view class="task-meta">
      <text>{{item.viewer_role === 'sender' || view === 'sent' ? '致 ' + item.recipient_name : '来自 ' + item.sender_name}}</text>
      <text class="dot">·</text>
      <text>{{item.created_at_text || item.created_at}}</text>
    </view>
    <view wx:if="{{item.deadline_label || item.cc_names_text}}" class="task-foot">
      <text wx:if="{{item.deadline_label}}" class="deadline deadline-{{item.deadline_state}}">{{item.deadline_label}}</text>
      <text wx:if="{{item.cc_names_text}}" class="cc-line">抄送 {{item.cc_names_text}}</text>
    </view>
    <view wx:if="{{view === 'done' && (item.completed_by_name || item.completed_at_text)}}" class="done-line">
      <text wx:if="{{item.completed_by_name}}">{{item.completed_by_name}} 完成</text>
      <text wx:if="{{item.completed_at_text}}">{{item.completed_by_name ? ' · ' : ''}}完成于 {{item.completed_at_text}}</text>
    </view>
  </view>

  <view wx:if="{{view === 'action' && tasks.length}}" class="section-label">派单任务</view>

  <view wx:if="{{view === 'tasks' && loading && !tasks.length}}" class="empty">正在加载派单…</view>
  <view wx:if="{{view === 'tasks' && !loading && !tasks.length}}" class="empty">当前没有符合条件的派单</view>
  <view wx:if="{{view === 'tasks' || view === 'action'}}" wx:for="{{tasks}}" wx:key="id" class="card task {{focusId === item.id ? 'focused' : ''}}">
    <view class="task-head">
      <view class="task-title">{{item.title}}</view>
      <view class="priority" style="{{item.priority === '紧急' ? 'color:#fff;background:#b93838' : item.priority === '高' ? 'color:#9d2e2e;background:#fee3e3' : ''}}">{{item.priority}}</view>
    </view>
    <view class="tags"><text>{{item.category}}</text><text>{{item.status}}</text></view>
    <view wx:if="{{item.description}}" class="description">{{item.description}}</view>
    <view wx:if="{{item.assigner_name}}" class="muted">派发人：{{item.assigner_name}}</view>
    <view wx:if="{{item.section || item.location}}" class="muted">地点：{{item.section}} {{item.location}}</view>
    <view wx:if="{{item.deadline}}" class="muted">截止：{{item.deadline}}</view>
    <view class="actions">
      <button wx:if="{{item.status === '待接单'}}" size="mini" data-id="{{item.id}}" disabled="{{actionId}}" bindtap="reject">拒绝</button>
      <button wx:if="{{item.status === '待接单'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="accept">接单</button>
      <button wx:if="{{item.status === '已接单'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="start">开始</button>
      <button wx:if="{{item.status === '进行中'}}" size="mini" data-id="{{item.id}}" bindtap="capture">上传取证</button>
      <button wx:if="{{item.status === '进行中'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="complete">完成</button>
      <button size="mini" open-type="share" data-id="{{item.id}}">分享</button>
    </view>
  </view>

  <view wx:if="{{view !== 'tasks' && hasMore}}" class="load-more" bindtap="loadMore">
    <text wx:if="{{loadingMore}}">正在加载…</text>
    <text wx:else>显示更多</text>
  </view>

  <view wx:if="{{detail}}" class="detail-mask" catchtouchmove="true">
    <view class="detail-backdrop" bindtap="closeDetail"></view>
    <view class="detail-panel">
      <view class="detail-head">
        <view class="detail-heading">
          <text class="detail-eyebrow">{{detail.object_type === 'work_record' ? '工作记录' : '工作文书'}} · {{detail.action_label || '协作事项'}}</text>
          <text class="detail-title">{{detail.title}}</text>
        </view>
        <text class="close" bindtap="closeDetail">×</text>
      </view>

      <view class="detail-chips">
        <text class="chip status-{{detail.status}}">{{detail.status_label || detail.status}}</text>
        <text wx:if="{{detail.mode_label}}" class="chip chip-quiet">{{detail.mode_label}}</text>
        <text wx:if="{{detail.deadline_label}}" class="chip deadline-{{detail.deadline_state}}">{{detail.deadline_label}}</text>
      </view>

      <view class="detail-info">
        <view class="info-row"><text class="info-key">发起人</text><text class="info-value">{{detail.sender_name}}</text></view>
        <view class="info-row"><text class="info-key">负责人</text><text class="info-value">{{detail.recipient_name}}</text></view>
        <view wx:if="{{detail.deadline}}" class="info-row"><text class="info-key">期望完成</text><text class="info-value">{{detail.deadline}}</text></view>
        <view wx:if="{{detail.source}}" class="info-row"><text class="info-key">来源</text><text class="info-value">{{detail.source}}</text></view>
        <view wx:if="{{detail.last_reminded_at_text}}" class="info-row"><text class="info-key">最近催办</text><text class="info-value">{{detail.last_reminded_at_text}}</text></view>
      </view>

      <view wx:if="{{detail.description}}" class="detail-description">{{detail.description}}</view>

      <view wx:if="{{detail.cc_recipients.length}}" class="detail-block">
        <text class="block-title">抄送</text>
        <view wx:for="{{detail.cc_recipients}}" wx:key="id" class="cc-row">
          <text>{{item.real_name}}</text>
          <text class="read-mark {{item.read_at ? 'read' : ''}}">{{item.read_at ? '已读' : '未读'}}</text>
        </view>
      </view>

      <view wx:if="{{detail.resolution || detail.status === 'completed'}}" class="resolution-card">
        <text class="block-title">处理结果</text>
        <text class="resolution-text">{{detail.resolution || '已完成'}}</text>
        <text class="resolution-meta">{{detail.completed_by_name}}{{detail.completed_at_text ? ' · ' + detail.completed_at_text : ''}}</text>
      </view>

      <view wx:if="{{detail.object_deleted}}" class="notice">关联业务对象已删除，仅保留协作记录</view>
      <view wx:if="{{detail.object}}" class="business-summary">
        <text class="block-title">业务状态</text>
        <view class="info-row"><text class="info-key">当前状态</text><text class="info-value">{{detail.object.status}}</text></view>
        <view wx:if="{{detail.object.record_type}}" class="info-row"><text class="info-key">记录类型</text><text class="info-value">{{detail.object.record_type}}</text></view>
        <view wx:if="{{detail.object.doc_type}}" class="info-row"><text class="info-key">文书类型</text><text class="info-value">{{detail.object.doc_type}}</text></view>
        <view wx:if="{{detail.object.reject_reason}}" class="info-row"><text class="info-key">驳回原因</text><text class="info-value">{{detail.object.reject_reason}}</text></view>
      </view>

      <view class="detail-block">
        <text class="block-title">处理记录</text>
        <view wx:if="{{!detail.history.length}}" class="history-empty">还没有处理记录</view>
        <view wx:for="{{detail.history}}" wx:key="created_at" class="history-row">
          <view class="history-dot"></view>
          <view class="history-body">
            <view class="history-head">
              <text>{{item.action_label || item.action}}</text>
              <text class="history-time">{{item.created_at_text || item.created_at}}</text>
            </view>
            <text wx:if="{{item.actor_name}}" class="history-actor">{{item.actor_name}}</text>
            <text wx:if="{{item.detail}}" class="history-detail">{{item.detail}}</text>
          </view>
        </view>
      </view>

      <view class="actions">
        <button wx:if="{{!detail.object_deleted}}" size="mini" class="action-ghost" bindtap="openBusiness">查看业务详情</button>
        <button wx:if="{{detail.can_remind}}" size="mini" class="action-ghost" loading="{{remindingId === detail.id}}" disabled="{{remindingId > 0}}" bindtap="remindItem">催办</button>
        <button wx:if="{{detail.can_transfer}}" size="mini" class="action-ghost" bindtap="openTransfer">转派</button>
        <button wx:if="{{detail.can_cancel}}" size="mini" class="action-ghost" bindtap="cancelItem">撤回</button>
        <button wx:if="{{detail.status === 'pending' && detail.action_type === 'approve' && !detail.object_deleted}}" size="mini" class="action-ghost danger-text" disabled="{{collabActionId > 0}}" bindtap="rejectItem">驳回</button>
        <button wx:if="{{detail.can_resolve}}" class="primary" size="mini" loading="{{collabActionId === detail.id}}" disabled="{{collabActionId > 0}}" bindtap="completeItem">标记完成</button>
        <button wx:if="{{detail.is_signoff && detail.status === 'pending' && !detail.object_deleted}}" class="primary" size="mini" bindtap="openBusiness">前往签认</button>
        <button wx:if="{{detail.status === 'pending' && detail.action_type === 'approve' && !detail.object_deleted}}" class="primary" size="mini" loading="{{collabActionId === detail.id}}" disabled="{{collabActionId > 0}}" bindtap="completeItem">审批通过</button>
      </view>
      <view wx:if="{{detail.viewer_role === 'sender' && detail.mode === 'action' && detail.status === 'pending' && !detail.can_remind && detail.remind_available_text}}" class="hint">可在 {{detail.remind_available_text}} 后再次催办</view>
    </view>
  </view>

  <view wx:if="{{completion}}" class="completion-mask" catchtouchmove="true">
    <view class="completion-backdrop" bindtap="closeCompletion"></view>
    <view class="completion-panel">
      <view class="completion-icon {{completion.tone}}">{{completion.tone === 'danger' ? '!' : '✓'}}</view>
      <text class="completion-eyebrow">{{completion.eyebrow}}</text>
      <text class="completion-title">{{completion.title}}</text>
      <text class="completion-desc">{{completion.description}}</text>
      <text wx:if="{{completion.note}}" class="completion-note">{{completion.note}}</text>
      <view class="completion-meta">
        <view class="completion-meta-row"><text>事项</text><text>{{completion.itemTitle}}</text></view>
        <view class="completion-meta-row"><text>发起人</text><text>{{completion.senderName}}</text></view>
        <view class="completion-meta-row"><text>状态</text><text class="completion-status">{{completion.statusLabel}}</text></view>
      </view>
      <button class="completion-primary" bindtap="viewCompletionBusiness" disabled="{{completion.objectDeleted}}">{{completion.objectDeleted ? '业务对象已删除' : completion.objectType === 'work_record' ? '查看工作记录' : '查看工作文书'}}</button>
      <button class="completion-secondary" bindtap="backToInbox">返回待办</button>
    </view>
  </view>
</view>