<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="待办事项" left="back" />
  <scroll-view scroll-x class="view-tabs" show-scrollbar="false">
    <view wx:for="{{views}}" wx:key="key" data-view="{{item.key}}" class="view-tab {{view === item.key ? 'active' : ''}}" bindtap="selectView">
      {{item.label}}<text wx:if="{{item.key === 'action' && pendingCount}}" class="count">{{pendingCount > 99 ? '99+' : pendingCount}}</text>
    </view>
  </scroll-view>
  <view wx:if="{{view === 'tasks'}}" class="filter-row">
    <picker mode="selector" range="{{statuses}}" value="{{statusIndex}}" bindchange="onFilterChange">
      <view class="filter">状态：{{statuses[statusIndex]}} ▾</view>
    </picker>
    <text class="muted">共 {{tasks.length}} 项</text>
  </view>

  <view wx:if="{{view !== 'tasks' && loading && !items.length}}" class="empty">正在加载待办事项…</view>
  <view wx:elif="{{view !== 'tasks' && !items.length && !(view === 'action' && tasks.length)}}" class="empty">{{view === 'action' ? '当前没有待处理事项' : view === 'cc' ? '当前没有抄送事项' : view === 'done' ? '还没有处理记录' : '当前没有发出的事项'}}</view>
  <view wx:if="{{view !== 'tasks'}}" wx:for="{{items}}" wx:key="id" class="card task" data-id="{{item.id}}" bindtap="openDetail">
    <view class="task-head"><view class="task-title">{{item.title}}</view><view class="state {{item.status}}">{{item.status_label || item.status}}</view></view>
    <view class="tags"><text>{{item.object_type === 'work_record' ? '工作记录' : '工作文书'}}</text><text>{{item.mode_label || (item.mode === 'cc' ? '抄送跟踪' : '待我处理')}}</text><text>{{item.action_label || '请处理'}}</text></view>
    <view wx:if="{{item.description}}" class="description">{{item.description}}</view>
    <view class="muted">{{view === 'sent' ? '接收人：' + item.recipient_name : '发起人：' + item.sender_name}} · {{item.created_at_text || item.created_at}}</view>
    <view wx:if="{{view === 'done' && item.completed_at_text}}" class="muted">完成于：{{item.completed_at_text}}</view>
    <view wx:if="{{item.cc_names_text}}" class="muted">抄送：{{item.cc_names_text}}</view>
  </view>

  <view wx:if="{{view === 'tasks' && loading && !tasks.length}}" class="empty">正在加载派单…</view>
  <view wx:if="{{view === 'tasks' && !loading && !tasks.length}}" class="empty">当前没有符合条件的派单</view>
  <view wx:if="{{view === 'tasks' || view === 'action'}}" wx:for="{{tasks}}" wx:key="id" class="card task {{focusId === item.id ? 'focused' : ''}}">
    <view class="task-head">
      <view class="task-title">{{item.title}}</view>
      <view class="priority" style="{{item.priority === '紧急' ? 'color:#fff;background:#b93838' : item.priority === '高' ? 'color:#9d2e2e;background:#fee3e3' : ''}}">{{item.priority}}</view>
    </view>
    <view class="tags"><text>{{item.category}}</text><text>{{item.status}}</text></view>
    <view wx:if="{{item.description}}" class="description">{{item.description}}</view>
    <view wx:if="{{item.assigner_name}}" class="muted">派发人：{{item.assigner_name}}</view>
    <view wx:if="{{item.section || item.location}}" class="muted">地点：{{item.section}} {{item.location}}</view>
    <view wx:if="{{item.deadline}}" class="muted">截止：{{item.deadline}}</view>
    <view class="actions">
      <button wx:if="{{item.status === '待接单'}}" size="mini" data-id="{{item.id}}" disabled="{{actionId}}" bindtap="reject">拒绝</button>
      <button wx:if="{{item.status === '待接单'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="accept">接单</button>
      <button wx:if="{{item.status === '已接单'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="start">开始</button>
      <button wx:if="{{item.status === '进行中'}}" size="mini" data-id="{{item.id}}" bindtap="capture">上传取证</button>
      <button wx:if="{{item.status === '进行中'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="complete">完成</button>
      <button size="mini" open-type="share" data-id="{{item.id}}">分享</button>
    </view>
  </view>

  <view wx:if="{{detail}}" class="detail-mask" catchtouchmove="true">
    <view class="detail-backdrop" bindtap="closeDetail"></view>
    <view class="detail-panel">
      <view class="detail-head"><text class="detail-title">{{detail.title}}</text><text class="close" bindtap="closeDetail">×</text></view>
      <view class="tags"><text>{{detail.object_type === 'work_record' ? '工作记录' : '工作文书'}}</text><text>{{detail.mode_label || (detail.mode === 'cc' ? '抄送跟踪' : '待我处理')}}</text><text>{{detail.action_label || '请处理'}}</text><text>{{detail.status_label || detail.status}}</text></view>
      <view class="muted">发起人：{{detail.sender_name}}</view>
      <view wx:if="{{detail.description}}" class="description">{{detail.description}}</view>
      <view wx:if="{{detail.cc_names_text}}" class="muted">抄送：{{detail.cc_names_text}}</view>
      <view wx:if="{{detail.object_deleted}}" class="muted">关联业务对象已删除，仅保留协作记录</view>
      <view wx:if="{{detail.object}}" class="business-summary">
        <view>业务状态：{{detail.object.status}}</view>
        <view wx:if="{{detail.object.record_type}}">记录类型：{{detail.object.record_type}}</view>
        <view wx:if="{{detail.object.doc_type}}">文书类型：{{detail.object.doc_type}}</view>
        <view wx:if="{{detail.object.reject_reason}}">驳回原因：{{detail.object.reject_reason}}</view>
      </view>
      <view wx:if="{{detail.history.length}}" class="history-title">处理记录</view>
      <view wx:for="{{detail.history}}" wx:key="created_at" class="history-row">{{item.action_label || item.action}}{{item.actor_name ? ' · ' + item.actor_name : ''}}{{item.detail ? ' · ' + item.detail : ''}} · {{item.created_at_text || item.created_at}}</view>
      <view class="actions">
        <button wx:if="{{!detail.object_deleted}}" size="mini" bindtap="openBusiness">查看业务详情</button>
        <button wx:if="{{!detail.object_deleted && detail.mode === 'action' && detail.status === 'pending' && detail.action_type !== 'approve' && !detail.is_signoff}}" class="primary" size="mini" loading="{{collabActionId === detail.id}}" disabled="{{collabActionId > 0}}" bindtap="completeItem">标记完成</button>
        <button wx:if="{{!detail.object_deleted && detail.mode === 'action' && detail.status === 'pending' && detail.is_signoff}}" class="primary" size="mini" bindtap="openBusiness">前往签认</button>
        <button wx:if="{{!detail.object_deleted && detail.can_transfer}}" size="mini" bindtap="openTransfer">转派</button>
        <button wx:if="{{detail.can_cancel}}" size="mini" bindtap="cancelItem">撤回</button>
        <button wx:if="{{!detail.object_deleted && detail.mode === 'action' && detail.status === 'pending' && detail.action_type === 'approve'}}" size="mini" disabled="{{collabActionId > 0}}" bindtap="rejectItem">驳回</button>
        <button wx:if="{{!detail.object_deleted && detail.mode === 'action' && detail.status === 'pending' && detail.action_type === 'approve'}}" class="primary" size="mini" loading="{{collabActionId === detail.id}}" disabled="{{collabActionId > 0}}" bindtap="completeItem">审批通过</button>
      </view>
    </view>
  </view>

  <view wx:if="{{completion}}" class="completion-mask" catchtouchmove="true">
    <view class="completion-backdrop" bindtap="closeCompletion"></view>
    <view class="completion-panel">
      <view class="completion-icon {{completion.tone}}">{{completion.tone === 'danger' ? '!' : '✓'}}</view>
      <text class="completion-eyebrow">{{completion.eyebrow}}</text>
      <text class="completion-title">{{completion.title}}</text>
      <text class="completion-desc">{{completion.description}}</text>
      <text wx:if="{{completion.note}}" class="completion-note">{{completion.note}}</text>
      <view class="completion-meta">
        <view class="completion-meta-row"><text>事项</text><text>{{completion.itemTitle}}</text></view>
        <view class="completion-meta-row"><text>发起人</text><text>{{completion.senderName}}</text></view>
        <view class="completion-meta-row"><text>状态</text><text class="completion-status">{{completion.statusLabel}}</text></view>
      </view>
      <button class="completion-primary" bindtap="viewCompletionBusiness" disabled="{{completion.objectDeleted}}">{{completion.objectDeleted ? '业务对象已删除' : completion.objectType === 'work_record' ? '查看工作记录' : '查看工作文书'}}</button>
      <button class="completion-secondary" bindtap="backToInbox">返回待办</button>
    </view>
  </view>
</view>
