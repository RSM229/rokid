/* 玻璃拟态改造（浅色版） */
.filter-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.view-tabs { white-space: nowrap; margin: 4rpx 0 24rpx; border-bottom: 1rpx solid rgba(33,53,74,.14); }
.view-tab { position: relative; display: inline-flex; align-items: center; gap: 8rpx; padding: 18rpx 20rpx; color: #536273; font-size: 27rpx; }
.view-tab.active { color: #176b62; font-weight: 650; border-bottom: 4rpx solid #176b62; }
.count { min-width: 30rpx; height: 30rpx; line-height: 30rpx; padding: 0 8rpx; border-radius: 18rpx; text-align: center; color: #fff; background: #c83c35; font-size: 20rpx; }
.state { flex: none; color: #6a7480; font-size: 23rpx; }
.state.pending { color: #b73832; }
.filter { padding: 16rpx 22rpx; border-radius: 16rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(255,255,255,0.60); }
.task.focused { outline: 4rpx solid #d9a441; }
.task-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.task-title { flex: 1; font-size: 31rpx; font-weight: 650; }
.priority { padding: 5rpx 14rpx; border-radius: 14rpx; color: #7d5b18; background: rgba(255, 241, 204, 0.85); font-size: 22rpx; }

.tags { display: flex; gap: 12rpx; margin: 18rpx 0; }
.tags text { padding: 6rpx 14rpx; border-radius: 12rpx; color: var(--brand, #1677ff); background: rgba(var(--wash-rgb, 234,243,255), 0.8); font-size: 22rpx; }
.description { margin-bottom: 16rpx; color: #334a64; line-height: 1.6; }
.actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; }
.actions button { margin: 0; }

/* 列表卡片反复渲染，去模糊保性能 */
.card { background: rgba(255,255,255,0.34); backdrop-filter: none; -webkit-backdrop-filter: none; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); }
.detail-mask { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: flex-end; }
.detail-backdrop { position: absolute; inset: 0; background: rgba(16,27,39,.42); }
.detail-panel { position: relative; width: 100%; max-height: 82vh; overflow-y: auto; box-sizing: border-box; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 16rpx 16rpx 0 0; background: #f8fafb; }
.detail-head { display: flex; align-items: flex-start; gap: 20rpx; justify-content: space-between; }
.detail-title { flex: 1; font-size: 34rpx; line-height: 1.4; font-weight: 650; color: #172b3b; }
.close { width: 48rpx; text-align: center; font-size: 44rpx; line-height: 44rpx; color: #677582; }
.business-summary { margin-top: 24rpx; padding: 18rpx 0; border-top: 1rpx solid #dfe5e9; border-bottom: 1rpx solid #dfe5e9; color: #354756; line-height: 1.8; }
.history-title { margin-top: 22rpx; font-weight: 650; }
.history-row { padding: 12rpx 0; color: #5c6873; font-size: 23rpx; border-bottom: 1rpx solid #e5e9ec; }

/* 处理完成：先给结果，再让事项进入“已完成”记录 */
.completion-mask { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: flex-end; }
.completion-backdrop { position: absolute; inset: 0; background: rgba(16, 27, 39, 0.46); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
.completion-panel {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 52rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
  text-align: center;
  animation: completion-up 0.24s ease-out;
}
.completion-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 54rpx;
  font-weight: 600;
  animation: completion-pop 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.2);
}
.completion-icon.success { background: linear-gradient(145deg, #2d9d82, #176b62); box-shadow: 0 16rpx 40rpx rgba(23, 107, 98, 0.22); }
.completion-icon.danger { background: linear-gradient(145deg, #d26057, #b73832); box-shadow: 0 16rpx 40rpx rgba(183, 56, 50, 0.2); }
.completion-eyebrow { display: block; color: #8795a6; font-size: 22rpx; letter-spacing: 3rpx; }
.completion-title { display: block; margin-top: 10rpx; color: #142b42; font-size: 42rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.completion-desc { display: block; max-width: 560rpx; margin: 18rpx auto 0; color: #5d6c7b; font-size: 26rpx; line-height: 1.65; }
.completion-note { display: block; margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: #f5f8fa; color: #3d5368; font-size: 24rpx; line-height: 1.6; text-align: left; word-break: break-all; }
.completion-meta { margin-top: 28rpx; border-top: 1rpx solid #e6ebef; }
.completion-meta-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx solid #eef2f5; font-size: 25rpx; }
.completion-meta-row text:first-child { flex: none; color: #8a97a5; }
.completion-meta-row text:last-child { flex: 1; color: #263e55; text-align: right; word-break: break-all; }
.completion-status { color: #176b62 !important; font-weight: 650; }
.completion-primary { margin-top: 30rpx; border-radius: 18rpx; background: #176b62; color: #fff; font-size: 29rpx; font-weight: 600; }
.completion-secondary { margin-top: 14rpx; background: transparent; color: #536273; font-size: 27rpx; }
.completion-primary::after, .completion-secondary::after { border: none; }
.completion-primary[disabled] { background: #dfe6e9; color: #8a97a5; }

@keyframes completion-up {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
@keyframes completion-pop {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}