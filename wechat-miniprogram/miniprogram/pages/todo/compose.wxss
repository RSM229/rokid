.compose-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; }
.form { padding-top: 18rpx; }
.field { padding: 22rpx 0; border-bottom: 1rpx solid #dfe5e9; }
.label { display: block; margin-bottom: 14rpx; color: #586875; font-size: 24rpx; }
.value, input, textarea, .picker { color: #203442; font-size: 28rpx; line-height: 1.5; }
.picker { padding: 12rpx 0; }
.modes { display: flex; gap: 34rpx; color: #203442; font-size: 27rpx; }
.cc-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx 18rpx; color: #203442; font-size: 25rpx; }
.cc-list label { display: flex; align-items: center; min-width: 0; }
.submit { margin-top: 36rpx; border-radius: 8rpx; background: #176b62; color: #fff; }
