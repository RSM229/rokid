<view class="page">
  <view class="title">项目通讯录</view>
  <view class="hint">与同项目成员进行语音或视频通话</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{active}}" bindtap="resume">返回当前通话</button>
  <view wx:for="{{contacts}}" wx:key="id" class="contact">
    <view class="name">{{item.real_name}}</view><view class="hint">{{item.role}}</view>
    <view class="actions">
      <button size="mini" data-id="{{item.id}}" data-media="audio" disabled="{{busy || !configured || active}}" bindtap="call">语音</button>
      <button size="mini" data-id="{{item.id}}" data-media="video" disabled="{{busy || !configured || active}}" bindtap="call">视频</button>
    </view>
  </view>
  <view wx:if="{{!loading && !contacts.length}}" class="hint">暂无可通话的项目成员</view>
  <button wx:if="{{more}}" loading="{{loading}}" bindtap="loadMore">加载更多</button>
  <button loading="{{loading}}" bindtap="load">刷新</button>
</view>
