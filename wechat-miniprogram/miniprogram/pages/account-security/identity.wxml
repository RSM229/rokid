<!-- 身份信息（账号安全 · 子目录）· 2026-10-12 晚
     只读展示：用户名 / 手机号 / 公司。缓存先上屏，/auth/me 实时覆盖。 -->
<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="身份信息" left="back" />

  <view class="section">
    <view class="cell" wx:if="{{user.username}}">
      <text class="cell-label">用户名</text>
      <text class="cell-value">{{user.username}}</text>
    </view>
    <view class="cell" wx:if="{{user.real_name}}">
      <text class="cell-label">姓名</text>
      <text class="cell-value">{{user.real_name}}</text>
    </view>
    <view class="cell" wx:if="{{user.role}}">
      <text class="cell-label">岗位角色</text>
      <text class="cell-value">{{user.role}}</text>
    </view>
    <view class="cell" wx:if="{{user.phone}}">
      <text class="cell-label">手机号</text>
      <text class="cell-value">{{user.phone}}</text>
    </view>
    <view class="cell" wx:if="{{user.company_name}}">
      <text class="cell-label">公司</text>
      <text class="cell-value">{{user.company_name}}</text>
    </view>
  </view>
</view>
