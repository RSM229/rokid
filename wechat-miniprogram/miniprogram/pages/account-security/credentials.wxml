<!-- 登录凭据（账号安全 · 子目录）· 2026-10-12 晚
     登录密码 + 密保问题。密保表单在独立页 pages/security（忘记密码自助重置的依据）。 -->
<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="登录凭据" left="back" />

  <view class="section">
    <!-- 设置登录密码：微信一键登录的用户设密后即可在电脑端(Web)用账号密码登录 -->
    <view class="cell" bindtap="setLoginPassword">
      <view class="cell-main">
        <text class="cell-label">{{settingPwd ? '正在设置…' : '设置登录密码'}}</text>
        <text class="cell-sub">设置后可在电脑端用「账号 + 密码」登录，数据与小程序同步</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <!-- 密保问题：忘记密码时自助重置的依据 -->
    <view class="cell" bindtap="openSecurity">
      <view class="cell-main">
        <text class="cell-label">密保问题</text>
        <text class="cell-sub">设置后忘记密码可自助重置，无需联系管理员</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>
</view>
