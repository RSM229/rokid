/* 账号安全（目录页）· 2026-10-12 晚重构
   目录行布局基元来自共用 partial；本文件只放「微信绑定」行的三个图标与徽标。 */
@import "../../styles/cell-list.wxss";

.bind-tag {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.65;
}
.bind-tag.on { color: #0f7a55; background: rgba(19,121,91,0.12); }
.bind-tag.off { color: #8a94a6; background: rgba(20,40,60,0.08); }
.bind-tag.unknown { color: #d97706; background: rgba(217,119,6,0.12); }

/* 身份信息：主题蓝（人形） */
.entry-icon.ic-id::before {
  background-color: var(--brand, #2f3237);
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4-4,1.79-4,4,1.79,4,4,4zm0,2c-2.67,0-8,1.34-8,4v3h16v-3c0-2.66-5.33-4-8-4z%22/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4-4,1.79-4,4,1.79,4,4,4zm0,2c-2.67,0-8,1.34-8,4v3h16v-3c0-2.66-5.33-4-8-4z%22/%3E%3C/svg%3E");
}

/* 微信绑定：微信绿（对话气泡） */
.entry-icon.ic-wx {
  background: rgba(19,121,91,0.10);
  border-color: rgba(19,121,91,0.20);
}
.entry-icon.ic-wx::before {
  background-color: #0f7a55;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%230f7a55%22%20d=%22M21,6h-2v9H6v2c0,0.55,0.45,1,1,1h11l4,4V7c0-0.55-0.45-1-1-1zM17,12V3c0-0.55-0.45-1-1-1H3c-0.55,0-1,0.45-1,1v14l4-4h10c0.55,0,1-0.45,1-1z%22/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%230f7a55%22%20d=%22M21,6h-2v9H6v2c0,0.55,0.45,1,1,1h11l4,4V7c0-0.55-0.45-1-1-1zM17,12V3c0-0.55-0.45-1-1-1H3c-0.55,0-1,0.45-1,1v14l4-4h10c0.55,0,1-0.45,1-1z%22/%3E%3C/svg%3E");
}

/* 登录凭据：中性灰蓝（钥匙）——与「我的」页设置的用色语言一致 */
.entry-icon.ic-key {
  background: rgba(20,40,60,0.07);
  border-color: rgba(20,40,60,0.14);
}
.entry-icon.ic-key::before {
  background-color: #5b6b85;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%235b6b85%22%20d=%22M12.65,10C11.83,7.67,9.61,6,7,6c-3.31,0-6,2.69-6,6s2.69,6,6,6c2.61,0,4.83-1.67,5.65-4H17v4h4v-4h2v-4H12.65zM7,14c-1.1,0-2-0.9-2-2s0.9-2,2-2,2,0.9,2,2-0.9,2-2,2z%22/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%235b6b85%22%20d=%22M12.65,10C11.83,7.67,9.61,6,7,6c-3.31,0-6,2.69-6,6s2.69,6,6,6c2.61,0,4.83-1.67,5.65-4H17v4h4v-4h2v-4H12.65zM7,14c-1.1,0-2-0.9-2-2s0.9-2,2-2,2,0.9,2,2-0.9,2-2,2z%22/%3E%3C/svg%3E");
}
