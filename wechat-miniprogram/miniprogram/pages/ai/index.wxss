/* 玻璃拟态改造（浅色版） */
.page { padding: 24rpx; }
.tabs { display: flex; gap: 10rpx; margin-bottom: 20rpx; padding: 8rpx; border-radius: 20rpx; background: rgba(255,255,255,0.48); border: 2rpx solid rgba(255,255,255,0.60); }
.tabs view { flex: 1; padding: 16rpx 0; text-align: center; border-radius: 16rpx; color: #5c6e84; font-size: 25rpx; font-weight: 500; }
.tabs .active { color: #fff; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); font-weight: 700; }
.card { padding: 24rpx; margin-bottom: 16rpx; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16); }
.field-label { display: block; margin-bottom: 10rpx; font-size: 25rpx; color: #555; font-weight: 600; }
.ta { width: 100%; min-height: 160rpx; padding: 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; background: rgba(255,255,255,0.34); box-sizing: border-box; }
.kb-row { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 0; }
.picker { height: 72rpx; line-height: 72rpx; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 26rpx; background: rgba(255,255,255,0.34); }
.btn-primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 26rpx; border-radius: 12rpx; border: none; }
.btn-green { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-full { width: 100%; margin-top: 16rpx; height: 76rpx; line-height: 76rpx; }
.result-title { font-size: 30rpx; font-weight: 700; color: var(--ink-2, #243b55); margin-bottom: 12rpx; }
.result-body { font-size: 27rpx; color: #334; line-height: 1.7; white-space: pre-wrap; margin-bottom: 16rpx; }

.model-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.32);
  border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14);
}
.model-bar-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0));
}
.model-bar-label { font-size: 25rpx; color: #5c6e84; font-weight: 600; }
.model-bar-name { flex: 1; font-size: 26rpx; color: var(--ink-2, #243b55); font-weight: 600; }
.model-bar-caret { font-size: 24rpx; color: #5c6e84; }
