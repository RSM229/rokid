<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="智能助手" left="back" />

  <view class="tabs">
    <view class="{{mode === 'task' ? 'active' : ''}}" data-mode="task" bindtap="onMode">任务报告</view>
    <view class="{{mode === 'podcast' ? 'active' : ''}}" data-mode="podcast" bindtap="onMode">播客</view>
    <view class="{{mode === 'image' ? 'active' : ''}}" data-mode="image" bindtap="onMode">AI 生图</view>
  </view>

  <view class="model-bar" bindtap="onModelPickerToggle">
    <view class="model-bar-dot"></view>
    <text class="model-bar-label">模型</text>
    <text class="model-bar-name">{{currentModelName}}</text>
    <text class="model-bar-caret">{{modelPickerVisible ? '▴' : '▾'}}</text>
  </view>

  <!-- 任务报告 -->
  <block wx:if="{{mode === 'task'}}">
    <view class="card">
      <view class="field-label">任务要求</view>
      <textarea class="ta" value="{{taskPrompt}}" data-field="taskPrompt" placeholder="如：根据资料库，写一份“旁站监理工作要点”报告" bindinput="onInput" auto-height maxlength="2000" />
      <view class="kb-row">
        <text class="field-label">结合资料库</text>
        <switch checked="{{useKb}}" bindchange="onUseKb" />
      </view>
      <picker wx:if="{{useKb}}" mode="selector" range="{{kbs}}" range-key="name" value="{{kbIndex}}" bindchange="onKbChange">
        <view class="picker">{{kbIndex >= 0 ? kbs[kbIndex].name : '请选择资料库'}} ▾</view>
      </picker>
      <button class="btn-primary btn-full" loading="{{running}}" bindtap="runTask">生成报告</button>
    </view>
    <view wx:if="{{taskContent}}" class="card">
      <view class="result-title">{{taskTitle}}</view>
      <view class="result-body">{{taskContent}}</view>
      <button class="btn-green" size="mini" bindtap="saveTaskNote">保存为笔记</button>
    </view>
  </block>

  <!-- 播客 -->
  <block wx:if="{{mode === 'podcast'}}">
    <view class="card">
      <view class="field-label">播客素材（或从笔记/资料库稍后扩展）</view>
      <textarea class="ta" value="{{podcastText}}" data-field="podcastText" placeholder="粘贴一段内容，AI 会改写成口播文案并合成语音" bindinput="onInput" auto-height maxlength="6000" />
      <button class="btn-primary btn-full" loading="{{podcasting}}" bindtap="runPodcast">生成播客</button>
    </view>
    <view wx:if="{{podcastScript}}" class="card">
      <view class="result-title">口播文案</view>
      <view class="result-body">{{podcastScript}}</view>
      <button wx:if="{{podcastAudio}}" class="btn-green" size="mini" bindtap="playPodcast">▶ 播放语音</button>
    </view>
  </block>

  <!-- 生图 -->
  <block wx:if="{{mode === 'image'}}">
    <view class="card">
      <view class="field-label">画面描述</view>
      <textarea class="ta" value="{{imagePrompt}}" data-field="imagePrompt" placeholder="如：施工现场塔吊与安全网，写实风格" bindinput="onInput" auto-height maxlength="800" />
      <button class="btn-primary btn-full" loading="{{imaging}}" bindtap="runImage">生成图片</button>
    </view>
    <view wx:if="{{imageUrl}}" class="card">
      <image class="result-image" src="{{imageUrl}}" mode="widthFix" />
    </view>
  </block>

  <model-picker visible="{{modelPickerVisible}}" models="{{models}}" value="{{currentModelId}}" bind:select="onModelPicked" bind:close="onModelPickerToggle" />
</view>
