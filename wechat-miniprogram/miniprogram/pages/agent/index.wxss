.input-wrapper { flex: 1; min-height: 148rpx; border-radius: 48rpx; background: #ffffff; display: flex; align-items: center; padding: 0 26rpx; }
.input-wrapper.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); }
.recording-hint { display: flex; align-items: center; gap: 12rpx; color: #fff; font-size: 28rpx; font-weight: 600; }
.rec-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #fff; animation: rec-pulse 0.8s infinite; }
@keyframes rec-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
.chat-input { width: 100%; height: 148rpx; font-size: 32rpx; line-height: 148rpx; }
.input-placeholder { color: #a8b2c1; }
.send-btn { padding: 0 28rpx; height: 88rpx; line-height: 88rpx; border-radius: 46rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.75); color: var(--brand-l, #3a4046); font-size: 28rpx; font-weight: 600; flex-shrink: 0; text-align: center; }
.send-btn.active { background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); color: #fff; }
.mic-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background-color: rgba(255,255,255,0.50); background-repeat: no-repeat; background-position: center; background-size: 58%; flex-shrink: 0; }
.mic-btn.ic-mic { background-color: var(--brand, #2f3237); -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M512%20128a128%20128%200%200%200-128%20128v256a128%20128%200%201%200%20256%200V256a128%20128%200%200%200-128-128m0-64a192%20192%200%200%201%20192%20192v256a192%20192%200%201%201-384%200V256A192%20192%200%200%201%20512%2064m-32%20832v-64a288%20288%200%200%201-288-288v-32a32%2032%200%200%201%2064%200v32a224%20224%200%200%200%20224%20224h64a224%20224%200%200%200%20224-224v-32a32%2032%200%201%201%2064%200v32a288%20288%200%200%201-288%20288v64h64a32%2032%200%201%201%200%2064H416a32%2032%200%201%201%200-64z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M512%20128a128%20128%200%200%200-128%20128v256a128%20128%200%201%200%20256%200V256a128%20128%200%200%200-128-128m0-64a192%20192%200%200%201%20192%20192v256a192%20192%200%201%201-384%200V256A192%20192%200%200%201%20512%2064m-32%20832v-64a288%20288%200%200%201-288-288v-32a32%2032%200%200%201%2064%200v32a224%20224%200%200%200%20224%20224h64a224%20224%200%200%200%20224-224v-32a32%2032%200%201%201%2064%200v32a288%20288%200%200%201-288%20288v64h64a32%2032%200%201%201%200%2064H416a32%2032%200%201%201%200-64z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; }
.voice-hold { flex: 1; min-height: 64rpx; border-radius: 32rpx; background: #ffffff; color: var(--brand, #2f3237); font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; text-align: center; }
.voice-hold.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); color: #fff; animation: pulse 0.8s infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.02); } }

/* Overlays */
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 200; display: flex; align-items: flex-end; justify-content: center; }
.overlay-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60,0.35); animation: fadeIn 0.2s ease; }
.overlay-panel { position: relative; width: 100%; max-height: 85vh; background: #ffffff; border: 1rpx solid rgba(17,19,26,0.08); border-radius: 32rpx 32rpx 0 0; padding: 40rpx 36rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-shadow: 0 -8rpx 32rpx rgba(22,38,74,0.10); animation: slideUp 0.3s ease; overflow-y: auto; }
.work-form-panel { max-height: 90vh; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.panel-header { text-align: center; margin-bottom: 36rpx; }
.panel-title { display: block; font-size: 40rpx; font-weight: 700; color: #11131a; }
.panel-subtitle { display: block; font-size: 26rpx; color: #8a94a6; margin-top: 8rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink, #11131a); margin-bottom: 10rpx; }
.form-input { width: 100%; height: 76rpx; padding: 0 24rpx; border-radius: 16rpx; border: 1rpx solid rgba(255,255,255,0.72); background: #ffffff; box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; min-height: 80rpx; padding: 16rpx 24rpx; border-radius: 16rpx; border: 1rpx solid rgba(255,255,255,0.72); background: #ffffff; box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box; }
.content-area { min-height: 160rpx; }
.picker-value { line-height: 88rpx; color: var(--ink, #11131a); }
.panel-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-cancel { flex: 1; height: 88rpx; line-height: 88rpx; border-radius: 16rpx; font-size: 32rpx; color: #8a94a6; background: #ffffff; text-align: center; }
.btn-submit { flex: 2; height: 88rpx; line-height: 88rpx; border-radius: 16rpx; font-size: 32rpx; color: #fff; background: linear-gradient(135deg, var(--brand, #2f3237) 0%, var(--brand, #2f3237) 100%); text-align: center; }

/* History Overlay */
.history-overlay { align-items: stretch; justify-content: flex-start; }
.history-panel { position: relative; width: 72%; height: 100%; background: #ffffff; border: 1rpx solid rgba(17,19,26,0.08); border-radius: 0 32rpx 32rpx 0; padding: 40rpx 36rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; box-shadow: 8rpx 0 32rpx rgba(22,38,74,0.10); animation: slideRight 0.3s ease; }
.history-top { display: flex; align-items: center; margin-bottom: 24rpx; }
.drawer-scroll { flex: 1; min-height: 0; }
/* 分组全部收起时抽屉很短，组间距略收一点 */
.drawer-group { margin-bottom: 20rpx; }
.drawer-title { font-size: 24rpx; font-weight: 600; color: #8a94a6; letter-spacing: 2rpx; margin-bottom: 12rpx; }
/* 分组标题行＝折叠开关（整行可点）：标题 + 右侧折角箭头 */
.drawer-head { display: flex; align-items: center; padding: 12rpx; margin-bottom: 4rpx; border-radius: 12rpx; }
.drawer-head:active { background: rgba(255,255,255,0.50); }
.drawer-head .drawer-title { flex: 1; margin-bottom: 0; }
.drawer-nav { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 12rpx; border-radius: 12rpx; }
.drawer-nav:active { background: rgba(255,255,255,0.50); }
.drawer-nav-icon { width: 36rpx; height: 36rpx; background-repeat: no-repeat; background-position: center; background-size: contain; flex-shrink: 0; }
.drawer-nav-text { font-size: 28rpx; color: var(--ink, #11131a); }
/* 可折叠子目录的展开箭头（CSS 折角，无 data-uri）：收起=▾，展开=▴ */
.drawer-arrow { margin-left: auto; width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.drawer-arrow::before { content: ''; width: 12rpx; height: 12rpx; border-right: 2rpx solid #8a94a6; border-bottom: 2rpx solid #8a94a6; transform: translateY(-4rpx) rotate(45deg); transition: transform 0.2s ease; }
.drawer-arrow.open::before { transform: translateY(4rpx) rotate(-135deg); }
.drawer-sub { padding-left: 44rpx; }
.drawer-sub .drawer-nav-icon { width: 30rpx; height: 30rpx; }
.drawer-sub .drawer-nav-text { font-size: 26rpx; color: #5c7086; }
.drawer-static { padding: 18rpx 20rpx; border-radius: 16rpx; background: linear-gradient(135deg, rgba(255,255,255,0.62), rgba(255,255,255,0.44)); border: 1rpx solid rgba(255,255,255,0.72); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.80); }
/* 「项目概况」整卡可点 → 修改项目信息：淡品牌色描边暗示可交互 */
.project-summary-card { border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.20); transition: background 0.2s ease, border-color 0.2s ease; }
.project-summary-card:active { background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(255,255,255,0.58)); border-color: rgba(var(--brand-rgb, 47,50,55), 0.42); }
.project-card-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.project-card-title { flex: 1; margin-bottom: 0; }
.project-card-edit { display: flex; align-items: center; gap: 2rpx; flex-shrink: 0; }
.project-card-edit-text { font-size: 22rpx; color: #8a94a6; }
/* 右侧折角箭头指向右（复用 .drawer-arrow 的折角，不改共享规则） */
.edit-arrow { width: 30rpx; height: 30rpx; }
.edit-arrow::before { width: 9rpx; height: 9rpx; border-right: 2rpx solid var(--brand, #2f3237); border-bottom: 2rpx solid var(--brand, #2f3237); transform: rotate(-45deg); border-radius: 1rpx; }
.drawer-project-name { display: block; font-size: 32rpx; font-weight: 600; color: var(--ink, #11131a); line-height: 1.35; }
.drawer-loc { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: #8a94a6; }
.drawer-desc { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.65; color: #5c7086; max-height: 160rpx; overflow: hidden; }
.project-picker-panel { max-height: 66vh; display: flex; flex-direction: column; }
.project-picker-list { flex: 1; min-height: 0; padding: 0 12rpx; }
.project-item { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 24rpx 22rpx; border-radius: 20rpx; margin-bottom: 12rpx; background: #ffffff; border: 1rpx solid rgba(17, 19, 26, 0.08); transition: background 0.18s ease; }
.project-item:active { background: #f2f4f7; }
/* 选中态：浅品牌底 + 一根细边即可。原来用 inset 6rpx 模拟左侧色条（很丑），已去掉 */
.project-item.active { background: rgba(47,50,55, 0.06); border: 1rpx solid rgba(47,50,55, 0.28); }
.project-item-main { flex: 1; min-width: 0; }
.project-item-name { display: block; font-size: 32rpx; color: var(--ink, #11131a); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.project-item-code { display: block; margin-top: 6rpx; font-size: 22rpx; color: #8a94a6; }
.project-item-check { color: var(--brand, #2f3237); font-size: 40rpx; flex-shrink: 0; }
.project-empty { text-align: center; color: #a8b2c1; font-size: 26rpx; padding: 30rpx 0; }
.project-picker-foot { flex-shrink: 0; padding: 20rpx 12rpx 4rpx; margin-top: 16rpx; border-top: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); }
.picker-add-btn { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 16rpx; background: rgba(var(--brand-rgb, 47,50,55), 0.07); border: 1rpx dashed rgba(var(--brand-rgb, 47,50,55), 0.45); }
.picker-add-plus { font-size: 40rpx; line-height: 1; color: var(--brand, #2f3237); margin-right: 10rpx; }
.picker-add-text { font-size: 32rpx; color: #33405a; }
.history-new { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 24rpx; border-radius: 20rpx; background: rgba(var(--brand-rgb, 47,50,55), 0.85); }
.history-new:active { background: rgba(var(--brand-l-rgb, 59,140,255), 0.9); }
.history-new-text { font-size: 26rpx; font-weight: 600; color: #fff; }
.history-new .side-icon { width: 32rpx; height: 32rpx; background-repeat: no-repeat; background-position: center; background-size: contain; }
.history-new .side-icon.ic-plus { background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M352%20480h320a32%2032%200%201%201%200%2064H352a32%2032%200%200%201%200-64%22/%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M480%20672V352a32%2032%200%201%201%2064%200v320a32%2032%200%200%201-64%200%22/%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M512%20896a384%20384%200%201%200%200-768%20384%20384%200%200%200%200%20768m0%2064a448%20448%200%201%201%200-896%20448%20448%200%200%201%200%20896%22/%3E%3C/svg%3E"); }
.history-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 8rpx; border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }

/* 历史搜索框（2026-11-19） */
.history-search { position: relative; margin: 12rpx 0 4rpx; }
.history-search-input { height: 64rpx; padding: 0 64rpx 0 24rpx; border-radius: 16rpx; background: rgba(var(--deep-rgb, 10,46,92), 0.05); font-size: 24rpx; color: var(--ink, #11131a); box-sizing: border-box; }
.history-search-ph { color: #a8b2c1; }
.history-search-clear { position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%); width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: rgba(var(--deep-rgb, 10,46,92), 0.12); color: #64748b; font-size: 26rpx; }
.history-main { flex: 1; min-width: 0; }
.history-title { display: block; font-size: 28rpx; color: var(--ink, #11131a); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-time { display: block; font-size: 22rpx; color: #a8b2c1; margin-top: 6rpx; }
.history-del { flex-shrink: 0; padding: 8rpx 20rpx; border-radius: 16rpx; background: rgba(253,232,232,0.75); color: #b93838; font-size: 24rpx; }
.history-empty { text-align: center; color: #a8b2c1; font-size: 26rpx; padding: 20rpx 0; }
@keyframes slideRight { from { transform: translateX(-100%); } to { transform: translateX(0); } }

/* AI Polish */
.ai-polish-btn { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; padding: 10rpx 20rpx; border-radius: 12rpx; background: rgba(255,247,230,0.75); }
.ai-polish-icon { font-size: 24rpx; }
.ai-polish-text { font-size: 24rpx; color: #fa8c16; font-weight: 500; }

/* Quick Entry Chips（聊天框上方） */
.quick-chips { display: flex; gap: 16rpx; padding: 12rpx 20rpx 0; }
.qchip { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; border-radius: 30rpx; background: #ffffff; border: 1rpx solid rgba(17,19,26,0.08); box-shadow: 0 2rpx 10rpx rgba(22,38,74,0.05); font-size: 24rpx; font-weight: 600; color: var(--brand-d, #0060df); transition: background 0.18s ease, transform 0.12s ease; }
.qchip:active { background: linear-gradient(140deg, rgba(255,255,255,0.68), rgba(255,255,255,0.42)); transform: translateY(1rpx); }
.qchip-icon { width: 30rpx; height: 30rpx; background-repeat: no-repeat; background-position: center; background-size: contain; }
.qchip-icon.ic-file-add { background-color: var(--brand-d, #0060df); -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%230b4a9e%22%20d=%22M832%20384H576V128H192v768h640zm-26.5-64L640%20154.5V320zM160%2064h480l256%20256v608a32%2032%200%200%201-32%2032H160a32%2032%200%200%201-32-32V96a32%2032%200%200%201%2032-32m320%20512V448h64v128h128v64H544v128h-64V640H352v-64z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%230b4a9e%22%20d=%22M832%20384H576V128H192v768h640zm-26.5-64L640%20154.5V320zM160%2064h480l256%20256v608a32%2032%200%200%201-32%2032H160a32%2032%200%200%201-32-32V96a32%2032%200%200%201%2032-32m320%20512V448h64v128h128v64H544v128h-64V640H352v-64z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; }
.qchip-icon.ic-memo, .drawer-nav-icon.ic-memo { background-color: var(--brand, #2f3237); -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20xml:space=%22preserve%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M480%20320h192q32%200%2032-32c0-32-10.7-32-32-32H480q-32%200-32%2032c0%2032%2010.7%2032%2032%2032%22/%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M887%2073q-9-9-23-9H160q-14%200-23%209t-9%2023v832q0%2014%209%2023c9%209%2013.7%209%2023%209h704q14%200%2023-9c9-9%209-13.7%209-23V96q0-14-9-23M192%20896V128h96v768zm640%200H352V128h480z%22/%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M480%20512h192q32%200%2032-32c0-32-10.7-32-32-32H480q-32%200-32%2032c0%2032%2010.7%2032%2032%2032m0%20192h192q32%200%2032-32c0-32-10.7-32-32-32H480q-32%200-32%2032c0%2032%2010.7%2032%2032%2032%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20xml:space=%22preserve%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M480%20320h192q32%200%2032-32c0-32-10.7-32-32-32H480q-32%200-32%2032c0%2032%2010.7%2032%2032%2032%22/%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M887%2073q-9-9-23-9H160q-14%200-23%209t-9%2023v832q0%2014%209%2023c9%209%2013.7%209%2023%209h704q14%200%2023-9c9-9%209-13.7%209-23V96q0-14-9-23M192%20896V128h96v768zm640%200H352V128h480z%22/%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M480%20512h192q32%200%2032-32c0-32-10.7-32-32-32H480q-32%200-32%2032c0%2032%2010.7%2032%2032%2032m0%20192h192q32%200%2032-32c0-32-10.7-32-32-32H480q-32%200-32%2032c0%2032%2010.7%2032%2032%2032%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; }
.qchip-icon.ic-document { background-color: var(--brand, #2f3237); -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M832%20384H576V128H192v768h640zm-26.5-64L640%20154.5V320zM160%2064h480l256%20256v608a32%2032%200%200%201-32%2032H160a32%2032%200%200%201-32-32V96a32%2032%200%200%201%2032-32m160%20448h384v64H320zm0-192h160v64H320zm0%20384h384v64H320z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M832%20384H576V128H192v768h640zm-26.5-64L640%20154.5V320zM160%2064h480l256%20256v608a32%2032%200%200%201-32%2032H160a32%2032%200%200%201-32-32V96a32%2032%200%200%201%2032-32m160%20448h384v64H320zm0-192h160v64H320zm0%20384h384v64H320z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; }


/* Menu Panel */
.menu-panel { position: relative; width: 100%; background: #ffffff; border: 1rpx solid rgba(17,19,26,0.08); border-radius: 32rpx 32rpx 0 0; padding: 36rpx 28rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); box-shadow: 0 -8rpx 32rpx rgba(22,38,74,0.10); animation: slideUp 0.25s ease; }
.menu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28rpx 0; }
.menu-text { white-space: nowrap; }
.menu-item { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.menu-icon { width: 96rpx; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; position: relative; }
.menu-icon { background-repeat: no-repeat; background-position: center; background-size: 56%; }
.menu-icon.todo { background-color: rgba(var(--wash-rgb, 234,243,255), 0.75); }
.menu-icon.dispatch { background-color: rgba(253,232,232,0.75); }
.menu-icon.doc { background-color: rgba(240,232,253,0.75); }
.menu-icon.hazard { background-color: rgba(253,232,232,0.75); }
.menu-icon.inspection { background-color: rgba(var(--wash-rgb, 234,243,255), 0.75); }
