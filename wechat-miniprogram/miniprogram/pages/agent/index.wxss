.voice-session-texts { max-height: 280rpx; overflow-y: auto; margin-bottom: 20rpx; }
.voice-session-item { display: flex; align-items: flex-start; gap: 10rpx; padding: 14rpx 16rpx; background: linear-gradient(135deg, rgba(255,255,255,0.58), rgba(255,255,255,0.40)); border: 1rpx solid rgba(255,255,255,0.68); border-radius: 12rpx; margin-bottom: 12rpx; font-size: 27rpx; color: var(--ink, #12253d); line-height: 1.6; }
.voice-session-num { color: var(--brand, #1677ff); font-weight: 600; flex-shrink: 0; white-space: nowrap; }
.voice-session-content { flex: 1; word-break: break-all; }
.voice-session-empty { text-align: center; color: #a3b1c2; font-size: 26rpx; padding: 40rpx 0; }
.voice-session-actions { display: flex; justify-content: center; margin-bottom: 20rpx; }
.voice-hold-btn { padding: 20rpx 48rpx; border-radius: 40rpx; background: rgba(255,255,255,0.50); color: var(--brand, #1677ff); font-size: 28rpx; font-weight: 600; text-align: center; }
.voice-hold-btn.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); color: #fff; animation: pulse 0.8s infinite; }
.voice-session-footer { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.voice-session-footer button { flex: 1; margin: 0; }
.voice-session-info { margin-top: 20rpx; padding: 16rpx 20rpx; background: linear-gradient(135deg, rgba(255,255,255,0.58), rgba(255,255,255,0.40)); border: 1rpx solid rgba(255,255,255,0.68); border-radius: 12rpx; font-size: 25rpx; color: var(--brand, #1677ff); line-height: 1.6; word-break: break-all; }

/* Input Card（ima 模式：一张圆角卡片，上输入下功能行） */
.input-card { flex: 1; min-width: 0; width: 100%; box-sizing: border-box; padding: 8rpx 24rpx 16rpx; border-radius: 40rpx; background: linear-gradient(140deg, rgba(255,255,255,0.50) 0%, rgba(255,255,255,0.26) 100%); backdrop-filter: blur(38rpx) saturate(1.9); -webkit-backdrop-filter: blur(38rpx) saturate(1.9); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.90), inset 0 -14rpx 28rpx rgba(var(--brand-rgb, 22,119,255), 0.12), 0 8rpx 24rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.input-card .input-wrapper { background: transparent; min-height: 72rpx; padding: 0 8rpx; border-radius: 24rpx; }
.input-card .input-wrapper.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); }
.input-card .chat-input { height: 72rpx; line-height: 72rpx; }
.input-card .chat-textarea { height: auto; min-height: 72rpx; max-height: 264rpx; line-height: 44rpx; padding: 14rpx 0; }
.input-card-row { display: flex; align-items: center; gap: 14rpx; margin-top: 6rpx; }
.flex-spacer { flex: 1; }
.scope-chip { display: flex; align-items: center; gap: 8rpx; padding: 0 20rpx; height: 60rpx; border-radius: 30rpx; background: linear-gradient(135deg, rgba(255,255,255,0.62), rgba(255,255,255,0.44)); border: 1rpx solid rgba(255,255,255,0.75); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.82); transition: background 0.2s ease; }
.scope-chip:active { background: linear-gradient(135deg, rgba(255,255,255,0.76), rgba(255,255,255,0.58)); }
.scope-chip-icon { width: 30rpx; height: 30rpx; background-repeat: no-repeat; background-position: center; background-size: contain; flex-shrink: 0; }
