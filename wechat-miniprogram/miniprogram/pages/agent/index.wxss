/* 玻璃拟态改造（浅色版） */

/* 背景不再由本页写死：环境光晕由 app.wxss 的 .page 承载（三调 2026-09-20），
   本页若写 background 会覆盖掉光晕，玻璃感归零。这里只管布局。 */
/* height:100vh + 底部留白 = 输入区固定在屏幕底部。
   --kb 是键盘高度（px，由页面根节点注入）：键盘弹起时把留白加大，
   内容和输入区一起上抬，避免被键盘盖住。 */
.page { display: flex; flex-direction: column; height: 100vh; background: #f2f4f7; padding: 0 0 calc(126rpx + env(safe-area-inset-bottom)); }

/* Nav Bar */
.nav-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; }
/* 导航栏材质只铺在标题那一条上：状态栏区域保持透明，透出页面底色。
   否则状态栏会被铺成一条没有任何内容的白带（用户反馈的"没作用的色块"）。 */
.nav-bar-fill { position: absolute; left: 0; right: 0; background: #ffffff; border-bottom: 1rpx solid rgba(17, 19, 26, 0.08); }
.nav-bar-inner { position: absolute; left: 0; right: 0; display: flex; align-items: center; justify-content: center; padding: 0 28rpx; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #11131a; max-width: 380rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav-title-wrap { display: flex; align-items: center; gap: 8rpx; max-width: 70%; }
.nav-caret { font-size: 26rpx; color: #8a94a6; }
.nav-left { position: absolute; left: 28rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 56rpx; border-radius: 16rpx; background: transparent; }
.nav-left:active { background: rgba(17, 19, 26, 0.06); }
.nav-menu-icon { width: 36rpx; height: 30rpx; background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M128%20224h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32%22/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: center; background-size: contain; }
.nav-icon { width: 30rpx; height: 30rpx; background-repeat: no-repeat; background-position: center; background-size: contain; }
.nav-icon.ic-clock { background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M512%20896a384%20384%200%201%200%200-768%20384%20384%200%200%200%200%20768m0%2064a448%20448%200%201%201%200-896%20448%20448%200%200%201%200%20896%22/%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M480%20256a32%2032%200%200%201%2032%2032v256a32%2032%200%200%201-64%200V288a32%2032%200%200%201%2032-32%22/%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M480%20512h256q32%200%2032%2032t-32%2032H480q-32%200-32-32t32-32%22/%3E%3C/svg%3E"); }
.nav-project { position: absolute; right: 28rpx; bottom: 4rpx; background: rgba(47,50,55, 0.10); padding: 2rpx 14rpx; border-radius: 999rpx; }
.nav-project-name { font-size: 20rpx; color: #33405a; }

/* Breadcrumb */

/* Bought derived with sidebar */
/* min-height:0 + overflow:hidden：flex 子项默认 min-height:auto 不许收缩，
   消息一多 .main 被撑大、把输入卡顶出屏幕（2026-10-10 真机实录） */
.main { flex: 1; min-width: 0; min-height: 0; overflow: hidden; padding: 12rpx 20rpx; display: flex; flex-direction: column; }
.messages { flex: 1; min-height: 0; }
.message { display: flex; flex-direction: column; width: 100%; box-sizing: border-box; margin-bottom: 26rpx; animation: fadeIn 0.25s ease; }
.message.assistant { align-items: stretch; padding-left: 18rpx; border-left: 4rpx solid #e6eaed; box-sizing: border-box; text-align: left; }
.message.assistant.typing-message { padding-left: 0; border-left: 0; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
.message.user { align-items: flex-end; }
.message-head { display: flex; align-items: center; gap: 10rpx; width: 100%; box-sizing: border-box; margin-bottom: 6rpx; }
.message.user .message-head { justify-content: flex-end; }
.message-role { color: #3c4c57; font-size: 22rpx; font-weight: 600; line-height: 1.35; }
.message-time { color: #98a2ab; font-size: 20rpx; line-height: 1.35; }
.message.user .message-role { color: #51606b; font-weight: 500; }
.message.assistant .message-head { order: -3; }
.message.assistant .agent-progress { order: -2; }
.message.assistant .bubble { order: -1; }
.bubble { box-sizing: border-box; max-width: 82%; padding: 22rpx 26rpx; border-radius: var(--r-bubble, 22rpx) var(--r-bubble, 22rpx) var(--r-bubble, 22rpx) 8rpx; line-height: 1.65; font-size: var(--fs-body, 28rpx); background: #ffffff; border: 1rpx solid rgba(17,19,26,0.08); box-shadow: 0 2rpx 10rpx rgba(22,38,74,0.05); word-break: break-word; white-space: pre-wrap; transition: background 0.18s ease; }
.message.assistant .bubble { align-self: stretch; width: 100%; max-width: 100%; padding: 4rpx 0 10rpx; border: 0; border-radius: 0; background: transparent; box-shadow: none; color: var(--ink, #243447); font-size: 28rpx; line-height: 1.65; text-align: left; }
.message.assistant .bubble:active { background: transparent; }
.message.assistant .bubble.typing { width: 104rpx; max-width: 104rpx; padding: 20rpx; border: 1rpx solid rgba(39, 66, 81, .12); border-left: 1rpx solid rgba(39, 66, 81, .12); border-radius: 18rpx; background: #ffffff; box-shadow: none; }
.bubble:active { background: linear-gradient(140deg, rgba(255,255,255,0.72) 0%, rgba(255,255,255,0.46) 100%); }
.message.user .bubble { align-self: flex-end; max-width: 84%; padding: 18rpx 22rpx; color: var(--ink, #11131a); border-radius: 10rpx; background: rgba(var(--brand-rgb, 47,50,55), 0.12); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.08); box-shadow: none; }
.msg-image { width: 100%; border-radius: 12rpx; margin-bottom: 12rpx; }

/* ================= 2026-10-09 输入区重构 =================
   布局：第一行＝输入框 + 常驻发送按钮；第二行＝左（+ 面板 / 模型下拉）+ 右（麦克风）
   另加：多附件暂存条、模型下拉气泡、消息内多图九宫格、+ 面板四宫格与提示 */
.input-card { position: relative; }
.input-line { position: relative; z-index: 1; display: flex; align-items: center; gap: 14rpx; padding: 0 4rpx; }

/* 发送按钮：圆角方形 + 向上箭头（仿 Auto Mode 排版） */
.send-fab { flex-shrink: 0; width: 68rpx; height: 68rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(var(--brand-rgb, 47,50,55), 0.30), rgba(var(--brand-rgb, 47,50,55), 0.18)); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); transition: background 0.2s ease, box-shadow 0.2s ease; }
.send-fab.active { background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); border-color: transparent; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 4rpx 16rpx rgba(var(--deep-rgb, 10,46,92), 0.22); }
.send-fab:active { transform: translateY(1rpx); }
.send-fab-ic { width: 34rpx; height: 34rpx; background-color: rgba(var(--brand-rgb, 47,50,55), 0.55); -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M536.6%20188.1c-13.8-13.8-36.1-13.8-49.9%200L224.4%20450.4c-13.8%2013.8-13.8%2036.1%200%2049.9s36.1%2013.8%2049.9%200L476%20298.7v513.1c0%2019.5%2015.8%2035.3%2035.3%2035.3s35.3-15.8%2035.3-35.3V296l204.4%20204.3c13.8%2013.8%2036.1%2013.8%2049.9%200s13.8-36.1%200-49.9L536.6%20188.1z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%2333405a%22%20d=%22M536.6%20188.1c-13.8-13.8-36.1-13.8-49.9%200L224.4%20450.4c-13.8%2013.8-13.8%2036.1%200%2049.9s36.1%2013.8%2049.9%200L476%20298.7v513.1c0%2019.5%2015.8%2035.3%2035.3%2035.3s35.3-15.8%2035.3-35.3V296l204.4%20204.3c13.8%2013.8%2036.1%2013.8%2049.9%200s13.8-36.1%200-49.9L536.6%20188.1z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; }
.send-fab.active .send-fab-ic { background-color: #fff; }

/* 停止生成（2026-11-19）：loading 时发送键变停止键（白方块，通用「停止」语义） */
.send-fab.stop { background: linear-gradient(135deg, #e8595b, #c9383a); border-color: transparent; box-shadow: 0 4rpx 16rpx rgba(201, 56, 58, 0.30); }
.stop-square { width: 22rpx; height: 22rpx; border-radius: 6rpx; background: #fff; }

/* 发送失败标记（2026-11-19）：用户气泡头部红色「点击重发」 */
.msg-failed { padding: 4rpx 14rpx; border-radius: 999rpx; background: rgba(232, 89, 91, 0.12); }
.msg-failed-text { font-size: 20rpx; color: #e8595b; }
.message.user.failed .bubble { opacity: 0.75; border-color: rgba(232, 89, 91, 0.35); }

/* + 号放大（原 60rpx → 78rpx）
   双写类名提升优先级：本文件后段还有同优先级的 60rpx 定义，后定义者胜，
   单写会被压回原尺寸（2026-10-09 实测 31px 而非 39px） */
/* + 号圈与麦克风圈同尺寸（均 60rpx）；+ 图标本身放大以更醒目 */
.round-btn.round-btn-lg { width: 60rpx; height: 64rpx; border-radius: 50%; }
.round-btn.round-btn-lg::before { width: 66%; height: 66%; }

/* @ 提及面板：锚定在输入栏 @ 按钮上方，absolute 不随滚动漂移 */
.at-anchor { position: relative; flex-shrink: 0; }
.at-chip { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 32rpx; font-size: 40rpx; font-weight: 600; color: var(--ink, #11131a); background: linear-gradient(135deg, rgba(255,255,255,0.62), rgba(255,255,255,0.44)); border: 1rpx solid rgba(255,255,255,0.75); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.82); }
.at-chip.active { color: #fff; background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); }
/* 面板：必须给「确定高度 + 裁切」，不能只给 max-height。
   scroll-view 在微信里需要确定高度才会滚动；只写 max-height 时它会按内容撑开，
   溢出面板上沿盖住底部「完成」条和输入框（实测踩到过）。 */
.at-panel { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(360rpx + var(--kb, 0px) + env(safe-area-inset-bottom)); z-index: 165; width: auto; height: 52vh; max-height: calc(100vh - 360rpx - var(--kb, 0px) - 100rpx); overflow: hidden; display: flex; flex-direction: column; padding: 20rpx 20rpx 0; border-radius: var(--r-card, 24rpx); background: rgba(255,255,255,0.99); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.18); box-shadow: var(--shadow-float, 0 14rpx 36rpx rgba(10,46,92,0.20)); animation: modelFade 0.15s ease; box-sizing: border-box; }
/* 固定区（标题/已选/提示/搜索/最近）不参与压缩，把空间全部让给可滚动的列表 */
.at-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--gap-3, 16rpx); flex-shrink: 0; }
.at-panel-title { font-size: var(--fs-body, 28rpx); font-weight: 700; color: var(--ink, #11131a); }
/* 「完成」是选择模式的唯一出口：胶囊按钮，比整条填满更克制，也比 × 语义明确 */
.at-panel-done { padding: 12rpx 28rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-sub, 24rpx); font-weight: 600; color: #fff; background: var(--brand, #2f3237); }
.at-panel-close { width: 44rpx; height: 44rpx; text-align: center; line-height: 40rpx; font-size: 40rpx; color: var(--ink-3, #8a94a6); }
.at-search { flex-shrink: 0; height: 76rpx; padding: 0 22rpx; border-radius: var(--r-item, 16rpx); background: rgba(var(--wash-rgb, 234,243,255), 0.7); font-size: var(--fs-sub, 24rpx); color: var(--ink, #11131a); box-sizing: border-box; }
.at-search-ph { color: var(--ink-3, #8a94a6); }
.at-tabs { display: flex; gap: var(--gap-1, 8rpx); margin: var(--gap-3, 16rpx) 0 var(--gap-2, 12rpx); }
.at-tab { flex: 1; text-align: center; padding: 12rpx 0; border-radius: var(--r-item, 16rpx); font-size: var(--fs-sub, 24rpx); color: var(--ink-3, #8a94a6); background: rgba(var(--wash-rgb, 234,243,255), 0.6); }
.at-tab.active { color: #fff; font-weight: 600; background: var(--brand, #2f3237); }
/* 列表：height:0 + flex:1 是让 scroll-view 拿到「剩余空间的具体高度」的标准写法；
   不写 height:0 时 flex 项的高度不会被 scroll-view 正确识别，导致不滚动、内容溢出。 */
.at-list { height: 0; flex: 1; min-height: 0; }
/* 底部固定「完成」条：主操作、远离输入框。
   默认灰态（零选择时仍可点，只收起面板）；有选择时变品牌色。
   改成胶囊而不是整条填满：整条深蓝会把面板压得很重，胶囊更克制，
   同时靠 96rpx 高度 + 底部安全间隔保证点击区域足够大。 */
.at-done-bar { flex-shrink: 0; margin: var(--gap-3, 16rpx) 0 calc(20rpx + env(safe-area-inset-bottom)); align-self: stretch; height: 96rpx; line-height: 96rpx; text-align: center; font-size: var(--fs-body, 28rpx); font-weight: 600; color: var(--ink-3, #8a94a6); background: rgba(var(--wash-rgb, 234,243,255), 0.9); border-radius: var(--r-card, 24rpx); }
.at-done-bar.active { color: #fff; background: var(--brand, #2f3237); box-shadow: 0 6rpx 18rpx rgba(var(--brand-rgb, 47,50,55), 0.26); }
.at-done-bar:active { opacity: 0.86; }
.at-empty { padding: 40rpx 0; text-align: center; font-size: var(--fs-sub, 24rpx); color: var(--ink-3, #8a94a6); }
.at-empty-error { color: #b93838; }
/* 列表行：96rpx 高度贴近 iOS 列表 44pt，点按目标更大、也不显拥挤 */
.at-item { display: flex; align-items: center; gap: var(--gap-3, 16rpx); padding: 20rpx 12rpx; border-radius: var(--r-item, 16rpx); }
.at-item:active { background: rgba(var(--wash-rgb, 234,243,255), 0.92); }
.at-item-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 32rpx; line-height: 1; }
.at-item-body { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; flex: 1; }
.at-item-label { font-size: var(--fs-body, 28rpx); font-weight: 600; color: var(--ink, #11131a); }
.at-item-desc { font-size: var(--fs-mini, 21rpx); color: var(--ink-3, #8a94a6); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 行首库名标签 + 标题同一行：多库同名路径靠它区分 */
.at-item-line { display: flex; align-items: center; gap: var(--gap-1, 8rpx); min-width: 0; }
.at-item-kb { flex-shrink: 0; max-width: 200rpx; padding: 3rpx 12rpx; border-radius: var(--r-pill, 999rpx); font-size: 20rpx; color: var(--brand-d, #0060df); background: rgba(var(--brand-rgb, 47,50,55), 0.10); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.at-avatar { width: 44rpx; height: 44rpx; flex-shrink: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; background: var(--brand, #2f3237); }

/* @ 资料库：已选区（唯一表达"选了什么"）。与输入卡里的 .at-chip 按钮区分命名，避免样式串味 */
.at-selected { display: flex; flex-wrap: wrap; gap: var(--gap-2, 12rpx); margin: 4rpx 0 var(--gap-1, 8rpx); flex-shrink: 0; max-height: 132rpx; overflow: hidden; }
.at-selected-head { width: 100%; font-size: var(--fs-mini, 21rpx); font-weight: 600; color: var(--ink-3, #8a94a6); padding-bottom: 2rpx; }
/* 已选卡片：卡片级圆角 + 品牌色描边，和候选行的小圆角区分层级 */
.at-selected-item { display: flex; align-items: center; gap: var(--gap-1, 8rpx); max-width: 100%; padding: 12rpx 18rpx; border-radius: var(--r-item, 16rpx); color: var(--brand-d, #0060df); background: rgba(var(--brand-rgb, 47,50,55), 0.12); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.26); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.7); }
.at-selected-icon { font-size: 24rpx; line-height: 1; }
/* 双行档案条：名称在上、语义在下（整棵子树 N 份 / 所属路径 / 按关键词检索） */
.at-selected-body { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; max-width: 420rpx; }
.at-selected-name { font-size: var(--fs-sub, 24rpx); font-weight: 600; color: var(--brand-d, #0060df); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.at-selected-sub { font-size: var(--fs-mini, 21rpx); color: var(--ink-3, #8a94a6); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.at-selected-x { font-size: 28rpx; color: var(--ink-3, #8a94a6); padding-left: 4rpx; }
.at-selected-more { display: flex; align-items: center; padding: 12rpx 16rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-mini, 21rpx); color: var(--ink-3, #8a94a6); background: rgba(var(--wash-rgb, 234,243,255), 0.8); }
/* 范围语义提示：让「文件夹=整棵子树」这件事可见，而不是只显示一行路径 */
.at-scope-hint { flex-shrink: 0; margin: -4rpx 0 var(--gap-2, 12rpx); font-size: var(--fs-mini, 21rpx); color: var(--ink-3, #8a94a6); }

/* 气泡内的引用胶囊：@[资料库 …] 不再和普通文字混在一起 */
.bubble-segments { white-space: pre-wrap; word-break: break-word; line-height: 1.65; }
.bubble-plain { white-space: pre-wrap; }
.bubble-mention { display: inline; padding: 3rpx 14rpx; margin: 0 3rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-sub, 24rpx); color: var(--brand-d, #0060df); background: rgba(var(--brand-rgb, 47,50,55), 0.14); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.28); word-break: break-all; }
/* 搜索结果：已选中项打勾，再点一次即取消（多选比点小 × 更顺手） */
.at-item.picked { background: rgba(var(--brand-rgb, 47,50,55), 0.08); }
.at-item-check { flex-shrink: 0; margin-left: auto; font-size: 26rpx; font-weight: 700; color: var(--brand, #2f3237); }
.at-more { padding: var(--gap-4, 24rpx) 0; text-align: center; font-size: var(--fs-sub, 24rpx); color: var(--brand, #2f3237); }
/* 分组标题：空查询时的「最近用过 / 常用 / 全部文件夹」分隔 */
/* 最近用过：横向快捷条（不占纵向空间，且不与候选列表重复） */
.at-recent { flex-shrink: 0; white-space: nowrap; margin: var(--gap-2, 12rpx) 0 var(--gap-1, 8rpx); }
.at-recent-item { display: inline-flex; align-items: center; gap: 6rpx; max-width: 320rpx; margin-right: var(--gap-2, 12rpx); padding: 12rpx 18rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-mini, 21rpx); color: var(--ink, #11131a); background: rgba(var(--wash-rgb, 234,243,255), 0.9); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.16); }
.at-recent-item.picked { color: var(--ink-3, #8a94a6); background: rgba(var(--brand-rgb, 47,50,55), 0.08); }
.at-recent-icon { font-size: var(--fs-mini, 21rpx); line-height: 1; }
.at-recent-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 分组标题：仅在需要时用作视觉分隔 */
.at-section { padding: 14rpx 12rpx 6rpx; font-size: 22rpx; font-weight: 600; color: var(--ink-3, #8a94a6); letter-spacing: 0.5rpx; }

/* 模型选择气泡锚点容器：absolute 气泡相对按钮定位，不随页面滚动/麦克风显隐漂移 */
.model-anchor { position: relative; flex-shrink: 0; }
.model-chip { display: flex; align-items: center; gap: 8rpx; padding: 0 22rpx; height: 64rpx; border-radius: 32rpx; background: linear-gradient(135deg, rgba(255,255,255,0.62), rgba(255,255,255,0.44)); border: 1rpx solid rgba(255,255,255,0.75); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.82); }
.model-chip:active { background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(255,255,255,0.58)); }

/* 附件暂存条：多图/多文件的缩略图 + 删除角标 */
.attach-strip { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 6rpx 16rpx; overflow-x: auto; white-space: nowrap; }
.attach-item { position: relative; width: 116rpx; height: 116rpx; flex-shrink: 0; }
.attach-thumb { width: 116rpx; height: 116rpx; border-radius: 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.6); }
.attach-file { width: 116rpx; height: 116rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(var(--wash-rgb, 234,243,255), 0.95), rgba(255,255,255,0.72)); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.18); }
.attach-file-ext { font-size: 22rpx; font-weight: 700; color: var(--brand, #2f3237); letter-spacing: 1rpx; }
.attach-del { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; border-radius: 50%; background: rgba(185, 56, 56, 0.92); color: #fff; font-size: 26rpx; }
.attach-count { flex-shrink: 0; font-size: 22rpx; color: var(--ink-3, #8a94a6); }

/* 消息气泡内的多图九宫格 */
.msg-images { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 12rpx; }
.msg-image-grid { width: 168rpx; height: 168rpx; border-radius: 12rpx; }

/* + 面板：四宫格 + 底部提示 */
.menu-grid-4 { grid-template-columns: repeat(4, 1fr); }
.menu-tip { margin-top: 22rpx; text-align: center; font-size: 22rpx; color: var(--ink-3, #8a94a6); }

/* 工作记录字段候选：字段名 + 可点选的常用值 chips（最后一个「自己填写」） */
.field-groups { max-width: 88%; margin-top: 12rpx; }
.field-group { margin-bottom: 18rpx; }
.field-label { display: block; font-size: 24rpx; color: var(--ink-3, #8a94a6); margin-bottom: 10rpx; }
.field-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.field-chip { padding: 10rpx 24rpx; border-radius: 20rpx; font-size: 24rpx; color: var(--brand, #2f3237); background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(255,255,255,0.52)); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.18); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.86); }
.field-chip:active { background: linear-gradient(135deg, rgba(255,255,255,0.86), rgba(255,255,255,0.66)); transform: translateY(1rpx); }
.field-chip.ghost { color: var(--ink-3, #8a94a6); border-style: dashed; border-color: rgba(var(--deep-rgb, 10,46,92), 0.22); }

/* Action Buttons（会话内跟随气泡的操作按钮） */
.action-buttons { display: flex; flex-wrap: wrap; gap: 12rpx; }
.message-actions { margin-top: 12rpx; }
.message-prompts { width: 100%; max-width: 100%; box-sizing: border-box; padding: 8rpx 4rpx 14rpx; line-height: 1.65; font-size: 26rpx; background: transparent; border: 0; box-shadow: none; word-break: break-word; }


.chat-generate-btn { display: inline-block; margin: 16rpx 0 0; padding: 0 30rpx; height: 64rpx; line-height: 64rpx; border-radius: 30rpx; font-size: 24rpx; color: #fff; background: #0060df; }
.chat-generate-btn[disabled] { opacity: .55; }
.chat-generate-done { display: block; margin-top: 14rpx; font-size: 22rpx; color: #0060df; }
.inline-hazard-candidates { width: 100%; margin-top: 12rpx; padding: 18rpx; box-sizing: border-box; border: 1rpx solid rgba(39,66,81,.14); border-radius: 8rpx; background: #ffffff; box-shadow: none; }
.inline-hazard-head { display: flex; align-items: flex-start; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 12rpx; margin-bottom: 12rpx; }
.inline-hazard-head > view { min-width: 0; flex: 1; }
.inline-hazard-title { display: block; color: #854723; font-size: 26rpx; font-weight: 700; }
.inline-hazard-subtitle { display: block; margin-top: 4rpx; color: #8a7568; font-size: 20rpx; line-height: 1.35; }
.inline-hazard-count { flex: none; margin-left: auto; color: #986343; font-size: 22rpx; }
.inline-hazard-item { padding: 16rpx 0; border-top: 1rpx solid rgba(133,71,35,.12); }
.inline-hazard-item.committed { opacity: .72; }
.inline-hazard-item.discarded { opacity: .45; }
.inline-hazard-row { display: flex; align-items: flex-start; gap: 12rpx; }
.inline-hazard-select { flex: none; width: 36rpx; height: 36rpx; line-height: 36rpx; border: 2rpx solid rgba(133,71,35,.35); border-radius: 8rpx; text-align: center; color: #fff; font-size: 22rpx; }
.inline-hazard-select.selected { border-color: #a95329; background: #a95329; }
.inline-hazard-photo { flex: none; width: 112rpx; height: 84rpx; border-radius: 10rpx; background: #e7ded7; }
.inline-hazard-main { flex: 1; min-width: 0; }
.inline-hazard-risk { display: block; color: var(--ink, #11131a); font-size: 24rpx; font-weight: 600; line-height: 1.35; }
.inline-hazard-meta { display: block; margin-top: 5rpx; color: #7d7068; font-size: 20rpx; line-height: 1.35; }
.inline-hazard-status { display: inline-block; margin-top: 7rpx; padding: 3rpx 9rpx; border-radius: 8rpx; background: rgba(169,83,41,.1); color: #98512d; font-size: 20rpx; }
.inline-hazard-evidence { margin: 10rpx 0 0 48rpx; color: #7d7068; font-size: 20rpx; line-height: 1.5; }
.inline-hazard-evidence text { display: block; }
.inline-hazard-error { display: block; margin-top: 8rpx; color: #b43f32; font-size: 20rpx; }
.inline-hazard-discard { display: block; margin-top: 8rpx; color: #8d6653; text-align: right; font-size: 20rpx; }
/* 隐患候选卡的确认按钮 + 结果文本——原 inline-review 表单卡遗留的同名类被复用于此 */
.inline-review-confirm { margin: 18rpx 0 0; height: 72rpx; line-height: 72rpx; border-radius: 16rpx; color: #fff; background: #0060df; font-size: 24rpx; }
.inline-review-confirm[disabled] { opacity: .55; }
.inline-review-result { display: block; margin-top: 14rpx; font-size: 22rpx; color: #0060df; }
.message-hint { padding: 0; box-shadow: none; }

/* ===== 对话内任务表单：在回复气泡里一次完成选择、填写和上传 ===== */
.agent-task-form { width: 100%; box-sizing: border-box; margin-top: 14rpx; padding: 0; overflow: hidden; border: 1rpx solid #e5e9ec; border-radius: 8rpx; background: #fff; box-shadow: none; }
.agent-task-form.completed { border-color: rgba(52,133,105,.22); background: #fbfdfc; }
.agent-task-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding: 16rpx 18rpx 12rpx; border-bottom: 1rpx solid #eef1f3; }
.agent-task-head > view { min-width: 0; flex: 1; }
.agent-task-title { display: block; color: #1f2d36; font-size: 26rpx; font-weight: 600; line-height: 1.35; }
.agent-task-hint { display: block; margin-top: 4rpx; color: #8a959d; font-size: 20rpx; line-height: 1.5; }
.agent-task-state { flex: 0 0 auto; padding: 3rpx 10rpx; border-radius: 10rpx; background: #f3f6f7; color: #5d6a74; font-size: 20rpx; line-height: 1.35; }
.agent-task-form.completed .agent-task-state { background: rgba(47,113,98,.13); color: #276555; }
.agent-task-toggle { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; width: 100%; min-height: 70rpx; margin: 0; padding: 14rpx 18rpx; box-sizing: border-box; border: 0; border-bottom: 1rpx solid #eef1f3; border-radius: 0; background: #fff; color: var(--ink, #243447); text-align: left; line-height: 1.35; }
.agent-task-toggle::after { border: 0; }
.agent-task-toggle:active { background: #f7f9fa; }
.agent-task-toggle-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.agent-task-toggle-title { color: #2f5d53; font-size: 22rpx; font-weight: 600; }
.agent-task-toggle-meta { color: #8a959d; font-size: 20rpx; }
.agent-task-toggle-action { display: flex; flex: none; align-items: center; gap: 5rpx; color: #67757f; font-size: 22rpx; }
.agent-task-toggle-arrow { color: #67757f; font-size: 32rpx; line-height: 1; transition: transform .18s ease; }
.agent-task-toggle-arrow.expanded { transform: rotate(90deg); }
.agent-task-body { margin: 0; padding: 4rpx 18rpx 18rpx; }
.agent-task-read { margin-top: 14rpx; padding: 12rpx 14rpx; border: 1rpx solid rgba(76,137,120,.16); border-radius: 8rpx; background: rgba(76,137,120,.07); }
.agent-task-read-title { display: block; margin-bottom: 7rpx; color: #41695f; font-size: 22rpx; font-weight: 600; }
.agent-task-read-row { display: grid; grid-template-columns: minmax(132rpx, .7fr) minmax(0, 1.7fr); gap: 12rpx; padding: 5rpx 0; color: #345c53; font-size: 22rpx; line-height: 1.5; }
.agent-task-read-row text:last-child { min-width: 0; overflow-wrap: anywhere; }
.agent-task-fields { display: flex; flex-direction: column; gap: 20rpx; margin-top: 10rpx; }
.agent-task-field { min-width: 0; }
.agent-task-section { display: block; margin: 18rpx 0 2rpx; padding: 10rpx 0 8rpx; border-bottom: 1rpx solid #eef1f3; color: #1f2d36; font-size: 24rpx; font-weight: 600; }
.agent-task-field:first-child .agent-task-section { margin-top: 6rpx; }
.agent-task-label { display: flex; align-items: center; gap: 4rpx; color: #1f2d36; font-size: 22rpx; font-weight: 500; line-height: 1.35; }
.agent-task-required { padding: 0; border-radius: 0; background: transparent; color: #c0392b; font-size: 22rpx; font-weight: 600; }
.agent-task-field-hint { display: block; margin-top: 5rpx; color: #8a959d; font-size: 20rpx; line-height: 1.35; }
.agent-task-suggestion { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 9rpx; padding: 9rpx 11rpx; border: 1rpx solid rgba(76,137,120,.16); border-radius: 8rpx; background: rgba(76,137,120,.08); color: #345f55; font-size: 22rpx; line-height: 1.35; }
.agent-task-suggestion > text:first-child { min-width: 0; flex: 1; }
.agent-task-suggestion-use { flex: 0 0 auto; padding: 6rpx 12rpx; border-radius: 4rpx; background: #2f3237; color: #fff; font-size: 20rpx; }
.agent-task-control, .agent-task-textarea { display: block; width: 100%; min-height: 72rpx; margin-top: 8rpx; padding: 12rpx 14rpx; box-sizing: border-box; border: 1rpx solid #d9d9d9; border-radius: 6rpx; background: #fff; color: var(--ink, #11131a); font-size: 22rpx; line-height: 1.5; }
.agent-task-control { display: flex; align-items: center; justify-content: space-between; }
.agent-task-control.placeholder { color: #bfbfbf; }
.agent-task-control-caret { margin-left: 12rpx; color: #7b8a99; font-size: 28rpx; line-height: 1; }
.agent-task-textarea { min-height: 118rpx; }
.agent-task-upload { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(20,45,65,.09); }
.agent-task-upload-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: var(--ink, #11131a); font-size: 22rpx; font-weight: 600; }
.agent-task-upload-head text:last-child { color: #748497; font-size: 20rpx; font-weight: 400; }
.agent-task-photos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9rpx; margin-top: 12rpx; }
.agent-task-photo { position: relative; overflow: hidden; height: 112rpx; border-radius: 8rpx; background: #eef2f5; }
.agent-task-photo image { display: block; width: 100%; height: 100%; }
.agent-task-photo-remove { position: absolute; top: 3rpx; right: 3rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: rgba(24,34,45,.74); color: #fff; font-size: 28rpx; line-height: 34rpx; text-align: center; }
.agent-task-upload-box { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 82rpx; margin-top: 11rpx; border: 1rpx dashed rgba(57,125,109,.46); border-radius: 8rpx; background: rgba(57,125,109,.045); color: #2f3237; font-size: 22rpx; }
.agent-task-upload-box.disabled { opacity: .52; }
.agent-task-upload-plus { font-size: 32rpx; line-height: 1; }
.agent-task-submit-row { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; }
.agent-task-submit { width: auto; min-width: 180rpx; height: 64rpx; margin: 0; padding: 0 24rpx; border-radius: 8rpx; background: #2f3237; color: #fff; font-size: 22rpx; line-height: 64rpx; }
.agent-task-submit[disabled] { background: #9eb6ae; color: #f7fbf9; }
.agent-task-skip { flex: 0 0 auto; color: #8a94a6; font-size: 22rpx; text-decoration: underline; text-underline-offset: 5rpx; }
.agent-task-links { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(20,45,65,.09); }
.agent-task-link { color: #2f3237; font-size: 22rpx; line-height: 1.5; text-decoration: underline; text-underline-offset: 4rpx; }
.action-btn { padding: 10rpx 24rpx; border-radius: 20rpx; background: #ffffff; color: var(--brand, #2f3237); font-size: 24rpx; font-weight: 500; border: 1rpx solid rgba(17,19,26,0.08); box-shadow: 0 2rpx 8rpx rgba(22,38,74,0.05); transition: background 0.18s ease, transform 0.12s ease; }
.action-btn:active { background: linear-gradient(135deg, rgba(255,255,255,0.82), rgba(255,255,255,0.62)); transform: translateY(1rpx); }

/* Hero（ima 风格空状态：大问候语 + 竖排建议按钮，居中偏上、左对齐） */
.hero { min-height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 0 24rpx 16%; box-sizing: border-box; }
.hero-greeting { font-size: 56rpx; font-weight: 600; color: var(--ink-2, #243b55); letter-spacing: 2rpx; margin-bottom: 44rpx; }
.hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 22rpx; }
.hero-pill { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 36rpx; border-radius: 28rpx; background: #ffffff; border: 1rpx solid rgba(17,19,26,0.08); box-shadow: 0 2rpx 12rpx rgba(22,38,74,0.06); font-size: 28rpx; color: var(--ink, #11131a); font-weight: 500; transition: background 0.18s ease, transform 0.12s ease; }
.hero-pill:active { background: #f2f4f7; transform: translateY(1rpx); }
.hero-pill-icon { width: 40rpx; height: 40rpx; background-repeat: no-repeat; background-position: center; background-size: contain; flex-shrink: 0; }
