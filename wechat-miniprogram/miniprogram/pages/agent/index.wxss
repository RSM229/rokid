/* ===== 智能体回执卡（2026-10-14「聊天即操作」）===== */
.agent-cards { display: flex; flex-direction: column; gap: 12rpx; max-width: 82%; margin-top: 12rpx; }
.agent-card { padding: 20rpx 24rpx; border-radius: 20rpx; background: linear-gradient(140deg, rgba(255,255,255,0.62) 0%, rgba(255,255,255,0.38) 100%); backdrop-filter: blur(30rpx) saturate(1.8); -webkit-backdrop-filter: blur(30rpx) saturate(1.8); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.16); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.88), 0 4rpx 14rpx rgba(var(--deep-rgb, 10,46,92), 0.10); transition: background 0.2s ease, transform 0.12s ease; }
.agent-card:active { transform: translateY(1rpx); background: linear-gradient(140deg, rgba(255,255,255,0.78) 0%, rgba(255,255,255,0.54) 100%); }
.agent-card-top { display: flex; align-items: center; justify-content: space-between; }
.agent-card-kind { font-size: 22rpx; font-weight: 600; color: var(--brand, #0a2e5c); letter-spacing: 1rpx; }
.agent-card-status { padding: 2rpx 14rpx; border-radius: 16rpx; font-size: 20rpx; color: var(--brand, #0a2e5c); background: rgba(var(--brand-rgb, 22,119,255), 0.12); }
.agent-card-title { display: block; margin-top: 8rpx; font-size: 28rpx; font-weight: 500; color: var(--ink, #12253d); line-height: 1.5; }
.agent-card-sub { display: block; margin-top: 4rpx; font-size: 24rpx; color: var(--ink-3, #6b7c93); }
.agent-card-time { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--ink-3, #6b7c93); }

/* ===== 智能体追问快速选项（点选即回答）===== */
.agent-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }
.agent-chip { padding: 12rpx 30rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 500; color: var(--brand, #0a2e5c); background: rgba(var(--brand-rgb, 22,119,255), 0.10); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.28); transition: background 0.15s ease, transform 0.12s ease; }
.agent-chip:active { transform: scale(0.95); background: rgba(var(--brand-rgb, 22,119,255), 0.20); }
.review-entry{position:relative;display:flex;flex-direction:column;align-items:flex-start;margin-top:30rpx;padding:20rpx 48rpx 20rpx 18rpx;border-top:1rpx solid rgba(20,45,65,.12);border-bottom:1rpx solid rgba(20,45,65,.12)}.review-entry-title{font-size:25rpx;font-weight:600;color:#245f56}.review-entry-detail{font-size:21rpx;color:#72808a;margin-top:5rpx}.review-entry-arrow{position:absolute;right:14rpx;top:50%;transform:translateY(-50%);font-size:34rpx;color:#75828d}

/* 参考备案助手的阶段性任务区，但保持监理对话为唯一主入口。 */
.review-progress { display: flex; align-items: flex-start; justify-content: space-between; gap: 8rpx; margin: 18rpx 0 12rpx; padding: 14rpx 12rpx; border-radius: 14rpx; background: rgba(var(--brand-rgb, 22,119,255), .055); }
.review-progress-step { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 5rpx; color: #9aa7b5; font-size: 19rpx; text-align: center; line-height: 1.25; }
.review-progress-step:not(:last-child)::after { content: ''; position: absolute; top: 17rpx; left: calc(50% + 18rpx); width: calc(100% - 36rpx); height: 2rpx; background: rgba(120,140,160,.22); }
.review-progress-dot { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #b7c0ca; font-size: 21rpx; font-weight: 600; z-index: 1; }
.review-progress-step.done { color: #267866; }.review-progress-step.done .review-progress-dot { background: #2e9b79; }.review-progress-step.current { color: var(--brand, #1767a5); font-weight: 600; }.review-progress-step.current .review-progress-dot { background: var(--brand, #1677ff); }
.inline-review-summary { display: block; margin: 6rpx 0 14rpx; padding: 12rpx 14rpx; border-left: 4rpx solid #4d93b2; background: rgba(77,147,178,.08); color: #4d6475; font-size: 22rpx; line-height: 1.45; }
.inline-review-detail { display: block; margin-top: 8rpx; color: #405568; font-size: 22rpx; line-height: 1.45; }
.inline-watermark-photo { margin-top: 12rpx; padding: 12rpx; border: 1rpx solid rgba(36,95,86,.14); border-radius: 8rpx; background: rgba(255,255,255,.55); }
.inline-watermark-head { display: flex; align-items: center; gap: 10rpx; color: #526b69; font-size: 21rpx; }
.inline-watermark-head image { width: 52rpx; height: 52rpx; flex: 0 0 52rpx; border-radius: 4rpx; }
.inline-watermark-head text:last-child { margin-left: auto; text-align: right; }
.inline-watermark-field { display: grid; grid-template-columns: 1fr 1.5fr; gap: 8rpx; margin-top: 8rpx; }
.inline-watermark-field input { min-width: 0; height: 60rpx; padding: 0 10rpx; box-sizing: border-box; border: 1rpx solid rgba(20,45,65,.14); border-radius: 6rpx; font-size: 21rpx; background: #fff; }
.inline-watermark-add { margin-top: 10rpx; color: #245f56; font-size: 21rpx; }
