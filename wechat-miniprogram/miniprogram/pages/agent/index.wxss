/* ===== 智能体回执卡（2026-10-14「聊天即操作」）===== */
.agent-cards { display: flex; flex-direction: column; gap: 12rpx; width: 100%; max-width: 100%; box-sizing: border-box; margin-top: 8rpx; }
.agent-card { padding: 16rpx 18rpx; border-radius: 8rpx; background: #ffffff; border: 1rpx solid rgba(39,66,81,.14); box-shadow: none; transition: background 0.2s ease, transform 0.12s ease; }
.agent-card:active { transform: translateY(1rpx); background: #f2f4f7; }
.agent-card-top { display: flex; align-items: center; justify-content: space-between; }
.agent-card-kind { font-size: 22rpx; font-weight: 600; color: var(--brand, #33405a); letter-spacing: 1rpx; }
.agent-card-status { padding: 2rpx 14rpx; border-radius: 16rpx; font-size: 20rpx; color: var(--brand, #33405a); background: rgba(var(--brand-rgb, 47,50,55), 0.12); }
.agent-card-title { display: block; margin-top: 8rpx; font-size: 28rpx; font-weight: 500; color: var(--ink, #11131a); line-height: 1.5; }
.agent-card-sub { display: block; margin-top: 4rpx; font-size: 24rpx; color: var(--ink-3, #8a94a6); }
.agent-card-time { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--ink-3, #8a94a6); }
/* 多卡回执折叠条：复用 inline-review-preview 外观，双类选择器覆盖其默认下边距 */
.inline-review-preview.agent-cards-toggle { margin: 8rpx 0 0; }

/* ===== 智能体追问快速选项（点选即回答）===== */
.agent-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }
.agent-chip { padding: 12rpx 30rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 500; color: var(--brand, #33405a); background: rgba(var(--brand-rgb, 47,50,55), 0.10); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.28); transition: background 0.15s ease, transform 0.12s ease; }
.agent-chip:active { transform: scale(0.95); background: rgba(var(--brand-rgb, 47,50,55), 0.20); }

.inline-review-preview { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 0 0 12rpx; padding: 12rpx 14rpx; border: 1rpx solid rgba(36,95,86,.18); border-radius: 6rpx; background: #f7fbf9; color: #2f5d53; font-size: 22rpx; font-weight: 500; }
.inline-review-preview:active { background: #eef7f3; }
.inline-review-preview-arrow { color: #5d7a70; font-size: 28rpx; line-height: 1; transition: transform .18s ease; }
.inline-review-preview-arrow.expanded { transform: rotate(90deg); }

/* 思考进度卡：平面风格 —— 白底 + 一根细线，去掉原来的 6rpx 绿色竖条与绿底（视觉过重、像告警条） */
.agent-progress { width: 100%; box-sizing: border-box; margin: 6rpx 0 14rpx; padding: 16rpx 20rpx; border: 1rpx solid rgba(17,19,26,0.08); border-radius: 20rpx; background: #ffffff; box-shadow: 0 2rpx 10rpx rgba(22,38,74,0.04); }
.agent-progress.done { background: #fbfcfd; border-color: rgba(17,19,26,0.06); box-shadow: none; }
/* 头部：左「状态点 + 标题 + 当前动作」，右「状态文字 + 折叠箭头」 */
.agent-progress-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 2rpx 0; }
.agent-progress-title-wrap { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.agent-progress-title-row { display: flex; align-items: center; gap: 8rpx; }
.agent-progress-title { flex: none; color: #11131a; font-size: 24rpx; font-weight: 600; }
.agent-progress.done .agent-progress-title { color: #8a94a6; font-weight: 500; }
.agent-progress-current { color: #8a94a6; font-size: 22rpx; line-height: 1.5; word-break: break-word; }
.agent-progress-meta { display: flex; flex: none; align-items: center; gap: 8rpx; color: #a8b2c1; font-size: 20rpx; white-space: nowrap; }
.agent-progress-chevron { color: #a8b2c1; font-size: 26rpx; line-height: 1; transition: transform 0.18s ease; }
.agent-progress-chevron.up { transform: rotate(-90deg); }
.agent-progress-list { max-height: 560rpx; overflow-y: auto; padding: 10rpx 0 2rpx; border-top: 1rpx solid rgba(17,19,26,0.06); margin-top: 10rpx; }
.agent-progress-event { position: relative; display: flex; gap: 10rpx; padding: 6rpx 0; border-bottom: 0; }
.agent-progress-mark { flex: none; width: 10rpx; height: 10rpx; margin-top: 12rpx; border-radius: 50%; background: #c6cdd3; }
.agent-progress-event.completed .agent-progress-mark { background: #1f8a63; }
.agent-progress-event.failed .agent-progress-mark { background: #c54d4d; }
.agent-progress-event.waiting .agent-progress-mark { background: #c58a35; }
.agent-progress-body { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 2rpx; }
.agent-progress-event-title { color: #354651; font-size: 22rpx; line-height: 1.5; word-break: break-word; }
.agent-progress-event.completed .agent-progress-event-title { color: #65737d; }
.agent-progress-detail { color: #8a94a6; font-size: 20rpx; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
.agent-progress-time { align-self: flex-start; color: #a8b2c1; font-size: 20rpx; }

/* 气泡下方 meta 行：时间戳在左 + 复制图标（双框剪贴板），模仿类 Discord 消息格式（2026-11-03） */
.bubble-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 10rpx; }
.message.user .bubble-meta { justify-content: flex-end; }
.bubble-time { font-size: 20rpx; color: #98a2ab; line-height: 1; }
.bubble-copy { display: flex; justify-content: flex-end; align-items: center; padding: 8rpx 4rpx; }
.bubble-copy:active { opacity: .55; }
.bubble-copy-ic { width: 30rpx; height: 30rpx; background-color: #a8b2c1; -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%20fill=%22%23000000%22%3E%3Crect%20x=%226.5%22%20y=%226.5%22%20width=%2211%22%20height=%2211%22%20rx=%222%22%20fill=%22none%22%20stroke=%22%23000000%22%20stroke-width=%222%22/%3E%3Crect%20x=%2210.5%22%20y=%2210.5%22%20width=%2211%22%20height=%2211%22%20rx=%222%22%20fill=%22none%22%20stroke=%22%23000000%22%20stroke-width=%222%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%20fill=%22%23000000%22%3E%3Crect%20x=%226.5%22%20y=%226.5%22%20width=%2211%22%20height=%2211%22%20rx=%222%22%20fill=%22none%22%20stroke=%22%23000000%22%20stroke-width=%222%22/%3E%3Crect%20x=%2210.5%22%20y=%2210.5%22%20width=%2211%22%20height=%2211%22%20rx=%222%22%20fill=%22none%22%20stroke=%22%23000000%22%20stroke-width=%222%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; }
.message.user .bubble-copy-ic { background-color: #8a94a6; }

/* ============ 长期偏好沉淀建议卡（2026-11-06） ============
   气泡下方的轻量确认条：Agent 判定「这句话像是一条以后都要遵守的规矩」时出现，
   点「记住」才写库（偏好会进以后每一轮系统上下文，绝不自动保存）。 */
.pref-suggest { margin-top: 14rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: rgba(var(--brand-rgb, 10,46,92), 0.05); box-shadow: inset 0 0 0 1rpx rgba(var(--brand-rgb, 10,46,92), 0.12); }
.pref-suggest-head { display: flex; align-items: baseline; gap: 12rpx; }
.pref-suggest-title { font-size: 26rpx; font-weight: 600; color: var(--ink, #11131a); }
.pref-suggest-sub { font-size: 22rpx; color: #8b98a8; }
.pref-suggest-rule { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.5; color: var(--ink-2, #2f4157); }
.pref-suggest-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
.pref-suggest-btn { padding: 10rpx 30rpx; border-radius: 12rpx; font-size: 24rpx; }
.pref-suggest-btn:active { opacity: .72; }
.pref-suggest-btn.ghost { color: #8a94a6; box-shadow: inset 0 0 0 1rpx rgba(var(--brand-rgb, 10,46,92), 0.16); }
.pref-suggest-btn.primary { color: var(--on-brand, #fff); background: var(--brand, #33405a); }
.pref-suggest-btn.disabled { opacity: .55; }
.pref-suggest-done { margin-top: 12rpx; font-size: 22rpx; color: #0f7a55; }

/* 建档后缺项：只标黄提示，不追问、不拦保存（2026-11-13 B 层） */
.doc-missing { margin-top: 12rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: rgba(200,120,51,.08); box-shadow: inset 0 0 0 1rpx rgba(200,120,51,.16); }
.doc-missing-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.doc-missing-title { font-size: 22rpx; font-weight: 600; color: #8b5427; }
.doc-missing-note { font-size: 20rpx; color: #a5825f; }
.doc-missing-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.doc-missing-tag { padding: 5rpx 12rpx; border-radius: 9rpx; background: #ffffff; color: #8b5427; font-size: 20rpx; }
.doc-missing-tag.required { background: rgba(200,120,51,.16); font-weight: 600; }
/* 独立复核意见：并进同一条回执，默认收起 */
.doc-review { margin-top: 12rpx; border-radius: 18rpx; background: #ffffff; border: 1rpx solid rgba(17,19,26,0.08); box-shadow: 0 2rpx 10rpx rgba(22,38,74,0.04); }
.doc-review-head { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 18rpx; }
.doc-review-head:active { opacity: .7; }
.doc-review-title { font-size: 24rpx; font-weight: 600; color: #11131a; }
.doc-review-arrow { font-size: 26rpx; color: #a8b2c1; transition: transform .2s ease; }
.doc-review-arrow.expanded { transform: rotate(90deg); }
.doc-review-list { padding: 0 18rpx 14rpx; }
.doc-review-item { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 10rpx; }
.doc-review-tag { flex: none; padding: 3rpx 12rpx; border-radius: 999rpx; background: rgba(47,50,55,0.10); color: #2f3237; font-size: 20rpx; }
.doc-review-tag.must { background: rgba(200,90,51,.12); color: #a44a24; }
.doc-review-text { flex: 1; font-size: 22rpx; line-height: 1.5; color: var(--ink-2, #2f4157); }

/* 草稿被拦的可见解释（2026-11-18）：reviewResult/reviewIssues 长期只写不渲染 */
.chat-generate-blocked { width: 100%; margin-top: 12rpx; padding: 16rpx 18rpx; box-sizing: border-box; border: 1rpx solid rgba(133,71,35,.25); border-radius: 8rpx; background: rgba(133,71,35,.06); }
.chat-generate-blocked-title { display: block; color: #854723; font-size: 24rpx; font-weight: 700; }
.chat-generate-blocked-text { display: block; margin-top: 6rpx; color: #6b564a; font-size: 22rpx; line-height: 1.5; }
.chat-generate-blocked-hint { display: block; margin-top: 8rpx; color: #8a7568; font-size: 20rpx; line-height: 1.35; }

/* AI 回答里的来源角标（后端用 [[编号]] 标注引用）：
   黑白主题下不用彩色，做成脚注编号的样子——浅灰底、中灰字、上抬一点。
   行高用 px 与高度对齐（契约测试只限制相对行高，px 属控件尺寸）。 */
.bubble-cite {
  display: inline-block;
  box-sizing: border-box;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  margin: 0 4rpx;
  border-radius: 8rpx;
  background: #eef1f4;
  color: #5b6472;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
  text-align: center;
  vertical-align: 4rpx;
}