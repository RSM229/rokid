/* Menu Panel */
.menu-panel { position: relative; width: 100%; background: linear-gradient(135deg, rgba(255,255,255,0.68), rgba(255,255,255,0.48)); backdrop-filter: blur(30rpx) saturate(1.8); -webkit-backdrop-filter: blur(30rpx) saturate(1.8); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.16); border-radius: 32rpx 32rpx 0 0; padding: 36rpx 28rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), inset 0 -14rpx 30rpx rgba(var(--brand-rgb, 22,119,255), 0.10), 0 -8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); animation: slideUp 0.25s ease; }
.menu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28rpx 0; }
.menu-text { white-space: nowrap; }
.menu-item { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.menu-icon { width: 96rpx; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; position: relative; }
.menu-icon { background-repeat: no-repeat; background-position: center; background-size: 56%; }
.menu-icon.todo { background-color: rgba(var(--wash-rgb, 234,243,255), 0.75); }
