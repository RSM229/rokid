/* Typing */
.typing { display: flex; gap: 8rpx; padding: 24rpx 32rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--brand-l, #3b8cff); animation: bounce 1.2s infinite; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce { 0%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-10rpx); } }

/* Input Bar */
/* 待补传语音提示条（录音上传失败入队后） */
.pending-voice { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 8rpx 16rpx 0; padding: 14rpx 18rpx; border-radius: 18rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.08); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.20); }
.pv-text { font-size: 24rpx; color: var(--ink, #12253d); }
.pv-actions { display: flex; gap: 10rpx; }

/* 待补全草稿横幅（聊天即操作的半成品提醒，顶部常驻，flex-shrink:0 不挤压聊天区） */
.pv-btn { margin: 0; font-size: 22rpx; line-height: 1.6; }

.input-bar { display: flex; align-items: center; padding: 12rpx 16rpx; gap: 8rpx; background: linear-gradient(180deg, rgba(255,255,255,0.22), rgba(var(--wash-rgb, 234,243,255), 0.42)); backdrop-filter: blur(44rpx) saturate(1.9); -webkit-backdrop-filter: blur(44rpx) saturate(1.9); border-top: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 -6rpx 26rpx rgba(var(--deep-rgb, 10,46,92), 0.10); position: relative; }
.model-btn { display: flex; align-items: center; gap: 6rpx; padding: 0 18rpx; height: 64rpx; border-radius: 32rpx; background: linear-gradient(135deg, rgba(var(--wash-rgb, 234,243,255), 0.8) 0%, rgba(var(--wash-rgb, 234,243,255), 0.8) 100%); flex-shrink: 0; }
.model-btn.hazard-active { background: linear-gradient(135deg, rgba(253,232,232,0.8) 0%, rgba(255,221,221,0.8) 100%); }
.model-btn-label { font-size: 24rpx; font-weight: 700; color: var(--brand, #1677ff); }
.hazard-active .model-btn-label { color: #b93838; }
.model-arrow { font-size: 20rpx; color: var(--brand, #1677ff); }
.hazard-active .model-arrow { color: #b93838; }
.model-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 150; }
.model-menu { position: absolute; right: 16rpx; bottom: calc(100% + 12rpx); z-index: 160; width: 480rpx; max-height: 52vh; overflow-y: auto; padding: 10rpx; border-radius: 24rpx; background: rgba(255,255,255,0.98); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.18); box-shadow: 0 14rpx 36rpx rgba(var(--deep-rgb, 10,46,92), 0.18); animation: slideUp 0.18s ease; box-sizing: border-box; }
.model-menu-item { display: block; padding: 16rpx 20rpx; border-radius: 16rpx; }
.model-menu-item.active { background: rgba(var(--wash-rgb, 234,243,255), 0.92); }
.model-menu-row1 { display: flex; align-items: center; gap: 10rpx; }
.model-menu-name { font-size: 27rpx; font-weight: 600; color: var(--ink, #12253d); }
.model-menu-item.active .model-menu-name { color: var(--brand, #1677ff); }
.model-menu-desc { display: block; margin-top: 4rpx; font-size: 21rpx; line-height: 1.5; color: var(--ink-3, #6b7c93); }
.model-menu-check { margin-left: auto; font-size: 26rpx; color: var(--brand, #1677ff); }
.model-icon { width: 36rpx; height: 36rpx; background-repeat: no-repeat; background-position: center; background-size: contain; }
