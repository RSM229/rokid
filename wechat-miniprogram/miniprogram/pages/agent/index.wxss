.voice-hold { flex: 1; min-height: 64rpx; border-radius: 32rpx; background: rgba(255,255,255,0.48); color: var(--brand, #1677ff); font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; text-align: center; }
.voice-hold.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); color: #fff; animation: pulse 0.8s infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.02); } }

/* Overlays */
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 200; display: flex; align-items: flex-end; justify-content: center; }
.overlay-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60,0.35); animation: fadeIn 0.2s ease; }
.overlay-panel { position: relative; width: 100%; max-height: 85vh; background: linear-gradient(135deg, rgba(255,255,255,0.68), rgba(255,255,255,0.48)); backdrop-filter: blur(30rpx) saturate(1.8); -webkit-backdrop-filter: blur(30rpx) saturate(1.8); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.16); border-radius: 32rpx 32rpx 0 0; padding: 40rpx 36rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), inset 0 -14rpx 30rpx rgba(var(--brand-rgb, 22,119,255), 0.10), 0 -8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); animation: slideUp 0.3s ease; overflow-y: auto; }
.work-form-panel { max-height: 90vh; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.panel-header { text-align: center; margin-bottom: 36rpx; }
.panel-title { display: block; font-size: 36rpx; font-weight: 700; color: var(--brand-deep, #0a2e5c); }
.panel-subtitle { display: block; font-size: 26rpx; color: #6b7c90; margin-top: 8rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink, #12253d); margin-bottom: 10rpx; }
.form-input { width: 100%; height: 76rpx; padding: 0 24rpx; border-radius: 16rpx; border: 1rpx solid rgba(255,255,255,0.72); background: rgba(255,255,255,0.46); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; min-height: 80rpx; padding: 16rpx 24rpx; border-radius: 16rpx; border: 1rpx solid rgba(255,255,255,0.72); background: rgba(255,255,255,0.46); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box; }
.content-area { min-height: 160rpx; }
.picker-value { line-height: 76rpx; color: var(--ink, #12253d); }
.panel-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-cancel { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 30rpx; color: #6b7c90; background: rgba(255,255,255,0.50); text-align: center; }
.btn-submit { flex: 2; height: 80rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 30rpx; color: #fff; background: linear-gradient(135deg, var(--brand, #1677ff) 0%, var(--brand, #1677ff) 100%); text-align: center; }

/* History Overlay */
.history-overlay { align-items: stretch; justify-content: flex-start; }
.history-panel { position: relative; width: 72%; height: 100%; background: linear-gradient(135deg, rgba(255,255,255,0.68), rgba(255,255,255,0.48)); backdrop-filter: blur(30rpx) saturate(1.8); -webkit-backdrop-filter: blur(30rpx) saturate(1.8); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.16); border-radius: 0 32rpx 32rpx 0; padding: 40rpx 36rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; box-shadow: inset 1rpx 0 0 rgba(255,255,255,0.85), 8rpx 0 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); animation: slideRight 0.3s ease; }
.history-top { display: flex; align-items: center; margin-bottom: 24rpx; }
.drawer-scroll { flex: 1; min-height: 0; }
/* 分组全部收起时抽屉很短，组间距略收一点 */
.drawer-group { margin-bottom: 20rpx; }
.drawer-title { font-size: 24rpx; font-weight: 600; color: var(--brand-l, #3b8cff); letter-spacing: 2rpx; margin-bottom: 12rpx; }
/* 分组标题行＝折叠开关（整行可点）：标题 + 右侧折角箭头 */
.drawer-head { display: flex; align-items: center; padding: 12rpx; margin-bottom: 4rpx; border-radius: 12rpx; }
.drawer-head:active { background: rgba(255,255,255,0.50); }
.drawer-head .drawer-title { flex: 1; margin-bottom: 0; }
.drawer-nav { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 12rpx; border-radius: 12rpx; }
.drawer-nav:active { background: rgba(255,255,255,0.50); }
.drawer-nav-icon { width: 36rpx; height: 36rpx; background-repeat: no-repeat; background-position: center; background-size: contain; flex-shrink: 0; }
.drawer-nav-text { font-size: 28rpx; color: var(--ink, #12253d); }
/* 可折叠子目录的展开箭头（CSS 折角，无 data-uri）：收起=▾，展开=▴ */
.drawer-arrow { margin-left: auto; width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.drawer-arrow::before { content: ''; width: 12rpx; height: 12rpx; border-right: 2rpx solid #8a9bb0; border-bottom: 2rpx solid #8a9bb0; transform: translateY(-4rpx) rotate(45deg); transition: transform 0.2s ease; }
.drawer-arrow.open::before { transform: translateY(4rpx) rotate(-135deg); }
.drawer-sub { padding-left: 44rpx; }
.drawer-sub .drawer-nav-icon { width: 30rpx; height: 30rpx; }
.drawer-sub .drawer-nav-text { font-size: 26rpx; color: #5c7086; }
.drawer-static { padding: 18rpx 20rpx; border-radius: 16rpx; background: linear-gradient(135deg, rgba(255,255,255,0.62), rgba(255,255,255,0.44)); border: 1rpx solid rgba(255,255,255,0.72); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.80); }
/* 「项目概况」整卡可点 → 修改项目信息：淡品牌色描边暗示可交互 */
.project-summary-card { border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.20); transition: background 0.2s ease, border-color 0.2s ease; }
.project-summary-card:active { background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(255,255,255,0.58)); border-color: rgba(var(--brand-rgb, 22,119,255), 0.42); }
.project-card-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.project-card-title { flex: 1; margin-bottom: 0; }
.project-card-edit { display: flex; align-items: center; gap: 2rpx; flex-shrink: 0; }
.project-card-edit-text { font-size: 22rpx; color: var(--brand, #1677ff); }
/* 右侧折角箭头指向右（复用 .drawer-arrow 的折角，不改共享规则） */
.edit-arrow { width: 30rpx; height: 30rpx; }
.edit-arrow::before { width: 9rpx; height: 9rpx; border-right: 2rpx solid var(--brand, #1677ff); border-bottom: 2rpx solid var(--brand, #1677ff); transform: rotate(-45deg); border-radius: 1rpx; }
.drawer-project-name { display: block; font-size: 30rpx; font-weight: 600; color: var(--ink, #12253d); line-height: 1.4; }
.drawer-loc { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: #8a9bb0; }
.drawer-desc { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.6; color: #5c7086; max-height: 160rpx; overflow: hidden; }
.project-picker-panel { max-height: 66vh; display: flex; flex-direction: column; }
.project-picker-list { flex: 1; min-height: 0; padding: 0 12rpx; }
.project-item { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 24rpx 22rpx; border-radius: 16rpx; margin-bottom: 12rpx; background: linear-gradient(135deg, rgba(255,255,255,0.58), rgba(255,255,255,0.40)); border: 1rpx solid rgba(255,255,255,0.68); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); transition: background 0.2s ease; }
.project-item:active { background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(255,255,255,0.54)); }
.project-item.active { background: rgba(var(--wash-rgb, 234,243,255), 0.95); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.45); box-shadow: inset 6rpx 0 0 var(--brand, #1677ff); }
.project-item-main { flex: 1; min-width: 0; }
.project-item-name { display: block; font-size: 30rpx; color: var(--ink, #12253d); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.project-item-code { display: block; margin-top: 6rpx; font-size: 22rpx; color: #8a9bb0; }
.project-item-check { color: var(--brand, #1677ff); font-size: 36rpx; flex-shrink: 0; }
.project-empty { text-align: center; color: #a3b1c2; font-size: 26rpx; padding: 30rpx 0; }
.project-picker-foot { flex-shrink: 0; padding: 20rpx 12rpx 4rpx; margin-top: 16rpx; border-top: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); }
.picker-add-btn { display: flex; align-items: center; justify-content: center; height: 84rpx; border-radius: 16rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.07); border: 1rpx dashed rgba(var(--brand-rgb, 22,119,255), 0.45); }
.picker-add-plus { font-size: 36rpx; line-height: 1; color: var(--brand, #1677ff); margin-right: 10rpx; }
.picker-add-text { font-size: 30rpx; color: var(--brand, #1677ff); }
.history-new { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 24rpx; border-radius: 20rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.85); }
.history-new:active { background: rgba(var(--brand-l-rgb, 59,140,255), 0.9); }
.history-new-text { font-size: 26rpx; font-weight: 600; color: #fff; }
.history-new .side-icon { width: 32rpx; height: 32rpx; background-repeat: no-repeat; background-position: center; background-size: contain; }
.history-new .side-icon.ic-plus { background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M352%20480h320a32%2032%200%201%201%200%2064H352a32%2032%200%200%201%200-64%22/%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M480%20672V352a32%2032%200%201%201%2064%200v320a32%2032%200%200%201-64%200%22/%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M512%20896a384%20384%200%201%200%200-768%20384%20384%200%200%200%200%20768m0%2064a448%20448%200%201%201%200-896%20448%20448%200%200%201%200%20896%22/%3E%3C/svg%3E"); }
.history-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 8rpx; border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.history-main { flex: 1; min-width: 0; }
.history-title { display: block; font-size: 28rpx; color: var(--ink, #12253d); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-time { display: block; font-size: 22rpx; color: #a3b1c2; margin-top: 6rpx; }
.history-del { flex-shrink: 0; padding: 8rpx 20rpx; border-radius: 16rpx; background: rgba(253,232,232,0.75); color: #b93838; font-size: 24rpx; }
.history-empty { text-align: center; color: #a3b1c2; font-size: 26rpx; padding: 20rpx 0; }
@keyframes slideRight { from { transform: translateX(-100%); } to { transform: translateX(0); } }

/* AI Polish */
.ai-polish-btn { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; padding: 10rpx 20rpx; border-radius: 12rpx; background: rgba(255,247,230,0.75); }
.ai-polish-icon { font-size: 24rpx; }
.ai-polish-text { font-size: 24rpx; color: #fa8c16; font-weight: 500; }

/* Quick Entry Chips（聊天框上方） */
.quick-chips { display: flex; gap: 16rpx; padding: 12rpx 20rpx 0; }
.qchip { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; border-radius: 30rpx; background: linear-gradient(140deg, rgba(255,255,255,0.50), rgba(255,255,255,0.26)); backdrop-filter: blur(30rpx) saturate(1.9); -webkit-backdrop-filter: blur(30rpx) saturate(1.9); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.90), 0 4rpx 14rpx rgba(var(--shadow-rgb, 20,70,140), 0.12); font-size: 25rpx; font-weight: 600; color: var(--brand-d, #0b5fd0); transition: background 0.2s ease, transform 0.12s ease; }
.qchip:active { background: linear-gradient(140deg, rgba(255,255,255,0.68), rgba(255,255,255,0.42)); transform: translateY(1rpx); }
