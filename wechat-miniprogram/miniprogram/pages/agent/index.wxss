.menu-text { font-size: 22rpx; color: var(--ink, #11131a); text-align: center; }

/* Voice Session */
.voice-session-texts { max-height: 280rpx; overflow-y: auto; margin-bottom: 20rpx; }
.voice-session-item { display: flex; align-items: flex-start; gap: 10rpx; padding: 14rpx 16rpx; background: linear-gradient(135deg, rgba(255,255,255,0.58), rgba(255,255,255,0.40)); border: 1rpx solid rgba(255,255,255,0.68); border-radius: 12rpx; margin-bottom: 12rpx; font-size: 26rpx; color: var(--ink, #11131a); line-height: 1.65; }
.voice-session-num { color: var(--brand, #2f3237); font-weight: 600; flex-shrink: 0; white-space: nowrap; }
.voice-session-content { flex: 1; word-break: break-all; }
.voice-session-empty { text-align: center; color: #a8b2c1; font-size: 26rpx; padding: 40rpx 0; }
.voice-session-actions { display: flex; justify-content: center; margin-bottom: 20rpx; }
.voice-hold-btn { padding: 20rpx 48rpx; border-radius: 40rpx; background: #ffffff; color: var(--brand, #2f3237); font-size: 28rpx; font-weight: 600; text-align: center; }
.voice-hold-btn.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); color: #fff; animation: pulse 0.8s infinite; }
.voice-session-footer { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.voice-session-footer button { flex: 1; margin: 0; }
.voice-session-info { margin-top: 20rpx; padding: 16rpx 20rpx; background: linear-gradient(135deg, rgba(255,255,255,0.58), rgba(255,255,255,0.40)); border: 1rpx solid rgba(255,255,255,0.68); border-radius: 12rpx; font-size: 24rpx; color: var(--brand, #2f3237); line-height: 1.65; word-break: break-all; }

/* Input Card（ima 模式：一张圆角卡片，上输入下功能行） */
/* 悬浮胶囊：两行内容（输入 + 按钮行），圆角取 44rpx 贴近胶囊；投影比卡片略强，靠浮起表达层级 */
.input-card { flex: 1; min-width: 0; width: 100%; box-sizing: border-box; padding: 8rpx 24rpx 16rpx; border-radius: 44rpx; background: #ffffff; border: 1rpx solid rgba(17,19,26,0.06); box-shadow: 0 8rpx 28rpx rgba(17,19,26,0.10); }
/* overflow: hidden 让 <editor> 的画布不越出自己的容器（内置组件的点击区域可能比 CSS 盒子大） */
.input-card .input-wrapper { background: transparent; min-height: 72rpx; padding: 0 8rpx; border-radius: 24rpx; overflow: hidden; }
.input-card .input-wrapper.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); }
.input-card .chat-input { height: 88rpx; line-height: 88rpx; }
.input-card .chat-textarea { height: auto; min-height: 72rpx; max-height: 264rpx; line-height: 44rpx; padding: 14rpx 0; }
/* 富文本输入框：尺寸与 textarea 对齐，保证切换到 editor 后输入区高度不跳。
   editor 内部是 contenteditable，行高/内边距要显式给，否则默认样式会和 textarea 不一致。 */
.input-card .chat-editor { width: 100%; height: auto; min-height: 72rpx; max-height: 264rpx; line-height: 44rpx; padding: 14rpx 0; font-size: 32rpx; box-sizing: border-box; overflow-y: auto; }
.chat-editor { width: 100%; font-size: 32rpx; line-height: 44rpx; box-sizing: border-box; }
/* 按钮行显式抬到上层：<editor> 是内置组件，卡片圆角/投影变化后它可能越过自身盒子，
   把下面一行的点击吃掉。用 z-index 明确层级，避免依赖内置组件的绘制顺序。 */
.input-card-row { position: relative; z-index: 3; display: flex; align-items: center; gap: 14rpx; margin-top: 6rpx; }
.flex-spacer { flex: 1; }
.scope-chip { display: flex; align-items: center; gap: 8rpx; padding: 0 20rpx; height: 60rpx; border-radius: 30rpx; background: linear-gradient(135deg, rgba(255,255,255,0.62), rgba(255,255,255,0.44)); border: 1rpx solid rgba(255,255,255,0.75); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.82); transition: background 0.2s ease; }
.scope-chip:active { background: linear-gradient(135deg, rgba(255,255,255,0.76), rgba(255,255,255,0.58)); }
