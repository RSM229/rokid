/* 玻璃拟态改造（浅色版） */

/* 背景不再由本页写死：环境光晕由 app.wxss 的 .page 承载（三调 2026-09-20），
   本页若写 background 会覆盖掉光晕，玻璃感归零。这里只管布局。 */
.page { display: flex; flex-direction: column; height: 100vh; padding: 0 0 calc(126rpx + env(safe-area-inset-bottom)); }

/* Nav Bar */
.nav-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: linear-gradient(135deg, rgba(var(--deep-rgb, 10,46,92), 0.86) 0%, rgba(var(--deep-rgb, 10,46,92), 0.76) 100%); backdrop-filter: blur(44rpx) saturate(1.9); -webkit-backdrop-filter: blur(44rpx) saturate(1.9); border-bottom: 1rpx solid rgba(255,255,255,0.16); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.16), 0 2rpx 14rpx rgba(var(--deep-rgb, 10,46,92), 0.20); }
.nav-bar-inner { position: absolute; left: 0; right: 0; display: flex; align-items: center; justify-content: center; padding: 0 28rpx; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #fff; max-width: 380rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav-title-wrap { display: flex; align-items: center; gap: 8rpx; max-width: 70%; }
.nav-caret { font-size: 26rpx; color: rgba(255,255,255,0.34); }
.nav-left { position: absolute; left: 28rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 56rpx; border-radius: 16rpx; background: rgba(255,255,255,0.18); }
.nav-left:active { background: rgba(255,255,255,0.32); }
.nav-menu-icon { width: 36rpx; height: 30rpx; background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M128%20224h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32%22/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: center; background-size: contain; }
.nav-icon { width: 30rpx; height: 30rpx; background-repeat: no-repeat; background-position: center; background-size: contain; }
.nav-icon.ic-clock { background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M512%20896a384%20384%200%201%200%200-768%20384%20384%200%200%200%200%20768m0%2064a448%20448%200%201%201%200-896%20448%20448%200%200%201%200%20896%22/%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M480%20256a32%2032%200%200%201%2032%2032v256a32%2032%200%200%201-64%200V288a32%2032%200%200%201%2032-32%22/%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M480%20512h256q32%200%2032%2032t-32%2032H480q-32%200-32-32t32-32%22/%3E%3C/svg%3E"); }
.nav-project { position: absolute; right: 28rpx; bottom: 4rpx; background: rgba(255,255,255,0.2); padding: 2rpx 14rpx; border-radius: 16rpx; }
.nav-project-name { font-size: 20rpx; color: #fff; }

/* Breadcrumb */
.breadcrumb { position: fixed; top: 0; left: 0; right: 0; z-index: 99; padding: 8rpx 28rpx; background: rgba(255,255,255,0.48); }
.bc-item { font-size: 24rpx; color: var(--brand, #1677ff); }
.bc-sep { color: var(--brand-l, #3b8cff); }

/* Bought derived with sidebar */
/* min-height:0 + overflow:hidden：flex 子项默认 min-height:auto 不许收缩，
   消息一多 .main 被撑大、把输入卡顶出屏幕（2026-10-10 真机实录） */
.main { flex: 1; min-width: 0; min-height: 0; overflow: hidden; padding: 12rpx 20rpx; display: flex; flex-direction: column; }
.messages { flex: 1; min-height: 0; }
.message { display: flex; margin-bottom: 24rpx; animation: fadeIn 0.25s ease; }
.message.assistant { flex-direction: column; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
.message.user { justify-content: flex-end; }
.bubble { max-width: 82%; padding: 22rpx 26rpx; border-radius: 24rpx 24rpx 24rpx 8rpx; line-height: 1.7; font-size: 28rpx; background: linear-gradient(140deg, rgba(255,255,255,0.54) 0%, rgba(255,255,255,0.30) 100%); backdrop-filter: blur(34rpx) saturate(1.9); -webkit-backdrop-filter: blur(34rpx) saturate(1.9); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.90), inset 0 -12rpx 24rpx rgba(var(--brand-rgb, 22,119,255), 0.12), 0 4rpx 16rpx rgba(var(--deep-rgb, 10,46,92), 0.10); word-break: break-all; white-space: pre-wrap; transition: background 0.25s ease, backdrop-filter 0.25s ease, -webkit-backdrop-filter 0.25s ease; }
.bubble:active { background: linear-gradient(140deg, rgba(255,255,255,0.72) 0%, rgba(255,255,255,0.46) 100%); }
.message.user .bubble { color: var(--ink, #12253d); border-radius: 24rpx 24rpx 8rpx 24rpx; background: linear-gradient(140deg, rgba(var(--brand-rgb, 22,119,255), 0.32) 0%, rgba(var(--brand-d-rgb, 11,95,208), 0.22) 100%); backdrop-filter: blur(34rpx) saturate(1.9); -webkit-backdrop-filter: blur(34rpx) saturate(1.9); border: 1rpx solid rgba(255,255,255,0.65); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.65), inset 0 -12rpx 24rpx rgba(var(--brand-rgb, 22,119,255), 0.10), 0 4rpx 14rpx rgba(var(--deep-rgb, 10,46,92), 0.10); }
.msg-image { width: 100%; border-radius: 12rpx; margin-bottom: 12rpx; }

/* ================= 2026-10-09 输入区重构 =================
   布局：第一行＝输入框 + 常驻发送按钮；第二行＝左（+ 面板 / 模型下拉）+ 右（麦克风）
   另加：多附件暂存条、模型下拉气泡、消息内多图九宫格、+ 面板四宫格与提示 */
.input-card { position: relative; }
.input-line { display: flex; align-items: center; gap: 14rpx; padding: 0 4rpx; }

/* 发送按钮：圆角方形 + 向上箭头（仿 Auto Mode 排版） */
.send-fab { flex-shrink: 0; width: 68rpx; height: 68rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(var(--brand-rgb, 22,119,255), 0.30), rgba(var(--brand-rgb, 22,119,255), 0.18)); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); transition: background 0.2s ease, box-shadow 0.2s ease; }
.send-fab.active { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); border-color: transparent; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 4rpx 16rpx rgba(var(--deep-rgb, 10,46,92), 0.22); }
.send-fab:active { transform: translateY(1rpx); }
.send-fab-ic { width: 34rpx; height: 34rpx; background-color: rgba(var(--brand-rgb, 22,119,255), 0.55); -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M536.6%20188.1c-13.8-13.8-36.1-13.8-49.9%200L224.4%20450.4c-13.8%2013.8-13.8%2036.1%200%2049.9s36.1%2013.8%2049.9%200L476%20298.7v513.1c0%2019.5%2015.8%2035.3%2035.3%2035.3s35.3-15.8%2035.3-35.3V296l204.4%20204.3c13.8%2013.8%2036.1%2013.8%2049.9%200s13.8-36.1%200-49.9L536.6%20188.1z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; mask: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M536.6%20188.1c-13.8-13.8-36.1-13.8-49.9%200L224.4%20450.4c-13.8%2013.8-13.8%2036.1%200%2049.9s36.1%2013.8%2049.9%200L476%20298.7v513.1c0%2019.5%2015.8%2035.3%2035.3%2035.3s35.3-15.8%2035.3-35.3V296l204.4%20204.3c13.8%2013.8%2036.1%2013.8%2049.9%200s13.8-36.1%200-49.9L536.6%20188.1z%22/%3E%3C/svg%3E") center / 100% 100% no-repeat; }
.send-fab.active .send-fab-ic { background-color: #fff; }

/* + 号放大（原 60rpx → 78rpx）
   双写类名提升优先级：本文件后段还有同优先级的 60rpx 定义，后定义者胜，
   单写会被压回原尺寸（2026-10-09 实测 31px 而非 39px） */
/* + 号圈与麦克风圈同尺寸（均 60rpx）；+ 图标本身放大以更醒目 */
.round-btn.round-btn-lg { width: 60rpx; height: 60rpx; border-radius: 50%; }
.round-btn.round-btn-lg::before { width: 66%; height: 66%; }

.model-chip { display: flex; align-items: center; gap: 8rpx; padding: 0 22rpx; height: 64rpx; border-radius: 32rpx; background: linear-gradient(135deg, rgba(255,255,255,0.62), rgba(255,255,255,0.44)); border: 1rpx solid rgba(255,255,255,0.75); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.82); }
.model-chip:active { background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(255,255,255,0.58)); }

/* 附件暂存条：多图/多文件的缩略图 + 删除角标 */
.attach-strip { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 6rpx 16rpx; overflow-x: auto; white-space: nowrap; }
.attach-item { position: relative; width: 116rpx; height: 116rpx; flex-shrink: 0; }
.attach-thumb { width: 116rpx; height: 116rpx; border-radius: 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.6); }
.attach-file { width: 116rpx; height: 116rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(var(--wash-rgb, 234,243,255), 0.95), rgba(255,255,255,0.72)); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.18); }
.attach-file-ext { font-size: 22rpx; font-weight: 700; color: var(--brand, #1677ff); letter-spacing: 1rpx; }
.attach-del { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; border-radius: 50%; background: rgba(185, 56, 56, 0.92); color: #fff; font-size: 26rpx; }
.attach-count { flex-shrink: 0; font-size: 22rpx; color: var(--ink-3, #6b7c93); }

/* 消息气泡内的多图九宫格 */
.msg-images { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 12rpx; }
.msg-image-grid { width: 168rpx; height: 168rpx; border-radius: 12rpx; }

/* + 面板：四宫格 + 底部提示 */
.menu-grid-4 { grid-template-columns: repeat(4, 1fr); }
.menu-tip { margin-top: 22rpx; text-align: center; font-size: 22rpx; color: var(--ink-3, #6b7c93); }

/* 工作记录字段候选：字段名 + 可点选的常用值 chips（最后一个「自己填写」） */
.field-groups { max-width: 88%; margin-top: 12rpx; }
.field-group { margin-bottom: 18rpx; }
.field-label { display: block; font-size: 24rpx; color: var(--ink-3, #6b7c93); margin-bottom: 10rpx; }
.field-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.field-chip { padding: 10rpx 24rpx; border-radius: 20rpx; font-size: 24rpx; color: var(--brand, #1677ff); background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(255,255,255,0.52)); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.18); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.86); }
.field-chip:active { background: linear-gradient(135deg, rgba(255,255,255,0.86), rgba(255,255,255,0.66)); transform: translateY(1rpx); }
.field-chip.ghost { color: var(--ink-3, #6b7c93); border-style: dashed; border-color: rgba(var(--deep-rgb, 10,46,92), 0.22); }

/* Action Buttons（会话内跟随气泡的操作按钮） */
.action-buttons { display: flex; flex-wrap: wrap; gap: 12rpx; }
.message-actions { margin-top: 12rpx; }
.message-prompts { max-width: 82%; padding: 16rpx 24rpx 20rpx; border-radius: 0 24rpx 24rpx 24rpx; line-height: 1.7; font-size: 28rpx; background: linear-gradient(140deg, rgba(255,255,255,0.54) 0%, rgba(255,255,255,0.30) 100%); backdrop-filter: blur(34rpx) saturate(1.9); -webkit-backdrop-filter: blur(34rpx) saturate(1.9); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.90), inset 0 -12rpx 24rpx rgba(var(--brand-rgb, 22,119,255), 0.12), 0 4rpx 16rpx rgba(var(--deep-rgb, 10,46,92), 0.10); word-break: break-all; }

/* 对话内整理计划：水印日期先作为线索展示，用户点击采用后才进入确认状态。 */
.inline-review { width: 92%; margin-top: 14rpx; padding: 22rpx; box-sizing: border-box; border: 1rpx solid rgba(36,95,86,.18); border-radius: 18rpx; background: rgba(255,255,255,.58); box-shadow: 0 4rpx 14rpx rgba(10,46,92,.08); }
.inline-review-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; }
.inline-review-title { font-size: 29rpx; font-weight: 700; color: #245f56; }
.inline-review-meta, .inline-review-event-count, .inline-review-selected { font-size: 22rpx; color: var(--ink-3, #6b7c93); }
.inline-review-empty { padding: 16rpx 0; color: var(--ink-3, #6b7c93); font-size: 24rpx; }
.inline-review-event { padding: 18rpx 0; border-top: 1rpx solid rgba(20,45,65,.10); }
.inline-review-event-head, .inline-review-date-row, .inline-review-form-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.inline-review-event-title { flex: 1; font-size: 26rpx; color: var(--ink, #12253d); font-weight: 600; }
.inline-review-label { font-size: 23rpx; color: var(--ink-3, #6b7c93); }
.inline-review-date-status { font-size: 24rpx; font-weight: 600; }
.inline-review-date-status.confirmed { color: #245f56; }
.inline-review-date-status.pending { color: #b06b20; }
.inline-review-source { display: block; margin-top: 8rpx; font-size: 21rpx; color: #71827e; line-height: 1.5; }
.inline-review-clues { margin-top: 12rpx; padding: 12rpx; border-radius: 12rpx; background: rgba(36,95,86,.06); }
.inline-review-clue-label { display: block; font-size: 22rpx; color: #5d766f; margin-bottom: 8rpx; }
.inline-review-chip-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.inline-review-chip { padding: 9rpx 16rpx; border-radius: 16rpx; font-size: 22rpx; color: #245f56; background: rgba(255,255,255,.84); border: 1rpx solid rgba(36,95,86,.22); }
.inline-review-chip.selected { color: #fff; background: #245f56; border-color: #245f56; }
.inline-review-date-picker { display: inline-flex; align-items: center; gap: 8rpx; margin-top: 12rpx; padding: 9rpx 14rpx; border-radius: 14rpx; font-size: 22rpx; color: var(--ink-3, #6b7c93); background: rgba(20,45,65,.05); }
.inline-review-form-row { margin-top: 18rpx; }
.inline-review-selected { margin-top: 10rpx; }
.inline-review-issues { margin-top: 12rpx; padding: 12rpx 14rpx; border-left: 4rpx solid #c87833; background: rgba(200,120,51,.08); }
.inline-review-issue { display: block; font-size: 22rpx; line-height: 1.6; color: #8b5427; }
.inline-review-confirm { margin: 18rpx 0 0; height: 72rpx; line-height: 72rpx; border-radius: 16rpx; color: #fff; background: #245f56; font-size: 25rpx; }
.inline-review-confirm[disabled] { opacity: .55; }
.inline-review-result, .inline-review-done { display: block; margin-top: 14rpx; font-size: 23rpx; color: #245f56; }
.message-hint { padding: 0; box-shadow: none; }
.agent-input-form { margin: 16rpx 0 4rpx; padding: 16rpx; border: 1rpx solid rgba(36,95,86,.18); border-radius: 8rpx; background: rgba(255,255,255,.72); }
.agent-input-field + .agent-input-field { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(20,45,65,.10); }
.agent-input-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 24rpx; line-height: 1.4; font-weight: 600; color: var(--ink, #12253d); }
.agent-input-reason { font-size: 19rpx; color: #477b70; font-weight: 400; }
.agent-input-recommendation { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; padding: 10rpx 12rpx; border-left: 4rpx solid #39836e; background: rgba(57,131,110,.08); color: #315f54; font-size: 22rpx; }
.agent-input-pick { flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 6rpx; background: #397d6d; color: #fff; }
.agent-input-options { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.agent-input-option { max-width: 100%; padding: 10rpx 14rpx; border: 1rpx solid rgba(36,95,86,.2); border-radius: 6rpx; background: #fff; color: #315f54; font-size: 22rpx; line-height: 1.35; box-sizing: border-box; }
.agent-input-option.selected { background: #397d6d; border-color: #397d6d; color: #fff; }
.agent-input-control, .agent-input-textarea { display: block; width: 100%; min-height: 72rpx; margin-top: 10rpx; padding: 14rpx; box-sizing: border-box; border: 1rpx solid rgba(20,45,65,.16); border-radius: 6rpx; background: #fff; color: var(--ink, #12253d); font-size: 23rpx; line-height: 1.45; }
.agent-input-textarea { min-height: 112rpx; }
.agent-input-attachment { margin-top: 10rpx; padding: 18rpx; border: 1rpx dashed rgba(36,95,86,.35); border-radius: 6rpx; color: #397d6d; font-size: 22rpx; text-align: center; }
.agent-input-submit { width: auto; min-width: 152rpx; height: 60rpx; margin: 12rpx 0 0; padding: 0 20rpx; border-radius: 6rpx; background: #397d6d; color: #fff; font-size: 22rpx; line-height: 60rpx; }
.agent-input-channel-note { display: block; margin-top: 12rpx; color: #6b7c93; font-size: 20rpx; line-height: 1.45; }

/* ===== 对话内任务表单：在回复气泡里一次完成选择、填写和上传 ===== */
.agent-task-form { margin-top: 14rpx; padding: 18rpx; border: 1rpx solid rgba(36,95,86,.22); border-radius: 16rpx; background: rgba(255,255,255,.80); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.90); }
.agent-task-form.completed { border-color: rgba(52,133,105,.18); background: rgba(241,248,245,.78); }
.agent-task-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding-bottom: 14rpx; border-bottom: 1rpx solid rgba(20,45,65,.09); }
.agent-task-head > view { min-width: 0; flex: 1; }
.agent-task-title { display: block; color: var(--ink, #12253d); font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.agent-task-hint { display: block; margin-top: 5rpx; color: #64768a; font-size: 21rpx; line-height: 1.5; }
.agent-task-state { flex: 0 0 auto; padding: 4rpx 12rpx; border-radius: 12rpx; background: rgba(36,95,86,.10); color: #2f7162; font-size: 19rpx; line-height: 1.45; }
.agent-task-form.completed .agent-task-state { background: rgba(47,113,98,.13); color: #276555; }
.agent-task-read { margin-top: 14rpx; padding: 12rpx 14rpx; border-left: 4rpx solid #4c8978; background: rgba(76,137,120,.07); }
.agent-task-read-title { display: block; margin-bottom: 7rpx; color: #41695f; font-size: 21rpx; font-weight: 600; }
.agent-task-read-row { display: grid; grid-template-columns: minmax(132rpx, .7fr) minmax(0, 1.7fr); gap: 12rpx; padding: 5rpx 0; color: #345c53; font-size: 21rpx; line-height: 1.5; }
.agent-task-read-row text:last-child { min-width: 0; overflow-wrap: anywhere; }
.agent-task-fields { display: flex; flex-direction: column; gap: 18rpx; margin-top: 16rpx; }
.agent-task-field { min-width: 0; }
.agent-task-section { display: block; margin: 4rpx 0 10rpx; color: #6b7c93; font-size: 19rpx; font-weight: 600; }
.agent-task-label { display: flex; align-items: center; gap: 10rpx; color: var(--ink, #12253d); font-size: 23rpx; font-weight: 600; line-height: 1.4; }
.agent-task-required { padding: 2rpx 8rpx; border-radius: 4rpx; background: rgba(97,112,128,.09); color: #7c8b9b; font-size: 18rpx; font-weight: 400; }
.agent-task-field-hint { display: block; margin-top: 5rpx; color: #718096; font-size: 20rpx; line-height: 1.45; }
.agent-task-suggestion { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 9rpx; padding: 9rpx 11rpx; border-left: 4rpx solid #4c8978; background: rgba(76,137,120,.08); color: #345f55; font-size: 21rpx; line-height: 1.45; }
.agent-task-suggestion > text:first-child { min-width: 0; flex: 1; }
.agent-task-suggestion-use { flex: 0 0 auto; padding: 6rpx 12rpx; border-radius: 4rpx; background: #397d6d; color: #fff; font-size: 20rpx; }
.agent-task-control, .agent-task-textarea { display: block; width: 100%; min-height: 70rpx; margin-top: 9rpx; padding: 12rpx 14rpx; box-sizing: border-box; border: 1rpx solid rgba(20,45,65,.18); border-radius: 8rpx; background: #fff; color: var(--ink, #12253d); font-size: 23rpx; line-height: 1.5; }
.agent-task-control { display: flex; align-items: center; justify-content: space-between; }
.agent-task-control.placeholder { color: #99a4b0; }
.agent-task-control-caret { margin-left: 12rpx; color: #7b8a99; font-size: 28rpx; line-height: 1; }
.agent-task-textarea { min-height: 118rpx; }
.agent-task-upload { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(20,45,65,.09); }
.agent-task-upload-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: var(--ink, #12253d); font-size: 23rpx; font-weight: 600; }
.agent-task-upload-head text:last-child { color: #748497; font-size: 20rpx; font-weight: 400; }
.agent-task-photos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9rpx; margin-top: 12rpx; }
.agent-task-photo { position: relative; overflow: hidden; height: 112rpx; border-radius: 8rpx; background: #eef2f5; }
.agent-task-photo image { display: block; width: 100%; height: 100%; }
.agent-task-photo-remove { position: absolute; top: 3rpx; right: 3rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: rgba(24,34,45,.74); color: #fff; font-size: 28rpx; line-height: 34rpx; text-align: center; }
.agent-task-upload-box { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 82rpx; margin-top: 11rpx; border: 1rpx dashed rgba(57,125,109,.46); border-radius: 8rpx; background: rgba(57,125,109,.045); color: #397d6d; font-size: 21rpx; }
.agent-task-upload-box.disabled { opacity: .52; }
.agent-task-upload-plus { font-size: 32rpx; line-height: 1; }
.agent-task-submit-row { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; }
.agent-task-submit { width: auto; min-width: 180rpx; height: 64rpx; margin: 0; padding: 0 24rpx; border-radius: 8rpx; background: #397d6d; color: #fff; font-size: 23rpx; line-height: 64rpx; }
.agent-task-submit[disabled] { background: #9eb6ae; color: #f7fbf9; }
.agent-task-skip { flex: 0 0 auto; color: #6b7c93; font-size: 21rpx; text-decoration: underline; text-underline-offset: 5rpx; }
.agent-task-links { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(20,45,65,.09); }
.agent-task-link { color: #397d6d; font-size: 21rpx; line-height: 1.5; text-decoration: underline; text-underline-offset: 4rpx; }
.action-btn { padding: 10rpx 24rpx; border-radius: 20rpx; background: linear-gradient(135deg, rgba(255,255,255,0.70), rgba(255,255,255,0.50)); color: var(--brand, #1677ff); font-size: 24rpx; font-weight: 500; border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.16); backdrop-filter: blur(16rpx) saturate(1.4); -webkit-backdrop-filter: blur(16rpx) saturate(1.4); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 2rpx 8rpx rgba(var(--deep-rgb, 10,46,92), 0.10); transition: background 0.2s ease, transform 0.12s ease; }
.action-btn:active { background: linear-gradient(135deg, rgba(255,255,255,0.82), rgba(255,255,255,0.62)); transform: translateY(1rpx); }

/* Hero（ima 风格空状态：大问候语 + 竖排建议按钮，居中偏上、左对齐） */
.hero { min-height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 0 24rpx 16%; box-sizing: border-box; }
.hero-greeting { font-size: 56rpx; font-weight: 600; color: var(--ink-2, #243b55); letter-spacing: 2rpx; margin-bottom: 44rpx; }
.hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 22rpx; }
.hero-pill { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 36rpx; border-radius: 24rpx; background: linear-gradient(140deg, rgba(255,255,255,0.52) 0%, rgba(255,255,255,0.26) 100%); backdrop-filter: blur(34rpx) saturate(1.9); -webkit-backdrop-filter: blur(34rpx) saturate(1.9); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.90), inset 0 -12rpx 24rpx rgba(var(--brand-rgb, 22,119,255), 0.12), 0 8rpx 22rpx rgba(var(--deep-rgb, 10,46,92), 0.10); font-size: 28rpx; color: var(--ink, #12253d); font-weight: 500; transition: background 0.25s ease, backdrop-filter 0.25s ease, -webkit-backdrop-filter 0.25s ease, transform 0.12s ease; }
.hero-pill:active { background: linear-gradient(140deg, rgba(255,255,255,0.70) 0%, rgba(255,255,255,0.44) 100%); backdrop-filter: blur(44rpx) saturate(2.2); -webkit-backdrop-filter: blur(44rpx) saturate(2.2); transform: translateY(1rpx); }
.hero-pill-icon { width: 40rpx; height: 40rpx; background-repeat: no-repeat; background-position: center; background-size: contain; flex-shrink: 0; }
