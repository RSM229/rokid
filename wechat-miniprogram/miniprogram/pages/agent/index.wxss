/* 🔴 无项目用户的常驻引导条（2026-10-21）：说清「现在能用什么」+「下一步去哪」。
   沿用 hero-pill 的毛玻璃质感与页面既有变量，不硬编码颜色（深色模式自动跟随）。 */
.no-project-tip { display: flex; flex-direction: column; align-items: flex-start; gap: 18rpx; width: 100%; box-sizing: border-box; margin-bottom: 32rpx; padding: 26rpx 32rpx; border-radius: 24rpx; background: linear-gradient(140deg, rgba(var(--brand-rgb, 47,50,55), 0.10) 0%, rgba(var(--brand-rgb, 47,50,55), 0.04) 100%); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.18); }
.no-project-tip-text { font-size: 26rpx; line-height: 1.65; color: var(--ink-2, #243b55); }
.no-project-tip-btn { align-self: flex-start; padding: 14rpx 32rpx; border-radius: 999rpx; background: var(--brand, #2f3237); color: #fff; font-size: 26rpx; font-weight: 500; }
.no-project-tip-btn:active { opacity: 0.82; }

/* Typing */
.typing { display: flex; gap: 8rpx; padding: 24rpx 32rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--brand-l, #3a4046); animation: bounce 1.2s infinite; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce { 0%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-10rpx); } }

/* Input Bar */
/* 待补传语音提示条（录音上传失败入队后） */
.pending-voice { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 8rpx 16rpx 0; padding: 14rpx 18rpx; border-radius: 18rpx; background: rgba(var(--brand-rgb, 47,50,55), 0.08); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.20); }
.pv-text { font-size: 24rpx; color: var(--ink, #11131a); }
.pv-actions { display: flex; gap: 10rpx; }

/* 待补全草稿横幅（聊天即操作的半成品提醒，顶部常驻，flex-shrink:0 不挤压聊天区） */
.pv-btn { margin: 0; font-size: 22rpx; line-height: 1.65; }

/* 键盘避让：只把输入条自身抬起，不动整页布局。整页加 padding 会把消息区压缩、
   输入卡被顶到导航栏下方（真机上踩过）。jl 的做法就是给底部容器 margin-bottom。 */
/* 输入区：只做容器与定位，不再铺底色。原来是「浅灰条（input-bar）+ 白卡（input-card）」两层卡片叠在一起，
   看起来像卡片套卡片。现在外层完全透明，只有白卡悬浮在消息区之上（iOS 风格：功能层浮于内容层之上）。 */
.input-bar { display: flex; align-items: center; padding: 8rpx 24rpx 16rpx; gap: 8rpx; position: relative; z-index: 155; }
.model-btn { display: flex; align-items: center; gap: 6rpx; padding: 0 18rpx; height: 64rpx; border-radius: 32rpx; background: linear-gradient(135deg, rgba(var(--wash-rgb, 234,243,255), 0.8) 0%, rgba(var(--wash-rgb, 234,243,255), 0.8) 100%); flex-shrink: 0; }
.model-btn.hazard-active { background: linear-gradient(135deg, rgba(253,232,232,0.8) 0%, rgba(255,221,221,0.8) 100%); }
.model-btn-label { font-size: 24rpx; font-weight: 700; color: #11131a; }
.hazard-active .model-btn-label { color: #b93838; }
.model-arrow { font-size: 20rpx; color: var(--brand, #2f3237); }
.hazard-active .model-arrow { color: #b93838; }
/* 气泡相对 .model-anchor 锚定（absolute 不随页面滚动/麦克风显隐漂移）；
   不能用 transform 居中（与动画 transform 冲突），改 right 对齐 + 纯透明度动画 */
.model-menu { position: absolute; right: 0; bottom: calc(100% + 12rpx); z-index: 160; width: 480rpx; max-height: 52vh; overflow-y: auto; padding: 10rpx; border-radius: 24rpx; background: rgba(255,255,255,0.98); border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.18); box-shadow: 0 14rpx 36rpx rgba(var(--deep-rgb, 10,46,92), 0.18); animation: modelFade 0.15s ease; box-sizing: border-box; }
@keyframes modelFade { from { opacity: 0; } to { opacity: 1; } }
.model-menu-item { display: block; padding: 16rpx 20rpx; border-radius: 16rpx; }
.model-menu-item.active { background: rgba(var(--wash-rgb, 234,243,255), 0.92); }
.model-menu-row1 { display: flex; align-items: center; gap: 10rpx; }
.model-menu-name { font-size: 26rpx; font-weight: 600; color: var(--ink, #11131a); }
.model-menu-item.active .model-menu-name { color: var(--brand, #2f3237); }
.model-menu-desc { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; color: var(--ink-3, #8a94a6); }
.model-menu-check { margin-left: auto; font-size: 26rpx; color: var(--brand, #2f3237); }
/* 模型菜单里的「隐患识别」快捷入口（收编原底部 tab，2026-11-16） */
.model-menu-hazard:active { background: rgba(var(--wash-rgb, 234,243,255), 0.92); }
