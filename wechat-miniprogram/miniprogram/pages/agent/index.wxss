.img-btn-text { font-size: 28rpx; }
.input-wrapper { flex: 1; min-height: 148rpx; border-radius: 48rpx; background: rgba(255,255,255,0.48); display: flex; align-items: center; padding: 0 26rpx; }
.input-wrapper.recording { background: linear-gradient(135deg, rgba(185,56,56,0.85) 0%, rgba(212,74,74,0.85) 100%); }
.recording-hint { display: flex; align-items: center; gap: 12rpx; color: #fff; font-size: 28rpx; font-weight: 600; }
.rec-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #fff; animation: rec-pulse 0.8s infinite; }
@keyframes rec-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
.chat-input { width: 100%; height: 148rpx; font-size: 32rpx; line-height: 148rpx; }
.input-placeholder { color: #a3b1c2; }
.send-btn { padding: 0 28rpx; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.75); color: var(--brand-l, #3b8cff); font-size: 28rpx; font-weight: 600; flex-shrink: 0; text-align: center; }
.send-btn.active { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; }
.mic-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background-color: rgba(255,255,255,0.50); background-repeat: no-repeat; background-position: center; background-size: 58%; flex-shrink: 0; }
