<view class="page" style="padding-top: {{statusBarHeight}}px;; {{themeStyle}}">
  <tab-bar active="agent" bind:doubletap="onTabDoubleTap" />
  <!-- Custom Nav Bar -->
  <view class="nav-bar" style="height: {{statusBarHeight + navBarHeight}}px;">
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px; top: {{statusBarHeight}}px;">
      <view class="nav-left" bindtap="openHistory">
        <view class="nav-menu-icon"></view>
      </view>
      <view class="nav-title-wrap" bindtap="switchProject">
        <text class="nav-title">{{projectName || '监理智能体'}}</text>
        <text class="nav-caret">▾</text>
      </view>
    </view>
  </view>

  <!-- Breadcrumb -->
  <view class="breadcrumb" wx:if="{{breadcrumb.length > 0}}">
    <text class="bc-item" wx:for="{{breadcrumb}}" wx:key="index">
      <text wx:if="{{index > 0}}" class="bc-sep"> › </text>
      {{item}}
    </text>
  </view>

  <!-- 待补全草稿卡已移入 main 顶部（见下方），避免被固定导航遮挡 -->

  <!-- Main Chat Area -->
  <view class="main" style="padding-top: {{statusBarHeight + navBarHeight + (breadcrumb.length > 0 ? 70 : 10)}}px;">
    <!-- 待补全草稿提醒卡已按用户要求移除（2026-10-15）：草稿数据仍落库，聊天内追问补全流程不变 -->
    <scroll-view class="messages" scroll-y scroll-into-view="bottom" enhanced show-scrollbar="{{false}}">
      <!-- Hero（ima 风格空状态：大问候语 + 竖排建议按钮） -->
      <view wx:if="{{messages.length <= 1 && !loading}}" class="hero">
        <view class="hero-greeting">你好，我是你的工程项目管理AI智能体</view>
        <!-- 🔴 无项目时的常驻引导条：说清「现在能用什么」+「下一步去哪」，
             取代原来那个必然 403 的「创建新项目」弹窗（该接口仅超管可调用，
             而超管不允许登录小程序 ⇒ 小程序里任何人都建不了项目）。 -->
        <view wx:if="{{noProject}}" class="no-project-tip">
          <text class="no-project-tip-text">你还没有加入项目。规范查询、AI 问答、天气等现在就能用；现场记录需要先加入项目。</text>
          <view class="no-project-tip-btn" bindtap="goJoinProject">去加入项目</view>
        </view>
        <view class="hero-actions">
          <view class="hero-pill" wx:for="{{visibleHeroActions}}" wx:for-item="act" wx:for-index="ai" wx:key="ai" data-command="{{act.command}}" bindtap="handleActionTap">
            <view class="hero-pill-icon {{act.icon}}"></view>
            <text>{{act.text}}</text>
          </view>
        </view>
      </view>
      <block wx:else>
        <view wx:for="{{messages}}" wx:for-index="mi" wx:key="index" class="message {{item.role}}" id="msg-{{mi}}">
          <view class="message-head">
            <block wx:if="{{item.role === 'assistant'}}">
              <text class="message-role">监理智能体</text>
              <text wx:if="{{item.timeText}}" class="message-time">{{item.timeText}}</text>
            </block>
            <block wx:else>
              <text wx:if="{{item.timeText}}" class="message-time">{{item.timeText}}</text>
              <text class="message-role">我</text>
            </block>
          </view>
          <view wx:if="{{item.text || item.image || (item.images && item.images.length)}}" class="bubble">
            <image wx:if="{{item.image}}" class="msg-image" src="{{item.image}}" mode="widthFix" data-url="{{item.image}}" bindtap="previewImageUrl" />
            <view wx:if="{{item.images && item.images.length}}" class="msg-images">
              <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="msg-image-grid"
                     src="{{img}}" mode="aspectFill" data-url="{{img}}" bindtap="previewImageUrl" />
            </view>
            <text>{{item.text}}</text>
          </view>
          <view wx:if="{{item.progressRequestId}}" class="agent-progress">
            <view class="agent-progress-head" data-index="{{mi}}" bindtap="toggleAgentProgress">
              <view class="agent-progress-title-wrap">
                <text class="agent-progress-title">处理过程</text>
                <text class="agent-progress-current">{{item.progressHeadline || '任务已接收'}}</text>
              </view>
              <view class="agent-progress-meta">
                <text>{{item.progressEvents.length}} 项 · {{item.progressElapsedSeconds || 0}} 秒</text>
                <text class="agent-progress-toggle">{{item.progressExpanded ? '收起' : '展开'}}</text>
              </view>
            </view>
            <view wx:if="{{item.progressExpanded}}" class="agent-progress-list">
              <view wx:for="{{item.progressEvents}}" wx:for-item="progress" wx:key="eventId" class="agent-progress-event {{progress.status}}">
                <view class="agent-progress-mark"></view>
                <view class="agent-progress-body">
                  <text class="agent-progress-event-title">{{progress.title}}</text>
                  <text wx:if="{{progress.detailText}}" class="agent-progress-detail">{{progress.detailText}}</text>
                  <text class="agent-progress-time">{{progress.createdAt}}</text>
                </view>
              </view>
            </view>
          </view>
          <!-- 智能体回执卡：点击进对应列表/详情 -->
          <view wx:if="{{item.cards && item.cards.length}}" class="agent-cards">
            <view class="agent-card" wx:for="{{item.cards}}" wx:for-item="cd" wx:for-index="ci" wx:key="ci"
                  data-kind="{{cd.kind}}" data-id="{{cd.id}}" bindtap="openAgentCard">
              <view class="agent-card-top">
                <text class="agent-card-kind">{{cd.kind === 'work_record' ? '工作记录' : (cd.kind === 'parallel_inspection' ? '平行检验记录' : (cd.kind === 'hazard' ? '隐患' : '文书'))}}</text>
                <text wx:if="{{cd.status}}" class="agent-card-status">{{cd.status}}</text>
              </view>
              <text class="agent-card-title">{{cd.title}}</text>
              <text wx:if="{{cd.sub}}" class="agent-card-sub">{{cd.sub}}</text>
              <text wx:if="{{cd.time}}" class="agent-card-time">{{cd.time}}</text>
            </view>
          </view>
          <!-- 整理计划直接在对话中完成：识别日期是候选，点击后才确认，不再跳转独立页面。 -->
          <view wx:if="{{item.reviewPlan}}" class="inline-review">
            <view class="inline-review-head">
              <text class="inline-review-title">工作记录草稿</text>
              <text class="inline-review-meta">{{item.reviewPlan.evidence.length}} 张图片 · {{item.reviewPlan.events.length}} 个事项</text>
            </view>
            <text wx:if="{{item.reviewSummary}}" class="inline-review-summary">{{item.reviewSummary}}</text>
            <view wx:if="{{(item.reviewEvents && item.reviewEvents.length) || (item.reviewUnassignedEvidence && item.reviewUnassignedEvidence.length)}}" class="inline-review-preview" data-index="{{mi}}" bindtap="toggleInlineReviewDetails">
              <text>{{item.reviewDetailsExpanded ? '收起草稿详情' : '查看草稿详情'}}</text>
              <text class="inline-review-preview-arrow {{item.reviewDetailsExpanded ? 'expanded' : ''}}">›</text>
            </view>
            <view wx:if="{{!item.reviewEvents || !item.reviewEvents.length}}" class="inline-review-empty">照片已收到，正在等待你确定用途。可点下面的记录类型，也可继续用下方输入框打字、语音或添加图片。</view>
            <view wx:if="{{item.reviewPurposeOptions && item.reviewPurposeOptions.length}}" class="inline-review-chip-row review-purpose-options">
              <view wx:if="{{item.reviewRecommendation}}" class="review-ai-recommendation">
                <view><text class="review-ai-recommendation-title">智能体建议：{{item.reviewRecommendation.recordType}}</text><text class="review-ai-recommendation-reason">{{item.reviewRecommendation.reason}}</text></view>
                <button class="inline-review-chip selected" data-index="{{mi}}" data-purpose="record_type:{{item.reviewRecommendation.recordType}}" bindtap="chooseInlineReviewPurpose">采用建议</button>
              </view>
              <button wx:for="{{item.reviewPurposeOptions}}" wx:for-item="purpose" wx:key="value" class="inline-review-chip" data-index="{{mi}}" data-purpose="{{purpose.value}}" bindtap="chooseInlineReviewPurpose">{{purpose.label}}</button>
            </view>
            <block wx:if="{{item.reviewDetailsExpanded}}">
            <view wx:if="{{item.reviewUnassignedEvidence && item.reviewUnassignedEvidence.length}}" class="inline-review-unassigned">
              <text class="inline-review-label">尚未分配的照片证据</text>
              <view wx:for="{{item.reviewUnassignedEvidence}}" wx:for-item="photo" wx:key="id" class="inline-watermark-photo">
                <view class="inline-watermark-head"><image src="{{photo.image}}" mode="aspectFill"/><text>图片水印信息</text><text>{{photo.status}}</text></view>
                <block wx:if="{{photo.items.length}}">
                  <view wx:for="{{photo.items}}" wx:for-item="field" wx:key="index" class="inline-review-source">{{field.label}}：{{field.value || '未识别/未知'}}</view>
                </block>
                <text wx:else class="inline-review-source">暂未提取到可显示的水印字段；原图仍已保留。</text>
                <text wx:if="{{photo.note}}" class="inline-review-source">图片内容与原始识别：{{photo.note}}</text>
                <view class="inline-evidence-actions">
                  <picker wx:if="{{item.reviewEventOptions && item.reviewEventOptions.length}}" range="{{item.reviewEventOptions}}" range-key="title" data-index="{{mi}}" data-evidence="{{photo.id}}" bindchange="assignInlineEvidence">
                    <view class="inline-review-action">加入已有事项</view>
                  </picker>
                  <view class="inline-review-action" data-index="{{mi}}" data-evidence="{{photo.id}}" bindtap="addInlineEventForEvidence">设为独立事项</view>
                </view>
              </view>
            </view>
            <view wx:for="{{item.reviewEvents}}" wx:for-item="event" wx:for-index="ei" wx:key="id" class="inline-review-event">
              <view class="inline-review-event-head">
                <view class="inline-merge-toggle {{event.mergeSelected ? 'selected' : ''}}" data-index="{{mi}}" data-id="{{event.id}}" bindtap="toggleInlineMerge">{{event.mergeSelected ? '已选' : '选择合并'}}</view>
                <text class="inline-review-event-title">{{ei + 1}}. {{event.title}}</text>
                <text class="inline-review-event-count">{{event.evidenceCount}} 张图片</text>
              </view>
              <view wx:if="{{event.missingFields.length}}" class="inline-review-missing">
                <text class="inline-review-missing-title">待补信息</text>
                <text wx:for="{{event.missingFields}}" wx:key="*this" class="inline-review-missing-item">{{item}}</text>
              </view>
              <view wx:if="{{event.issues.length}}" class="inline-review-clues">
                <text wx:for="{{event.issues}}" wx:key="*this" class="inline-review-issue">{{item}}</text>
              </view>
              <view class="inline-review-field">
                <text>工作名称</text>
                <input value="{{event.title}}" placeholder="例如：3号楼二层钢筋绑扎巡视" data-index="{{mi}}" data-id="{{event.id}}" data-field="title" bindblur="changeInlineReviewField" />
              </view>
              <view class="inline-review-field-grid">
                <view class="inline-review-field"><text>地点</text><input value="{{event.location}}" placeholder="可补充" data-index="{{mi}}" data-id="{{event.id}}" data-field="location" bindblur="changeInlineReviewField" /></view>
                <view class="inline-review-field"><text>施工部位</text><input value="{{event.section}}" placeholder="可补充" data-index="{{mi}}" data-id="{{event.id}}" data-field="section" bindblur="changeInlineReviewField" /></view>
              </view>
              <view wx:for="{{event.entityFieldRows}}" wx:for-item="entityField" wx:for-index="efi" wx:key="field" class="inline-review-field entity-field {{entityField.conflict ? 'conflict' : ''}}">
                <view class="inline-review-entity-head">
                  <text>{{entityField.label}}</text>
                  <text wx:if="{{entityField.conflict}}" class="inline-review-conflict">待确认</text>
                  <text wx:elif="{{entityField.value}}" class="inline-review-source-tag">已有识别值</text>
                </view>
                <input value="{{entityField.value}}" placeholder="未识别，可直接补充" data-index="{{mi}}" data-id="{{event.id}}" data-field="{{entityField.field}}" bindblur="changeInlineReviewEntityField" />
                <view wx:if="{{entityField.values.length > 1}}" class="inline-review-chip-row entity-choice-row">
                  <view wx:for="{{entityField.values}}" wx:for-item="choice" wx:for-index="choiceIndex" wx:key="choiceIndex" class="inline-review-chip {{entityField.value === choice ? 'selected' : ''}}" data-index="{{mi}}" data-id="{{event.id}}" data-field="{{entityField.field}}" data-value="{{choice}}" bindtap="changeInlineReviewEntityField">采用 {{choice}}</view>
                </view>
              </view>
              <view wx:if="{{event.formFields && event.formFields.length}}" class="inline-form-schema">
                <view class="inline-form-schema-head">
                  <text class="inline-form-schema-title">待定工作记录草稿 · {{event.draftStatusLabel}}</text>
                  <text class="inline-review-source-tag">{{event.formCode}} · {{event.contractVersion}}</text>
                </view>
                <view wx:for="{{event.formFields}}" wx:for-item="formField" wx:key="canonical" class="inline-review-field form-schema-field {{formField.missing || formField.conflict || formField.validationError ? 'required-missing' : ''}}">
                  <view class="inline-review-entity-head">
                    <text>{{formField.label}}{{formField.required ? ' *' : ''}}</text>
                    <text wx:if="{{formField.conflict}}" class="inline-review-conflict">待确认</text>
                    <text wx:elif="{{formField.missing}}" class="inline-review-conflict">待补</text>
                    <text wx:elif="{{formField.validationError}}" class="inline-review-conflict">格式待修正</text>
                    <text wx:elif="{{formField.source === 'watermark'}}" class="inline-review-source-tag">水印识别</text>
                    <text wx:elif="{{formField.value}}" class="inline-review-source-tag">已填写</text>
                  </view>
                  <text wx:if="{{formField.validationError}}" class="inline-review-source">{{formField.validationError}}</text>
                  <view wx:if="{{formField.conflict && formField.candidates.length}}" class="inline-review-chip-row form-option-row">
                    <view wx:for="{{formField.candidates}}" wx:for-item="candidate" wx:for-index="candidateIndex" wx:key="candidateIndex" class="inline-review-chip {{formField.value === candidate.value ? 'selected' : ''}}" data-index="{{mi}}" data-id="{{event.id}}" data-form-code="{{event.formCode}}" data-field="{{formField.canonical}}" data-value="{{candidate.value}}" bindtap="chooseInlineReviewFormOption">采用 {{candidate.value}}</view>
                  </view>
                  <date-time-picker wx:if="{{formField.control === 'datetime-local'}}" value="{{formField.value}}" reference-date="{{event.date}}" reference-enabled="{{formField.required}}" disabled="{{formField.readonly}}" data-index="{{mi}}" data-id="{{event.id}}" data-form-code="{{event.formCode}}" data-field="{{formField.canonical}}" bind:change="changeInlineReviewDateTime" />
                  <date-time-picker wx:elif="{{formField.control === 'time'}}" mode="time" value="{{formField.value}}" reference-enabled="{{formField.required}}" disabled="{{formField.readonly}}" data-index="{{mi}}" data-id="{{event.id}}" data-form-code="{{event.formCode}}" data-field="{{formField.canonical}}" bind:change="changeInlineReviewDateTime" />
                  <textarea wx:elif="{{formField.control === 'textarea'}}" value="{{formField.value}}" disabled="{{formField.readonly}}" auto-height maxlength="-1" placeholder="{{formField.question || '请填写'}}" data-index="{{mi}}" data-id="{{event.id}}" data-form-code="{{event.formCode}}" data-field="{{formField.canonical}}" bindblur="changeInlineReviewFormField" />
                  <view wx:elif="{{formField.control === 'select' && formField.options.length}}" class="inline-review-chip-row form-option-row">
                    <view wx:for="{{formField.options}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="optionIndex" class="inline-review-chip {{formField.value === option ? 'selected' : ''}}" data-index="{{mi}}" data-id="{{event.id}}" data-form-code="{{event.formCode}}" data-field="{{formField.canonical}}" data-value="{{option}}" bindtap="chooseInlineReviewFormOption">{{option}}</view>
                  </view>
                  <input wx:else value="{{formField.value}}" disabled="{{formField.readonly}}" type="{{formField.control === 'number' ? 'number' : 'text'}}" placeholder="{{formField.question || (formField.readonly ? '由系统带出' : '请填写')}}" data-index="{{mi}}" data-id="{{event.id}}" data-form-code="{{event.formCode}}" data-field="{{formField.canonical}}" bindblur="changeInlineReviewFormField" />
                </view>
              </view>
              <view class="inline-review-field"><text>工作描述</text><textarea value="{{event.content}}" auto-height maxlength="-1" placeholder="补充现场工作情况" data-index="{{mi}}" data-id="{{event.id}}" data-field="content" bindblur="changeInlineReviewField" /></view>
              <view class="inline-review-date-row">
                <text class="inline-review-label">业务日期</text>
                <text class="inline-review-date-status {{event.date ? 'confirmed' : 'pending'}}">{{event.date ? event.date : '待补充'}}</text>
              </view>
              <text wx:if="{{event.dateSource}}" class="inline-review-source">日期依据：{{event.dateSource === 'watermark' ? '照片水印' : (event.dateSource === 'exif' ? '照片 EXIF' : (event.dateSource === 'watermark_or_exif' ? '照片水印/EXIF' : (event.dateSource === 'user_message' ? '你的文字描述' : event.dateSource)))}}</text>
              <text wx:if="{{event.evidenceSummary}}" class="inline-review-source">图片证据：{{event.evidenceSummary}}</text>
              <text wx:if="{{event.watermarkSummary}}" class="inline-review-source">水印字段（待核对）：{{event.watermarkSummary}}</text>
              <text wx:if="{{!event.watermarkSummary && event.evidenceCount}}" class="inline-review-source">水印字段未识别到；地点、区域、参建单位及记录表所需信息可在对话中补充。</text>
              <view wx:for="{{event.evidenceFields}}" wx:for-item="photo" wx:key="id" class="inline-watermark-photo">
                <view class="inline-watermark-head"><image src="{{photo.image}}" mode="aspectFill"/><text>图片水印信息</text><text>{{photo.status}}</text></view>
                <view wx:for="{{photo.items}}" wx:for-item="field" wx:key="index" class="inline-watermark-field">
                  <input value="{{field.label}}" placeholder="字段名（如施工区域）" data-index="{{mi}}" data-evidence="{{photo.id}}" data-item="{{field.index}}" data-key="label" bindblur="changeInlineWatermarkField" />
                  <input value="{{field.value}}" placeholder="未识别/未知，可补充" data-index="{{mi}}" data-evidence="{{photo.id}}" data-item="{{field.index}}" data-key="value" bindblur="changeInlineWatermarkField" />
                </view>
                <view class="inline-watermark-add" data-index="{{mi}}" data-evidence="{{photo.id}}" bindtap="addInlineWatermarkField">+ 补充字段或备注</view>
                <view class="inline-evidence-actions">
                  <view class="inline-review-action" data-index="{{mi}}" data-evidence="{{photo.id}}" bindtap="releaseInlineEvidence">移出本事项</view>
                  <view wx:if="{{event.evidenceCount > 1}}" class="inline-review-action" data-index="{{mi}}" data-evidence="{{photo.id}}" bindtap="splitInlineEvidence">拆成独立事项</view>
                </view>
              </view>
              <text wx:if="{{event.sourceText}}" class="inline-review-source">证据来源：{{event.sourceText}}</text>
              <view wx:if="{{event.dateOptions && event.dateOptions.length}}" class="inline-review-clues">
                <text class="inline-review-clue-label">照片水印识别到：</text>
                <view class="inline-review-chip-row">
                  <view wx:for="{{event.dateOptions}}" wx:for-item="date" wx:key="*this" class="inline-review-chip {{event.date === date && event.dateConfirmed ? 'selected' : ''}}" data-index="{{mi}}" data-id="{{event.id}}" data-date="{{date}}" bindtap="adoptInlineReviewDate">采用 {{date}}</view>
                </view>
              </view>
              <picker mode="date" value="{{event.date || '2000-01-01'}}" data-index="{{mi}}" data-id="{{event.id}}" bindchange="changeInlineReviewDate">
                <view class="inline-review-date-picker">{{event.dateConfirmed ? '修改日期' : (event.dateOptions && event.dateOptions.length ? '从照片日期中选择' : '补充业务日期')}} <text>▾</text></view>
              </picker>
              <view class="inline-review-form-row">
                <text class="inline-review-label">工作记录类型</text>
                <text class="inline-review-date-status {{event.recordType === '待定' ? 'pending' : 'confirmed'}}">{{event.recordType}} · {{event.draftStatusLabel}}</text>
              </view>
              <view class="inline-review-chip-row">
                <view wx:for="{{event.recordTypeOptions}}" wx:for-item="type" wx:key="label" class="inline-review-chip form-chip {{type.checked ? 'selected' : ''}}" data-index="{{mi}}" data-id="{{event.id}}" data-type="{{type.label}}" bindtap="changeInlineReviewType">{{type.label}}</view>
              </view>
              <text wx:if="{{event.recordTypeReason}}" class="inline-review-source">判断依据：{{event.recordTypeReason}}</text>
              <view class="inline-review-remove" data-index="{{mi}}" data-id="{{event.id}}" bindtap="removeInlineReviewEvent">删除此事项（照片保留到待分配）</view>
            </view>
            <button wx:if="{{item.reviewMergeSelection.length >= 2}}" class="inline-review-merge" data-index="{{mi}}" bindtap="mergeInlineReview">合并已选 {{item.reviewMergeSelection.length}} 个事项</button>
            </block>
            <view wx:if="{{item.reviewIssues && item.reviewIssues.length}}" class="inline-review-issues">
              <text wx:for="{{item.reviewIssues}}" wx:key="*this" class="inline-review-issue">{{item}}</text>
            </view>
            <text wx:if="{{item.reviewResult}}" class="inline-review-result">{{item.reviewResult}}</text>
            <button wx:if="{{item.reviewPlan.status !== 'executed'}}" class="inline-review-confirm" disabled="{{item.reviewBusy}}" loading="{{item.reviewBusy}}" bindtap="confirmInlineReview" data-index="{{mi}}">{{item.reviewBusy ? '正在生成' : (item.reviewIssues && item.reviewIssues.length ? '先处理待确认项' : '确认并生成工作记录')}}</button>
            <text wx:if="{{item.reviewPlan.status === 'executed'}}" class="inline-review-done">已完成建档，正式记录已创建。</text>
          </view>
          <view wx:if="{{item.hazardCandidates && item.hazardCandidates.length}}" class="inline-hazard-candidates">
            <view class="inline-hazard-head">
              <view>
                <text class="inline-hazard-title">隐患候选</text>
                <text class="inline-hazard-subtitle">识别结果尚未正式建档，请核对后勾选确认</text>
              </view>
              <text class="inline-hazard-count">{{item.hazardCandidates.length}} 项</text>
            </view>
            <view wx:for="{{item.hazardCandidates}}" wx:for-item="candidate" wx:key="id" class="inline-hazard-item {{candidate.status}}">
              <view class="inline-hazard-row">
                <view class="inline-hazard-select {{candidate.selected ? 'selected' : ''}}" data-index="{{mi}}" data-id="{{candidate.id}}" bindtap="toggleHazardCandidate">{{candidate.selected ? '✓' : ''}}</view>
                <image class="inline-hazard-photo" src="{{candidate.image}}" mode="aspectFill" />
                <view class="inline-hazard-main">
                  <text class="inline-hazard-risk">{{candidate.title}}</text>
                  <text class="inline-hazard-meta">{{candidate.riskCategory}}{{candidate.section ? ' · ' + candidate.section : ''}}{{candidate.location ? ' · ' + candidate.location : ''}}</text>
                  <text class="inline-hazard-status">{{candidate.statusText}}</text>
                </view>
              </view>
              <view wx:if="{{candidate.evidence.length}}" class="inline-hazard-evidence">
                <text wx:for="{{candidate.evidence}}" wx:for-item="reason" wx:key="*this">依据：{{reason}}</text>
              </view>
              <text wx:if="{{candidate.error}}" class="inline-hazard-error">{{candidate.error}}</text>
              <text wx:if="{{candidate.status === 'pending'}}" class="inline-hazard-discard" data-index="{{mi}}" data-id="{{candidate.id}}" bindtap="discardHazardCandidate">排除此项</text>
            </view>
            <button wx:if="{{item.hazardPendingCount}}" class="inline-review-confirm" disabled="{{item.hazardCandidateBusy}}" loading="{{item.hazardCandidateBusy}}" data-index="{{mi}}" bindtap="confirmHazardCandidates">{{item.hazardCandidateBusy ? '正在建档' : '确认所选隐患并建档'}}</button>
            <text wx:if="{{item.hazardCandidateResult}}" class="inline-review-result">{{item.hazardCandidateResult}}</text>
          </view>
          <!-- 会话内的操作按钮（如语音提取后的「查看表单」）仍跟随气泡 -->
          <view wx:if="{{item.hint || (item.actions && item.actions.length) || (item.chips && item.chips.length)}}" class="message-prompts">
            <view wx:if="{{item.hint}}" class="message-hint">
              <text>{{item.hint}}</text>
            </view>
            <!-- 智能体追问的快速候选值：点一下即作为回答发送 -->
            <view wx:if="{{item.chips && item.chips.length}}" class="agent-chips">
              <view class="agent-chip" wx:for="{{item.chips}}" wx:for-item="chip" wx:for-index="chi" wx:key="chi" data-command="agent-chip:{{chip}}" bindtap="handleActionTap">{{chip}}</view>
            </view>
            <view wx:if="{{item.actions && item.actions.length}}" class="action-buttons message-actions">
              <view class="action-btn" wx:for="{{item.actions}}" wx:for-item="act" wx:for-index="ai" wx:key="ai" data-command="{{act.command}}" bindtap="handleActionTap">{{act.label}}</view>
            </view>
          </view>
          <view wx:if="{{item.agentForm}}" class="agent-task-form {{item.agentForm.kind === 'attachments_done' ? 'completed' : ''}}">
            <view class="agent-task-head">
              <view>
                <text class="agent-task-title">{{item.agentForm.title}}</text>
                <text wx:if="{{item.agentForm.hint}}" class="agent-task-hint">{{item.agentForm.hint}}</text>
              </view>
              <text class="agent-task-state">{{item.agentForm.kind === 'attachments_done' ? '已完成' : (item.agentForm.busy ? '处理中' : '待补全')}}</text>
            </view>

            <button class="agent-task-toggle" type="default" data-message="{{mi}}" bindtap="toggleAgentForm">
              <view class="agent-task-toggle-copy">
                <text class="agent-task-toggle-title">{{item.agentForm.kind === 'attachments_done' ? '查看补全信息' : '填写或核对信息'}}</text>
                <text class="agent-task-toggle-meta">{{item.agentForm.fields.length}} 项信息{{item.agentForm.attachments && item.agentForm.attachments.enabled ? ' · 含附件' : ''}}</text>
              </view>
              <view class="agent-task-toggle-action">
                <text>{{item.agentForm.expanded ? '收起' : (item.agentForm.kind === 'attachments_done' ? '查看' : '展开')}}</text>
                <text class="agent-task-toggle-arrow {{item.agentForm.expanded ? 'expanded' : ''}}">›</text>
              </view>
            </button>

            <view wx:if="{{item.agentForm.expanded}}" class="agent-task-body">
              <view wx:if="{{item.agentForm.filled && item.agentForm.filled.length}}" class="agent-task-read">
                <text class="agent-task-read-title">已从你的描述和照片读取</text>
                <view wx:for="{{item.agentForm.filled}}" wx:for-item="known" wx:key="label" class="agent-task-read-row">
                  <text>{{known.label}}</text><text>{{known.value}}</text>
                </view>
              </view>

              <view wx:if="{{item.agentForm.fields && item.agentForm.fields.length}}" class="agent-task-fields">
                <view wx:for="{{item.agentForm.fields}}" wx:for-item="field" wx:for-index="fieldIndex" wx:key="name" class="agent-task-field">
                  <text wx:if="{{field.showSection}}" class="agent-task-section">{{field.section}}</text>
                  <view class="agent-task-label"><text wx:if="{{field.required}}" class="agent-task-required">*</text><text>{{field.label}}</text></view>
                  <text wx:if="{{field.hint}}" class="agent-task-field-hint">{{field.hint}}</text>
                  <view wx:if="{{field.recommendation}}" class="agent-task-suggestion">
                    <text>建议 {{field.recommendation}}<text wx:if="{{field.reason}}"> · {{field.reason}}</text></text>
                    <text class="agent-task-suggestion-use" data-message="{{mi}}" data-field="{{field.name}}" data-value="{{field.recommendation}}" bindtap="chooseAgentFormOption">采用</text>
                  </view>
                  <picker wx:if="{{field.control === 'select'}}" range="{{field.options}}" data-message="{{mi}}" data-field="{{field.name}}" bindchange="onAgentFormPicker">
                    <view class="agent-task-control {{field.value ? '' : 'placeholder'}}">{{field.value || field.placeholder || '请选择'}}<text class="agent-task-control-caret">›</text></view>
                  </picker>
                  <picker wx:elif="{{field.control === 'date'}}" mode="date" value="{{field.value || '2000-01-01'}}" data-message="{{mi}}" data-field="{{field.name}}" bindchange="onAgentFormPicker">
                    <view class="agent-task-control {{field.value ? '' : 'placeholder'}}">{{field.value || '选择日期'}}<text class="agent-task-control-caret">›</text></view>
                  </picker>
                  <date-time-picker wx:elif="{{field.control === 'datetime'}}" value="{{field.value}}" reference-enabled="{{field.required}}" bind:change="onAgentFormDateTimeChange" data-message="{{mi}}" data-field="{{field.name}}" />
                  <date-time-picker wx:elif="{{field.control === 'time'}}" mode="time" value="{{field.value}}" reference-enabled="{{field.required}}" bind:change="onAgentFormDateTimeChange" data-message="{{mi}}" data-field="{{field.name}}" />
                  <textarea wx:elif="{{field.control === 'textarea'}}" class="agent-task-textarea" value="{{field.value}}" auto-height maxlength="-1" placeholder="{{field.placeholder || '填写' + field.label}}" data-message="{{mi}}" data-field="{{field.name}}" bindinput="onAgentFormInput" />
                  <input wx:else class="agent-task-control" type="{{field.control === 'number' ? 'number' : 'text'}}" value="{{field.value}}" placeholder="{{field.placeholder || '填写' + field.label}}" data-message="{{mi}}" data-field="{{field.name}}" bindinput="onAgentFormInput" />
                </view>
              </view>

              <view wx:if="{{item.agentForm.attachments && item.agentForm.attachments.enabled}}" class="agent-task-upload">
                <view class="agent-task-upload-head"><text>{{item.agentForm.attachments.label}}</text><text>{{item.agentForm.attachments.picked.length}}/{{item.agentForm.attachments.max}}</text></view>
                <text class="agent-task-field-hint">{{item.agentForm.attachments.hint}}</text>
                <view class="agent-task-photos" wx:if="{{item.agentForm.attachments.picked.length}}">
                  <view wx:for="{{item.agentForm.attachments.picked}}" wx:for-item="photo" wx:key="id" class="agent-task-photo">
                    <image src="{{photo.path}}" mode="aspectFill" />
                    <view class="agent-task-photo-remove" data-message="{{mi}}" data-id="{{photo.id}}" catchtap="removeAgentFormAttachment">×</view>
                  </view>
                </view>
                <view class="agent-task-upload-box {{item.agentForm.busy ? 'disabled' : ''}}" data-message="{{mi}}" bindtap="chooseAgentFormAttachments">
                  <text class="agent-task-upload-plus">＋</text>
                  <text>点击拍照或从相册上传</text>
                </view>
              </view>

              <view wx:if="{{item.agentForm.kind !== 'attachments_done'}}" class="agent-task-submit-row">
                <button class="agent-task-submit" loading="{{item.agentForm.busy}}" disabled="{{item.agentForm.busy}}" data-message="{{mi}}" bindtap="submitAgentForm">{{item.agentForm.busy ? '提交中' : (item.agentForm.submit_label === '保存记录' ? '保存并生成记录' : (item.agentForm.submit_label || '提交'))}}</button>
                <text wx:if="{{item.agentForm.skippable}}" class="agent-task-skip" data-message="{{mi}}" bindtap="skipAgentForm">暂时跳过</text>
              </view>
              <view wx:if="{{item.agentForm.actions && item.agentForm.actions.length}}" class="agent-task-links">
                <text wx:for="{{item.agentForm.actions}}" wx:for-item="formAction" wx:key="label" class="agent-task-link" data-type="{{formAction.type}}" data-url="{{formAction.url}}" data-record-id="{{formAction.record_id}}" data-command="{{formAction.command}}" bindtap="handleAgentFormAction">{{formAction.label}}</text>
              </view>
            </view>
          </view>
          <!-- 工作记录字段候选：点选即填入，不符合的走「自己填写」 -->
          <view wx:if="{{item.commands && item.commands.length}}" class="field-groups">
            <view class="field-group" wx:for="{{item.commands}}" wx:for-item="grp" wx:key="field">
              <text class="field-label">{{grp.label}}</text>
              <view class="field-chips">
                <view class="field-chip" wx:for="{{grp.options}}" wx:for-item="opt" wx:key="*this"
                      data-command="work-field:{{grp.field}}:{{opt}}" bindtap="handleActionTap">{{opt}}</view>
                <view class="field-chip ghost" data-command="work-field-manual:{{grp.field}}" bindtap="handleActionTap">自己填写</view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{loading && activeProgressIndex < 0}}" class="message assistant typing-message">
        <view class="bubble typing">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
      <view id="bottom"></view>
    </scroll-view>
  </view>

  <!-- Quick Entry 已移除（2026-10-09：工作记录/规范文书气泡删除，入口走底栏与「+」面板） -->

  <!-- 待补传语音（PRD 19.5：录音上传失败进队列，可重试或取消） -->
  <view wx:if="{{pendingVoiceCount}}" class="pending-voice">
    <text class="pv-text">有 {{pendingVoiceCount}} 段语音未上传成功</text>
    <view class="pv-actions">
      <button class="pv-btn" size="mini" loading="{{pendingVoiceRetrying}}" disabled="{{pendingVoiceRetrying}}" bindtap="retryPendingVoice">重试</button>
      <button class="pv-btn" size="mini" disabled="{{pendingVoiceRetrying}}" bindtap="discardPendingVoice">取消</button>
    </view>
  </view>

  <!-- Input Card（上：输入框 + 常驻发送；下：左 + / 模型下拉，右 麦克风） -->
  <view class="input-bar">
    <view class="input-card">
      <!-- 附件暂存区：多图/多文件先挂这里，可继续补文字，再一次性发送识别 -->
      <view class="attach-strip" wx:if="{{attachments.length}}">
        <view class="attach-item" wx:for="{{attachments}}" wx:key="id">
          <image wx:if="{{item.kind === 'image'}}" class="attach-thumb" src="{{item.path}}" mode="aspectFill"
                 data-index="{{index}}" bindtap="previewAttachment" />
          <view wx:else class="attach-file">
            <text class="attach-file-ext">{{item.ext || 'FILE'}}</text>
          </view>
          <view class="attach-del" data-index="{{index}}" catchtap="removeAttachment">×</view>
        </view>
        <view class="attach-count">{{attachments.length}} 个待识别</view>
      </view>

      <!-- 第一行：文本输入 + 发送按钮（常驻在右侧） -->
      <view class="input-line">
        <view class="input-wrapper {{recording ? 'recording' : ''}}"
              bindtouchstart="onInputTouchStart"
              bindtouchend="onInputTouchEnd"
              bindtouchcancel="onInputTouchCancel">
          <textarea wx:if="{{!recording}}"
            class="chat-input chat-textarea"
            focus="{{draftFocus}}"
            value="{{input}}"
            placeholder="{{attachments.length ? '可补充说明，再点发送' : (noProject ? '问我规范、工艺、天气都行；记录现场工作需先加入项目' : '发消息或按住说话')}}"
            placeholder-class="input-placeholder"
            bindinput="onInput"
            maxlength="-1"
            auto-height
            show-confirm-bar="{{false}}"
          />
          <view wx:else class="recording-hint">
            <view class="rec-dot"></view>
            <text>录音中…松开发送</text>
          </view>
          <!-- 🔴 2026-10-21 上面的 textarea 去掉了 disabled="{{!projectCreated}}"：
               无项目时后端 /agent/chat 对 read 类工具（查规范/查天气/查记录）照常放行、
               对 write 类工具返回「去加入项目」导航卡，前端把输入框整个禁掉等于把这套
               降级能力全埋没，裸用户连问一句规范都做不到。
               注：本注释放在 wx:if/wx:else **结构之外**——WXML 要求 wx:if 与 wx:else
               必须是相邻兄弟节点，中间插注释会导致 wx:else 匹配不到 wx:if。 -->
        </view>
      </view>

      <!-- 第二行：左「+」，右「模型▾ / 麦克风 / 发送箭头」（仿 Auto Mode 排版） -->
      <view class="input-card-row">
        <view class="round-btn round-btn-lg ic-plus-g" bindtap="togglePlusPanel"></view>
        <view class="flex-spacer"></view>
        <view class="model-chip" bindtap="toggleModelMenu">
          <view class="scope-chip-icon ic-model"></view>
          <text class="scope-chip-label">模型</text>
          <text class="scope-chip-caret">{{showModelMenu ? '▴' : '▾'}}</text>
        </view>
        <!-- 麦克风：按住说话、松手结束（与输入框一致；touchcancel 也按松手处理，避免滑出丢话） -->
        <view wx:if="{{!input && !attachments.length}}" class="round-btn {{recording ? 'ic-stop recording' : 'ic-mic'}}"
              bindtouchstart="onMicTouchStart" bindtouchend="onMicTouchEnd" bindtouchcancel="onMicTouchEnd"></view>
        <view class="send-fab {{canSend ? 'active' : ''}}" bindtap="send">
          <view class="send-fab-ic"></view>
        </view>
        <view wx:if="{{showModelMenu}}" class="model-mask" bindtap="toggleModelMenu"></view>
        <view class="model-menu" wx:if="{{showModelMenu}}">
          <view class="model-menu-item {{currentModel === item.id ? 'active' : ''}}"
                wx:for="{{models}}" wx:key="id" data-model="{{item.id}}" bindtap="selectModel">
            <view class="model-menu-row1">
              <text class="model-menu-name">{{item.name}}</text>
              <text wx:if="{{currentModel === item.id}}" class="model-menu-check">✓</text>
            </view>
            <text class="model-menu-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== Overlays ========== -->

  <!-- Project Form Overlay（新建 / 修改项目概况共用） -->
  <view class="overlay" wx:if="{{showProjectForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="cancelProject"></view>
    <view class="overlay-panel project-panel">
      <view class="panel-header">
        <text class="panel-title">{{projectFormMode === 'edit' ? '修改项目概况' : '创建新项目'}}</text>
        <text class="panel-subtitle">{{projectFormMode === 'edit' ? '更新后会同步到侧边栏与看板' : '填写项目信息后开始工作'}}</text>
      </view>
      <view class="form-group">
        <text class="form-label">项目名称 *</text>
        <input class="form-input" value="{{projectForm.projectName}}" placeholder="请输入项目名称" data-field="projectName" bindinput="onProjectFormInput" />
      </view>
      <view class="form-group">
        <text class="form-label">项目地点</text>
        <input class="form-input" value="{{projectForm.location}}" placeholder="请输入项目地点" data-field="location" bindinput="onProjectFormInput" />
      </view>
      <view class="form-group">
        <text class="form-label">施工单位</text>
        <input class="form-input" value="{{projectForm.constructionUnit}}" placeholder="施工单位名称（文书「施工单位」栏自动带出）" data-field="constructionUnit" bindinput="onProjectFormInput" />
      </view>
      <view class="form-group">
        <text class="form-label">监理单位</text>
        <input class="form-input" value="{{projectForm.supervisionUnit}}" placeholder="监理单位名称（文书「监理单位」栏自动带出）" data-field="supervisionUnit" bindinput="onProjectFormInput" />
      </view>
      <view class="form-group">
        <text class="form-label">项目描述</text>
        <textarea class="form-textarea" value="{{projectForm.description}}" placeholder="项目描述（工程规模、参建单位等，可选）" data-field="description" bindinput="onProjectFormInput" auto-height maxlength="200" />
      </view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="cancelProject">取消</button>
        <button class="btn-submit" loading="{{loading}}" disabled="{{loading}}" bindtap="submitProject">{{projectFormMode === 'edit' ? '保存修改' : '创建项目'}}</button>
      </view>
    </view>
  </view>

  <!-- 模型选择（原来的整屏 overlay 已改为输入区内的下拉气泡，见下方 input-card） -->

  <!-- Plus Panel（+）：只保留 图片 / 拍照 / 文件 / 微信文件（2026-10-09 精简，其余入口走底栏与左侧抽屉） -->
  <view class="overlay" wx:if="{{showPlusPanel}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeOverlay"></view>
    <view class="menu-panel">
      <view class="menu-grid menu-grid-4">
        <view class="menu-item" data-source="album" bindtap="selectImage"><view class="menu-icon ic-image"></view><text class="menu-text">图片</text></view>
        <view class="menu-item" data-source="camera" bindtap="selectImage"><view class="menu-icon ic-camera"></view><text class="menu-text">拍照</text></view>
        <view class="menu-item" bindtap="pickLocalFile"><view class="menu-icon ic-docadd"></view><text class="menu-text">文件</text></view>
        <view class="menu-item" bindtap="pickWechatFile"><view class="menu-icon ic-docadd"></view><text class="menu-text">微信文件</text></view>
      </view>
    </view>
  </view>

  <!-- Daily Log Dialog -->
  <view class="overlay" wx:if="{{showLogDialog}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeOverlay"></view>
    <view class="overlay-panel project-panel">
      <view class="panel-header"><text class="panel-title">生成监理日志</text></view>
      <view class="form-group">
        <text class="form-label">选择日期</text>
        <picker mode="date" value="{{logDate}}" bindchange="onLogDateChange">
          <view class="form-input picker-value">{{logDate}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">天气</text>
        <picker range="{{weatherOptions}}" bindchange="onLogWeatherChange">
          <view class="form-input picker-value">{{logWeather || '请选择'}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">最低气温(℃)</text>
        <input class="form-input" type="digit" value="{{logTempLow}}" data-field="logTempLow" bindinput="onLogTempInput" placeholder="请输入最低气温" />
      </view>
      <view class="form-group">
        <text class="form-label">最高气温(℃)</text>
        <input class="form-input" type="digit" value="{{logTempHigh}}" data-field="logTempHigh" bindinput="onLogTempInput" placeholder="请输入最高气温" />
      </view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="closeOverlay">取消</button>
        <button class="btn-submit" loading="{{logGenerating}}" disabled="{{logGenerating}}" bindtap="submitDailyLog">生成</button>
      </view>
    </view>
  </view>

  <!-- Voice Session Overlay（语音拍照自动创建工作记录） -->
  <view class="overlay" wx:if="{{voiceSessionActive}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeOverlay"></view>
    <view class="overlay-panel project-panel work-form-panel">
      <view class="panel-header">
        <text class="panel-title">语音记录现场工作</text>
      </view>
      <view class="form-group">
        <text class="form-label">语音片段</text>
        <view class="voice-session-texts">
          <view class="voice-session-item" wx:for="{{voiceSessionTexts}}" wx:key="index">
            <text class="voice-session-num">{{index + 1}}.</text>
            <text class="voice-session-content">{{item}}</text>
          </view>
          <view wx:if="{{!voiceSessionTexts.length}}" class="voice-session-empty">{{voiceWorkPending ? '请按住说话补充信息…' : '暂无语音片段，按住下方按钮开始说话'}}</view>
        </view>
      </view>
      <view class="voice-session-actions">
        <view class="voice-hold-btn {{recording ? 'recording' : ''}}" bindtouchstart="startRecord" bindtouchend="stopRecord" bindtouchcancel="stopRecord">{{recording ? '松开结束' : '按住说话'}}</view>
      </view>
      <view class="voice-session-footer">
        <button size="mini" bindtap="clearVoiceSession" wx:if="{{voiceSessionTexts.length}}" plain>清空</button>
        <button class="btn-submit" size="mini" bindtap="autoCreateWorkSession" loading="{{voiceWorkCreating}}" disabled="{{!voiceSessionTexts.length || voiceWorkCreating || voiceWorkPending}}" wx:if="{{!voiceWorkPending}}">完成记录</button>
      </view>
    </view>
  </view>

  <!-- Task Dispatch Form -->
  <view class="overlay" wx:if="{{showTaskForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeOverlay"></view>
    <view class="overlay-panel project-panel">
      <view class="panel-header"><text class="panel-title">新建派单</text></view>
      <view class="form-group"><text class="form-label">任务标题 *</text><input class="form-input" value="{{taskForm.title}}" data-field="title" bindinput="onTaskFormInput" placeholder="请输入任务标题" /></view>
      <view class="form-group"><text class="form-label">任务描述</text><textarea class="form-textarea" value="{{taskForm.description}}" data-field="description" bindinput="onTaskFormInput" placeholder="请输入任务描述" auto-height /></view>
      <view class="form-group">
        <text class="form-label">指派给</text>
        <picker range="{{assignableUsers}}" range-key="real_name" bindchange="onTaskAssigneeChange">
          <view class="form-input picker-value">请选择执行人</view>
        </picker>
      </view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="closeOverlay">取消</button>
        <button class="btn-submit" loading="{{taskSubmitting}}" disabled="{{taskSubmitting}}" bindtap="submitTaskForm">派单</button>
      </view>
    </view>
  </view>

  <!-- Document Form -->
  <view class="overlay" wx:if="{{showDocForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeOverlay"></view>
    <view class="overlay-panel project-panel work-form-panel">
      <view class="panel-header"><text class="panel-title">新建监理文书</text></view>
      <view class="form-group">
        <text class="form-label">文书类型</text>
        <picker range="{{docTypes}}" bindchange="onDocTypeChange">
          <view class="form-input picker-value">{{docForm.doc_type}}</view>
        </picker>
      </view>
      <view class="form-group"><text class="form-label">标题 *</text><input class="form-input" value="{{docForm.title}}" data-field="title" bindinput="onDocFormInput" placeholder="请输入文书标题" /></view>
      <view class="form-group">
        <text class="form-label">内容</text>
        <textarea class="form-textarea content-area" value="{{docForm.content}}" data-field="content" bindinput="onDocFormInput" placeholder="请输入文书内容" auto-height />
        <view class="ai-polish-btn" bindtap="polishDocContent">
          <text class="ai-polish-icon">✨</text>
          <text class="ai-polish-text">{{docPolishing ? 'AI润色中...' : 'AI润色'}}</text>
        </view>
      </view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="closeOverlay">取消</button>
        <button class="btn-submit" loading="{{docSubmitting}}" disabled="{{docSubmitting}}" bindtap="submitDocForm">保存</button>
      </view>
    </view>
  </view>

  <!-- History / Menu Drawer -->
  <view class="overlay history-overlay" wx:if="{{showHistory}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeHistory"></view>
    <view class="history-panel" style="padding-top: {{statusBarHeight + 7}}px;">
      <view class="history-top">
        <view class="history-new" bindtap="newChat">
          <view class="side-icon ic-plus"></view>
          <text class="history-new-text">新建对话</text>
        </view>
      </view>
      <scroll-view scroll-y class="drawer-scroll">
        <view class="drawer-group">
          <!-- 整卡可点：进「修改项目概况」（名称/地点/描述） -->
          <view class="drawer-static project-summary-card" bindtap="openProjectEdit">
            <view class="project-card-head">
              <text class="drawer-title project-card-title">项目概况</text>
              <view class="project-card-edit">
                <text class="project-card-edit-text">修改</text>
                <view class="drawer-arrow edit-arrow"></view>
              </view>
            </view>
            <text class="drawer-project-name">{{projectName || '未绑定项目'}}</text>
            <text class="drawer-loc" wx:if="{{projectLocation}}">{{projectLocation}}</text>
            <text class="drawer-desc">{{projectSummary || '暂无项目描述，点击这里补充'}}</text>
          </view>
        </view>

        <view class="drawer-group">
          <view class="drawer-head" data-group="docs" bindtap="toggleDrawerGroup">
            <text class="drawer-title">工作文书</text>
            <view class="drawer-arrow {{drawerDocsExpanded ? 'open' : ''}}"></view>
          </view>
          <block wx:if="{{drawerDocsExpanded}}">
            <!-- 材料台账：二级可折叠目录（「文书档案」入口已移到「+」面板「规范文书」，同一页面不重复提供） -->
            <view class="drawer-nav" data-group="ledger" bindtap="toggleDrawerGroup">
              <view class="drawer-nav-icon ic-list"></view>
              <text class="drawer-nav-text">材料台账</text>
              <view class="drawer-arrow {{drawerLedgerExpanded ? 'open' : ''}}"></view>
            </view>
            <view class="drawer-sub" wx:if="{{drawerLedgerExpanded}}">
              <view class="drawer-nav" data-url="/pages/documents/index?tab=ledger" bindtap="navigateTo">
                <view class="drawer-nav-icon ic-list"></view>
                <text class="drawer-nav-text">台账总览</text>
              </view>
              <view
                class="drawer-nav"
                wx:for="{{docEntries}}"
                wx:key="key"
                data-url="{{item.url}}"
                bindtap="navigateTo">
                <view class="drawer-nav-icon ic-list"></view>
                <text class="drawer-nav-text">{{item.label}}</text>
              </view>
            </view>
          </block>
        </view>

        <!-- 「资料库」整组已撤（2026-10-08）：
             - 「共享资料库」＝底部 tab「资料库」，本页「+」面板亦已有同名入口，无重复必要；
             - 「规范资料库」「我的笔记」唯一入口原在此处，已改挂到「+」面板，避免失去入口。 -->

        <!-- 「现场工具」整组（AI 隐患识别 / 现场采集 / AI 巡检 / 隐患管理 / 工作记录 / AI 工坊 / 待办任务）
             与「+」面板逐项重复，2026-09-30 去重后统一由「+」面板提供，侧栏不再重复 -->

        <view class="drawer-group" style="margin-top: 12rpx; padding-top: 24rpx; border-top: 1rpx solid #eef3f0;">
          <view class="drawer-head" data-group="history" bindtap="toggleDrawerGroup">
            <text class="drawer-title">历史对话</text>
            <view class="drawer-arrow {{drawerHistoryExpanded ? 'open' : ''}}"></view>
          </view>
          <block wx:if="{{drawerHistoryExpanded}}">
            <view class="history-item" wx:for="{{historyList}}" wx:key="id" data-id="{{item.id}}" bindtap="loadHistoryItem">
              <view class="history-main">
                <text class="history-title">{{item.title}}</text>
                <text class="history-time">{{item.updatedAt}}</text>
              </view>
              <view class="history-del" catchtap="deleteHistoryItem" data-id="{{item.id}}">删除</view>
            </view>
            <view class="history-empty" wx:if="{{historyList.length === 0}}">暂无历史对话</view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Project Picker Overlay -->
  <view class="overlay" wx:if="{{showProjectPicker}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeProjectPicker"></view>
    <view class="overlay-panel project-picker-panel">
      <view class="panel-header">
        <text class="panel-title">切换项目</text>
        <text class="panel-subtitle">选择要切换到的项目</text>
      </view>
      <scroll-view scroll-y class="project-picker-list">
        <view class="project-item {{item.id === currentProjectId ? 'active' : ''}}" wx:for="{{projectList}}" wx:key="id" data-id="{{item.id}}" bindtap="pickProject">
          <view class="project-item-main">
            <text class="project-item-name">{{item.name}}</text>
            <text class="project-item-code">{{item.code}}</text>
          </view>
          <text class="project-item-check" wx:if="{{item.id === currentProjectId}}">✓</text>
        </view>
        <view class="project-empty" wx:if="{{projectList.length === 0}}">暂无项目</view>
      </scroll-view>
      <view class="project-picker-foot">
        <view class="picker-add-btn" bindtap="openProjectCreate">
          <text class="picker-add-plus">+</text>
          <text class="picker-add-text">新建项目</text>
        </view>
      </view>
    </view>
  </view>
  <view class="overlay" wx:if="{{showWorkForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeOverlay"></view>
    <view class="overlay-panel work-form-panel">
      <view class="panel-header"><text class="panel-title">现场记录（补全后保存）</text></view>
      <scroll-view scroll-y style="max-height:65vh;">
        <view class="form-group" wx:for="{{workFormFields}}" wx:key="key">
          <text class="form-label">{{item.label}}</text>
          <picker wx:if="{{item.key === 'acceptance_result' || item.key === 'witness_accept_result'}}" range="{{['合格','不合格','待整改']}}" data-field="{{item.key}}" data-options="{{['合格','不合格','待整改']}}" bindchange="onWorkFormPickerChange"><view class="form-input">{{workForm[item.key] || '请人工确认'}}</view></picker>
          <picker wx:elif="{{item.key === 'record_date'}}" mode="date" value="{{workForm[item.key]}}" data-field="{{item.key}}" bindchange="onWorkFormDateChange"><view class="form-input">{{workForm[item.key] || '选择业务日期'}}<text class="agent-task-control-caret">›</text></view></picker>
          <date-time-picker wx:elif="{{item.key === 'inspection_start_time' || item.key === 'inspection_end_time' || item.key === 'start_time' || item.key === 'end_time'}}" value="{{workForm[item.key]}}" reference-date="{{workForm.record_date}}" reference-enabled="{{item.key !== 'inspection_end_time'}}" data-field="{{item.key}}" bind:change="onWorkFormDateTimeChange" />
          <textarea wx:else class="form-textarea" value="{{workForm[item.key]}}" data-field="{{item.key}}" bindinput="onWorkFormInput" auto-height maxlength="5000" />
        </view>
      </scroll-view>
      <view class="panel-actions"><button bindtap="closeOverlay">取消</button><button loading="{{workFormSubmitting}}" disabled="{{workFormSubmitting}}" bindtap="submitWorkForm">保存并生成记录</button></view>
    </view>
  </view>
</view>
