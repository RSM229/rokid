/* 玻璃拟态（浅色版）—— 与注册页同一视觉语言 */
.page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8a8f8c;
}

.steps {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.step {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8a8f8c;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #ffffff;
}

.step.active {
  color: #fff;
  background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df));
}

.form {
  background: #ffffff;
  border: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.4), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20, 70, 140), 0.16);
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--deep-rgb, 10, 46, 92), 0.08);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.input {
  width: 100%;
  height: 72rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.notice {
  margin: 8rpx 0;
  padding: 16rpx 20rpx;
  background: rgba(47,50,55, 0.06);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #666;
}

.error {
  color: #e74c3c;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: rgba(255, 255, 255, 0.5);
  color: #555;
  font-size: 32rpx;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-plain::after {
  border: none;
}

.done {
  padding: 48rpx 0;
  text-align: center;
}

.done-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  color: #fff;
  font-size: 56rpx;
  background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df));
}

.done-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.done-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a8f8c;
}

.footer {
  text-align: center;
  font-size: 28rpx;
  color: #8a8f8c;
}

.link {
  color: var(--brand, #2f3237);
}
