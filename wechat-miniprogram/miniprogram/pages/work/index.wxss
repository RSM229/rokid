/* 玻璃拟态改造（浅色版） */
.toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.toolbar button { margin: 0; }
.toolbar-right { display: flex; align-items: center; gap: 16rpx; }
.time-btn { padding: 10rpx 20rpx; border-radius: 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.8); color: var(--brand, #2f3237); font-size: 24rpx; font-weight: 600; }
.select-btn { padding: 10rpx 20rpx; border-radius: 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.8); color: var(--brand, #2f3237); font-size: 24rpx; font-weight: 600; }
.type-tabs-container { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; overflow-x: auto; white-space: nowrap; }
.type-tab { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 28rpx; border-radius: 28rpx; background: rgba(243, 246, 244, 0.75); color: #8a94a6; font-size: 26rpx; font-weight: 500; flex-shrink: 0; }
.type-tab.active { background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); color: #fff; font-weight: 600; }
.arrow { font-size: 22rpx; transition: transform 0.2s; }
.arrow.up { transform: rotate(90deg); }
.type-tabs-expand { display: flex; gap: 16rpx; }
.select-hint { padding: 16rpx 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.8); color: var(--brand, #2f3237); font-size: 24rpx; border-radius: 12rpx; margin-bottom: 16rpx; text-align: center; }
.record-head { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 16rpx; align-items: center; }
.type { font-size: 32rpx; font-weight: 600; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status { color: var(--brand, #2f3237); font-size: 24rpx; flex-shrink: 0; }
.record-desc { font-size: 26rpx; color: var(--ink-2, #243b55); margin-bottom: 8rpx; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; }
.actions button { margin: 0; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 9; background: rgba(20,40,60, 0.35); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; max-height: 82vh; overflow-y: auto; padding: 32rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #ffffff; border-top: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); box-shadow: 0 -8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.close { padding: 0 16rpx; color: #8a94a6; font-size: 56rpx; line-height: 1; }
.sheet-item { padding: 22rpx 24rpx; border-radius: 16rpx; background: #ffffff; border: 2rpx solid rgba(255,255,255,0.60); margin-bottom: 16rpx; font-size: 28rpx; color: var(--ink, #11131a); }
.sheet-item.active { background: rgba(var(--wash-rgb, 234,243,255), 0.9); color: var(--brand, #2f3237); font-weight: 600; }
.sheet-item:active { opacity: 0.85; }

/* ---- 隐患卡片 ---- */
.hazard { padding: 0; }
.hazard .status { padding: 5rpx 13rpx; border-radius: 12rpx; color: #9b351f; background: rgba(254, 233, 226, 0.85); font-size: 22rpx; }
.photo { width: 100%; height: 330rpx; background: rgba(222,230,240, 0.7); }
.hazard-content { flex: 1; min-width: 0; overflow: hidden; padding: 26rpx; }
.hazard-content .muted { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 14rpx; }
.hazard-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 32rpx; font-weight: 600; }
.evidence { margin-top: 16rpx; color: var(--ink-2, #243b55); font-size: 24rpx; line-height: 1.65; }

/* ---- 卡片选择模式 ---- */
.card { display: flex; align-items: flex-start; padding: 0; background: #ffffff; border: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); }
.record-checkbox-inline { display: flex; align-items: flex-start; padding: 24rpx 0 0 24rpx; flex-shrink: 0; }
.card-content { flex: 1; min-width: 0; overflow: hidden; padding: 24rpx; }
/* flex 子项默认 min-width:auto 会被长文本撑出卡片，收窄后单行省略才生效 */
.card-content .muted { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 右侧 ⋯ 菜单绝对定位在卡片中部，正文留白避免压住 chips / 操作行 */
.record .card-content { padding-right: 64rpx; }

/* ---- 结构化记录卡（时间+部位+事项 / 状态可见 / 摘要已清洗 / 一键补填成文） ---- */
.rec-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; }
.rec-time { font-size: 22rpx; color: #8795a6; flex-shrink: 0; }
.hazard-time { font-size: 22rpx; color: #8795a6; margin-bottom: 10rpx; }
.rec-chips { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.rec-chip { padding: 5rpx 14rpx; border-radius: 10rpx; font-size: 22rpx; font-weight: 600; line-height: 1.35; }
.rec-chip.rec-type { color: #2f6fd0; background: rgba(47, 111, 208, 0.12); }
.rec-chip.rec-status { color: #8a6a1f; background: rgba(224, 169, 62, 0.20); }
.rec-chip.rec-status.done { color: #13795b; background: rgba(19, 121, 91, 0.12); }
.rec-chip.rec-status.pending { color: #2f6fd0; background: rgba(47, 111, 208, 0.12); }
.rec-chip.rec-status.warn { color: #b23c2c; background: rgba(220, 82, 62, 0.12); }
.rec-title { font-size: 32rpx; font-weight: 600; color: var(--ink, #11131a); line-height: 1.35; margin-bottom: 8rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.rec-meta { font-size: 22rpx; color: #8795a6; margin-bottom: 14rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rec-summary { font-size: 24rpx; color: var(--ink-2, #243b55); line-height: 1.65; margin-bottom: 18rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.rec-foot { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10, 46, 92), 0.08); }
.rec-missing { font-size: 22rpx; color: #b26a12; font-weight: 600; padding: 6rpx 0; }
.rec-complete { font-size: 22rpx; color: #13795b; }
.rec-missing:active { opacity: 0.6; }

.card-menu { position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: #9aa9bc; padding: 10rpx; z-index: 5; }
.card-menu:active { color: var(--brand, #2f3237); }

/* ---- 批量操作栏 ---- */
.batch-bar { position: fixed; left: 0; right: 0; bottom: calc(122rpx + env(safe-area-inset-bottom)); z-index: 20; display: flex; flex-direction: column; gap: 14rpx; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); box-shadow: 0 -4rpx 20rpx rgba(var(--deep-rgb, 10,46,92), 0.10); }
.batch-top { display: flex; align-items: center; justify-content: space-between; }
.batch-info { font-size: 26rpx; color: #8a94a6; }
.batch-select-all { font-size: 26rpx; color: var(--brand, #2f3237); font-weight: 600; padding: 4rpx 16rpx; }
.batch-select-all:active { opacity: 0.7; }
.batch-actions { display: flex; gap: 16rpx; justify-content: flex-end; }
.batch-actions button { padding: 14rpx 32rpx; border-radius: 24rpx; font-size: 26rpx; font-weight: 600; }
.batch-actions button.primary { background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); color: #fff; }
.batch-actions button.danger { background: #ffffff; color: #c53030; border: 1rpx solid #c53030; }

/* ---- 记录菜单 ---- */
.menu-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); border-radius: 32rpx 32rpx 0 0; box-shadow: 0 -4rpx 20rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.menu-item { display: flex; align-items: center; padding: 20rpx 0; font-size: 28rpx; color: var(--ink, #11131a); border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.menu-item:last-child { border-bottom: none; }
.menu-item.cancel { margin-top: 16rpx; color: #8a94a6; font-weight: 500; border-bottom: none; }
.menu-item[danger="true"] { color: #c53030; }

/* ---- 详情弹窗 ---- */
.detail-sheet { position: fixed; left: 0; right: 0; top: 88px; bottom: 0; z-index: 10; display: flex; flex-direction: column; background: #ffffff; border-top: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); border-radius: 32rpx 32rpx 0 0; }
/* detail-sheet 本体无 padding，标题行单独留边（.sheet 自带 padding，此处不共用） */
.detail-sheet .sheet-head { padding: 24rpx 30rpx 8rpx; }
/* 文书入口按钮样式 .doc-btn / .doc-btn-row 已上收 app.wxss（work 详情与 documents 详情共用） */
/* box-sizing 必须显式：scroll-view 作为 flex 子项 stretch 后 padding 会撑出容器，
   真机实测 390px 屏 scroll-view 被撑到 420px，右侧卡片被裁掉 30px */
.detail-scroll { flex: 1; overflow-y: auto; padding: 24rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; width: 100%; min-width: 0; }
.detail-section { background: #ffffff; border: 2rpx solid rgba(255,255,255,0.60); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.detail-title { font-size: 28rpx; font-weight: 600; color: var(--ink, #11131a); margin-bottom: 16rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.detail-row { display: flex; align-items: flex-start; padding: 12rpx 0; }
.detail-label { width: 160rpx; font-size: 24rpx; color: #8a94a6; flex-shrink: 0; }
.detail-value { flex: 1; font-size: 24rpx; color: var(--ink, #11131a); word-break: break-all; line-height: 1.65; white-space: pre-wrap; }
.status-tag { color: var(--brand, #2f3237); font-weight: 600; }
.detail-empty { color: #9aa9bc; font-size: 22rpx; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.detail-photo { width: 210rpx; height: 210rpx; border-radius: 12rpx; background: rgba(222,230,240, 0.7); }
.evidence-list { margin-top: 18rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), .08); }
.evidence-item { display: flex; flex-direction: column; gap: 4rpx; padding: 12rpx 0 0; }
.evidence-index { color: var(--ink, #11131a); font-size: 22rpx; font-weight: 600; }
.evidence-meta { color: #8a94a6; font-size: 22rpx; line-height: 1.35; }
.form-choice-hint { display: block; color: #8a94a6; font-size: 22rpx; line-height: 1.5; margin-bottom: 14rpx; }
.form-choice-list { display: flex; flex-direction: column; gap: 10rpx; }
.form-choice { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid rgba(var(--deep-rgb, 10,46,92), .10); border-radius: 12rpx; background: rgba(255,255,255,.34); }
.form-choice.selected { border-color: var(--brand, #2f3237); background: rgba(var(--wash-rgb, 234,243,255), .9); }
.form-choice-main { min-width: 0; flex: 1; }.form-choice-name { display: block; color: var(--ink, #11131a); font-size: 24rpx; }.form-choice-number { display: block; color: #8795a6; font-size: 22rpx; margin-top: 3rpx; }.form-choice-check { width: 30rpx; color: var(--brand, #2f3237); font-size: 32rpx; text-align: center; }
.form-choice-section .doc-btn { margin-top: 16rpx; width: 100%; }
/* 按需生成表单默认收起：标题行即折叠开关（2026-11-12） */
.form-choice-toggle { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.form-choice-toggle:active { opacity: .65; }
.form-choice-toggle-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.form-choice-toggle-title { font-size: 28rpx; font-weight: 600; color: var(--ink, #11131a); }
.form-choice-count { font-size: 22rpx; font-weight: 400; color: #8795a6; }
.form-choice-toggle-meta { font-size: 22rpx; color: #8795a6; }
.form-choice-arrow { flex: none; font-size: 32rpx; line-height: 1; color: #8a94a6; transition: transform .18s ease; }
.form-choice-arrow.expanded { transform: rotate(90deg); }
.form-choice-body { margin-top: 20rpx; }

/* ---- 报告生成弹窗 ---- */
.report-options { margin-top: 20rpx; }
.report-type { display: flex; align-items: center; gap: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #ffffff; margin-bottom: 16rpx; border: 2rpx solid transparent; }
.report-type:active { background: #ffffff; }
.report-type.selected { border-color: var(--brand, #2f3237); background: rgba(var(--wash-rgb, 234,243,255), 0.9); }
.type-icon { font-size: 48rpx; }
.type-info { flex: 1; }
.type-name { font-size: 28rpx; font-weight: 600; color: var(--ink, #11131a); }
.type-desc { font-size: 24rpx; color: #8a94a6; margin-top: 4rpx; }
.type-check { font-size: 32rpx; color: var(--brand, #2f3237); display: none; }
.report-type.selected .type-check { display: block; }
.report-date { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; padding: 16rpx 0; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.report-date text { width: 120rpx; font-size: 26rpx; color: #8a94a6; }
.report-date input { flex: 1; font-size: 26rpx; color: var(--ink, #11131a); }
.report-options-row { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.checkbox-label { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: var(--ink, #11131a); }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.sheet-actions button { flex: 1; padding: 18rpx 0; border-radius: 28rpx; font-size: 28rpx; font-weight: 600; }
.sheet-actions button.primary { background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); color: #fff; }

/* ---- 编辑弹窗 ---- */
.edit-scroll { max-height: 50vh; }
.edit-field { width: 100%; height: 88rpx; min-height: 88rpx; margin-bottom: 16rpx; padding: 0 20rpx; border-radius: 12rpx; border: 1rpx solid rgba(255,255,255,0.34); font-size: 26rpx; color: var(--ink, #11131a); box-sizing: border-box; background: #ffffff; }
.edit-picker-value { display: flex; align-items: center; justify-content: space-between; line-height: 88rpx; }
.edit-field-label { display: block; margin: 2rpx 0 9rpx; color: var(--ink-3, #8a94a6); font-size: 22rpx; }
/* 高度必须显式声明：原生 input 带基础库注入的 height/min-height:1.4rem（=22.4px），
   仅写 padding 会被内边距吃光内容区，文字被裁切（同 app.wxss 的 .field）。
   多行版给 150px = 300rpx：基础库 wx-textarea 默认就是 150px，且内层 textarea 绝对定位，
   写 height:auto 会塌陷。 */
.edit-field.textarea { height: 300rpx; min-height: 300rpx; padding: 16rpx 20rpx; line-height: 1.65; }
.edit-field:focus { border-color: var(--brand, #2f3237); outline: none; }
/* 具体位置 + 定位按钮同行：输入框吃掉剩余宽度，按钮取可读地址回填 */
.edit-location-row { display: flex; align-items: center; gap: 12rpx; }
.edit-location-row .edit-field { flex: 1; width: auto; min-width: 0; margin-bottom: 16rpx; }
.edit-locate-btn { flex: none; height: 88rpx; min-height: 88rpx; margin-bottom: 16rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: var(--brand, #2f3237); color: #fff; font-size: 26rpx; }
.edit-locate-btn:active { opacity: 0.85; }

/* ---- 待定记录改类型（2026-11-13） ----
   mask 与 modal 平级兄弟；modal 自行 fixed 居中，
   z-index 必须高于 detail-sheet(10)，否则会被详情弹层盖住。 */
.type-mask { z-index: 30; }
.type-modal {
  position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
  z-index: 31; width: 78vw; box-sizing: border-box;
  padding: 36rpx 32rpx 28rpx; border-radius: 28rpx;
  background: rgba(255,255,255,0.94);
  border: 2rpx solid rgba(255,255,255,0.70);
  box-shadow: 0 12rpx 48rpx rgba(17,19,26,0.16);
}
.type-modal-title { font-size: 32rpx; font-weight: 600; color: var(--ink, #11131a); }
.type-modal-hint { margin-top: 12rpx; font-size: 24rpx; line-height: 1.65; color: #8a94a6; }
.type-option-list { margin-top: 24rpx; }
.type-option {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; margin-bottom: 14rpx; border-radius: 16rpx;
  font-size: 28rpx; color: var(--ink, #11131a);
  background: rgba(234,243,255,0.55); border: 2rpx solid transparent;
}
.type-option.selected {
  border-color: var(--brand, #2f3237); color: var(--brand, #2f3237); font-weight: 600;
}
.type-option-check { font-size: 32rpx; }
.type-modal-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.type-modal-actions button { flex: 1; font-size: 28rpx; border-radius: 24rpx; padding: 14rpx 0; }
.type-modal-actions button::after { border: none; }
.type-modal-cancel { background: rgba(234,243,255,0.70); color: #4a5d73; }
.type-modal-confirm { background: linear-gradient(135deg, #3a4046, #0060df); color: #fff; }
.type-change-section .doc-btn { width: 100%; margin-top: 16rpx; }
.type-change-hint { font-size: 24rpx; line-height: 1.65; color: #8a94a6; }
/* 按字段清单渲染：必填星号 + 超长字段名全文（如巡视内容六项） */
.field-required { color: #e35d4f; font-weight: 600; }
.field-note { display: block; margin: 0 0 10rpx 160rpx; font-size: 22rpx; line-height: 1.65; color: #8a99ab; white-space: pre-wrap; word-break: break-all; }

/* 个人工作记录（监理日记）置顶卡 */
.diary-card{margin:16rpx 20rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#f6f8fb;border:1rpx solid #e5e7eb;}
.diary-card.pinned{background:#eef6ff;border-color:#bcdcff;}
.diary-card.pending{background:#fff7e6;border-color:#ffe0a3;}
.diary-card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx;}
.diary-card-title{font-size: 32rpx;font-weight: 600;color:#1f2937;}
.diary-card-actions{display:flex;align-items:center;gap:16rpx;font-size: 24rpx;color:#6b7280;}
.diary-badge{color:#2f3237;font-weight: 600;}
.diary-meta{font-size: 24rpx;color:#4b5563;margin:8rpx 0 12rpx;line-height: 1.5;}
.diary-doc-row{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0;border-top:1rpx solid rgba(0,0,0,0.06);font-size: 26rpx;}
.diary-doc-title{color:#111827;}
.diary-doc-open{color:#2f3237;font-size: 24rpx;}
.diary-card-btns{margin-top:12rpx;display:flex;gap:12rpx;}
.batch-hint{margin-top:8rpx;font-size: 22rpx;color:#6b7280;text-align:center;}
/* diary/doc sheets */
.diary-sheet-scroll{max-height:60vh;padding:16rpx 24rpx;}
.diary-sheet-hint{font-size: 24rpx;color:#6b7280;margin-bottom:16rpx;line-height: 1.5;}
.diary-pick-row{display:flex;align-items:flex-start;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0;}
.diary-pick-main{flex:1;}
.diary-pick-title{font-size: 28rpx;color:#111827;}
.diary-pick-meta{font-size: 22rpx;color:#6b7280;margin-top:4rpx;}
.doc-match-row{display:flex;justify-content:space-between;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #f0f0f0;}
.doc-match-title{font-size: 28rpx;color:#111827;}
.doc-match-form{font-size: 24rpx;color:#2f3237;margin-top:4rpx;}
.doc-match-status{font-size: 22rpx;color:#6b7280;}

/* 文书弹层：生成 → 审批 → 归档 三段 */
.doc-sheet{max-height:86vh;}
.doc-step-bar{display:flex;align-items:center;padding:8rpx 32rpx 20rpx;}
.doc-step{display:flex;align-items:center;gap:8rpx;font-size: 24rpx;color:#9ca3af;}
.doc-step-no{width:36rpx;height:36rpx;line-height:36rpx;text-align:center;border-radius:50%;background:#e5e7eb;color:#6b7280;font-size: 22rpx;}
.doc-step.done .doc-step-no{background:#d1e7ff;color:#2f3237;}
.doc-step.active{color:#2f3237;font-weight: 600;}
.doc-step.active .doc-step-no{background:#2f3237;color:#fff;}
.doc-step-line{flex:1;height:2rpx;background:#e5e7eb;margin:0 12rpx;}
.doc-result-row{padding:18rpx 0;border-bottom:1rpx solid #f0f0f0;}
.doc-result-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;}
.doc-result-title{font-size: 26rpx;color:#111827;flex:1;}
.doc-result-chip{font-size: 22rpx;padding:2rpx 12rpx;border-radius:20rpx;flex:none;}
.chip-draft{background:#f3f4f6;color:#6b7280;}
.chip-pending{background:#fff7e6;color:#d97706;}
.chip-ok{background:#ecfdf5;color:#059669;}
.chip-warn{background:#fef2f2;color:#dc2626;}
.doc-result-meta{font-size: 22rpx;color:#6b7280;margin-top:6rpx;}
.doc-result-btns{display:flex;gap:12rpx;margin-top:12rpx;}
.doc-sheet-note{margin:0 32rpx 8rpx;padding:14rpx 18rpx;border-radius:12rpx;background:#f6f8fb;font-size: 22rpx;color:#4b5563;line-height: 1.5;}
