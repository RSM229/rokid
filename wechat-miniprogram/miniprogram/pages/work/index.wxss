/* 玻璃拟态改造（浅色版） */
.toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.toolbar button { margin: 0; }
.toolbar-right { display: flex; align-items: center; gap: 16rpx; }
.time-btn { padding: 10rpx 20rpx; border-radius: 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.8); color: var(--brand, #1677ff); font-size: 24rpx; font-weight: 600; }
.select-btn { padding: 10rpx 20rpx; border-radius: 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.8); color: var(--brand, #1677ff); font-size: 24rpx; font-weight: 600; }
.doc-entry-btn { padding: 10rpx 20rpx; border-radius: 20rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.12); color: var(--brand, #1677ff); font-size: 24rpx; font-weight: 600; }
.type-tabs-container { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; overflow-x: auto; white-space: nowrap; }
.type-tab { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 28rpx; border-radius: 28rpx; background: rgba(243, 246, 244, 0.75); color: #6b7c90; font-size: 26rpx; font-weight: 500; flex-shrink: 0; }
.type-tab.active { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-weight: 600; }
.arrow { font-size: 22rpx; transition: transform 0.2s; }
.arrow.up { transform: rotate(90deg); }
.type-tabs-expand { display: flex; gap: 16rpx; }
.select-hint { padding: 16rpx 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.8); color: var(--brand, #1677ff); font-size: 24rpx; border-radius: 12rpx; margin-bottom: 16rpx; text-align: center; }
.record-head { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 16rpx; align-items: center; }
.type { font-size: 30rpx; font-weight: 650; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status { color: var(--brand, #1677ff); font-size: 24rpx; flex-shrink: 0; }
.record-desc { font-size: 26rpx; color: var(--ink-2, #243b55); margin-bottom: 8rpx; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; }
.actions button { margin: 0; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 9; background: rgba(20,40,60, 0.35); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; max-height: 82vh; overflow-y: auto; padding: 32rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border-top: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: 0 -8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.close { padding: 0 16rpx; color: #6b7c90; font-size: 54rpx; line-height: 1; }
.sheet-item { padding: 22rpx 24rpx; border-radius: 16rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(255,255,255,0.60); margin-bottom: 16rpx; font-size: 28rpx; color: var(--ink, #12253d); }
.sheet-item.active { background: rgba(var(--wash-rgb, 234,243,255), 0.9); color: var(--brand, #1677ff); font-weight: 600; }
.sheet-item:active { opacity: 0.85; }

/* ---- 隐患卡片 ---- */
.hazard { padding: 0; }
.hazard .status { padding: 5rpx 13rpx; border-radius: 12rpx; color: #9b351f; background: rgba(254, 233, 226, 0.85); font-size: 22rpx; }
.photo { width: 100%; height: 330rpx; background: rgba(222,230,240, 0.7); }
.hazard-content { flex: 1; min-width: 0; overflow: hidden; padding: 26rpx; }
.hazard-content .muted { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 14rpx; }
.hazard-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 31rpx; font-weight: 650; }
.evidence { margin-top: 16rpx; color: var(--ink-2, #243b55); font-size: 25rpx; line-height: 1.65; }

/* ---- 卡片选择模式 ---- */
.card { display: flex; align-items: flex-start; padding: 0; background: rgba(255,255,255,0.34); backdrop-filter: none; -webkit-backdrop-filter: none; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); }
.record-checkbox-inline { display: flex; align-items: flex-start; padding: 24rpx 0 0 24rpx; flex-shrink: 0; }
.card-content { flex: 1; min-width: 0; overflow: hidden; padding: 24rpx; }
/* flex 子项默认 min-width:auto 会被长文本撑出卡片，收窄后单行省略才生效 */
.card-content .muted { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 右侧 ⋯ 菜单绝对定位在卡片中部，正文留白避免压住 chips / 操作行 */
.record .card-content { padding-right: 64rpx; }

/* ---- 结构化记录卡（时间+部位+事项 / 状态可见 / 摘要已清洗 / 一键补填成文） ---- */
.rec-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; }
.rec-time { font-size: 23rpx; color: #8795a6; flex-shrink: 0; }
.hazard-time { font-size: 23rpx; color: #8795a6; margin-bottom: 10rpx; }
.rec-chips { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.rec-chip { padding: 5rpx 14rpx; border-radius: 10rpx; font-size: 21rpx; font-weight: 600; line-height: 1.4; }
.rec-chip.rec-type { color: #2f6fd0; background: rgba(47, 111, 208, 0.12); }
.rec-chip.rec-status { color: #8a6a1f; background: rgba(224, 169, 62, 0.20); }
.rec-chip.rec-status.done { color: #13795b; background: rgba(19, 121, 91, 0.12); }
.rec-chip.rec-status.pending { color: #2f6fd0; background: rgba(47, 111, 208, 0.12); }
.rec-chip.rec-status.warn { color: #b23c2c; background: rgba(220, 82, 62, 0.12); }
.rec-title { font-size: 31rpx; font-weight: 650; color: var(--ink, #12253d); line-height: 1.45; margin-bottom: 8rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.rec-meta { font-size: 23rpx; color: #8795a6; margin-bottom: 14rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rec-summary { font-size: 25rpx; color: var(--ink-2, #243b55); line-height: 1.6; margin-bottom: 18rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.rec-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10, 46, 92), 0.08); }
.rec-missing { font-size: 23rpx; color: #b26a12; font-weight: 600; padding: 6rpx 0; }
.rec-complete { font-size: 23rpx; color: #13795b; }
.rec-missing:active { opacity: 0.6; }

.card-menu { position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: #9aa9bc; padding: 10rpx; z-index: 5; }
.card-menu:active { color: var(--brand, #1677ff); }

/* ---- 批量操作栏 ---- */
.batch-bar { position: fixed; left: 0; right: 0; bottom: calc(122rpx + env(safe-area-inset-bottom)); z-index: 20; display: flex; flex-direction: column; gap: 14rpx; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.34); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border-top: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: 0 -4rpx 20rpx rgba(var(--deep-rgb, 10,46,92), 0.10); }
.batch-top { display: flex; align-items: center; justify-content: space-between; }
.batch-info { font-size: 26rpx; color: #6b7c90; }
.batch-select-all { font-size: 26rpx; color: var(--brand, #1677ff); font-weight: 600; padding: 4rpx 16rpx; }
.batch-select-all:active { opacity: 0.7; }
.batch-actions { display: flex; gap: 16rpx; justify-content: flex-end; }
.batch-actions button { padding: 14rpx 32rpx; border-radius: 24rpx; font-size: 26rpx; font-weight: 600; }
.batch-actions button.primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; }
.batch-actions button.danger { background: rgba(255,255,255,0.34); color: #c53030; border: 1rpx solid #c53030; }

/* ---- 记录菜单 ---- */
.menu-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.34); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border-top: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 32rpx 32rpx 0 0; box-shadow: 0 -4rpx 20rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.menu-item { display: flex; align-items: center; padding: 20rpx 0; font-size: 28rpx; color: var(--ink, #12253d); border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.menu-item:last-child { border-bottom: none; }
.menu-item.cancel { margin-top: 16rpx; color: #6b7c90; font-weight: 500; border-bottom: none; }
.menu-item[danger="true"] { color: #c53030; }

/* ---- 详情弹窗 ---- */
.detail-sheet { position: fixed; left: 0; right: 0; top: 88px; bottom: 0; z-index: 10; display: flex; flex-direction: column; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border-top: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 32rpx 32rpx 0 0; }
/* detail-sheet 本体无 padding，标题行单独留边（.sheet 自带 padding，此处不共用） */
.detail-sheet .sheet-head { padding: 24rpx 30rpx 8rpx; }
/* 文书入口按钮样式 .doc-btn / .doc-btn-row 已上收 app.wxss（work 详情与 documents 详情共用） */
/* box-sizing 必须显式：scroll-view 作为 flex 子项 stretch 后 padding 会撑出容器，
   真机实测 390px 屏 scroll-view 被撑到 420px，右侧卡片被裁掉 30px */
.detail-scroll { flex: 1; overflow-y: auto; padding: 24rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; width: 100%; min-width: 0; }
.detail-section { background: rgba(255,255,255,0.34); border: 2rpx solid rgba(255,255,255,0.60); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.detail-title { font-size: 28rpx; font-weight: 650; color: var(--ink, #12253d); margin-bottom: 16rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.detail-row { display: flex; align-items: flex-start; padding: 12rpx 0; }
.detail-label { width: 160rpx; font-size: 25rpx; color: #6b7c90; flex-shrink: 0; }
.detail-value { flex: 1; font-size: 25rpx; color: var(--ink, #12253d); word-break: break-all; line-height: 1.6; }
.status-tag { color: var(--brand, #1677ff); font-weight: 600; }
.detail-empty { color: #9aa9bc; font-size: 23rpx; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.detail-photo { width: 210rpx; height: 210rpx; border-radius: 12rpx; background: rgba(222,230,240, 0.7); }
.evidence-list { margin-top: 18rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), .08); }
.evidence-item { display: flex; flex-direction: column; gap: 4rpx; padding: 12rpx 0 0; }
.evidence-index { color: var(--ink, #12253d); font-size: 23rpx; font-weight: 600; }
.evidence-meta { color: #6b7c90; font-size: 22rpx; line-height: 1.4; }
.form-choice-hint { display: block; color: #6b7c90; font-size: 23rpx; line-height: 1.5; margin-bottom: 14rpx; }
.form-choice-list { display: flex; flex-direction: column; gap: 10rpx; }
.form-choice { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid rgba(var(--deep-rgb, 10,46,92), .10); border-radius: 12rpx; background: rgba(255,255,255,.34); }
.form-choice.selected { border-color: var(--brand, #1677ff); background: rgba(var(--wash-rgb, 234,243,255), .9); }
.form-choice-main { min-width: 0; flex: 1; }.form-choice-name { display: block; color: var(--ink, #12253d); font-size: 25rpx; }.form-choice-number { display: block; color: #8795a6; font-size: 21rpx; margin-top: 3rpx; }.form-choice-check { width: 30rpx; color: var(--brand, #1677ff); font-size: 30rpx; text-align: center; }
.form-choice-section .doc-btn { margin-top: 16rpx; width: 100%; }

/* ---- 报告生成弹窗 ---- */
.report-options { margin-top: 20rpx; }
.report-type { display: flex; align-items: center; gap: 20rpx; padding: 20rpx; border-radius: 16rpx; background: rgba(255,255,255,0.34); margin-bottom: 16rpx; border: 2rpx solid transparent; }
.report-type:active { background: rgba(255,255,255,0.34); }
.report-type.selected { border-color: var(--brand, #1677ff); background: rgba(var(--wash-rgb, 234,243,255), 0.9); }
.type-icon { font-size: 50rpx; }
.type-info { flex: 1; }
.type-name { font-size: 28rpx; font-weight: 600; color: var(--ink, #12253d); }
.type-desc { font-size: 24rpx; color: #6b7c90; margin-top: 4rpx; }
.type-check { font-size: 30rpx; color: var(--brand, #1677ff); display: none; }
.report-type.selected .type-check { display: block; }
.report-date { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; padding: 16rpx 0; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.report-date text { width: 120rpx; font-size: 26rpx; color: #6b7c90; }
.report-date input { flex: 1; font-size: 26rpx; color: var(--ink, #12253d); }
.report-options-row { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.checkbox-label { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: var(--ink, #12253d); }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.sheet-actions button { flex: 1; padding: 18rpx 0; border-radius: 28rpx; font-size: 28rpx; font-weight: 600; }
.sheet-actions button.primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; }

/* ---- 编辑弹窗 ---- */
.edit-scroll { max-height: 50vh; }
.edit-field { width: 100%; height: 84rpx; min-height: 84rpx; margin-bottom: 16rpx; padding: 0 20rpx; border-radius: 12rpx; border: 1rpx solid rgba(255,255,255,0.34); font-size: 26rpx; color: var(--ink, #12253d); box-sizing: border-box; background: rgba(255,255,255,0.32); }
.edit-picker-value { display: flex; align-items: center; justify-content: space-between; line-height: 84rpx; }
.edit-field-label { display: block; margin: 2rpx 0 9rpx; color: var(--ink-3, #6b7c93); font-size: 23rpx; }
/* 高度必须显式声明：原生 input 带基础库注入的 height/min-height:1.4rem（=22.4px），
   仅写 padding 会被内边距吃光内容区，文字被裁切（同 app.wxss 的 .field）。
   多行版给 150px = 300rpx：基础库 wx-textarea 默认就是 150px，且内层 textarea 绝对定位，
   写 height:auto 会塌陷。 */
.edit-field.textarea { height: 300rpx; min-height: 300rpx; padding: 16rpx 20rpx; line-height: 1.6; }
.edit-field:focus { border-color: var(--brand, #1677ff); outline: none; }
