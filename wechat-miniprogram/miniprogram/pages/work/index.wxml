<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="工作记录" left="back" />
  <tab-bar active="work" />

  <view class="toolbar">
    <view class="title">工作记录</view>
    <view class="toolbar-right">
      <view class="time-btn" bindtap="openTimeSheet">{{timeRangeLabel}} ▾</view>
      <view class="time-btn" bindtap="openPeopleSheet">{{memberFilterLabel}} ▾</view>
      <view class="select-btn" bindtap="toggleSelectMode">
        {{selectMode ? '完成' : '选择'}}
      </view>
    </view>
  </view>

  <view class="type-tabs-container">
    <view class="type-tab {{selectedType === 'all' ? 'active' : ''}}" data-type="all" bindtap="toggleTypeDrawer">
      <text>全部</text>
      <text class="arrow {{showTypeDrawer ? 'up' : ''}}">▸</text>
    </view>
    <view wx:if="{{showTypeDrawer}}" class="type-tabs-expand">
      <view class="type-tab {{selectedType === item.label ? 'active' : ''}}" wx:for="{{typeTabs}}" wx:key="key" data-type="{{item.label}}" bindtap="selectType">
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 个人工作记录（监理日记）置顶卡：原型要求手动生成 / 24 点兜底、生成后置顶可增改 -->
  <view wx:if="{{!loading || records.length || hazards.length || diaryDocs.length}}" class="diary-card {{diaryDocs.length ? 'pinned' : 'pending'}}">
    <view class="diary-card-head">
      <view class="diary-card-title">个人工作记录 · {{timeRangeLabel === '今天' ? '今日' : '汇总'}}</view>
      <view class="diary-card-actions">
        <text wx:if="{{diaryDocs.length}}" class="diary-badge">已置顶</text>
        <text class="diary-fold" bindtap="toggleDiaryCard">{{diaryCardVisible ? '收起' : '展开'}}</text>
      </view>
    </view>
    <block wx:if="{{diaryCardVisible}}">
      <view wx:if="{{diaryLoading}}" class="diary-meta">正在加载…</view>
      <block wx:elif="{{diaryDocs.length}}">
        <view class="diary-meta">已生成 {{diaryDocs.length}} 份（当日个人汇总，仅个人可见）</view>
        <view class="diary-doc-row" wx:for="{{diaryDocs}}" wx:key="id" bindtap="openDiaryDoc" data-id="{{item.id}}">
          <text class="diary-doc-title">{{item.title}}</text>
          <text class="diary-doc-open">查看 ›</text>
        </view>
        <view class="diary-card-btns">
          <button size="mini" class="primary" bindtap="openDiarySheet">增加内容 / 修改</button>
        </view>
      </block>
      <block wx:else>
        <view class="diary-meta">尚未生成。勾选当日部分或全部记录后生成；24:00 前未手动生成将由系统自动汇总当时全部记录。</view>
        <view class="diary-card-btns">
          <button size="mini" class="primary" bindtap="openDiarySheet">选择记录生成</button>
          <button size="mini" bindtap="confirmDiary" data-auto="1">按当前全部记录生成</button>
        </view>
      </block>
    </block>
  </view>

  <!-- 全部模式：同时显示工作记录和隐患 -->
  <block wx:if="{{selectedType === 'all'}}">
    <view wx:if="{{selectMode}}" class="select-hint">点击卡片勾选记录，勾选后可在底部操作栏批量处理</view>
    <view wx:if="{{loading && !records.length && !hazards.length}}" class="empty">正在加载…</view>
    <view wx:elif="{{records.length && !visibleRecords.length && !hazards.length}}" class="empty">该成员暂无记录</view>
    <view wx:elif="{{!records.length && !hazards.length}}" class="empty">暂无记录</view>
    
    <!-- 工作记录 -->
    <view wx:for="{{visibleRecords}}" wx:key="id" class="card record" data-type="record" data-id="{{item.id}}">
      <view wx:if="{{selectMode}}" class="record-checkbox-inline" data-type="record" data-id="{{item.id}}" bindtap="onCardTap">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" data-type="record" />
      </view>
      <view class="card-content" bindtap="onCardTap" data-type="record" data-id="{{item.id}}">
        <!-- 时间 + 类型/状态：状态要有色彩区分，不再和标题挤一行 -->
        <view class="rec-top">
          <text class="rec-time">{{item.displayTime}}</text>
          <view class="rec-chips">
            <text class="rec-chip rec-type">{{item.record_type}}</text>
            <text class="rec-chip rec-status {{item.statusTone}}">{{item.status}}</text>
          </view>
        </view>
        <!-- 部位 · 事项 -->
        <view class="rec-title">{{item.titleText}}</view>
        <!-- 项目 / 位置：只出现一次，不重复项目名 -->
        <view class="rec-meta" wx:if="{{item.metaText}}">{{item.metaText}}</view>
        <!-- 清洗后的摘要：无 Markdown、无机器标签、无截断原文 -->
        <view class="rec-summary">{{item.summaryText}}</view>
        <view class="rec-foot" wx:if="{{!selectMode}}">
          <!-- 记录人：2026-11-18 列表补 creator 字段后回显，便于总监按人核查 -->
          <text wx:if="{{item.creator_name}}" class="rec-creator">{{item.creator_name}}</text>
          <view wx:if="{{item.missingCount}}" class="rec-missing" catchtap="onCardFill" data-id="{{item.id}}" data-missing="{{item.missingHint}}" data-count="{{item.missingCount}}">待补充 {{item.missingCount}} 项 ›</view>
          <text wx:else class="rec-complete">信息齐全</text>
        </view>
      </view>
      <view class="card-menu" wx:if="{{!selectMode}}" bindtap="openRecordMenu" data-type="record" data-id="{{item.id}}">⋯</view>
    </view>
    
    <!-- 隐患记录 -->
    <view wx:for="{{hazards}}" wx:key="id" class="card hazard" data-type="hazard" data-id="{{item.id}}">
      <view wx:if="{{selectMode}}" class="record-checkbox-inline" data-type="hazard" data-id="{{item.id}}" bindtap="onCardTap">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" data-type="hazard" />
      </view>
      <view class="card-content" bindtap="onCardTap" data-type="hazard" data-id="{{item.id}}">
        <image wx:if="{{item.image_url}}" class="photo" src="{{item.image_url}}" mode="aspectFill" catchtap="preview" data-url="{{item.image_url}}"></image>
        <view class="hazard-content">
          <view class="head">
            <view class="hazard-title">{{item.top1_risk || item.risk_category || '现场隐患'}}</view>
            <view class="status">{{item.status}}</view>
          </view>
          <view wx:if="{{item.displayTime}}" class="hazard-time">{{item.displayTime}}</view>
          <view class="muted">#{{item.id}} · {{item.section || '未填写区域'}} · {{item.location || '未填写位置'}}</view>
          <view wx:if="{{item.evidence_text}}" class="evidence">依据：{{item.evidence_text}}</view>
        </view>
      </view>
      <view class="card-menu" wx:if="{{!selectMode}}" bindtap="openRecordMenu" data-type="hazard" data-id="{{item.id}}">⋯</view>
    </view>
  </block>

  <!-- 隐患列表 -->
  <block wx:elif="{{selectedType === '隐患'}}">
    <view wx:if="{{selectMode}}" class="select-hint">点击卡片勾选记录，勾选后可在底部操作栏批量处理</view>
    <view wx:if="{{loading && !hazards.length}}" class="empty">正在加载隐患…</view>
    <view wx:elif="{{!hazards.length}}" class="empty">当前项目暂无隐患记录</view>
    <view wx:for="{{hazards}}" wx:key="id" class="card hazard" data-type="hazard" data-id="{{item.id}}">
      <view wx:if="{{selectMode}}" class="record-checkbox-inline" data-type="hazard" data-id="{{item.id}}" bindtap="onCardTap">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" data-type="hazard" />
      </view>
      <view class="card-content" bindtap="onCardTap" data-type="hazard" data-id="{{item.id}}">
        <image wx:if="{{item.image_url}}" class="photo" src="{{item.image_url}}" mode="aspectFill" catchtap="preview" data-url="{{item.image_url}}"></image>
        <view class="hazard-content">
          <view class="head">
            <view class="hazard-title">{{item.top1_risk || item.risk_category || '现场隐患'}}</view>
            <view class="status">{{item.status}}</view>
          </view>
          <view wx:if="{{item.displayTime}}" class="hazard-time">{{item.displayTime}}</view>
          <view class="muted">#{{item.id}} · {{item.section || '未填写区域'}} · {{item.location || '未填写位置'}}</view>
          <view wx:if="{{item.evidence_text}}" class="evidence">依据：{{item.evidence_text}}</view>
        </view>
      </view>
      <view class="card-menu" wx:if="{{!selectMode}}" bindtap="openRecordMenu" data-type="hazard" data-id="{{item.id}}">⋯</view>
    </view>
  </block>

  <!-- 工作记录列表 -->
  <block wx:else>
    <view wx:if="{{selectMode}}" class="select-hint">点击卡片勾选记录，勾选后可在底部操作栏批量处理</view>
    <view wx:if="{{loading && !records.length}}" class="empty">正在加载工作记录…</view>
    <view wx:elif="{{records.length && !visibleRecords.length}}" class="empty">该成员暂无{{selectedType === 'all' ? '' : selectedType}}记录</view>
    <view wx:elif="{{!records.length}}" class="empty">暂无工作记录</view>
    <view wx:for="{{visibleRecords}}" wx:key="id" class="card record" data-type="record" data-id="{{item.id}}">
      <view wx:if="{{selectMode}}" class="record-checkbox-inline" data-type="record" data-id="{{item.id}}" bindtap="onCardTap">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" data-type="record" />
      </view>
      <view class="card-content" bindtap="onCardTap" data-type="record" data-id="{{item.id}}">
        <!-- 时间 + 类型/状态：状态要有色彩区分，不再和标题挤一行 -->
        <view class="rec-top">
          <text class="rec-time">{{item.displayTime}}</text>
          <view class="rec-chips">
            <text class="rec-chip rec-type">{{item.record_type}}</text>
            <text class="rec-chip rec-status {{item.statusTone}}">{{item.status}}</text>
          </view>
        </view>
        <!-- 部位 · 事项 -->
        <view class="rec-title">{{item.titleText}}</view>
        <!-- 项目 / 位置：只出现一次，不重复项目名 -->
        <view class="rec-meta" wx:if="{{item.metaText}}">{{item.metaText}}</view>
        <!-- 清洗后的摘要：无 Markdown、无机器标签、无截断原文 -->
        <view class="rec-summary">{{item.summaryText}}</view>
        <view class="rec-foot" wx:if="{{!selectMode}}">
          <!-- 记录人：2026-11-18 列表补 creator 字段后回显，便于总监按人核查 -->
          <text wx:if="{{item.creator_name}}" class="rec-creator">{{item.creator_name}}</text>
          <view wx:if="{{item.missingCount}}" class="rec-missing" catchtap="onCardFill" data-id="{{item.id}}" data-missing="{{item.missingHint}}" data-count="{{item.missingCount}}">待补充 {{item.missingCount}} 项 ›</view>
          <text wx:else class="rec-complete">信息齐全</text>
        </view>
      </view>
      <view class="card-menu" wx:if="{{!selectMode}}" bindtap="openRecordMenu" data-type="record" data-id="{{item.id}}">⋯</view>
    </view>
  </block>

  <!-- 批量操作栏（原型：生成个人工作记录 / 生成文书；监理日志为项目级自动任务不在此处） -->
  <view wx:if="{{selectMode && selectedCount > 0 && !showTimeSheet && !showRecordMenu && !showDetail && !showReportModal && !showEditModal && !showDiarySheet && !showDocSheet}}" class="batch-bar">
    <view class="batch-top">
      <view class="batch-info">已选 {{selectedCount}} 条</view>
      <view class="batch-select-all" bindtap="toggleSelectAll">{{allSelected ? '取消全选' : '全选'}}</view>
    </view>
    <view class="batch-actions">
      <button size="mini" class="primary" bindtap="openDiarySheet">生成个人工作记录</button>
      <button size="mini" class="primary" bindtap="openDocSheet">生成文书</button>
      <button size="mini" class="danger" bindtap="batchDelete" loading="{{deletingBatch}}">删除</button>
    </view>
    <view class="batch-hint">监理日志由项目级自动任务按设定时间点生成，不在此处操作。</view>
  </view>

  <!-- 时间筛选弹窗 -->
  <view wx:if="{{showTimeSheet}}" class="mask" bindtap="closeTimeSheet"></view>
  <view wx:if="{{showTimeSheet}}" class="sheet">
    <view class="sheet-head">
      <view class="title">时间范围</view>
      <text class="close" bindtap="closeTimeSheet">×</text>
    </view>
    <view wx:for="{{timeRanges}}" wx:key="key" class="sheet-item {{timeRange === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectTimeRange">{{item.label}}</view>
  </view>

  <!-- 按人筛选弹窗（2026-11-18）：选项由列表 distinct 记录人生成，无需额外权限 -->
  <view wx:if="{{showPeopleSheet}}" class="mask" bindtap="closePeopleSheet"></view>
  <view wx:if="{{showPeopleSheet}}" class="sheet">
    <view class="sheet-head">
      <view class="title">按人筛选</view>
      <text class="close" bindtap="closePeopleSheet">×</text>
    </view>
    <view class="sheet-item {{memberFilterId === null ? 'active' : ''}}" data-id="" bindtap="selectMemberFilter">全部成员</view>
    <view wx:for="{{memberOptions}}" wx:key="id" class="sheet-item {{memberFilterId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectMemberFilter">
      {{item.name}}<text wx:if="{{item.count}}" class="people-count">{{item.count}} 条</text>
    </view>
  </view>

  <!-- 记录操作菜单 -->
  <view wx:if="{{showRecordMenu}}" class="mask" bindtap="closeRecordMenu"></view>
  <view wx:if="{{showRecordMenu}}" class="menu-sheet">
    <view wx:for="{{recordMenuItems}}" wx:key="key" class="menu-item" bindtap="onMenuAction" data-action="{{item.key}}">{{item.label}}</view>
    <view class="menu-item cancel" bindtap="closeRecordMenu">取消</view>
  </view>

  <!-- 详情弹窗 -->
  <view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail"></view>
  <view wx:if="{{showDetail}}" class="detail-sheet" style="top: {{navHeight}}px;">
    <view class="sheet-head">
      <view class="title">{{detail.record_type || '隐患'}}记录详情</view>
      <text class="close" bindtap="closeDetail">×</text>
    </view>
    <scroll-view scroll-y class="detail-scroll">
      <!-- 基本信息 -->
      <view class="detail-section">
        <view class="detail-row"><text class="detail-label">状态</text><text class="detail-value status-tag {{detail.status === '已提交' ? 'ok' : ''}}">{{detail.status}}</text></view>
        <view class="detail-row"><text class="detail-label">业务项目</text><text class="detail-value">{{detail.project_name || detail.station_project_name || '未填写'}}</text></view>
        <view wx:if="{{detail.project_mismatch}}" class="detail-row"><text class="detail-label">水印项目</text><text class="detail-value">{{detail.watermark_project_name || '-'}}</text></view>
        <view wx:if="{{detail.project_mismatch}}" class="form-choice-hint">记录归属当前选择的项目；水印项目仅作为证据保留。新建记录时需先在 Agent 内确认采用哪一组项目信息。</view>
        <!-- 2026-11-17 用户「楼栋/楼层/区域都归属于工程部位」：新版字段区已展示
             「巡视的工程部位」等正式字段（同一 section 值），顶部不再单列「区域」，
              避免同一个值重复显示两遍。隐患详情/旧版兜底仍保留该行，不丢信息。 -->
        <view wx:if="{{!(detailType === 'record' && showFieldSections)}}" class="detail-row"><text class="detail-label">区域</text><text class="detail-value">{{detail.section || '未填写'}}</text></view>
        <view class="detail-row"><text class="detail-label">位置</text><text class="detail-value {{detail.location ? '' : 'detail-empty'}}">{{detail.location || '未填写（可在编辑记录中补充）'}}</text></view>
        <view class="detail-row"><text class="detail-label">创建时间</text><text class="detail-value">{{detail.created_at || '-'}}</text></view>
      </view>

      <!-- 按字段清单渲染：栏目名/分组/必填全部来自用户 xlsx「字段清单」生成的
           record_field_spec.FORMS，后端 /work-record/{id} 返回 field_sections。
           后端未部署时 showFieldSections=false，自动退回下面四个手写区块，不白屏。 -->
      <block wx:if="{{showFieldSections}}">
        <view wx:for="{{detail.field_sections}}" wx:for-item="section" wx:key="title" class="detail-section">
          <view class="detail-title">{{section.title}}</view>
          <block wx:for="{{section.fields}}" wx:for-item="field" wx:key="label">
            <view class="detail-row">
              <text class="detail-label">{{field.label}}<text wx:if="{{field.required}}" class="field-required"> *</text></text>
              <text class="detail-value {{field.missing ? 'detail-empty' : ''}}">{{field.display_value}}</text>
            </view>
            <text wx:if="{{field.note}}" class="field-note">{{field.note}}</text>
          </block>
        </view>
      </block>

      <!-- 巡视信息（后端旧版本兜底；栏目对齐房建 GD-B-214「巡视记录」表） -->
      <view wx:if="{{detail.record_type === '巡视' && !showFieldSections}}" class="detail-section">
        <view class="detail-title">巡视记录</view>
        <view class="detail-row"><text class="detail-label">工程项目名称</text><text class="detail-value">{{detail.project_name || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">巡视的工程部位</text><text class="detail-value">{{detail.section || '未填写'}}</text></view>
        <view class="detail-row"><text class="detail-label">施工单位</text><text class="detail-value">{{detail.construction_unit || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">巡视时间</text><text class="detail-value">{{detail.inspection_time_text || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">巡视监理人员</text><text class="detail-value">{{detail.inspector || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">问题及处理情况</text><text class="detail-value">{{detail.problem_text || '-'}}</text></view>
      </view>

      <!-- 验收信息（后端旧版本兜底） -->
      <view wx:if="{{detail.record_type === '验收' && !showFieldSections}}" class="detail-section">
        <view class="detail-title">验收信息</view>
        <view class="detail-row"><text class="detail-label">验收类型</text><text class="detail-value">{{detail.acceptance_guide_ref || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">验收结果</text><text class="detail-value">{{detail.acceptance_result || '-'}}</text></view>
        <view wx:if="{{detail.acceptance_content}}" class="detail-row"><text class="detail-label">验收内容（验收要点）</text><text class="detail-value">{{detail.acceptance_content}}</text></view>
        <view wx:elif="{{detail.acceptance_points_text}}" class="detail-row"><text class="detail-label">验收内容（要点待确认）</text><text class="detail-value">{{detail.acceptance_points_text}}</text></view>
        <view wx:else class="detail-row"><text class="detail-label">验收内容（验收要点）</text><text class="detail-value">-</text></view>
        <view class="detail-row"><text class="detail-label">工作内容</text><text class="detail-value">{{detail.work_content || '-'}}</text></view>
      </view>

      <!-- 旁站信息（后端旧版本兜底） -->
      <view wx:if="{{detail.record_type === '旁站' && !showFieldSections}}" class="detail-section">
        <view class="detail-title">旁站信息</view>
        <view class="detail-row"><text class="detail-label">工程名称</text><text class="detail-value">{{detail.station_project_name || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">施工单位</text><text class="detail-value">{{detail.construction_unit || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">旁站部位</text><text class="detail-value">{{detail.prov_fields.section || detail.section || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">关键工序</text><text class="detail-value">{{detail.prov_fields.station_process || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">旁站内容</text><text class="detail-value">{{detail.station_content || detail.work_content || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">旁站结论</text><text class="detail-value">{{detail.station_conclusion || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">开始时间</text><text class="detail-value">{{detail.station_start_time || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">结束时间</text><text class="detail-value">{{detail.station_end_time || '-'}}</text></view>
      </view>

      <!-- 见证信息（后端旧版本兜底） -->
      <view wx:if="{{detail.record_type === '见证' && !showFieldSections}}" class="detail-section">
        <view class="detail-title">见证信息</view>
        <view class="detail-row"><text class="detail-label">工程项目</text><text class="detail-value">{{detail.project_name || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">施工单位</text><text class="detail-value">{{detail.construction_unit || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">材料名称</text><text class="detail-value">{{detail.witness_material_name || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">规格型号</text><text class="detail-value">{{detail.witness_material_spec || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">取样数量</text><text class="detail-value">{{detail.prov_fields.quantity || detail.witness_quantity || '-'}} {{detail.prov_fields.unit || detail.witness_unit || ''}}</text></view>
        <view class="detail-row"><text class="detail-label">取样部位</text><text class="detail-value">{{detail.prov_fields.section || detail.section || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">生产厂家</text><text class="detail-value">{{detail.prov_fields.manufacturer || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">取样人</text><text class="detail-value">{{detail.prov_fields.sampler || detail.supervisor || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">合格证/报告编号</text><text class="detail-value">{{detail.prov_fields.cert_no || detail.witness_cert_no || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">见证结论</text><text class="detail-value">{{detail.prov_fields.acceptance_result || detail.witness_accept_result || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">工作内容</text><text class="detail-value">{{detail.work_content || '-'}}</text></view>
      </view>

      <!-- 隐患信息 -->
      <view wx:if="{{detailType === 'hazard'}}" class="detail-section">
        <view class="detail-title">隐患信息</view>
        <view class="detail-row"><text class="detail-label">风险类型</text><text class="detail-value">{{detail.top1_risk || detail.risk_category || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">风险状态</text><text class="detail-value">{{detail.risk_status || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">证据</text><text class="detail-value">{{detail.evidence_text || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">整改建议</text><text class="detail-value">{{detail.suggestion || '-'}}</text></view>
      </view>

      <!-- 影像资料 -->
      <view wx:if="{{detailPhotos.length}}" class="detail-section">
        <view class="detail-title">影像资料 ({{detailPhotos.length}})</view>
        <view class="photo-grid">
          <image wx:for="{{detailPhotos}}" wx:key="*this" class="detail-photo" src="{{item}}" mode="aspectFill" bindtap="previewDetailPhoto" data-url="{{item}}"></image>
        </view>
        <view wx:if="{{detailMediaEvidence.length}}" class="evidence-list">
          <view wx:for="{{detailMediaEvidence}}" wx:key="id" class="evidence-item">
            <text class="evidence-index">图片 {{index + 1}}</text>
            <text wx:if="{{item.capture_time}}" class="evidence-meta">{{item.capture_time}}（{{item.capture_time_source === 'watermark' ? '照片水印' : (item.capture_time_source === 'exif' ? 'EXIF' : '服务器时间')}}）</text>
            <text wx:if="{{item.location || item.section || item.weather}}" class="evidence-meta">{{item.location || ''}}{{item.section ? ' · ' + item.section : ''}}{{item.weather ? ' · ' + item.weather : ''}}</text>
          </view>
        </view>
      </view>

      <!-- 待定记录：先改类型，再按需选表式（2026-11-13 补的入口）。
           后端 /work-record/{id}/set-type 早已存在，但小程序一直没接，用户按回执
           提示来「工作记录页」根本改不了类型。「待定」不在 RECORD_DOC_TYPES 里，
           不改类型时下面的按需生成表单也选不到任何表式。 -->
      <view wx:if="{{detailType === 'record' && detail.record_type === '待定'}}" class="detail-section type-change-section">
        <view class="type-change-hint">这条记录的类型还没定。改成具体类型后，就能在下面按需生成对应的表式。</view>
        <button class="doc-btn" bindtap="openTypeModal">修改记录类型</button>
      </view>

      <!-- 🔴 2026-11-17 改：去掉"按需选表式"折叠区 → 用户点"生成文书"按钮，
           后端 effective_record_form_code() 自动判断：工程类型（房建/市政）+ 记录类型 + 是否危大 → 对应表式 -->
      <view class="doc-btn-row">
        <button wx:if="{{detailType === 'record'}}" class="doc-btn ghost" bindtap="openCollaboration">发起协作</button>
        <button class="doc-btn ghost" bindtap="editDetailRecord">编辑修改</button>
        <button wx:if="{{detail.generated_doc_id}}" class="doc-btn" bindtap="openRecordDocument">查看文书</button>
        <button wx:elif="{{detailType === 'record' || detailType === 'hazard'}}" class="doc-btn" bindtap="generateRecordDocument" loading="{{generatingDoc}}">生成文书</button>
      </view>
    </scroll-view>
  </view>

  <!-- 报告生成弹窗（周报/月报；监理日志为项目级自动任务） -->
  <view wx:if="{{showReportModal}}" class="mask" bindtap="closeReportModal"></view>
  <view wx:if="{{showReportModal}}" class="sheet">
    <view class="sheet-head">
      <view class="title">生成周报 / 月报</view>
      <text class="close" bindtap="closeReportModal">×</text>
    </view>
    <view class="report-options">
      <view class="report-type {{reportType === item.key ? 'selected' : ''}}" wx:for="{{reportTypes}}" wx:key="key" data-type="{{item.key}}" bindtap="selectReportType">
        <view class="type-icon">{{item.icon}}</view>
        <view class="type-info">
          <view class="type-name">{{item.label}}</view>
          <view class="type-desc">{{item.desc}}</view>
        </view>
        <view class="type-check {{reportType === item.key ? 'checked' : ''}}">✓</view>
      </view>
    </view>
    <view class="report-date">
      <text>日期/范围</text>
      <input value="{{reportDate}}" placeholder="YYYY-MM-DD" bindinput="onReportDateChange" />
    </view>
    <view wx:if="{{reportType !== 'day'}}" class="report-options-row">
      <label class="checkbox-label">
        <checkbox value="{{useLlm}}" checked="{{useLlm}}" bindchange="onLlmChange" />
        <text>使用 AI 润色内容</text>
      </label>
    </view>
    <view class="sheet-actions">
      <button class="primary" bindtap="confirmGenerateReport" loading="{{generatingReport}}">生成</button>
      <button bindtap="closeReportModal">取消</button>
    </view>
  </view>

  <!-- 编辑记录弹窗 -->
  <view wx:if="{{showEditModal}}" class="mask" bindtap="closeEditModal"></view>
  <view wx:if="{{showEditModal}}" class="sheet">
    <view class="sheet-head">
      <view class="title">编辑记录</view>
      <text class="close" bindtap="closeEditModal">×</text>
    </view>
    <scroll-view scroll-y class="edit-scroll">
      <view class="edit-field-label">业务日期</view>
      <picker mode="date" value="{{editForm.record_date || '2000-01-01'}}" bindchange="onEditDateChange"><view class="edit-field edit-picker-value">{{editForm.record_date || '选择业务日期'}}<text>›</text></view></picker>
      <!-- 每个输入框都带字段名：原来只靠 placeholder 承载字段名，一旦有值
           （如天气「多云 30℃」）就认不出这是哪个字段（2026-11-18 用户反馈）。
           placeholder 只放填写提示，不再重复字段名。 -->
      <block wx:if="{{editForm.record_type === '巡视'}}">
        <view class="edit-field-label">施工人数（必填）</view>
        <input class="edit-field" type="number" value="{{editForm.worker_count}}" placeholder="当日无人施工可填 0" bindinput="onEditInput" data-field="worker_count" />
        <view class="edit-field-label">巡视开始时间</view>
        <date-time-picker value="{{editForm.inspection_start_time}}" reference-date="{{editForm.record_date}}" data-field="inspection_start_time" bind:change="onEditDateTimeChange" />
        <view class="edit-field-label">巡视结束时间</view>
        <date-time-picker value="{{editForm.inspection_end_time}}" reference-date="{{editForm.record_date}}" reference-enabled="false" data-field="inspection_end_time" bind:change="onEditDateTimeChange" />
      </block>

      <block wx:if="{{editForm.record_type === '旁站'}}">
        <view class="edit-field-label">旁站关键部位（必填）</view>
        <input class="edit-field" value="{{editForm.station_location}}" placeholder="如：3# 楼二层梁板" bindinput="onEditInput" data-field="station_location" />
        <view class="edit-field-label">旁站关键工序（必填）</view>
        <input class="edit-field" value="{{editForm.station_process}}" placeholder="如：混凝土浇筑" bindinput="onEditInput" data-field="station_process" />
        <view class="edit-field-label">工程名称</view>
        <input class="edit-field" value="{{editForm.station_project_name}}" placeholder="与合同工程名称一致" bindinput="onEditInput" data-field="station_project_name" />
        <view class="edit-field-label">旁站内容</view>
        <textarea class="edit-field textarea" value="{{editForm.station_content}}" placeholder="旁站过程中看到的情况" bindinput="onEditInput" data-field="station_content" />
        <view class="edit-field-label">旁站监理情况</view>
        <textarea class="edit-field textarea" value="{{editForm.station_supervision_status}}" placeholder="监理到岗、旁站执行情况" bindinput="onEditInput" data-field="station_supervision_status" />
        <view class="edit-field-label">旁站结论</view>
        <textarea class="edit-field textarea" value="{{editForm.station_conclusion}}" placeholder="是否符合设计及规范要求" bindinput="onEditInput" data-field="station_conclusion" />
        <view class="edit-field-label">旁站开始时间</view>
        <date-time-picker value="{{editForm.station_start_time}}" reference-date="{{editForm.record_date}}" data-field="station_start_time" bind:change="onEditDateTimeChange" />
        <view class="edit-field-label">旁站结束时间</view>
        <date-time-picker value="{{editForm.station_end_time}}" reference-date="{{editForm.record_date}}" data-field="station_end_time" bind:change="onEditDateTimeChange" />
      </block>

      <block wx:if="{{editForm.record_type === '验收'}}">
        <view class="edit-field-label">验收内容（必填）</view>
        <textarea class="edit-field textarea" value="{{editForm.acceptance_content}}" placeholder="本次验收的部位与内容" bindinput="onEditInput" data-field="acceptance_content" />
        <view class="edit-field-label">实际参验单位及人员</view>
        <textarea class="edit-field textarea" value="{{editForm.acceptance_participants}}" placeholder="可从项目资料带出后确认" bindinput="onEditInput" data-field="acceptance_participants" />
        <view class="edit-field-label">验收类型</view>
        <input class="edit-field" value="{{editForm.acceptance_guide_ref}}" placeholder="如：检验批验收" bindinput="onEditInput" data-field="acceptance_guide_ref" />
        <view class="edit-field-label">验收结论</view>
        <picker range="{{acceptanceResults}}" bindchange="onAcceptanceResultChange"><view class="edit-field edit-picker-value">{{editForm.acceptance_result || '请人工确认'}}<text>›</text></view></picker>
        <view class="edit-field-label">检验依据</view>
        <textarea class="edit-field textarea" value="{{editForm.acceptance_basis}}" placeholder="设计文件、规范条款" bindinput="onEditInput" data-field="acceptance_basis" />
      </block>

      <view class="edit-field-label">施工区域</view>
      <input class="edit-field" value="{{editForm.section}}" placeholder="如：建材纵一路" bindinput="onEditInput" data-field="section" />
      <view class="edit-field-label">具体位置</view>
      <view class="edit-location-row">
        <input class="edit-field" value="{{editForm.location}}" placeholder="也可点右侧「定位」自动填写" bindinput="onEditInput" data-field="location" />
        <view class="edit-locate-btn" bindtap="chooseLocationForEdit">定位</view>
      </view>
      <view class="edit-field-label">工作内容</view>
      <textarea class="edit-field textarea" value="{{editForm.work_content}}" placeholder="本次记录的主要工作内容" bindinput="onEditInput" data-field="work_content" />

      <block wx:if="{{editForm.record_type === '巡视'}}">
        <view class="edit-field-label">天气</view>
        <input class="edit-field" value="{{editForm.weather}}" placeholder="如：多云 30℃" bindinput="onEditInput" data-field="weather" />
        <view class="edit-field-label">巡视备注</view>
        <textarea class="edit-field textarea" value="{{editForm.inspection_remark}}" placeholder="补充说明（选填）" bindinput="onEditInput" data-field="inspection_remark" />
      </block>

      <block wx:if="{{editForm.record_type === '巡视' || editForm.record_type === '旁站'}}">
        <view class="edit-field-label">发现的问题</view>
        <textarea class="edit-field textarea" value="{{editForm.problems}}" placeholder="未发现问题可留空" bindinput="onEditInput" data-field="problems" />
      </block>

      <block wx:if="{{editForm.record_type === '巡视' || editForm.record_type === '旁站' || editForm.record_type === '验收'}}">
        <view class="edit-field-label">处理意见及措施</view>
        <textarea class="edit-field textarea" value="{{editForm.treatment}}" placeholder="针对上述问题的处理意见" bindinput="onEditInput" data-field="treatment" />
      </block>

      <block wx:if="{{editForm.record_type === '见证'}}">
        <view class="edit-field-label">材料名称</view>
        <input class="edit-field" value="{{editForm.witness_material_name}}" placeholder="如：HRB400 钢筋" bindinput="onEditInput" data-field="witness_material_name" />
        <view class="edit-field-label">规格型号</view>
        <input class="edit-field" value="{{editForm.witness_material_spec}}" placeholder="如：Φ20" bindinput="onEditInput" data-field="witness_material_spec" />
        <view class="edit-field-label">取样数量</view>
        <input class="edit-field" value="{{editForm.witness_quantity}}" placeholder="填写数量" bindinput="onEditInput" data-field="witness_quantity" />
        <view class="edit-field-label">数量单位</view>
        <input class="edit-field" value="{{editForm.witness_unit}}" placeholder="如：组 / 根 / t" bindinput="onEditInput" data-field="witness_unit" />
        <view class="edit-field-label">合格证/检测报告编号</view>
        <input class="edit-field" value="{{editForm.witness_cert_no}}" placeholder="填写编号" bindinput="onEditInput" data-field="witness_cert_no" />
        <view class="edit-field-label">进场验收结论</view>
        <input class="edit-field" value="{{editForm.witness_accept_result}}" placeholder="合格 / 不合格" bindinput="onEditInput" data-field="witness_accept_result" />
      </block>
    </scroll-view>
    <view class="sheet-actions">
      <button class="primary" bindtap="saveEditRecord" loading="{{savingEdit}}">保存</button>
      <button bindtap="closeEditModal">取消</button>
    </view>
  </view>

  <!-- 改记录类型弹窗（2026-11-13）：mask 与 modal 必须平级兄弟，
       modal 自行 fixed 居中；嵌套进 mask 会因冒泡导致点选项/按钮直接关闭。 -->
  <view wx:if="{{showTypeModal}}" class="mask type-mask" bindtap="closeTypeModal"></view>
  <view wx:if="{{showTypeModal}}" class="type-modal">
    <view class="type-modal-title">修改记录类型</view>
    <view class="type-modal-hint">把这条「待定」记录确定为具体类型；照片和已填内容都会保留。</view>
    <view class="type-option-list">
      <view wx:for="{{typeOptions}}" wx:key="*this"
            class="type-option {{item === selectedTypeValue ? 'selected' : ''}}"
            data-type="{{item}}" bindtap="selectRecordType">
        <text>{{item}}记录</text>
        <text wx:if="{{item === selectedTypeValue}}" class="type-option-check">✓</text>
      </view>
    </view>
    <view class="type-modal-actions">
      <button class="type-modal-cancel" bindtap="closeTypeModal">取消</button>
      <button class="type-modal-confirm" bindtap="confirmRecordType"
              loading="{{savingType}}" disabled="{{!selectedTypeValue || savingType}}">确定</button>
    </view>
  </view>

  <!-- 个人工作记录（监理日记）生成/修改弹层 -->
  <view wx:if="{{showDiarySheet}}" class="mask" bindtap="closeDiarySheet"></view>
  <view wx:if="{{showDiarySheet}}" class="sheet diary-sheet">
    <view class="sheet-head">
      <view class="title">{{diaryIsEdit ? '修改个人工作记录' : '生成个人工作记录'}} · {{timeRangeLabel}}</view>
      <text class="close" bindtap="closeDiarySheet">×</text>
    </view>
    <scroll-view scroll-y class="diary-sheet-scroll">
      <view class="diary-sheet-hint">勾选当日部分或全部工作记录，生成个人当日汇总并置顶（仅个人可见）。</view>
      <view wx:if="{{!records.length}}" class="empty">当前列表暂无工作记录</view>
      <view wx:for="{{records}}" wx:key="id" class="diary-pick-row" bindtap="toggleDiaryPick" data-id="{{item.id}}">
        <checkbox checked="{{diaryPickMap[item.id]}}" />
        <view class="diary-pick-main">
          <view class="diary-pick-title">{{item.titleText || item.record_type}}</view>
          <view class="diary-pick-meta">{{item.displayTime}} {{item.metaText}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <button class="primary" bindtap="confirmDiary" loading="{{diarySaving}}">{{diaryIsEdit ? '保存修改' : '生成并置顶'}}</button>
      <button bindtap="closeDiarySheet">取消</button>
    </view>
  </view>

  <!-- 文书弹层：生成 → 审批 → 归档 三段（原型：审批状态只在系统里，成品不写审批字样） -->
  <view wx:if="{{showDocSheet}}" class="mask" bindtap="closeDocSheet"></view>
  <view wx:if="{{showDocSheet}}" class="sheet doc-sheet">
    <view class="sheet-head">
      <view class="title">文书处理 · 已选 {{docSheetRecordIds.length}} 条</view>
      <text class="close" bindtap="closeDocSheet">×</text>
    </view>

    <view class="doc-step-bar">
      <view class="doc-step {{docSheetStep === 'gen' ? 'active' : ''}} {{docSheetResults.length ? 'done' : ''}}" data-step="gen" bindtap="switchDocStep">
        <text class="doc-step-no">1</text><text class="doc-step-label">生成</text>
      </view>
      <view class="doc-step-line"></view>
      <view class="doc-step {{docSheetStep === 'approve' ? 'active' : ''}} {{docSheetResults.length ? 'done' : ''}}" data-step="approve" bindtap="switchDocStep">
        <text class="doc-step-no">2</text><text class="doc-step-label">审批</text>
      </view>
      <view class="doc-step-line"></view>
      <view class="doc-step {{docSheetStep === 'archive' ? 'active' : ''}}" data-step="archive" bindtap="switchDocStep">
        <text class="doc-step-no">3</text><text class="doc-step-label">归档</text>
      </view>
    </view>

    <!-- 第 1 段：匹配表式并生成 -->
    <block wx:if="{{docSheetStep === 'gen'}}">
      <scroll-view scroll-y class="diary-sheet-scroll">
        <view class="diary-sheet-hint">按项目性质与记录类型自动匹配省统表表式，逐条生成对应表式文书（同类合并/异类分表仍按现有路由结果）。</view>
        <view wx:if="{{!docSheetMatched.length}}" class="empty">所选记录暂无可自动匹配的表式</view>
        <view wx:for="{{docSheetMatched}}" wx:key="record_id" class="doc-match-row">
          <view class="doc-match-main">
            <view class="doc-match-title">{{item.record_type}} · #{{item.record_id}}</view>
            <view class="doc-match-form">{{item.form_name || item.form_code || '待匹配'}}</view>
          </view>
          <view class="doc-match-status">{{item.form_code ? '可生成' : '需手选'}}</view>
        </view>
      </scroll-view>
    </block>

    <!-- 第 2 段：审批（草稿可提交、待审批可通过/退回） -->
    <block wx:elif="{{docSheetStep === 'approve'}}">
      <scroll-view scroll-y class="diary-sheet-scroll">
        <view class="diary-sheet-hint">审批状态只记录在系统里，成品签名栏与备注栏留空；需签发的文书提交前必须先完成必签项。</view>
        <view wx:if="{{!docSheetResults.length}}" class="empty">还没有生成的文书</view>
        <view wx:for="{{docSheetResults}}" wx:key="doc_id" class="doc-result-row">
          <view class="doc-result-head">
            <text class="doc-result-title">{{item.title}}</text>
            <text class="doc-result-chip chip-{{item.tone}}">{{item.status}}</text>
          </view>
          <view class="doc-result-meta">{{item.record_type}} · {{item.form_name || item.form_code}}</view>
          <view class="doc-result-btns">
            <block wx:if="{{item.tone === 'draft' || item.tone === 'warn'}}">
              <button size="mini" class="primary" data-doc-id="{{item.doc_id}}" bindtap="submitDoc" loading="{{docSheetActing === item.doc_id}}">提交审批</button>
            </block>
            <block wx:if="{{item.tone === 'pending'}}">
              <button size="mini" class="primary" data-doc-id="{{item.doc_id}}" bindtap="approveDoc" loading="{{docSheetActing === item.doc_id}}">通过</button>
              <button size="mini" data-doc-id="{{item.doc_id}}" bindtap="rejectDoc">退回</button>
            </block>
            <button size="mini" data-doc-id="{{item.doc_id}}" bindtap="openDocDetail">查看文书</button>
          </view>
        </view>
      </scroll-view>
    </block>

    <!-- 第 3 段：归档（正式文件落资料库） -->
    <block wx:else>
      <scroll-view scroll-y class="diary-sheet-scroll">
        <view class="diary-sheet-hint">已审批/已归档的文书统一进资料库「项目文件夹/工作记录与表单」，此处只做跳转查看，不在本页重复签认。</view>
        <view wx:if="{{!docSheetArchived.length}}" class="empty">还没有已归档的文书，先完成审批</view>
        <view wx:for="{{docSheetArchived}}" wx:key="doc_id" class="doc-result-row">
          <view class="doc-result-head">
            <text class="doc-result-title">{{item.title}}</text>
            <text class="doc-result-chip chip-{{item.tone}}">{{item.status}}</text>
          </view>
          <view class="doc-result-meta">{{item.record_type}} · {{item.form_name || item.form_code}}</view>
          <view class="doc-result-btns">
            <button size="mini" class="primary" data-doc-id="{{item.doc_id}}" bindtap="openDocArchive">查看归档</button>
          </view>
        </view>
      </scroll-view>
    </block>

    <view wx:if="{{docSheetNote}}" class="doc-sheet-note">{{docSheetNote}}</view>

    <view class="sheet-actions">
      <block wx:if="{{docSheetStep === 'gen'}}">
        <button class="primary" bindtap="confirmDocSheet" loading="{{docSheetSubmitting}}" disabled="{{!docSheetMatched.length}}">生成文书</button>
      </block>
      <block wx:elif="{{docSheetStep === 'approve'}}">
        <button class="primary" data-step="archive" bindtap="switchDocStep" disabled="{{!docSheetArchived.length}}">下一步：归档</button>
      </block>
      <block wx:else>
        <button bindtap="closeDocSheet">完成</button>
      </block>
      <button bindtap="closeDocSheet">关闭</button>
    </view>
  </view>

  <!-- 全屏图片预览（带「上一张/下一张」按钮；详情照片与列表缩略图共用） -->
  <image-viewer visible="{{imageViewerVisible}}" urls="{{imageViewerUrls}}"
                current="{{imageViewerCurrent}}" bind:close="onImageViewerClose" />
</view>
