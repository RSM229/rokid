/* 玻璃拟态改造（浅色版） */
.hazard { overflow: hidden; padding: 0; }
.hazard.focused { outline: 4rpx solid #d9a441; }
.photo-strip { display: flex; }
.photo-strip .photo { width: 50%; height: 300rpx; }
.photo { width: 100%; height: 330rpx; background: rgba(222,230,240, 0.7); }
.hazard-content { padding: 26rpx; }
.head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 14rpx; }
.hazard-title { flex: 1; font-size: 31rpx; font-weight: 650; }
.status { padding: 5rpx 13rpx; border-radius: 12rpx; color: #9b351f; background: rgba(254, 233, 226, 0.85); font-size: 22rpx; }
.evidence { margin-top: 16rpx; color: var(--ink-2, #243b55); font-size: 25rpx; line-height: 1.65; }
.detail { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.detail-row { display: flex; gap: 16rpx; margin-top: 12rpx; font-size: 25rpx; line-height: 1.6; }
.detail-label { flex-shrink: 0; color: #6b7c90; }
.detail-text { flex: 1; }
.detail-row .ok { color: var(--brand, #0f62fe); }
.detail-row .bad { color: #c0392b; }
.link { color: var(--brand, #0f62fe); }
.media-block { margin-top: 18rpx; }
.media-title { margin-bottom: 12rpx; color: #6b7c90; font-size: 24rpx; }
.media-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.media-thumb { width: 150rpx; height: 150rpx; border-radius: 12rpx; background: rgba(222,230,240, 0.7); }
.actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.actions button { margin: 0; }
.mask { position: fixed; inset: 0; z-index: 9; background: rgba(20,40,60, 0.35); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; max-height: 82vh; overflow-y: auto; padding: 32rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #ffffff; border-top: 2rpx solid rgba(var(--brand-rgb, 15,98,254), 0.14); box-shadow: 0 -8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.close { padding: 0 16rpx; color: #6b7c90; font-size: 54rpx; line-height: 1; }
.field { margin-bottom: 16rpx; }

/* 列表卡片反复渲染，去模糊保性能 */
.card { background: #ffffff; border: 2rpx solid rgba(var(--brand-rgb, 15,98,254), 0.14); }
