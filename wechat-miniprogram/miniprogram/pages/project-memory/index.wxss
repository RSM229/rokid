.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.memory-note {
  margin: 24rpx 34rpx 0;
  color: var(--color-text-secondary, #666);
  font-size: 24rpx;
  line-height: 36rpx;
}
.maintainer-line {
  margin: 10rpx 34rpx 0;
  color: var(--color-text-tertiary, #999);
  font-size: 22rpx;
  line-height: 32rpx;
}

.group-title {
  margin: 30rpx 34rpx 14rpx;
  color: var(--color-text-secondary, #666);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.section {
  margin: 0 28rpx;
  background: var(--color-background-primary, #fff);
  border-radius: 18rpx;
  overflow: hidden;
}

/* ============ 新增 ============ */
.add-wrap {
  padding: 22rpx 24rpx;
}
.add-input {
  width: 100%;
  min-height: 110rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: var(--color-text-primary, #222);
  box-sizing: border-box;
}
.add-placeholder {
  color: var(--color-text-tertiary, #aaa);
}
.add-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 16rpx;
}
.add-hint {
  margin-top: 12rpx;
  color: var(--color-text-tertiary, #999);
  font-size: 22rpx;
  line-height: 32rpx;
}
.cat-picker {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: var(--color-background-secondary, #f3f4f6);
  font-size: 25rpx;
  color: var(--color-text-secondary, #666);
}
.cat-value {
  font-size: 25rpx;
}
.add-btn {
  min-width: 150rpx;
  background: var(--brand, #13795b);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
}
.add-btn[disabled] {
  opacity: 0.5;
}

/* ============ 列表 ============ */
.pref-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--color-border, #f0f0f0);
}
.pref-item:last-child {
  border-bottom: none;
}
.pref-main {
  flex: 1;
  min-width: 0;
}
.pref-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.pref-cat {
  font-size: 22rpx;
  color: var(--brand, #33405a);
  background: var(--color-background-secondary, #eef2f7);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.source-tag {
  font-size: 20rpx;
  color: var(--color-text-tertiary, #999);
}
.pref-tag {
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}
.pref-tag.on {
  color: #13795b;
  background: rgba(19, 121, 91, 0.1);
}
.pref-tag.off {
  color: #999;
  background: rgba(0, 0, 0, 0.05);
}
.pref-rule {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-primary, #222);
  font-size: 28rpx;
  line-height: 42rpx;
  word-break: break-all;
}
.pref-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
  flex-shrink: 0;
}
.pref-actions switch {
  transform: scale(0.8);
  transform-origin: right center;
}
.pref-del {
  font-size: 24rpx;
  color: #c0392b;
  padding: 4rpx 8rpx;
}

/* ============ 待审批 ============ */
.pending-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--color-border, #f0f0f0);
}
.pending-item:last-child {
  border-bottom: none;
}
.pending-author {
  font-size: 20rpx;
  color: var(--color-text-tertiary, #999);
}
.pending-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  flex-shrink: 0;
}
.approve-btn,
.reject-btn {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  text-align: center;
}
.approve-btn {
  color: #fff;
  background: #13795b;
}
.reject-btn {
  color: #c0392b;
  background: rgba(192, 57, 43, 0.08);
}

/* ============ 空态 ============ */
.empty {
  margin: 40rpx 60rpx;
  text-align: center;
  color: var(--color-text-tertiary, #aaa);
  font-size: 26rpx;
  line-height: 40rpx;
}

/* ============ 个人记忆入口 ============ */
.personal-link {
  margin-top: 40rpx;
}
.entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}
.entry-title {
  font-size: 28rpx;
  color: var(--color-text-primary, #222);
}
.entry-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #999);
}
.cell-arrow {
  color: var(--color-text-tertiary, #bbb);
  font-size: 32rpx;
}

/* ============ 分类选择浮层 ============ */
.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
}
.overlay-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.cat-sheet {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 60rpx;
  background: var(--color-background-primary, #fff);
  border-radius: 20rpx;
  overflow: hidden;
  z-index: 901;
}
.cat-sheet-title {
  padding: 26rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary, #666);
  border-bottom: 1rpx solid var(--color-border, #f0f0f0);
}
.cat-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 34rpx;
  font-size: 30rpx;
  color: var(--color-text-primary, #222);
  border-bottom: 1rpx solid var(--color-border, #f0f0f0);
}
.cat-option.selected {
  color: var(--brand, #13795b);
}
.cat-check {
  color: var(--brand, #13795b);
}
.cat-sheet-cancel {
  padding: 26rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text-secondary, #666);
}

/* ============ ʹ��ͳ�� / ��� ============ */
.use-tag {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary, #999);
}
.stat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border, #f0f0f0);
}
.stat-item:last-child {
  border-bottom: none;
}
.stat-main {
  flex: 1;
  min-width: 0;
}
.stat-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary, #222);
  line-height: 38rpx;
  word-break: break-all;
}
.stat-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary, #999);
}
.stat-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand, #13795b);
}
.audit-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border, #f0f0f0);
  font-size: 22rpx;
}
.audit-item:last-child {
  border-bottom: none;
}
.audit-action {
  color: var(--brand, #33405a);
  flex-shrink: 0;
}
.audit-actor {
  color: var(--color-text-secondary, #666);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.audit-time {
  color: var(--color-text-tertiary, #999);
  flex-shrink: 0;
}
