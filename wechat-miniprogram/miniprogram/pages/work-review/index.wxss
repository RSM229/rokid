.screen{min-height:100vh;background:#fff;color:#23303c;padding:20rpx 26rpx 170rpx;box-sizing:border-box}.status-line,.scenario,.toolbar,.event-heading,.form-heading,.bottom-note,.footer-actions,.preview-head,.preview-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.status-line{font-size:21rpx;color:#6c7883;padding:8rpx 0 20rpx;border-bottom:1rpx solid #e5e9ec}.local-status{color:#32695f}.scenario{padding:18rpx 0;border-bottom:1rpx solid #e5e9ec}.section-label,.field-label{font-size:23rpx;color:#74808a}.scenario-name{font-size:25rpx;margin-left:auto}.chevron{color:#7c8791}.request{padding:22rpx 0;border-bottom:1rpx solid #e5e9ec}.request-text{display:block;width:100%;min-height:55rpx;padding:12rpx 0;font-size:31rpx;box-sizing:border-box}.request-meta{font-size:21rpx;color:#89939c}.metrics{display:grid;grid-template-columns:repeat(3,1fr);padding:22rpx 0;border-bottom:1rpx solid #e5e9ec}.metrics view{text-align:center;color:#77828c;font-size:21rpx}.metric-number{display:block;color:#253745;font-size:33rpx;font-weight:600;margin-bottom:5rpx}.toolbar{padding:19rpx 0 10rpx}.section-title{font-size:28rpx;font-weight:600}.toolbar-actions{display:flex;gap:14rpx}.text-button{margin:0;padding:4rpx 10rpx;background:transparent;color:#28645b;font-size:22rpx;line-height:1.5;border:0}.text-button::after,.photo-actions button::after,.assign-link::after{border:0}.event{border-bottom:1rpx solid #e4e8eb;padding:16rpx 0}.event-heading{justify-content:flex-start}.event-heading checkbox{transform:scale(.8);margin-left:-9rpx}.event-summary{flex:1;min-width:0}.event-title,.event-meta{display:block}.event-title{font-size:26rpx;font-weight:600}.event-meta{font-size:21rpx;color:#78848e;margin-top:5rpx}.expand{font-size:21rpx;color:#327066;padding:12rpx 0 12rpx 15rpx}.event-forms{display:block;margin-left:44rpx;color:#526b64;font-size:21rpx;padding-bottom:6rpx}.event-details{padding:15rpx 0 8rpx 43rpx}.field-label{display:block;margin:16rpx 0 8rpx}.field-input,.content-input{box-sizing:border-box;width:100%;border-bottom:1rpx solid #e0e5e8;padding:10rpx 0;font-size:25rpx}.content-input{min-height:85rpx;padding:12rpx;border:1rpx solid #e0e5e8;border-radius:5rpx}.date-picker{height:65rpx;padding:0 13rpx;border:1rpx solid #dce2e6;border-radius:5rpx;display:flex;align-items:center;justify-content:space-between;font-size:24rpx}.date-clue{font-size:20rpx;color:#71808a;margin-top:8rpx}.date-conflict{color:#936517}.conflict-note{display:block;margin-top:5rpx}.pending-label{color:#986b1b;font-size:20rpx}.confirmed-label{color:#28645b;font-size:20rpx}.adopt-date{margin:9rpx 0 0;padding:0 12rpx;height:50rpx;line-height:50rpx;background:#eff7f4;color:#28645b;font-size:21rpx;text-align:left;border-radius:4rpx}.form-heading{margin-top:9rpx}.form-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rpx 12rpx}.form-option{display:flex;align-items:center;min-height:64rpx;font-size:21rpx;color:#53616d}.form-option checkbox{transform:scale(.76);margin-left:-9rpx}.evidence-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin-top:18rpx}.evidence image{width:100%;aspect-ratio:1.25;display:block;border-radius:4rpx;background:#f0f2f4}.photo-date{font-size:18rpx;color:#72808a;line-height:1.35}.photo-actions{display:flex;justify-content:space-between}.photo-actions button{margin:4rpx 0 0;padding:0;background:transparent;color:#28645b;font-size:20rpx;line-height:1.5}.remove-event{padding:9rpx 0;margin:12rpx 0 0;background:transparent;color:#9a5250;font-size:20rpx;text-align:left}.unassigned,.review-status{padding:21rpx 0;border-top:1rpx solid #e2e7ea}.unassigned-item{display:flex;gap:12rpx;padding:10rpx 0}.unassigned-item>image{width:92rpx;height:73rpx;border-radius:4rpx}.unassigned-detail{flex:1;min-width:0}.assign-actions{display:flex;flex-wrap:wrap;gap:0 12rpx}.assign-link{padding:5rpx 0;color:#28645b;font-size:20rpx}.empty-state{padding:35rpx 10rpx;color:#838d96;font-size:23rpx}.issue{display:block;margin-top:9rpx;color:#8d641b;font-size:21rpx}.ready-note{display:block;margin-top:8rpx;color:#65747e;font-size:21rpx}.bottom-note{padding:11rpx 0 13rpx;color:#8e671d;font-size:20rpx}.footer-actions{position:fixed;z-index:5;bottom:0;left:0;right:0;padding:14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e2e7ea}.footer-actions button{margin:0;height:78rpx;line-height:78rpx;border-radius:5rpx;font-size:25rpx}.preview-button{width:35%;background:#fff;border:1rpx solid #cfd7dc;color:#3c4c57}.confirm-button{flex:1;background:#245f56;color:#fff}.preview-mask{position:fixed;z-index:30;inset:0;display:flex;align-items:flex-end}.preview-backdrop{position:absolute;inset:0;background:rgba(25,35,43,.42)}.preview-sheet{position:relative;width:100%;max-height:85vh;box-sizing:border-box;background:#fff;border-radius:8rpx 8rpx 0 0;padding:22rpx 25rpx calc(24rpx + env(safe-area-inset-bottom))}.preview-head{padding-bottom:12rpx;border-bottom:1rpx solid #e2e7ea}.preview-title{font-size:29rpx;font-weight:600}.preview-note{display:block;color:#976b1b;font-size:21rpx;padding:12rpx 0}.preview-scroll{max-height:68vh}.preview-event{padding:15rpx 0;border-bottom:1rpx solid #e2e7ea}.preview-form{display:block;color:#28645b;font-size:22rpx;font-weight:600}.preview-name{display:block;font-size:24rpx;margin-top:5rpx}.preview-row{font-size:21rpx;color:#71808a;padding-top:7rpx}.preview-content{display:block;font-size:21rpx;color:#46545f;margin-top:9rpx}.pending-fields{display:block;color:#986b1b;font-size:19rpx;margin-top:7rpx}
.schema-editor{margin-top:20rpx;padding-top:14rpx;border-top:1rpx solid #e2e7ea}.schema-title{display:block;color:#28645b;font-size:24rpx;font-weight:600}.schema-section{margin-top:12rpx}.schema-section-title{display:block;color:#74808a;font-size:21rpx}.schema-field{margin-top:7rpx}
