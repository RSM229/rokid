<view class="screen">
  <view class="status-line"><text wx:if="{{loadingPlan}}">正在加载整理计划</text><text wx:elif="{{hasServerPlan}}">服务端整理计划</text><text wx:else>等待从智能体导入资料</text><text wx:if="{{hasServerPlan}}" class="local-status">版本 {{plan.revision}}</text></view>
  <view class="request" wx:if="{{hasServerPlan}}"><text class="section-label">本次要求</text><textarea class="request-text" value="{{plan.requestText}}" maxlength="500" auto-height bindblur="updateRequest"/><text class="request-meta">用户描述优先保留；资料日期仅作为核对线索。</text></view>
  <view class="metrics"><view><text class="metric-number">{{plan.evidence.length}}</text><text>张资料</text></view><view><text class="metric-number">{{events.length}}</text><text>个事项</text></view><view><text class="metric-number">{{records.length}}</text><text>份计划记录</text></view></view>
  <view wx:if="{{!loadingPlan && !hasServerPlan}}" class="empty-state">请在智能体对话中发送资料并说明整理要求。</view>
  <view class="toolbar" wx:if="{{hasServerPlan}}"><text class="section-title">现场事项</text><view class="toolbar-actions"><button class="text-button" bindtap="add">新增事项</button><button class="text-button {{canMerge ? '' : 'disabled-action'}}" bindtap="merge">合并 {{selectedIds.length}}</button></view></view>
  <view wx:if="{{!events.length}}" class="empty-state">用途和事项尚未确定</view>
  <view class="event" wx:for="{{events}}" wx:for-item="event" wx:key="id">
    <view class="event-heading"><checkbox checked="{{event.selected}}" color="#245f56" data-id="{{event.id}}" bindtap="toggleEvent"/><view class="event-summary" data-id="{{event.id}}" bindtap="expand"><text class="event-title">{{event.number}}. {{event.title}}</text><text class="event-meta">{{event.evidenceIds.length}} 张资料 · {{event.dateConfirmed ? event.date : '日期待确认'}}</text></view><text class="expand" data-id="{{event.id}}" bindtap="expand">{{activeId === event.id ? '收起' : '展开'}}</text></view>
    <text class="event-forms">{{event.formText}}</text>
    <view wx:if="{{activeId === event.id}}" class="event-details">
      <text class="field-label">事项名称</text><input class="field-input" value="{{event.title}}" data-id="{{event.id}}" data-field="title" bindblur="updateText" maxlength="80"/>
      <text class="field-label">工程部位</text><input class="field-input" placeholder="待补充" value="{{event.location}}" data-id="{{event.id}}" data-field="location" bindblur="updateText" maxlength="100"/>
      <view class="field-label">业务日期 <text class="{{event.dateConfirmed ? 'confirmed-label' : 'pending-label'}}">{{event.dateConfirmed ? '已确认' : '待确认'}}</text></view>
      <picker mode="date" value="{{event.date}}" data-id="{{event.id}}" bindchange="updateDate"><view class="date-picker">{{event.date || '选择业务日期'}}<text>▾</text></view></picker>
      <view class="date-clue {{event.dateConflict ? 'date-conflict' : ''}}"><text>资料日期线索：{{event.dateClue}}</text><text wx:if="{{event.dateConflict}}" class="conflict-note">存在多个日期，请核对是否需要拆分事项。</text></view>
      <button wx:if="{{event.hasSuggestedDate}}" class="adopt-date" data-id="{{event.id}}" data-date="{{event.suggestedDate}}" bindtap="adoptDate">确认采用 {{event.suggestedDate}}</button>
      <view class="form-heading"><text class="field-label">拟生成表式</text><button class="text-button" data-id="{{event.id}}" bindtap="editForms">{{formEditorId === event.id ? '收起选择' : '选择表式'}}</button></view>
      <checkbox-group wx:if="{{formEditorId === event.id}}" data-id="{{event.id}}" bindchange="changeForms" class="form-list"><label wx:for="{{event.formOptions}}" wx:for-item="form" wx:key="value" class="form-option"><checkbox value="{{form.value}}" checked="{{form.checked}}" color="#245f56"/><text>{{form.value}}</text></label></checkbox-group>
      <text class="field-label">工作情况 / 补充说明</text><textarea class="content-input" value="{{event.content}}" placeholder="待补充" data-id="{{event.id}}" data-field="content" bindblur="updateText" maxlength="1500" auto-height/>
      <view wx:for="{{event.formSchemas}}" wx:for-item="formSchema" wx:key="code" class="schema-editor"><text class="schema-title">{{formSchema.label}}专用字段</text><view wx:for="{{formSchema.sections}}" wx:for-item="section" wx:key="name" class="schema-section"><text class="schema-section-title">{{section.name}}</text><view wx:for="{{section.fields}}" wx:for-item="field" wx:key="key" class="schema-field"><text class="field-label">{{field.label}}{{field.required ? '（必填）' : ''}}</text><picker wx:if="{{field.hasChoices}}" mode="selector" range="{{field.choices}}" value="{{field.choiceIndex}}" data-id="{{event.id}}" data-form="{{formSchema.code}}" data-field="{{field.key}}" bindchange="updateSchemaChoice"><view class="date-picker">{{field.value || '请选择'}}<text>▾</text></view></picker><picker wx:elif="{{field.type === 'date'}}" mode="date" value="{{field.value}}" data-id="{{event.id}}" data-form="{{formSchema.code}}" data-field="{{field.key}}" bindchange="updateSchemaDate"><view class="date-picker">{{field.value || '选择日期'}}<text>▾</text></view></picker><textarea wx:elif="{{field.multiline}}" class="content-input" value="{{field.value}}" data-id="{{event.id}}" data-form="{{formSchema.code}}" data-field="{{field.key}}" bindblur="updateSchemaField" auto-height/><input wx:else class="field-input" value="{{field.value}}" data-id="{{event.id}}" data-form="{{formSchema.code}}" data-field="{{field.key}}" bindblur="updateSchemaField"/></view></view></view>
      <view wx:if="{{event.photos.length}}" class="evidence-grid"><view class="evidence" wx:for="{{event.photos}}" wx:for-item="photo" wx:key="id"><image src="{{photo.image}}" mode="aspectFill" data-id="{{photo.id}}" bindtap="previewImage"/><text class="photo-date">{{photo.note}}</text><view class="photo-actions"><button data-id="{{photo.id}}" bindtap="split">拆分</button><button data-id="{{photo.id}}" bindtap="release">移出</button></view></view></view>
      <button class="remove-event" data-id="{{event.id}}" bindtap="remove">移除事项</button>
    </view>
  </view>
  <view class="unassigned" wx:if="{{unassigned.length}}"><text class="section-title">待分配资料 · {{unassigned.length}}</text><view class="unassigned-item" wx:for="{{unassigned}}" wx:for-item="photo" wx:key="id"><image src="{{photo.image}}" mode="aspectFill" data-id="{{photo.id}}" bindtap="previewImage"/><view class="unassigned-detail"><text class="photo-date">{{photo.note}}</text><view class="assign-actions"><button wx:for="{{events}}" wx:for-item="target" wx:key="id" class="assign-link" data-evidence="{{photo.id}}" data-event="{{target.id}}" bindtap="assign">放入事项 {{target.number}}</button></view></view></view></view>
  <view class="review-status"><text class="section-title">{{confirmed ? '分组已确认' : '待核对项'}} · {{issues.length}}</text><text wx:for="{{issues}}" wx:key="*this" class="issue">{{item}}</text><text wx:if="{{!issues.length}}" class="ready-note">事项、日期和表式均已确认。记录内容仍需核对。</text></view>
  <view class="bottom-note" wx:if="{{hasServerPlan}}"><text wx:if="{{!confirmed}}">确认前仍是整理草稿；确认后再执行建档。</text><text wx:elif="{{executed}}">已按当前版本创建正式工作记录和文书。</text><text wx:else>分组已确认，点击“执行建档”才会创建正式业务记录。</text></view>
  <view class="footer-actions" wx:if="{{hasServerPlan}}"><button class="preview-button" bindtap="preview">预览草稿</button><button wx:if="{{!confirmed}}" class="confirm-button" bindtap="confirm">确认分组</button><button wx:elif="{{!executed}}" class="confirm-button" bindtap="execute" loading="{{executing}}">{{executing ? '正在建档' : '执行建档'}}</button><button wx:else class="confirm-button" disabled>已完成建档</button></view>
  <view class="preview-mask" wx:if="{{showPreview}}"><view class="preview-backdrop" bindtap="closePreview"></view><view class="preview-sheet">
    <view class="preview-head"><text class="preview-title">计划记录 · {{records.length}} 份</text><button class="text-button" bindtap="closePreview">关闭</button></view>
    <text class="preview-note">{{executed ? '已完成建档' : confirmed ? '分组已确认，尚未建档' : '分组待确认'}} · {{executed ? '正式记录已创建' : '当前仅为草稿'}}</text>
    <scroll-view scroll-y class="preview-scroll"><view wx:if="{{executed && executionResult.records.length}}" class="execution-result"><text class="result-title">已创建 {{executionResult.created_count}} 份正式记录</text><view class="preview-event" wx:for="{{executionResult.records}}" wx:for-item="result" wx:key="record_id"><text class="preview-form">{{result.form_name}}</text><text class="preview-name">记录 #{{result.record_id}} · 文书 #{{result.document_id}}</text><text class="preview-content">{{result.document_title}}</text><text class="pending-fields">已关联 {{result.media_ids.length}} 张资料</text><text wx:if="{{result.pendingText}}" class="pending-fields">后续待补：{{result.pendingText}}</text></view></view><view wx:else><view class="preview-event" wx:for="{{records}}" wx:for-item="record" wx:key="id"><text class="preview-form">{{record.form}}</text><text class="preview-name">事项 {{record.eventNumber}} · {{record.title}}</text><view class="preview-row"><text>业务日期</text><text>{{record.date}}</text></view><view class="preview-row"><text>工程部位</text><text>{{record.location}}</text></view><view class="preview-row"><text>关联资料</text><text>{{record.photoCount}} 张</text></view><text class="preview-content">{{record.content}}</text><text class="pending-fields">专用字段、结论及签章待后续补充</text></view><view wx:if="{{!records.length}}" class="empty-state">尚未选择记录表式</view><text wx:for="{{issues}}" wx:key="*this" class="issue">{{item}}</text></view></scroll-view>
  </view></view>
</view>
