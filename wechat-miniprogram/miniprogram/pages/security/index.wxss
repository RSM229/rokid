.page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8a8f8c;
}

.status {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(22, 119, 255, 0.06);
  border-radius: 12rpx;
}

.status-tag {
  font-size: 26rpx;
  font-weight: 600;
}

.status-tag.ok {
  color: #07c160;
}

.status-tag.no {
  color: #e6a23c;
}

.status-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #666;
}

.form {
  background: #ffffff;
  border: 2rpx solid rgba(var(--brand-rgb, 22, 119, 255), 0.14);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.4), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20, 70, 140), 0.16);
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--deep-rgb, 10, 46, 92), 0.08);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.answer-label {
  margin-top: 16rpx;
}

.required {
  color: #e74c3c;
}

.input {
  width: 100%;
  height: 72rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.ops {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ops .btn-plain {
  flex: 1;
  margin-bottom: 0;
}

.error {
  color: #e74c3c;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.btn-plain {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: rgba(255, 255, 255, 0.5);
  color: #555;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
}

.btn-plain::after {
  border: none;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--brand-l, #2b96ff), var(--brand-d, #0060df));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}
