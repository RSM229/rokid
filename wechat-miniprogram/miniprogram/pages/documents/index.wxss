/* 玻璃拟态改造（浅色版） */
.item { padding: 28rpx; }
.item-title { font-size: 30rpx; font-weight: 600; }
.item-meta { margin-top: 10rpx; font-size: 24rpx; }
.loading { padding: 60rpx; text-align: center; color: #6b7c90; }
.search-bar { margin-bottom: 20rpx; }
.search-field { height: 76rpx; padding: 0 24rpx; border-radius: 16rpx; background: rgba(255,255,255,0.40); backdrop-filter: blur(12rpx); -webkit-backdrop-filter: blur(12rpx); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.12); font-size: 27rpx; color: var(--ink, #12253d); box-shadow: 0 2rpx 8rpx rgba(var(--deep-rgb, 10,46,92), 0.06); }
.filter-tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.filter-tab { padding: 12rpx 28rpx; border-radius: 28rpx; background: rgba(243, 246, 244, 0.75); color: #6b7c90; font-size: 26rpx; font-weight: 500; }
.filter-tab.active { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-weight: 600; }

/* 现场记录文书分类（巡视/旁站/见证/验收/待定） */
.cat-scroll { margin-bottom: 18rpx; white-space: nowrap; }
.cat-tabs { display: inline-flex; gap: 14rpx; padding: 4rpx 0; }
.cat-tab { flex-shrink: 0; padding: 10rpx 24rpx; border-radius: 24rpx; background: rgba(255,255,255,0.55); border: 2rpx solid rgba(255,255,255,0.40); color: #5c7086; font-size: 25rpx; }
.cat-tab.active { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-weight: 600; border-color: transparent; }
.active-cat { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; padding: 0 4rpx; }
.active-cat-text { font-size: 24rpx; color: var(--brand, #1677ff); font-weight: 600; }
.active-cat-clear { font-size: 23rpx; color: #8a9bb0; padding: 4rpx 16rpx; border-radius: 16rpx; background: rgba(255,255,255,0.5); }

/* ==================== 台账子视图（统一页内） ==================== */
.is-ledger { padding-bottom: 160rpx; }
.ledger-sub-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.ledger-sub-row .type-tabs-scroll { flex: 1; min-width: 0; margin-bottom: 0; }
.ledger-sub-row .filter-btn { flex-shrink: 0; }
.ledger-view { padding-bottom: 160rpx; }
.toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.toolbar-right { display: flex; align-items: center; gap: 16rpx; }
.filter-btn { padding: 10rpx 20rpx; border-radius: 20rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.8); color: var(--brand, #1677ff); font-size: 24rpx; font-weight: 600; }
.type-tabs-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.type-tabs { display: flex; gap: 16rpx; }
.type-tab { padding: 12rpx 28rpx; border-radius: 28rpx; background: rgba(243, 246, 244, 0.75); color: #6b7c90; font-size: 26rpx; font-weight: 500; flex-shrink: 0; }
.type-tab.active { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-weight: 600; }

.ledger-card { padding: 0; overflow: hidden; background: rgba(255,255,255,0.34); backdrop-filter: none; -webkit-backdrop-filter: none; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); }
.ledger-card .photo { width: 100%; height: 330rpx; background: rgba(222,230,240, 0.7); }
.ledger-content { padding: 26rpx; }
.head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 14rpx; }
.ledger-title { flex: 1; font-size: 30rpx; font-weight: 650; }
.status { padding: 4rpx 14rpx; border-radius: 12rpx; color: #9b351f; background: rgba(254, 233, 226, 0.85); font-size: 22rpx; flex-shrink: 0; }
.status.ok { color: var(--brand, #1677ff); background: rgba(var(--wash-rgb, 234,243,255), 0.85); }
.doc-number { font-size: 24rpx; color: var(--ink-2, #243b55); margin-bottom: 8rpx; }
.hazard-link { margin-top: 14rpx; font-size: 26rpx; color: var(--brand, #1677ff); font-weight: 600; }

.mask { position: fixed; inset: 0; z-index: 9; background: rgba(20,40,60, 0.35); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; max-height: 82vh; overflow-y: auto; padding: 32rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border-top: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: 0 -8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.close { padding: 0 16rpx; color: #6b7c90; font-size: 54rpx; line-height: 1; }
.filter-field { display: flex; align-items: center; gap: 24rpx; padding: 18rpx 24rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(255,255,255,0.34); border-radius: 16rpx; margin-top: 16rpx; }
.filter-label { width: 140rpx; flex-shrink: 0; font-size: 26rpx; color: #6b7c90; }
.filter-input { flex: 1; font-size: 26rpx; color: var(--ink, #12253d); }
.picker-value { flex: 1; font-size: 26rpx; color: var(--ink, #12253d); }
.picker-value.placeholder { color: #aab6c6; }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.sheet-actions button { flex: 1; padding: 18rpx 0; border-radius: 28rpx; font-size: 28rpx; font-weight: 600; }
.sheet-actions button.primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; }

.export-bar { position: fixed; left: 0; right: 0; bottom: calc(122rpx + env(safe-area-inset-bottom)); z-index: 8; display: flex; gap: 16rpx; padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.34); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border-top: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: 0 -4rpx 20rpx rgba(var(--deep-rgb, 10,46,92), 0.10); }
.export-btn { flex: 1; padding: 20rpx 0; text-align: center; border-radius: 28rpx; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 28rpx; font-weight: 600; }

.load-more { padding: 24rpx 0 8rpx; text-align: center; color: #7b8b9f; font-size: 26rpx; }

/* 文书列表：文件条目样式（点开直接看内容，详情按钮进详情页） */
.item.file-item { display: flex; flex-direction: row; align-items: center; width: 100%; box-sizing: border-box; }
.doc-file-icon { width: 72rpx; height: 72rpx; border-radius: 12rpx; background: linear-gradient(135deg, #2b7cdf, #1f5fb0); color: #fff; font-size: 20rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; letter-spacing: 1rpx; }
/* 图标统一类型短徽标（巡视/旁站/日志…）：浅色底、品牌色文字 */
.doc-file-icon.type-badge { background: rgba(var(--brand-rgb, 22,119,255), 0.14); color: var(--brand-deep, #0a2e5c); font-size: 22rpx; letter-spacing: 0; padding: 0 8rpx; width: auto; min-width: 72rpx; box-sizing: border-box; }
.doc-file-info { flex: 1; margin-left: 20rpx; min-width: 0; overflow: hidden; }
.doc-file-name { font-size: 30rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.doc-file-sub { color: #9aa5b5; font-size: 24rpx; margin-top: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.doc-file-detail { flex-shrink: 0; margin-left: 12rpx; padding: 8rpx 20rpx; border-radius: 8rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.12); color: var(--brand-deep, #0a2e5c); font-size: 24rpx; }

/* 右上角「选择」按钮 */
.nav-select-btn { padding: 8rpx 22rpx; border-radius: 24rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.14); color: var(--brand-deep, #0a2e5c); font-size: 26rpx; font-weight: 600; }

/* 多选模式 */
.file-item.checking { border-color: var(--brand, #1677ff); background: rgba(var(--wash-rgb, 234,243,255), 0.55); }
.doc-check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid #b9c6d6; color: transparent; font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 16rpx; box-sizing: border-box; }
.doc-check.on { background: var(--brand, #1677ff); border-color: var(--brand, #1677ff); color: #fff; }

/* 多选操作栏（浮在 tab-bar 之上） */
.select-bar { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(122rpx + env(safe-area-inset-bottom)); z-index: 9; display: flex; gap: 16rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: rgba(255,255,255,0.75); backdrop-filter: blur(24rpx); -webkit-backdrop-filter: blur(24rpx); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: 0 -4rpx 24rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.select-all { flex-shrink: 0; padding: 16rpx 24rpx; border-radius: 24rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.9); color: var(--brand-deep, #0a2e5c); font-size: 26rpx; font-weight: 600; }
.select-action { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 24rpx; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 26rpx; font-weight: 600; }
.select-action.danger { background: linear-gradient(135deg, #e2483d, #c0392b); }
.select-action.disabled { opacity: 0.45; }

/* 签认 / 用章弹窗 */
.sign-mask { position: fixed; inset: 0; z-index: 100; background: rgba(20,40,60, 0.45); display: flex; align-items: center; padding: 40rpx; box-sizing: border-box; }
.sign-panel { width: 100%; border-radius: 24rpx; padding: 32rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.96); }
.sign-doc-name { font-size: 28rpx; font-weight: 600; color: var(--ink, #12253d); margin-bottom: 16rpx; }
.sign-panel .picker-value { padding: 18rpx 0; border-bottom: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.10); }
.sign-pwd { margin-top: 20rpx; padding: 18rpx 24rpx; border-radius: 16rpx; background: rgba(255,255,255,0.6); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.12); }
.sign-panel .sheet-actions { margin-top: 28rpx; }
.sign-hint { margin-top: 16rpx; text-align: center; color: #9aa5b5; font-size: 22rpx; }
