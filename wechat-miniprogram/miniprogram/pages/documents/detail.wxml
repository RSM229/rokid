<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="文书详情" left="back" />

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:elif="{{doc}}">
    <view class="card header">
      <view class="doc-title">{{doc.title || doc.doc_type || '文书'}}</view>
      <view class="status">{{doc.status}}</view>
      <view class="muted" wx:if="{{doc.doc_number}}">编号：{{doc.doc_number}}</view>
      <view class="muted" wx:if="{{doc.doc_type}}">类型：{{doc.doc_type}}</view>
      <view wx:if="{{doc.archive_sync_status === 'failed'}}" class="muted">资料库同步失败：{{doc.archive_sync_error || '请重试'}}</view>
      <button wx:if="{{doc.archive_sync_status === 'failed' && doc.can_retry_archive}}" size="mini" bindtap="retryArchive">重试归档</button>
    </view>

    <!-- 文书详情：直接铺开正文/影像/补填/签认履历（2026-10-15 定稿：内容优先，PDF/Word 收进底部按钮） -->
    <view class="card">
      <view class="row" wx:if="{{doc.section}}">
          <text class="label">施工区域</text>
          <text>{{doc.section}}</text>
        </view>
        <view class="row" wx:if="{{doc.location}}">
          <text class="label">位置</text>
          <text>{{doc.location}}</text>
        </view>
        <view class="row" wx:if="{{doc.weather}}">
          <text class="label">天气</text>
          <text>{{doc.weather}}</text>
        </view>
        <view class="row" wx:if="{{doc.created_at}}">
          <text class="label">创建时间</text>
          <text>{{doc.created_at}}</text>
        </view>
        <view class="row" wx:if="{{doc.updated_at}}">
          <text class="label">更新时间</text>
          <text>{{doc.updated_at}}</text>
        </view>

        <block wx:if="{{fields.length}}">
          <view class="card-title" style="margin-top:20rpx;">文书内容</view>
          <view class="row" wx:for="{{fields}}" wx:key="key">
            <text class="label">{{item.key}}</text>
            <text class="field-value">{{item.value}}</text>
          </view>
        </block>

        <view class="card-title" style="margin-top:20rpx;" wx:if="{{images.length}}">关联影像</view>
        <view class="images" wx:if="{{images.length}}">
          <image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="thumb"
                 data-url="{{item}}" bindtap="previewImage" />
        </view>

        <view class="card-title" style="margin-top:20rpx;" wx:if="{{doc.status === '草稿' && contentEditor.length}}">补填 / 修订日志</view>
        <view wx:if="{{doc.status === '草稿' && contentEditor.length}}">
          <view wx:for="{{contentEditor}}" wx:key="key"><text>{{item.label}}</text><textarea style="width:100%;min-height:70rpx;margin:12rpx 0;" value="{{item.value}}" data-key="{{item.key}}" bindinput="onContentInput" maxlength="-1" /></view>
          <button bindtap="saveContent">保存修订（已有签认需重签）</button>
        </view>

        <view class="card-title" style="margin-top:20rpx;" wx:if="{{!isDiary}}">签认履历</view>
        <block wx:if="{{!isDiary}}">
          <view wx:for="{{signHistory}}" wx:key="index">
            <text>{{item.label}}：</text>
            <text wx:if="{{item.type === 'offline'}}">纸签完成确认人 {{item.confirmed_by}}</text>
            <text wx:else>电子签认人 {{item.signer}}</text>
            <text> · {{item.signed_at}} · {{item.current ? '当前版本' : '历史版本'}}</text>
          </view>
          <view wx:if="{{!signHistory.length}}">尚未签认</view>
          <view wx:for="{{signSlots}}" wx:key="key" style="margin-top:16rpx;">
            <view>{{item.label}}：{{item.completed ? (item.completion_type === 'offline' ? '线下签署已确认' : '电子签认已完成') : (item.mode === 'offline' ? '等待打印并手签' : '待签认')}}</view>
            <button wx:if="{{item.mode === 'offline' && !item.completed && doc.status !== '已归档'}}" class="doc-btn ghost" data-slot="{{item.key}}" bindtap="confirmOfflineSignoff">确认纸质签署已完成</button>
          </view>
        </block>
        <view wx:if="{{isDiary}}" class="muted" style="margin-top:20rpx;">个人工作记录（日记）无需签认与审批，仅本人可见。</view>
    </view>

    <!-- 文件导出：与工作记录详情同款 doc-btn 样式；日记以 Markdown 为正式产物 -->
    <view class="doc-btn-row">
      <button wx:if="{{doc.markdown_path}}" class="doc-btn" bindtap="openMarkdown">查看 Markdown</button>
      <button wx:if="{{!isDiary}}" class="doc-btn ghost" bindtap="onPdfTap" loading="{{generatingPdf}}">{{hasPdf ? '查看 PDF' : '生成 PDF'}}</button>
      <button wx:if="{{!isDiary}}" class="doc-btn ghost" bindtap="openWord">导出 Word</button>
    </view>

    <!-- 业务动作：签认 / 审批（日记是个人汇总，不参与审批流转） -->
    <view class="actions" wx:if="{{!isDiary}}">
      <button wx:if="{{doc.status !== '已归档'}}" class="doc-btn ghost" bindtap="openCollaboration">发起协作</button>
      <button wx:if="{{doc.status !== '已归档'}}" class="doc-btn" bindtap="openSign">本人签认 / 项目用章</button>
      <button wx:if="{{doc.status === '草稿'}}" class="doc-btn" loading="{{submitting}}" bindtap="submit">提交审批</button>
      <button wx:if="{{canApprove}}" class="doc-btn" loading="{{approving}}" bindtap="approve">审批通过</button>
      <button wx:if="{{canApprove}}" class="doc-btn ghost" loading="{{approving}}" bindtap="reject">驳回</button>
    </view>
  </block>

  <view class="empty" wx:elif="{{!loading}}">
    <text>文书不存在或已删除</text>
  </view>

  <view wx:if="{{showSign}}" class="sign-mask" catchtouchmove="preventTouchMove">
    <view class="sign-panel">
      <view class="sign-head">
        <view>
          <view class="sign-title">签认 / 用章授权</view>
          <view class="sign-doc-title">{{doc.title || doc.doc_type || '文书'}}</view>
        </view>
        <text class="sign-close" bindtap="closeSign">×</text>
      </view>

      <view class="sign-field">
        <text class="sign-label">签认位置</text>
        <picker range="{{signSlots}}" range-key="label" value="{{signSlotIndex}}" bindchange="onSignSlot">
          <view class="sign-picker-value">{{signSlots[signSlotIndex].label || '请选择'}}<text class="sign-chevron">›</text></view>
        </picker>
      </view>

      <view class="sign-field">
        <text class="sign-label">签署方式</text>
        <picker range="{{['在线手写签名','上传电子签名','线下打印手签']}}" value="{{signingModeIndex}}" bindchange="onSigningMode">
          <view class="sign-picker-value">{{signingMode === 'online' ? '在线手写签名' : (signingMode === 'offline' ? '线下打印手签' : '上传电子签名')}}<text class="sign-chevron">›</text></view>
        </picker>
      </view>

      <view wx:if="{{signingMode === 'online'}}" class="signature-entry" bindtap="openSignatureCanvas">
        <image wx:if="{{signatureTempPath}}" class="signature-preview" src="{{signatureTempPath}}" mode="aspectFit" />
        <view wx:else class="signature-empty">点击此处手写签名</view>
        <text wx:if="{{signatureTempPath}}" class="signature-state">已完成 · 点击重签</text>
      </view>

      <view wx:if="{{signingMode === 'uploaded'}}" class="sign-field">
        <text class="sign-label">个人签名</text>
        <picker range="{{signatures}}" range-key="name" value="{{signSignatureIndex}}" bindchange="onSignSignature">
          <view class="sign-picker-value">{{signatures[signSignatureIndex].name || '请先上传个人签名'}}<text class="sign-chevron">›</text></view>
        </picker>
      </view>

      <view wx:if="{{signingMode === 'offline'}}" class="offline-note">确认后将记录线下签署方式，不会生成电子签名图片。</view>
      <input wx:if="{{signingMode !== 'offline'}}" class="sign-password" password value="{{signPassword}}" bindinput="onSignPassword" placeholder="签章使用密码" />

      <view class="sign-actions">
        <button class="sign-primary" loading="{{signing}}" disabled="{{signing}}" bindtap="confirmSign">{{signingMode === 'offline' ? '确认线下签署方式' : '确认本人授权签认'}}</button>
        <button wx:if="{{signingMode === 'uploaded'}}" class="sign-secondary" loading="{{uploadingSignature}}" disabled="{{uploadingSignature || signing}}" bindtap="uploadPersonalSignature">从相册上传签名图片</button>
        <button class="sign-cancel" disabled="{{signing}}" bindtap="closeSign">取消</button>
      </view>
    </view>
  </view>

  <!-- Markdown 正文弹层（监理日记正式产物） -->
  <view wx:if="{{showMarkdown}}" class="sign-mask" catchtouchmove="preventTouchMove" bindtap="closeMarkdown">
    <view class="sign-panel" catchtap="preventTouchMove">
      <view class="sign-head">
        <view>
          <view class="sign-title">{{doc.doc_type}} · Markdown</view>
          <view class="sign-doc-title">{{doc.title}}</view>
        </view>
        <view class="sign-close" bindtap="closeMarkdown">×</view>
      </view>
      <scroll-view scroll-y class="md-body">
        <text class="md-text" user-select="{{true}}">{{markdownLoading ? '加载中…' : markdownText}}</text>
      </scroll-view>
      <view class="sign-actions">
        <button class="sign-primary" disabled="{{markdownLoading || !markdownText}}" bindtap="copyMarkdown">复制全文</button>
        <button class="sign-cancel" bindtap="closeMarkdown">关闭</button>
      </view>
    </view>
  </view>

  <!-- 全屏图片预览（带「上一张/下一张」按钮；关联影像点开即进这里） -->
  <image-viewer visible="{{imageViewerVisible}}" urls="{{imageViewerUrls}}"
                current="{{imageViewerCurrent}}" bind:close="onImageViewerClose" />
</view>
