page { width: 100%; height: 100%; overflow: hidden; background: #eef2f3; }
.signature-page { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; box-sizing: border-box; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); background: #eef2f3; }
.signature-header { display: flex; flex: 0 0 76rpx; align-items: center; justify-content: space-between; padding: 0 22rpx; box-sizing: border-box; }
.signature-title { color: #17324a; font-size: 30rpx; font-weight: 700; }
.signature-header-action { width: 128rpx; height: 64rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #526673; font-size: 25rpx; line-height: 64rpx; }
.signature-header-action::after { border: 0; }
.signature-stage { flex: 1; min-width: 0; min-height: 0; padding: 0 22rpx 10rpx; box-sizing: border-box; }
.signature-canvas { display: block; width: 100%; height: 100%; box-sizing: border-box; border: 1rpx solid #d8e0e3; border-radius: 8rpx; background: #fff; }
.signature-footer { display: flex; flex: 0 0 98rpx; justify-content: flex-end; align-items: center; padding: 0 22rpx; }
.signature-confirm { width: 240rpx; height: 76rpx; margin: 0; padding: 0; border: 0; border-radius: 8rpx; background: #176b58; color: #fff; font-size: 27rpx; font-weight: 600; line-height: 76rpx; }
.signature-confirm::after { border: 0; }
.signature-confirm[disabled] { opacity: 0.56; }
