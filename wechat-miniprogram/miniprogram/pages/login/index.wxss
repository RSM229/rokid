/* 玻璃拟态改造（浅色版） */
.login-page { padding-top: 120rpx; }
.brand { text-align: center; margin-bottom: 56rpx; }
.brand-mark { width: 108rpx; height: 108rpx; display: block; margin: 0 auto 24rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(var(--brand-rgb, 22,119,255), 0.28); }
.brand .title { margin-bottom: 12rpx; font-size: 48rpx; }
.section-title { font-size: 34rpx; font-weight: 650; }
.note { margin: 16rpx 0 28rpx; }
.action { margin-top: 32rpx; border-radius: 16rpx; }
.picker { color: #314a66; }
.error { margin: 20rpx 10rpx; color: #b93838; text-align: center; }
.privacy { margin-top: 46rpx; color: #7b8b9f; font-size: 24rpx; text-align: center; }
.footer-links { text-align: center; margin-top: 32rpx; }
.link-item { display: inline-block; color: var(--brand, #1677ff); font-size: 28rpx; padding: 16rpx 24rpx; }
