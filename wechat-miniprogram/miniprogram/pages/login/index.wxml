<!-- 登录页：对齐 jl 小程序的平面极简形态
     结构来自 jl/pages/login/login.wxml：背景光晕 + 品牌区（横版 logo）+ 操作区 + 底部链接。
     不同点（业务需要，刻意保留）：我们是「微信登录 / 绑定已有账号」两态，
     jl 是「一键登录 + 协议勾选」单态。 -->

<view class="page-flat login-page {{needBind ? 'bind-mode' : ''}}" style="{{themeStyle}}">
  <!-- 背景光晕：jl 靠两团径向渐变造氛围，成本低、不像玻璃那样叠光影 -->
  <view class="flat-glow flat-glow-a"></view>
  <view class="flat-glow flat-glow-b"></view>

  <!-- 品牌区：横版 logo（来自 jl/assets/brand-logo.png，420×56rpx 比例） -->
  <view class="hero">
    <image class="logo" src="/assets/brand-logo.png" mode="aspectFit" />
    <view class="hero-title">工程监理智能体</view>
    <view class="hero-sub">{{needBind ? '绑定已有账号后继续' : '说一句话，文书自己长出来'}}</view>
  </view>

  <!-- 操作区 -->
  <view class="act">
    <!-- 态一：微信身份登录 -->
    <block wx:if="{{!needBind}}">
      <button class="btn-flat" loading="{{loading}}" bindtap="login" aria-label="微信登录">微信登录</button>
      <view class="hint-flat">首次使用需要绑定已有广东建设智慧监理账号</view>
    </block>

    <!-- 态二：绑定已有账号 -->
    <block wx:else>
      <view class="bind-title">绑定广东建设智慧监理账号</view>
      <input class="field-flat bind-field" placeholder="用户名" value="{{username}}" data-field="username" bindinput="onInput" />
      <input class="field-flat bind-field" password placeholder="密码" value="{{password}}" data-field="password" bindinput="onInput" />
      <picker mode="selector" range="{{roleLabels}}" value="{{roleIndex}}" bindchange="onRoleChange">
        <view class="field-flat bind-field picker">账号登记角色：{{roleLabels[roleIndex]}}</view>
      </picker>
      <!-- 微信昵称：微信平台不提供真实微信号，管理员在后台凭昵称/头像识别绑定者 -->
      <input class="field-flat bind-field" type="nickname" placeholder="你的微信昵称（便于管理员确认，选填）" value="{{wxNickname}}" data-field="wxNickname" bindinput="onInput" bindblur="onInput" />
      <view class="hint-flat">角色需与该账号在系统中登记的一致，选错将无法绑定</view>
      <button class="btn-flat" loading="{{loading}}" bindtap="bind" aria-label="确认绑定并登录">确认绑定并登录</button>
    </block>

    <view class="error-flat" wx:if="{{error}}">{{error}}</view>
  </view>

  <!-- 底部链接：裸文字 + 一根细线分隔，不用卡片包裹 -->
  <view class="foot">
    <view class="foot-links">
      <text class="foot-link" bindtap="goRegister">还没有账号？立即注册</text>
      <text class="foot-sep">·</text>
      <text class="foot-link" bindtap="goForgot">忘记密码</text>
    </view>
    <view class="foot-note">摄像头和麦克风仅在您主动拍摄或录音时启用</view>
  </view>
</view>
