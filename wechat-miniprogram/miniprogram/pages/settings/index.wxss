/* 设置（二级页）· 2026-10-12 新建
   卡片/cell 基元来自共用 partial；本文件只放本页专有的
   两个浮层（主题抽屉、扫码弹层）。
   微信绑定徽标样式随账号组迁至 pages/account-security（2026-10-12 晚）。 */
@import "../../styles/cell-list.wxss";

/* ============ 主题配色入口与抽屉（2026-09-20 新增，2026-10-12 随本页迁出） ============ */
.theme-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.92), 0 2rpx 8rpx rgba(var(--shadow-rgb, 20,70,140), 0.28);
}

.overlay { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; }
.overlay-mask { position: absolute; inset: 0; background: rgba(20,40,60,0.35); }
.theme-overlay { align-items: flex-end; }

/* 抽屉本体＝真玻璃（2026-09-20 二改）
   原先是 0.94 近实心白，压在半透明遮罩上完全读不出玻璃感。
   现在：降低白填充 + 加强模糊（遮罩下的页面内容被模糊 → 毛玻璃成立）
      ① 边界：1rpx 淡品牌色细线（白边在白底/白面板上不可见）
      ② 层叠：顶缘内白高光 + 底缘品牌色微染（inset 双阴影）
      ③ 浮起：品牌色柔影 + 顶缘再叠一道更透的玻璃唇（0 -8rpx 0 负 spread）
      ④ 通透：blur 提到 60rpx，遮罩导致背后偏暗，面板呈冷调霜感 */
.theme-sheet {
  position: relative;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 40rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(168deg,
    rgba(255, 255, 255, 0.84) 0%,
    rgba(252, 254, 255, 0.72) 46%,
    rgba(var(--wash-rgb, 234,243,255), 0.66) 100%);
  border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.16);
  border-bottom: none;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96),
    inset 0 -26rpx 48rpx rgba(var(--brand-rgb, 47,50,55), 0.07),
    0 -8rpx 0 -2rpx rgba(255, 255, 255, 0.34),
    0 -14rpx 48rpx rgba(var(--shadow-rgb, 20,70,140), 0.24);
}

.ts-head { margin-bottom: 26rpx; }
.ts-title { font-size: 32rpx; font-weight: 700; color: var(--ink, #11131a); }
.ts-sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #8a94a6; }

/* 实时预览卡
   底座先铺一层主题色的柔光（两处光斑），玻璃卡浮在上面 ——
   这样卡片的 backdrop-filter 才真的能模糊到带色的内容，玻璃感肉眼可见。
   这也是纯白底页面上展示玻璃拟态唯一有效的做法：下面必须有东西可模糊。 */
.ts-preview {
  position: relative;
  margin-bottom: 10rpx;
  padding: 22rpx;
  border-radius: 32rpx;
  background-color: rgba(var(--wash-rgb, 234,243,255), 0.34);
  background-image:
    radial-gradient(62% 130% at 10% 0%, rgba(var(--brand-rgb, 47,50,55), 0.24) 0%, rgba(var(--brand-rgb, 47,50,55), 0) 70%),
    radial-gradient(54% 130% at 94% 100%, rgba(var(--brand-l-rgb, 59,140,255), 0.24) 0%, rgba(var(--brand-l-rgb, 59,140,255), 0) 72%);
}
.tsp-card {
  padding: 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.70) 0%, rgba(var(--wash-rgb, 234,243,255), 0.44) 100%);
  border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    inset 0 -14rpx 30rpx rgba(var(--brand-rgb, 47,50,55), 0.06),
    0 8rpx 26rpx rgba(var(--shadow-rgb, 20,70,140), 0.10);
}
.tsp-row { display: flex; align-items: center; gap: 20rpx; }
.tsp-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df));
  box-shadow: 0 4rpx 14rpx rgba(var(--brand-rgb, 47,50,55), 0.30);
}
.tsp-lines { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.tsp-line { height: 16rpx; border-radius: 8rpx; background: rgba(var(--deep-rgb, 10,46,92), 0.14); }
.tsp-line.short { width: 54%; }
.tsp-chips { display: flex; gap: 14rpx; margin-top: 22rpx; }
.tsp-chip {
  width: 88rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}
.tsp-chip.active {
  background: linear-gradient(135deg, rgba(var(--brand-l-rgb, 59,140,255), 0.30), rgba(var(--brand-d-rgb, 11,95,208), 0.24));
  border-color: rgba(var(--brand-rgb, 47,50,55), 0.45);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.70), 0 4rpx 14rpx rgba(var(--brand-rgb, 47,50,55), 0.20);
}
.tsp-btn {
  margin-top: 22rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 22rpx;
  font-size: 26rpx;
  color: var(--on-brand, #ffffff);
  background: linear-gradient(135deg, var(--brand-l, #3a4046) 0%, var(--brand-d, #0060df) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35), 0 8rpx 22rpx rgba(var(--brand-rgb, 47,50,55), 0.28);
}

/* 调色滑块 */
.ts-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.ts-label { flex-shrink: 0; width: 72rpx; font-size: 26rpx; color: #8a94a6; }
.ts-hue-wrap { position: relative; flex: 1; height: 64rpx; }
.ts-hue-rainbow {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 50%;
  height: 16rpx;
  transform: translateY(-50%);
  border-radius: 8rpx;
  background: linear-gradient(90deg,
    #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%,
    #0000ff 67%, #ff00ff 83%, #ff0000 100%);
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.05);
}
.ts-hue { position: relative; margin: 0; }
.ts-slider { flex: 1; margin: 0; }

/* 预设色板 */
.ts-presets { display: flex; justify-content: space-between; margin-top: 28rpx; }
.ts-preset {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.06), 0 3rpx 10rpx rgba(var(--shadow-rgb, 20,70,140), 0.18);
  transition: transform 0.15s ease;
}
.ts-preset:active { transform: scale(0.9); }
.ts-preset.on {
  box-shadow:
    0 0 0 4rpx rgba(255, 255, 255, 0.94),
    0 0 0 7rpx var(--brand, #2f3237),
    0 6rpx 18rpx rgba(var(--brand-rgb, 47,50,55), 0.32);
}

.ts-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }
.ts-btn { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 22rpx; font-size: 28rpx; }
/* 次级按钮也走玻璃（与全站 .glass 一套语言） */
.ts-btn.ghost {
  color: var(--ink, #11131a);
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.44) 100%);
  border: 1rpx solid rgba(var(--brand-rgb, 47,50,55), 0.16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90), 0 6rpx 18rpx rgba(var(--shadow-rgb, 20,70,140), 0.10);
}
.ts-btn.ghost:active {
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.80) 0%, rgba(255, 255, 255, 0.56) 100%);
  border-color: rgba(var(--brand-rgb, 47,50,55), 0.30);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 9rpx 24rpx rgba(var(--shadow-rgb, 20,70,140), 0.15);
}
.ts-btn.solid {
  color: var(--on-brand, #ffffff);
  background: linear-gradient(135deg, var(--brand-l, #3a4046) 0%, var(--brand-d, #0060df) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35), 0 8rpx 22rpx rgba(var(--brand-rgb, 47,50,55), 0.28);
}
.ts-btn.solid:active { filter: brightness(1.06); }

/* ============ 眼镜端扫码登录弹层（2026-10-12 随本页迁出） ============ */
.qr-panel { position: relative; width: 560rpx; padding: 40rpx 40rpx 30rpx; border-radius: 24rpx; background: #ffffff; border: 2rpx solid rgba(var(--brand-rgb, 47,50,55), 0.14); box-shadow: 0 16rpx 48rpx rgba(20,40,60,0.25); display: flex; flex-direction: column; align-items: center; }
.qr-title { font-size: 32rpx; font-weight: 600; color: var(--ink, #11131a); }
.qr-sub { margin-top: 12rpx; font-size: 24rpx; color: #8a94a6; }
.qr-box { margin-top: 30rpx; padding: 20rpx; border: 1rpx solid #e8ede9; border-radius: 16rpx; position: relative; width: 260px; height: 260px; display: flex; align-items: center; justify-content: center; }
.qr-canvas { position: absolute; left: -9999rpx; width: 220px; height: 220px; }
.qr-img { width: 220px; height: 220px; }
.qr-placeholder { font-size: 26rpx; color: #a8b2c1; }
.qr-refresh { margin-top: 28rpx !important; color: #fff; background: linear-gradient(135deg, var(--brand-l, #3a4046), var(--brand-d, #0060df)); border-radius: 18rpx; font-size: 26rpx; }
.qr-close { margin-top: 16rpx !important; color: #8a94a6; background: rgba(255,255,255,0.50); border-radius: 18rpx; font-size: 26rpx; }
