/* 玻璃拟态改造（浅色版）
   2026-10-12：「我的」拆出二级页 pages/settings、pages/account-security。
     · 卡片/cell 基元（.section/.cell/.group-title…）抽到 styles/cell-list.wxss，多页共用
     · 主题配色抽屉、眼镜端扫码弹层的样式随浮层一并迁到 settings/index.wxss
   本文件只留「我的」独占的部分：Hero、待上传、项目看板入口、退出登录。 */
@import "../../styles/cell-list.wxss";

.hero { display: flex; align-items: center; gap: 28rpx; padding: 40rpx 34rpx; background: linear-gradient(135deg, rgba(var(--deep-rgb, 10,46,92), 0.92), rgba(var(--brand-l-rgb, 59,140,255), 0.85)); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); color: #fff; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,.25); text-align: center; line-height: 120rpx; font-size: 48rpx; font-weight: 700; }
.name { font-size: 38rpx; font-weight: 700; }
/* Hero 深底上的次要白字（卡片内的次要文字由 cell-list.wxss 的 .section .muted 覆盖成深色） */
.muted { color: rgba(255,255,255,.75); font-size: 25rpx; }
.info { flex: 1; }

/* ============ 待上传资料（2026-10-12 由页面最底部提到 Hero 之下） ============
   这是需要用户亲手处理的待办，埋在最后一屏等于没人看得到。 */
.upload-item { padding: 24rpx 30rpx; color: var(--ink, #12253d); font-size: 25rpx; overflow-wrap: anywhere; }
.upload-error { margin: 12rpx 0; color: #a33b32; }
.upload-head { align-items: flex-start; }

.logout-btn { margin: 48rpx 34rpx; color: #c0392b; border: 1rpx solid rgba(192,57,43,0.55); background: rgba(255,255,255,0.48); border-radius: 18rpx; font-size: 30rpx; }

/* ============ 三个同级入口：项目看板 / 账号安全 / 设置（2026-10-12） ============
   布局基元（.entry-item/.entry-icon…）已上收 cell-list.wxss；本文件只留本页三个图标。 */

/* 项目看板：主题色（沿用原 tab 级入口的图标） */
.entry-icon.ic-board::before {
  background-color: var(--brand, #1677ff);
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%231677ff%22%20d=%22M128%20128h352v224H128zm416%200h352v352H544zM128%20416h352v480H128zm416-64h352v544H544z%22/%3E%3C/svg%3E");
