}

/* 账号安全：安全绿（盾牌） */
.entry-icon.ic-shield {
  background: rgba(19,121,91,0.10);
  border-color: rgba(19,121,91,0.20);
}
.entry-icon.ic-shield::before {
  background-color: #0f7a55;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%230f7a55%22%20d=%22M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5l-9-4z%22/%3E%3C/svg%3E");
