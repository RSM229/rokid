  background-color: #e8831a;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22%23e8831a%22%20d=%22M14,3v2h3.59l-9.3,9.29,1.42,1.42L19,6.41V10h2V3zM5,5h5V3H5c-1.1,0-2,.9-2,2v14c0,1.1.9,2,2,2h14c1.1,0,2-.9,2-2v-5h-2v5H5z%22/%3E%3C/svg%3E");
