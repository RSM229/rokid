<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="我的" left="back" />
  <tab-bar active="mine" />

  <view class="hero">
    <view class="avatar">{{user.real_name ? user.real_name[0] : '?'}}</view>
    <view class="info">
      <view class="name">{{user.real_name || '未登录'}}</view>
      <view class="muted">{{user.role || ''}}{{user.project_id ? ' · 项目 #' + user.project_id : ''}}</view>
    </view>
  </view>

  <!-- 待上传资料：2026-10-12 由页面最底部提到 Hero 之下。
       这是需要用户亲手处理的待办，埋在最后一屏等于没人看得到。 -->
  <view class="section" wx:if="{{pendingUploads.length}}">
    <view class="cell upload-head">
      <view class="cell-main">
        <text class="cell-label">待上传资料（{{pendingUploads.length}}）</text>
        <text class="cell-sub">这部分资料还没传到服务器，退出前记得处理</text>
      </view>
      <button size="mini" bindtap="retryUploads" loading="{{retryingUploads}}" disabled="{{retryingUploads}}">重试</button>
    </view>
    <view class="upload-item" wx:for="{{pendingUploads}}" wx:key="id">
      <view>{{item.label}} · {{item.createdAt}}</view>
      <view class="upload-error" wx:if="{{item.lastError}}">{{item.lastError}}</view>
      <button size="mini" data-id="{{item.id}}" bindtap="cancelUpload" disabled="{{retryingUploads}}">取消上传</button>
    </view>
  </view>

  <!-- 待补全草稿：聊天即操作的「半成品」，落库持久化、跨会话可见。
       与「待上传资料」同级——都是需要用户亲手收尾的待办，埋在底屏等于没人看。 -->
  <view class="section" wx:if="{{draftCount}}">
    <view class="cell entry-tint draft-entry" bindtap="openDrafts">
      <view class="entry-main">
        <view class="entry-icon ic-draft"></view>
        <view class="entry-text">
          <text class="entry-title">待补全草稿（{{draftCount}}）</text>
          <text class="entry-desc">有记录还没填完，点这里继续填写</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 三个同级入口（2026-10-12 用户要求统一层级 + 配图标）：
       项目看板 / 账号安全 / 设置 —— 原先「项目看板」单独成卡、另两个是素文字行，
       视觉上像两个层级。现合并进同一张卡，三行结构完全一致（图标 + 标题 + 副提示 + 箭头）。
       图标色只为区分功能，不表示层级：看板=主题色、账号=安全绿、设置=中性灰蓝。 -->
  <view class="section">
    <view class="cell entry-item entry-tint" bindtap="openJoinProject">
      <view class="entry-main">
        <view class="entry-icon ic-join"></view>
        <view class="entry-text">
          <text class="entry-title">加入项目</text>
          <text class="entry-desc">填写项目负责人发放的项目邀请码，加入项目并获取岗位</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell entry-item entry-tint" bindtap="openDashboard">
      <view class="entry-main">
        <view class="entry-icon ic-board"></view>
        <view class="entry-text">
          <text class="entry-title">项目看板</text>
          <text class="entry-desc">项目数据总览 · 处置进度 · 快捷操作</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell entry-item entry-tint" bindtap="openAccountSecurity">
      <view class="entry-main">
        <view class="entry-icon ic-shield"></view>
        <view class="entry-text">
          <text class="entry-title">账号安全</text>
          <text class="entry-desc">身份信息 · 微信绑定 · 登录密码 · 密保问题</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell entry-item entry-tint" bindtap="openSettings">
      <view class="entry-main">
        <view class="entry-icon ic-gear"></view>
        <view class="entry-text">
          <text class="entry-title">设置</text>
          <text class="entry-desc">主题配色 · 通知订阅 {{noticeSubscribed}}/{{noticeTotal}} 项 · 关于</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell entry-item entry-tint" bindtap="openPreferences">
      <view class="entry-main">
        <view class="entry-icon ic-pref"></view>
        <view class="entry-text">
          <text class="entry-title">AI 记忆</text>
          <text class="entry-desc">管理跨会话生效的个人工作规则</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell entry-item entry-tint" bindtap="openProjectMemory">
      <view class="entry-main">
        <view class="entry-icon ic-board"></view>
        <view class="entry-text">
          <text class="entry-title">项目记忆</text>
          <text class="entry-desc">本项目总监设定、全项目共享的统一口径</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <!-- 派单入口：仅持 task_assign 权限（总监/总代等）显示。
         方案②：跳 agent 对话页带派单指令，对 AI 说一句话即可派单，不弹独立表单。 -->
    <view class="cell entry-item entry-tint" wx:if="{{canDispatch}}" bindtap="openDispatch">
      <view class="entry-main">
        <view class="entry-icon ic-send"></view>
        <view class="entry-text">
          <text class="entry-title">派单</text>
          <text class="entry-desc">对 AI 说一句话，把任务指派给项目成员</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>

</view>
