<!--
  AI 记忆管理页

  能力：管理「用户长期记忆」——用户明示的、希望 AI 一直遵守的做事规则。
  这些规则会跨会话进入 Agent 系统上下文（后端 /api/agent/preferences，
  由 agent 聊天时注入），比如「整改回复必须附前后对比照片」。

  页面布局：
    ① 新增卡：输入一句话偏好 + 选分类
    ② 列表卡：已添加的偏好，每行可启用/停用/删除
  参照 account-security 的目录页风格（glass-nav-bar + section/cell 基元）。
-->
<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="AI 记忆" left="back" />

  <view class="memory-note">会话记录用于回看对话；这里的记忆会跨会话影响 AI。仅保存你确认的工作规则。</view>

  <!-- 项目规约入口：总监维护、全项目共享的统一口径 -->
  <view class="section project-link">
    <view class="cell entry-item" bindtap="openProjectMemory">
      <view class="entry-main">
        <view class="entry-text">
          <text class="entry-title">项目规约{{projectName ? '（' + projectName + '）' : ''}}</text>
          <text class="entry-desc">{{canManageProjectMemory ? '你是总监/总监代表，可维护全项目共享口径' : '查看本项目总监设定的统一口径'}}</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 新增或编辑记忆 -->
  <view class="group-title">{{editingId ? '编辑记忆' : '告诉 AI 你的工作规矩'}}</view>
  <view class="section">
    <view class="add-wrap">
      <textarea
        class="add-input"
        value="{{inputValue}}"
        placeholder="例如：整改回复必须附前后对比照片"
        placeholder-class="add-placeholder"
        maxlength="500"
        bindinput="onInput"
        auto-height
      ></textarea>
      <view class="add-row">
        <view class="cat-picker" bindtap="openCategoryPicker">
          <text class="cat-value">{{selectedCategoryLabel || '分类'}}</text>
          <text class="cell-arrow">▾</text>
        </view>
        <button
          class="add-btn"
          size="mini"
          loading="{{adding}}"
          disabled="{{adding || !inputValue}}"
          bindtap="submitPreference"
        >{{editingId ? '保存' : '添加'}}</button>
        <view wx:if="{{editingId}}" class="cancel-edit" bindtap="cancelEdit">取消</view>
      </view>
      <view class="scope-row" wx:if="{{projectId}}">
        <view
          class="scope-option {{selectedScope === 'global' ? 'active' : ''}}"
          data-scope="global"
          bindtap="chooseScope"
        >通用（所有项目）</view>
        <view
          class="scope-option {{selectedScope === 'project' ? 'active' : ''}}"
          data-scope="project"
          bindtap="chooseScope"
        >仅本项目</view>
      </view>
    </view>
  </view>

  <!-- 已保存的记忆 -->
  <view class="group-title">已添加（{{preferences.length}}）</view>
  <view class="section" wx:if="{{preferences.length}}">
    <view class="cell pref-item" wx:for="{{preferences}}" wx:key="id">
      <view class="pref-main">
        <view class="pref-head">
          <text class="pref-cat">{{item.categoryLabel}}</text>
          <text class="scope-tag">{{item.scopeLabel}}</text>
          <view class="pref-tag {{item.active ? 'on' : 'off'}}">{{item.active ? '生效中' : '已停用'}}</view>
        </view>
        <text class="pref-rule">{{item.rule}}</text>
      </view>
      <view class="pref-actions">
        <switch
          checked="{{item.active}}"
          data-id="{{item.id}}"
          data-active="{{item.active}}"
          bindchange="togglePreference"
          color="#13795b"
        />
        <view
          wx:if="{{canManageProjectMemory && item.active}}"
          class="pref-publish {{publishingId === item.id ? 'busy' : ''}}"
          data-id="{{item.id}}"
          bindtap="publishToProject"
        >{{publishingId === item.id ? '发布中' : '发布到项目'}}</view>
        <view
          wx:if="{{projectId}}"
          class="pref-scope {{scopeBusyId === item.id ? 'busy' : ''}}"
          data-id="{{item.id}}"
          bindtap="toggleMemoryScope"
        >{{item.project_id ? '改为通用' : '仅本项目'}}</view>
        <view class="pref-edit" data-id="{{item.id}}" bindtap="startEdit">编辑</view>
        <view class="pref-del" data-id="{{item.id}}" bindtap="removePreference">删除</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:elif="{{!loading}}">
    <text>还没有记忆。添加后，AI 会在以后的对话里遵守。</text>
  </view>
  <view class="empty" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>

  <!-- 分类选择浮层（mask + sheet 平级兄弟，禁嵌 modal 进 mask） -->
  <view class="overlay" wx:if="{{showCategoryPicker}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeCategoryPicker"></view>
    <view class="cat-sheet">
      <view class="cat-sheet-title">选择分类</view>
      <view
        class="cat-option {{selectedCategory === item.value ? 'selected' : ''}}"
        wx:for="{{categories}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onCategoryChange"
      >
        <text>{{item.label}}</text>
        <text class="cat-check" wx:if="{{selectedCategory === item.value}}">✓</text>
      </view>
      <view class="cat-sheet-cancel" bindtap="closeCategoryPicker">取消</view>
    </view>
  </view>
</view>
