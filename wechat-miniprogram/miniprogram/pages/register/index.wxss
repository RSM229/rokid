/* 玻璃拟态改造（浅色版） */
.page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8a8f8c;
}

.form {
  background: rgba(255,255,255,0.32);
  backdrop-filter: blur(40rpx) saturate(1.8);
  -webkit-backdrop-filter: blur(40rpx) saturate(1.8);
  border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16);
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  margin-bottom: 32rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #e74c3c;
}

.input {
  width: 100%;
  height: 72rpx;
  background: rgba(255,255,255,0.34);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  background: rgba(255,255,255,0.34);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

.card {
  background: rgba(255,255,255,0.32);
  backdrop-filter: blur(40rpx) saturate(1.8);
  -webkit-backdrop-filter: blur(40rpx) saturate(1.8);
  border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.hint {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(22,119,255,0.06);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #666;
}

.error {
  color: #e74c3c;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 32rpx;
}

.btn-primary::after {
  border: none;
}

.footer {
  text-align: center;
  font-size: 28rpx;
  color: #8a8f8c;
}

.link {
  color: var(--brand, #1677ff);
  margin-left: 8rpx;
}
