<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="注册 / 绑定" left="none" />

  <!-- 选择模式：微信授权 + 邀请码注册 -->
  <block wx:if="{{mode === 'choose'}}">
    <view class="header">
      <view class="title">欢迎使用监理通</view>
      <view class="subtitle">微信授权 + 项目负责人发放的邀请码，即可入组</view>
    </view>

    <view class="card">
      <view class="form">
        <view class="form-item">
          <view class="label">邀请码 <text class="required">*</text></view>
          <input
            class="input"
            placeholder="请输入项目负责人发放的邀请码"
            value="{{inviteCode}}"
            bindinput="onInviteInput"
            bindblur="onInviteBlur"
            maxlength="20"
          />
        </view>
        <view class="form-item">
          <view class="label">真实姓名</view>
          <input class="input" type="nickname" placeholder="便于同事识别，选填" value="{{realName}}" bindinput="onInput" data-field="realName" />
        </view>
      </view>

      <!-- 邀请码实时回显：让用户在点「注册」前就看到会进哪家公司 -->
      <view wx:if="{{inviteHint}}" class="hint invite-hint">{{inviteHint}}</view>
      <view wx:if="{{inviteError}}" class="error">{{inviteError}}</view>

      <button class="btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="wechatRegister">微信授权注册</button>
      <view class="hint">邀请码决定你的企业归属、项目与岗位：项目负责人发的项目码，注册后直接进项目干活；企业码则先进公司，再由负责人发项目码加入具体项目。无需手机号与短信验证码。</view>
    </view>

    <view class="footer">
      <text>已有监理通账号？</text>
      <text class="link" bindtap="onModeBind">绑定微信登录</text>
    </view>
    <view class="footer">
      <text>想用账号密码登录？</text>
      <text class="link" bindtap="goLogin">返回登录</text>
    </view>
  </block>

  <!-- 绑定已有账号（次） -->
  <block wx:else>
    <view class="header">
      <view class="title">绑定已有账号</view>
      <view class="subtitle">将本微信绑定到你的监理通账号</view>
    </view>

    <view class="form">
      <view class="form-item">
        <view class="label">用户名 <text class="required">*</text></view>
        <input class="input" placeholder="请输入用户名" value="{{username}}" bindinput="onInput" data-field="username" />
      </view>

      <view class="form-item">
        <view class="label">密码 <text class="required">*</text></view>
        <input class="input" password placeholder="请输入密码（至少8位）" value="{{password}}" bindinput="onInput" data-field="password" />
      </view>

      <view class="form-item">
        <view class="label">我的岗位 <text class="required">*</text></view>
        <picker mode="selector" range="{{roleOptions}}" value="{{roleIndex}}" bindchange="onRoleChange">
          <view class="picker">{{roleOptions[roleIndex]}}<text class="arrow"> ›</text></view>
        </picker>
      </view>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <button class="btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="bindAndLogin">绑定并登录</button>

    <view class="footer">
      <text>改用微信注册？</text>
      <text class="link" bindtap="onModeChoose">返回</text>
    </view>
  </block>
</view>
