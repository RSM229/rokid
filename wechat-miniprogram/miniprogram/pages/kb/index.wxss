/* 资料库首页：直接渲染分类树（去掉多库列表） */
.page { padding: 0 24rpx calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 文档卡沿用全局 .card 玻璃风格（app.wxss），这里只补内部排版 */
.doc { padding: 24rpx 26rpx; }
.doc-head { display: flex; align-items: center; gap: 18rpx; }
.doc-icon { width: 68rpx; height: 68rpx; flex: none; display: flex; align-items: center; justify-content: center; font-size: 34rpx; border-radius: 18rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.08); }
.doc-info { flex: 1; min-width: 0; }
.doc-name { font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; word-break: break-all; }
.doc-meta { margin-top: 6rpx; color: #8a9bb0; font-size: 23rpx; }
.doc-btns { display: flex; gap: 30rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.10); }
.link-green { color: var(--brand-l, #3b8cff); font-size: 25rpx; font-weight: 600; }
.link-gray { color: #6b7c90; font-size: 25rpx; }
.link-red { color: #d9534f; font-size: 25rpx; font-weight: 600; }

.btn-primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-green { background: var(--brand-l, #3b8cff); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-plain { background: rgba(255,255,255,0.55); color: var(--brand-d, #0b5fd0); font-size: 24rpx; border-radius: 12rpx; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.28); }

.empty { padding: 90rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }

.tree-tip { margin: 0 0 16rpx; padding: 14rpx 18rpx; background: rgba(255,193,7,0.10); border: 2rpx solid rgba(255,193,7,0.32); border-radius: 12rpx; color: #a07800; font-size: 22rpx; line-height: 1.5; }

/* 面包屑：胶囊路径条 */
.breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx; padding: 10rpx 20rpx; margin-bottom: 20rpx; background: rgba(255,255,255,0.60); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.12); border-radius: 999rpx; font-size: 24rpx; align-self: flex-start; width: fit-content; max-width: 100%; }
.crumb { color: #6b7c90; }
.crumb.root { color: var(--brand-l, #3b8cff); font-weight: 600; }
.crumb:not(:last-child)::after { content: "›"; margin-left: 12rpx; color: #c2ccd6; }

/* 子分类：横向图标砖，自适应列数铺满整行（2 个时各占一半，不再左浮空一块） */
.folder-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300rpx, 1fr)); gap: 18rpx; margin-bottom: 24rpx; }
.fcard { box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; padding: 24rpx 22rpx; min-height: 120rpx; background: linear-gradient(140deg, rgba(255,255,255,0.94) 0%, rgba(var(--wash-rgb, 234,243,255), 0.80) 100%); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 24rpx; box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.98), 0 6rpx 20rpx rgba(var(--shadow-rgb, 20,70,140), 0.08); transition: transform 0.12s ease; }
.fcard:active { transform: scale(0.97); }
.ficon-wrap { width: 76rpx; height: 76rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.08); }
.ficon { font-size: 40rpx; line-height: 1; }
.fbody { flex: 1; min-width: 0; }
.fname { font-size: 26rpx; font-weight: 600; color: var(--ink-2, #243b55); line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.fcount { margin-top: 4rpx; font-size: 21rpx; color: #8a9bb0; }

/* 底部操作栏：固定在 tab 栏上方，等宽分三格 */
.action-bar { position: fixed; left: 0; right: 0; bottom: calc(112rpx + env(safe-area-inset-bottom)); z-index: 4; display: flex; gap: 16rpx; padding: 14rpx 24rpx; background: rgba(255,255,255,0.86); backdrop-filter: blur(30rpx) saturate(1.6); -webkit-backdrop-filter: blur(30rpx) saturate(1.6); border-top: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.12); }
.action-bar button { flex: 1; margin: 0; height: 76rpx; line-height: 76rpx; }

.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60, 0.35); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.modal { width: 100%; background: rgba(255,255,255,0.96); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 20rpx; padding: 28rpx; box-sizing: border-box; box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.modal-title { font-size: 30rpx; font-weight: 700; color: var(--ink-2, #243b55); margin-bottom: 20rpx; }
.content-box { max-height: 56vh; }
.content-box text { font-size: 25rpx; color: #334; line-height: 1.7; white-space: pre-wrap; }
.field-group { margin-bottom: 22rpx; }
.field-label { display: block; margin-bottom: 8rpx; font-size: 25rpx; color: #555; font-weight: 600; }
.field-input { width: 100%; height: 72rpx; padding: 0 18rpx; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.18); border-radius: 12rpx; font-size: 26rpx; background: rgba(255,255,255,0.9); box-sizing: border-box; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 10rpx; }
.modal-btns button { flex: 1; height: 76rpx; line-height: 76rpx; margin: 0; font-size: 27rpx; }
.btn-cancel { background: rgba(245, 245, 245, 0.8); color: #666; border-radius: 12rpx; border: none; }
