/* 资料库首页：直接渲染分类树（去掉多库列表） */
.page { padding: 0 24rpx 40rpx; box-sizing: border-box; }

.card { padding: 24rpx; margin-bottom: 14rpx; background: rgba(255,255,255,0.34); backdrop-filter: none; -webkit-backdrop-filter: none; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }

.btn-primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-green { background: var(--brand-l, #3b8cff); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-plain { background: rgba(255,255,255,0.55); color: var(--brand-d, #0b5fd0); font-size: 24rpx; border-radius: 12rpx; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.28); }

.doc-name { font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); }
.doc-meta { margin-top: 6rpx; color: #999; font-size: 23rpx; }
.doc-btns { display: flex; gap: 30rpx; margin-top: 14rpx; }
.link-green { color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 25rpx; font-weight: 600; }
.link-gray { color: #6b7c90; font-size: 25rpx; }
.link-red { color: #d9534f; font-size: 25rpx; font-weight: 600; }

.empty { padding: 90rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }

.breadcrumb { display: flex; flex-wrap: wrap; align-items: center; padding: 6rpx 4rpx 16rpx; font-size: 24rpx; }
.crumb { color: #6b7c90; margin-right: 6rpx; }
.crumb.root { color: var(--brand-l, #3b8cff); font-weight: 600; }
.crumb:not(:last-child)::after { content: "›"; margin-left: 6rpx; color: #c2ccd6; }

.folder-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 18rpx; }
.fcard { width: calc((100% - 28rpx) / 3); box-sizing: border-box; padding: 22rpx 12rpx; background: rgba(255,255,255,0.40); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; }
.ficon { font-size: 44rpx; line-height: 1; }
.fname { margin-top: 12rpx; font-size: 24rpx; font-weight: 600; color: var(--ink-2, #243b55); text-align: center; }
.fcount { margin-top: 6rpx; font-size: 20rpx; color: #999; }

.action-bar { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 8rpx; }

.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60, 0.35); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.modal { width: 100%; background: rgba(255,255,255,0.34); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 20rpx; padding: 28rpx; box-sizing: border-box; box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.modal-title { font-size: 30rpx; font-weight: 700; color: var(--ink-2, #243b55); margin-bottom: 20rpx; }
.content-box { max-height: 56vh; }
.content-box text { font-size: 25rpx; color: #334; line-height: 1.7; white-space: pre-wrap; }
.field-group { margin-bottom: 22rpx; }
.field-label { display: block; margin-bottom: 8rpx; font-size: 25rpx; color: #555; font-weight: 600; }
.field-input { width: 100%; height: 72rpx; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; background: rgba(255,255,255,0.40); box-sizing: border-box; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 10rpx; }
.modal-btns button { flex: 1; height: 76rpx; line-height: 76rpx; margin: 0; font-size: 27rpx; }
.btn-cancel { background: rgba(245, 245, 245, 0.8); color: #666; border-radius: 12rpx; border: none; }
