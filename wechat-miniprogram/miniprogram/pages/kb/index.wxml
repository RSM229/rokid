<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="{{kbName}}" left="back" />
  <!-- 2026-10-08 起「资料库」是底部第 4 个 tab，本页即其落点；已改为直接渲染分类树 -->
  <tab-bar active="kb" />

  <view wx:if="{{resolving}}" class="empty">正在加载资料库…</view>

  <block wx:else>
    <!-- 面包屑：非根层显示，可点「全部」回到根 -->
    <view wx:if="{{currentFolderId !== 0}}" class="breadcrumb">
      <text class="crumb root" data-id="0" bindtap="goBreadcrumb">全部</text>
      <text wx:for="{{breadcrumb}}" wx:key="id" class="crumb" data-id="{{item.id}}" bindtap="goBreadcrumb">{{item.name}}</text>
    </view>

    <!-- 分类树接口未上线时的降级提示 -->
    <view wx:if="{{treeUnavailable}}" class="tree-tip">当前服务端暂未提供分类目录，已按平铺文档显示</view>

    <!-- 搜索：输入即全局搜文档名称（不带文件夹过滤），清空恢复文件夹视图 -->
    <view class="search-bar">
      <input
        class="search-input"
        value="{{searchKeyword}}"
        placeholder="搜索文档名称"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>

    <!-- 标签筛选条：横向 chips，点选即跨文件夹过滤文档；「管理」入口可删除标签 -->
    <scroll-view wx:if="{{tags.length}}" scroll-x class="tag-bar">
      <view class="tag-chip {{tagFilterId === 0 ? 'on' : ''}}" bindtap="clearTagFilter">全部</view>
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag-chip {{tagFilterId === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="toggleTagFilter"
      >
        {{item.name}}（{{item.count}}）
      </view>
      <view wx:if="{{canUpload}}" class="tag-chip tag-manage-entry" bindtap="openTagManage">管理</view>
    </scroll-view>

    <!-- 文件夹操作行：标题 + 「+ ▾」下拉（新建/重命名/删除）。当前目录为根时，重命名/删除禁用 -->
    <view wx:if="{{canUpload}}" class="sec folder-ops">
      <view class="sec-head">
        <text class="sec-title">文件夹</text>
        <view class="ops-right">
          <text class="sec-act" bindtap="toggleFolderMenu">+ ▾</text>
          <view wx:if="{{showFolderMenu}}" class="folder-menu">
            <view class="fmenu-item" bindtap="menuNewFolder">新建文件夹</view>
            <view class="fmenu-item {{currentFolderId === 0 ? 'fmenu-disabled' : ''}}" bindtap="menuRenameFolder">重命名文件夹</view>
            <view class="fmenu-item fmenu-danger {{currentFolderId === 0 ? 'fmenu-disabled' : ''}}" bindtap="menuDeleteFolder">删除文件夹</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 文件夹：竖排列表（文件管理器式）。根目录只列文件夹，文档只在文件夹内部出现；搜索/标签筛选时隐藏 -->
    <view wx:if="{{!searchKeyword && !tagFilterId && currentSubfolders.length}}" class="sec">
      <view class="folder-list">
        <view wx:for="{{currentSubfolders}}" wx:key="id" class="frow" data-id="{{item.id}}" bindtap="selectFolder">
          <view class="fico"><view class="fico-shape" /></view>
          <view class="fmain">
            <view class="fname">{{item.name}}</view>
            <view class="fsub">{{item.count}} 份文档</view>
          </view>
          <view class="fchev">›</view>
        </view>
      </view>
    </view>

    <!-- 文档：在文件夹内 / 根目录有未分类 / 搜索中 / 标签筛选中时出现，避免和文件夹并列成同级 -->
    <view wx:if="{{searchKeyword || tagFilterId || currentFolderId !== 0 || docs.length}}" class="sec">
      <view class="sec-head">
        <text class="sec-title">{{searchKeyword ? '搜索「' + searchKeyword + '」' : (tagFilterId ? '标签「' + tagFilterName + '」' : (currentFolderId !== 0 ? '文档' : '未分类文档'))}}</text>
        <text class="sec-count">{{docs.length}}</text>
      </view>
      <view wx:if="{{docsLoading && !docs.length}}" class="empty-mini">正在加载…</view>
      <view wx:elif="{{!docs.length}}" class="empty-mini">{{tagFilterId ? '没有文档带这个标签' : '这个文件夹下还没有文档。点下方「上传文档」会直接归档到这里。'}}</view>
    </view>
    <view wx:for="{{docs}}" wx:key="id" class="card doc">
      <view class="doc-head">
        <view class="doc-icon"><view class="doc-shape" /></view>
        <view class="doc-info">
          <view class="doc-name">{{item.name}}</view>
          <view class="doc-meta">{{item.sizeText}} · {{item.uploader_name}}</view>
          <view wx:if="{{item.tags && item.tags.length}}" class="doc-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id" class="doc-tag-chip">{{tag.name}}</text>
          </view>
        </view>
      </view>
      <view class="doc-btns">
        <text class="link-green" data-id="{{item.id}}" bindtap="openContent">查看</text>
        <text class="link-gray" data-id="{{item.id}}" bindtap="downloadDoc">下载</text>
        <text wx:if="{{canUpload && folderOptions.length}}" class="link-gray" data-id="{{item.id}}" bindtap="openMoveDoc">移动</text>
        <text wx:if="{{canUpload}}" class="link-gray" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openTagEdit">标签</text>
        <text wx:if="{{canUpload}}" class="link-red" data-id="{{item.id}}" bindtap="deleteDoc">删除</text>
      </view>
    </view>
  </block>

  <!-- 底部操作栏：新建文件夹已移到「文件夹」分组标题右侧，这里只留两个主操作 -->
  <view class="action-bar">
    <button wx:if="{{canUpload}}" class="btn-primary" size="mini" bindtap="uploadDoc">+ 上传文档</button>
    <button wx:if="{{canUpload}}" class="btn-plain" size="mini" bindtap="chooseAudio">录音转写</button>
  </view>

  <!-- 文件夹下拉菜单的透明背板：点页面其他位置关闭（菜单本体 z-index 更高，保持可点） -->
  <view wx:if="{{showFolderMenu}}" class="menu-mask" bindtap="closeFolderMenu"></view>

  <!-- 文档内容预览 -->
  <view wx:if="{{showContent}}" class="mask" bindtap="closeContent"></view>
  <view wx:if="{{showContent}}" class="modal">
    <view class="modal-title">{{contentTitle}}</view>
    <scroll-view scroll-y class="content-box"><text>{{contentText}}</text></scroll-view>
    <button class="btn-cancel" bindtap="closeContent">关闭</button>
  </view>

  <!-- 新建文件夹 -->
  <view wx:if="{{showNewFolder}}" class="mask" bindtap="hideNewFolder"></view>
  <view wx:if="{{showNewFolder}}" class="modal">
    <view class="modal-title">新建文件夹</view>
    <view class="field-group">
      <text class="field-label">文件夹名称</text>
      <input class="field-input" value="{{newFolderName}}" placeholder="如：合同与资质、巡视记录" bindinput="onNewFolderInput" />
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideNewFolder">取消</button>
      <button class="btn-primary" loading="{{creatingFolder}}" bindtap="confirmNewFolder">创建</button>
    </view>
  </view>

  <!-- 重命名文件夹 -->
  <view wx:if="{{showRenameFolder}}" class="mask" bindtap="hideRenameFolder"></view>
  <view wx:if="{{showRenameFolder}}" class="modal">
    <view class="modal-title">重命名文件夹</view>
    <view class="field-group">
      <text class="field-label">文件夹名称</text>
      <input class="field-input" value="{{renameFolderName}}" placeholder="输入新的名称" bindinput="onRenameFolderInput" />
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideRenameFolder">取消</button>
      <button class="btn-primary" loading="{{renamingFolder}}" bindtap="confirmRenameFolder">保存</button>
    </view>
  </view>

  <!-- 标签管理：列出库内全部标签，可删除（仅摘标签，不动文档） -->
  <view wx:if="{{showTagManage}}" class="mask" bindtap="hideTagManage"></view>
  <view wx:if="{{showTagManage}}" class="modal">
    <view class="modal-title">标签管理</view>
    <scroll-view scroll-y class="picker-list">
      <view wx:for="{{tags}}" wx:key="id" class="prow">
        <text class="prow-name">{{item.name}}（{{item.count}}）</text>
        <text class="prow-arrow prow-del" data-id="{{item.id}}" catchtap="deleteTagInManage">删除</text>
      </view>
      <view wx:if="{{!tags.length}}" class="empty-mini">还没有标签。在文档卡片上点「标签」即可新建。</view>
    </scroll-view>
    <button class="btn-cancel" bindtap="hideTagManage">关闭</button>
  </view>

  <!-- 编辑文档标签：勾选已有标签 + 输入新建（全量替换保存） -->
  <view wx:if="{{showTagEdit}}" class="mask" bindtap="cancelTagEdit"></view>
  <view wx:if="{{showTagEdit}}" class="modal">
    <view class="modal-title">设置标签</view>
    <view class="field-group">
      <text class="field-label">文档：{{editingDocName}}</text>
    </view>
    <scroll-view scroll-y class="picker-list">
      <view wx:for="{{tags}}" wx:key="id" class="prow" data-id="{{item.id}}" bindtap="toggleEditTag">
        <text class="prow-name">{{editTagIds.indexOf(item.id) >= 0 ? '☑' : '☐'}} {{item.name}}</text>
      </view>
      <view wx:if="{{!tags.length}}" class="empty-mini">还没有标签，用下面的输入框新建第一个。</view>
    </scroll-view>
    <view class="field-group tag-new-row">
      <input class="field-input" value="{{newTagName}}" placeholder="新标签名称" bindinput="onNewTagInput" bindconfirm="createTagInline" />
      <button class="btn-plain" size="mini" loading="{{creatingTag}}" bindtap="createTagInline">新建</button>
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="cancelTagEdit">取消</button>
      <button class="btn-primary" loading="{{savingTags}}" bindtap="confirmSaveDocTags">保存</button>
    </view>
  </view>

  <!-- 文件夹选择器：根目录上传前选目标 / 录音归档 / 文档移动 -->
  <view wx:if="{{showPicker}}" class="mask" bindtap="hidePicker"></view>
  <view wx:if="{{showPicker}}" class="modal">
    <view class="modal-title">{{pickerTitle}}</view>
    <scroll-view scroll-y class="picker-list">
      <view wx:if="{{pickerMode === 'move'}}" class="prow" data-id="0" bindtap="choosePickerFolder">
        <text class="prow-name prow-muted">未分类（根目录）</text>
      </view>
      <view
        wx:for="{{folderOptions}}"
        wx:key="id"
        class="prow"
        data-id="{{item.id}}"
        bindtap="choosePickerFolder"
        style="padding-left: {{24 + item.depth * 30}}rpx"
      >
        <text class="prow-name">{{item.name}}</text>
        <text class="prow-arrow">›</text>
      </view>
    </scroll-view>
    <button class="btn-cancel" bindtap="hidePicker">取消</button>
  </view>
</view>
