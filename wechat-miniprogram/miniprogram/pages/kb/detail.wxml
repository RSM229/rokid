<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="知识详情" left="back" custom-back bind:lefttap="onNavBack" />

  <view class="card kb-head">
    <view class="kb-top">
      <view class="kb-name">{{kb.name}}</view>
      <view class="kb-tag {{kb.kb_type}}">{{kb.kb_type === 'shared' ? '共享' : '个人'}}</view>
    </view>
    <view wx:if="{{kb.description}}" class="kb-desc">{{kb.description}}</view>
    <view class="kb-sub">{{kb.document_count}} 份文档 · {{kb.member_count}} 位成员 · 我的角色：{{roleLabel[kb.role]}}</view>
    <view class="kb-actions">
      <button wx:if="{{canUpload}}" class="btn-primary" size="mini" bindtap="uploadDoc">+ 上传文档</button>
      <button wx:if="{{false}}" class="btn-green" size="mini" bindtap="toggleRecord">{{recording ? ('停止录音 ' + recSec + 's') : '录音转写'}}</button>
      <button wx:if="{{false}}" class="btn-gray" size="mini" bindtap="chooseAudio">音频文件</button>
      <button wx:if="{{canManage && kb.kb_type === 'shared'}}" class="btn-green" size="mini" bindtap="showInvite">邀请码</button>
      <button wx:if="{{canManage && kb.kb_type === 'shared'}}" class="btn-gray" size="mini" bindtap="togglePublish">{{kb.is_public ? '取消发布' : '发布到广场'}}</button>
      <button wx:if="{{canManage}}" class="btn-gray" size="mini" bindtap="showAddMember">+ 成员</button>
    </view>
    <view wx:if="{{kb.is_builtin}}" class="builtin-tip">系统内置资料库，文档由「规范库维护」统一管理，可直接检索与问答。</view>
  </view>

  <view wx:if="{{kb.is_project_archive}}" class="archive-tip">
    <view class="archive-tip-copy">
      <text class="archive-tip-title">归档资料库</text>
      <text class="archive-tip-sub">文书归档在「项目文件夹 / 工作记录与表单 / 对应类型」</text>
    </view>
    <button
      wx:if="{{canUpload && archivePending > 0}}"
      class="btn-gray archive-sync-btn"
      size="mini"
      loading="{{backfilling}}"
      bindtap="syncArchiveBackfill"
    >同步历史文书（{{archivePending}}）</button>
  </view>

  <view class="tabs">
    <view class="{{tab === 'docs' ? 'active' : ''}}" data-tab="docs" bindtap="onTab">文档 ({{kb.document_count}})</view>
    <view class="{{tab === 'qa' ? 'active' : ''}}" data-tab="qa" bindtap="onTab">问答</view>
    <view class="{{tab === 'members' ? 'active' : ''}}" data-tab="members" bindtap="onTab">成员 ({{kb.member_count}})</view>
  </view>

  <!-- 文档 -->
  <block wx:if="{{tab === 'docs'}}">
    <!-- 回收站入口：点此切换回收站视图（始终可见） -->
    <view class="trash-row">
      <text class="trash-link" bindtap="toggleTrash">{{showTrash ? '← 返回资料库' : '回收站'}}</text>
    </view>

    <block wx:if="{{!showTrash}}">
    <view class="breadcrumb">
      <text class="crumb {{currentFolderId === 0 ? 'on' : ''}}" data-id="0" bindtap="goBreadcrumb">根目录</text>
      <text wx:for="{{breadcrumb}}" wx:key="id" class="crumb {{item.id === currentFolderId ? 'on' : ''}}" data-id="{{item.id}}" bindtap="goBreadcrumb"> › {{item.name}}</text>
    </view>

    <!-- 文件夹操作行：「+ ▾」下拉（新建/重命名/删除）。当前目录为根时，重命名/删除禁用 -->
    <view wx:if="{{canUpload}}" class="folder-ops">
      <text class="ops-title">文件夹</text>
      <view class="ops-right">
        <text class="sec-act" bindtap="toggleFolderMenu">+ ▾</text>
        <view wx:if="{{showFolderMenu}}" class="folder-menu">
          <view class="fmenu-item" bindtap="menuNewFolder">新建文件夹</view>
          <view class="fmenu-item {{currentFolderId === 0 ? 'fmenu-disabled' : ''}}" bindtap="menuRenameFolder">重命名文件夹</view>
          <view class="fmenu-item fmenu-danger {{currentFolderId === 0 ? 'fmenu-disabled' : ''}}" bindtap="menuDeleteFolder">删除文件夹</view>
        </view>
      </view>
    </view>

    <!-- 搜索：输入即全局搜文档名称（不带文件夹过滤），清空恢复文件夹视图 -->
    <view class="search-bar">
      <input
        class="search-input"
        value="{{searchKeyword}}"
        placeholder="搜索文档名称"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>
    <view wx:if="{{searchKeyword}}" class="search-tip">搜索「{{searchKeyword}}」：{{docs.length}} 条结果</view>

    <view wx:if="{{!searchKeyword && currentSubfolders.length}}" class="folder-grid">
      <view wx:for="{{currentSubfolders}}" wx:key="id" class="folder-card" data-id="{{item.id}}" bindtap="selectFolder">
        <text class="folder-ico">📁</text>
        <text class="folder-name">{{item.name}}</text>
        <text class="folder-count">{{item.count}} 份</text>
      </view>
    </view>

    <view wx:if="{{docsLoading && !docs.length && !currentSubfolders.length}}" class="empty">正在加载…</view>
    <view wx:elif="{{!currentSubfolders.length && !docs.length}}" class="empty">{{searchKeyword ? '没有匹配的文档，换个关键词试试' : (kb.is_project_archive ? '当前目录暂无文档。文书会自动归档到「项目文件夹 / 工作记录与表单」下对应类型目录。' : '还没有文档，点上方“+ 上传文档”归档到分类')}}</view>
    <view wx:for="{{docs}}" wx:key="id" class="card doc">
      <view class="doc-name">{{item.name}}</view>
      <view class="doc-meta">{{item.sizeText}} · {{item.uploader_name}}</view>
      <view wx:if="{{item.tags && item.tags.length}}" class="doc-tags">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id" class="doc-tag-chip">{{tag.name}}</text>
      </view>
      <view class="doc-btns">
        <text class="link-green" data-id="{{item.id}}" bindtap="openContent">查看</text>
        <text class="link-gray" data-id="{{item.id}}" bindtap="downloadDoc">下载</text>
        <text wx:if="{{canUpload}}" class="link-gray" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openTagEdit">标签</text>
        <text wx:if="{{canUpload}}" class="link-red" data-id="{{item.id}}" bindtap="deleteDoc">删除</text>
      </view>
    </view>
    </block>

    <!-- 回收站：软删除文档，可恢复 / 彻底删除 -->
    <view wx:if="{{showTrash}}" class="trash-view">
      <view class="sec-head">
        <text class="sec-title">回收站</text>
        <text class="sec-count">{{trashDocs.length}}</text>
      </view>
      <view wx:if="{{trashLoading && !trashDocs.length}}" class="empty">正在加载…</view>
      <view wx:elif="{{!trashDocs.length}}" class="empty">回收站是空的。删除的文档会先到这里，可恢复或彻底删除。</view>
      <view wx:for="{{trashDocs}}" wx:key="id" class="card doc">
        <view class="doc-name">{{item.name}}</view>
        <view class="doc-meta">{{item.sizeText}} · {{item.uploader_name}}</view>
        <view class="doc-btns">
          <text class="link-green" data-id="{{item.id}}" bindtap="restoreDoc">恢复</text>
          <text class="link-red" data-id="{{item.id}}" bindtap="purgeDoc">彻底删除</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 问答 -->
  <block wx:if="{{tab === 'qa'}}">
    <view class="card">
      <textarea class="qa-input" value="{{question}}" placeholder="基于本资料库提问，例如：旁站记录应包含哪些内容？" bindinput="onQuestionInput" auto-height maxlength="1000" />
      <button class="btn-primary btn-full" loading="{{asking}}" bindtap="ask">提问</button>
    </view>
    <view wx:if="{{answer || citations.length}}" class="card answer">
      <view class="answer-title">回答</view>
      <view class="answer-body">{{answer}}</view>
      <view class="answer-actions">
        <button wx:if="{{answer}}" class="btn-green" size="mini" bindtap="saveAnswerNote">保存为笔记</button>
      </view>
      <view wx:if="{{citations.length}}" class="citations">
        <view class="cite-title">引用来源</view>
        <view wx:for="{{citations}}" wx:key="id" class="cite-item">
          <view class="cite-name">[{{item.name}}]</view>
          <view class="cite-snippet">{{item.snippet}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 成员 -->
  <block wx:if="{{tab === 'members'}}">
    <view wx:if="{{membersLoading && !members.length}}" class="empty">正在加载…</view>
    <view wx:for="{{members}}" wx:key="user_id" class="card member">
      <view class="member-info">
        <view class="member-name">{{item.real_name}}</view>
        <view class="member-user">@{{item.username}}</view>
      </view>
      <view class="member-role">{{item.roleLabel}}</view>
      <text wx:if="{{canManage && item.role !== 'owner'}}" class="link-red" data-id="{{item.user_id}}" bindtap="removeMember">移除</text>
    </view>
  </block>

  <!-- 文件夹下拉菜单的透明背板：点页面其他位置关闭（菜单本体 z-index 更高，保持可点） -->
  <view wx:if="{{showFolderMenu}}" class="menu-mask" bindtap="closeFolderMenu"></view>

  <!-- 文档内容 -->
  <view wx:if="{{showContent}}" class="mask" bindtap="closeContent"></view>
  <view wx:if="{{showContent}}" class="modal content-modal">
    <view class="modal-title">{{contentTitle}}</view>
    <scroll-view scroll-y class="content-scroll">
      <text class="content-text">{{contentText}}</text>
    </scroll-view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="closeContent">关闭</button>
    </view>
  </view>

  <!-- 添加成员 -->
  <view wx:if="{{showAddMember}}" class="mask" bindtap="hideAddMember"></view>
  <view wx:if="{{showAddMember}}" class="modal">
    <view class="modal-title">添加成员</view>
    <view class="field-group">
      <text class="field-label">用户名</text>
      <input class="field-input" value="{{addUsername}}" placeholder="对方的登录用户名" bindinput="onAddInput" />
    </view>
    <view class="field-group">
      <text class="field-label">角色</text>
      <picker mode="selector" range="{{addRoleLabels}}" value="{{addRoleIndex}}" bindchange="onAddRole">
        <view class="field-input picker-val">{{addRoleLabels[addRoleIndex]}} ▾</view>
      </picker>
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideAddMember">取消</button>
      <button class="btn-primary" loading="{{adding}}" bindtap="confirmAddMember">添加</button>
    </view>
  </view>

  <!-- 重命名文件夹 -->
  <view wx:if="{{showRenameFolder}}" class="mask" bindtap="hideRenameFolder"></view>
  <view wx:if="{{showRenameFolder}}" class="modal">
    <view class="modal-title">重命名文件夹</view>
    <view class="field-group">
      <text class="field-label">文件夹名称</text>
      <input class="field-input" value="{{renameFolderName}}" placeholder="输入新的名称" bindinput="onRenameFolderInput" />
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideRenameFolder">取消</button>
      <button class="btn-primary" loading="{{renamingFolder}}" bindtap="confirmRenameFolder">保存</button>
    </view>
  </view>

  <!-- 新建文件夹 -->
  <view wx:if="{{showNewFolder}}" class="mask" bindtap="hideNewFolder"></view>
  <view wx:if="{{showNewFolder}}" class="modal">
    <view class="modal-title">新建文件夹</view>
    <view class="field-group">
      <text class="field-label">文件夹名称</text>
      <input class="field-input" value="{{newFolderName}}" placeholder="如：合同与资质、巡视记录" bindinput="onNewFolderInput" />
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideNewFolder">取消</button>
      <button class="btn-primary" loading="{{creatingFolder}}" bindtap="confirmNewFolder">创建</button>
    </view>
  </view>

  <!-- 编辑文档标签：勾选已有标签 + 输入新建（全量替换保存） -->
  <view wx:if="{{showTagEdit}}" class="mask" bindtap="cancelTagEdit"></view>
  <view wx:if="{{showTagEdit}}" class="modal">
    <view class="modal-title">设置标签</view>
    <view class="field-group">
      <text class="field-label">文档：{{editingDocName}}</text>
    </view>
    <scroll-view scroll-y class="picker-list">
      <view wx:for="{{tags}}" wx:key="id" class="prow" data-id="{{item.id}}" bindtap="toggleEditTag">
        <text class="prow-name">{{editTagIds.indexOf(item.id) >= 0 ? '☑' : '☐'}} {{item.name}}</text>
      </view>
      <view wx:if="{{!tags.length}}" class="empty-mini">还没有标签，用下面的输入框新建第一个。</view>
    </scroll-view>
    <view class="field-group tag-new-row">
      <input class="field-input" value="{{newTagName}}" placeholder="新标签名称" bindinput="onNewTagInput" bindconfirm="createTagInline" />
      <button class="btn-plain" size="mini" loading="{{creatingTag}}" bindtap="createTagInline">新建</button>
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="cancelTagEdit">取消</button>
      <button class="btn-primary" loading="{{savingTags}}" bindtap="confirmSaveDocTags">保存</button>
    </view>
  </view>
</view>
