<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="知识详情" left="back" />

  <view class="card kb-head">
    <view class="kb-top">
      <view class="kb-name">{{kb.name}}</view>
      <view class="kb-tag {{kb.kb_type}}">{{kb.kb_type === 'shared' ? '共享' : '个人'}}</view>
    </view>
    <view wx:if="{{kb.description}}" class="kb-desc">{{kb.description}}</view>
    <view class="kb-sub">{{kb.document_count}} 份文档 · {{kb.member_count}} 位成员 · 我的角色：{{roleLabel[kb.role]}}</view>
    <view class="kb-actions">
      <button wx:if="{{canUpload}}" class="btn-primary" size="mini" bindtap="uploadDoc">+ 上传文档</button>
      <button wx:if="{{canUpload}}" class="btn-green" size="mini" bindtap="toggleRecord">{{recording ? ('停止录音 ' + recSec + 's') : '录音转写'}}</button>
      <button wx:if="{{canUpload}}" class="btn-gray" size="mini" bindtap="chooseAudio">音频文件</button>
      <button wx:if="{{canManage && kb.kb_type === 'shared'}}" class="btn-green" size="mini" bindtap="showInvite">邀请码</button>
      <button wx:if="{{canManage && kb.kb_type === 'shared'}}" class="btn-gray" size="mini" bindtap="togglePublish">{{kb.is_public ? '取消发布' : '发布到广场'}}</button>
      <button wx:if="{{canManage}}" class="btn-gray" size="mini" bindtap="showAddMember">+ 成员</button>
    </view>
    <view wx:if="{{kb.is_builtin}}" class="builtin-tip">系统内置资料库，文档由「规范库维护」统一管理，可直接检索与问答。</view>
  </view>

  <view class="tabs">
    <view class="{{tab === 'docs' ? 'active' : ''}}" data-tab="docs" bindtap="onTab">文档 ({{kb.document_count}})</view>
    <view class="{{tab === 'qa' ? 'active' : ''}}" data-tab="qa" bindtap="onTab">问答</view>
    <view class="{{tab === 'members' ? 'active' : ''}}" data-tab="members" bindtap="onTab">成员 ({{kb.member_count}})</view>
  </view>

  <!-- 文档 -->
  <block wx:if="{{tab === 'docs'}}">
    <view class="breadcrumb">
      <text class="crumb {{currentFolderId === 0 ? 'on' : ''}}" data-id="0" bindtap="goBreadcrumb">全部</text>
      <text wx:for="{{breadcrumb}}" wx:key="id" class="crumb {{item.id === currentFolderId ? 'on' : ''}}" data-id="{{item.id}}" bindtap="goBreadcrumb"> › {{item.name}}</text>
    </view>

    <view wx:if="{{currentSubfolders.length}}" class="folder-grid">
      <view wx:for="{{currentSubfolders}}" wx:key="id" class="folder-card" data-id="{{item.id}}" bindtap="selectFolder">
        <text class="folder-ico">📁</text>
        <text class="folder-name">{{item.name}}</text>
        <text class="folder-count">{{item.count}} 份</text>
        <text wx:if="{{canUpload}}" class="folder-rename" data-id="{{item.id}}" catchtap="openRenameFolder">重命名</text>
        <text wx:if="{{canUpload}}" class="folder-del" data-id="{{item.id}}" catchtap="deleteFolder">删除</text>
      </view>
    </view>

    <view wx:if="{{docsLoading && !docs.length && !currentSubfolders.length}}" class="empty">正在加载…</view>
    <view wx:elif="{{!currentSubfolders.length && !docs.length}}" class="empty">还没有文档，点上方“+ 上传文档”归档到分类</view>
    <view wx:for="{{docs}}" wx:key="id" class="card doc">
      <view class="doc-name">{{item.name}}</view>
      <view class="doc-meta">{{item.sizeText}} · {{item.uploader_name}}</view>
      <view class="doc-btns">
        <text class="link-green" data-id="{{item.id}}" bindtap="openContent">查看</text>
        <text class="link-gray" data-id="{{item.id}}" bindtap="downloadDoc">下载</text>
        <text wx:if="{{canUpload}}" class="link-red" data-id="{{item.id}}" bindtap="deleteDoc">删除</text>
      </view>
    </view>
  </block>

  <!-- 问答 -->
  <block wx:if="{{tab === 'qa'}}">
    <view class="card">
      <textarea class="qa-input" value="{{question}}" placeholder="基于本资料库提问，例如：旁站记录应包含哪些内容？" bindinput="onQuestionInput" auto-height maxlength="1000" />
      <button class="btn-primary btn-full" loading="{{asking}}" bindtap="ask">提问</button>
    </view>
    <view wx:if="{{answer || citations.length}}" class="card answer">
      <view class="answer-title">回答</view>
      <view class="answer-body">{{answer}}</view>
      <view class="answer-actions">
        <button wx:if="{{answer}}" class="btn-green" size="mini" bindtap="saveAnswerNote">保存为笔记</button>
      </view>
      <view wx:if="{{citations.length}}" class="citations">
        <view class="cite-title">引用来源</view>
        <view wx:for="{{citations}}" wx:key="id" class="cite-item">
          <view class="cite-name">[{{item.name}}]</view>
          <view class="cite-snippet">{{item.snippet}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 成员 -->
  <block wx:if="{{tab === 'members'}}">
    <view wx:if="{{membersLoading && !members.length}}" class="empty">正在加载…</view>
    <view wx:for="{{members}}" wx:key="user_id" class="card member">
      <view class="member-info">
        <view class="member-name">{{item.real_name}}</view>
        <view class="member-user">@{{item.username}}</view>
      </view>
      <view class="member-role">{{item.roleLabel}}</view>
      <text wx:if="{{canManage && item.role !== 'owner'}}" class="link-red" data-id="{{item.user_id}}" bindtap="removeMember">移除</text>
    </view>
  </block>

  <!-- 文档内容 -->
  <view wx:if="{{showContent}}" class="mask" bindtap="closeContent"></view>
  <view wx:if="{{showContent}}" class="modal content-modal">
    <view class="modal-title">{{contentTitle}}</view>
    <scroll-view scroll-y class="content-scroll">
      <text class="content-text">{{contentText}}</text>
    </scroll-view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="closeContent">关闭</button>
    </view>
  </view>

  <!-- 添加成员 -->
  <view wx:if="{{showAddMember}}" class="mask" bindtap="hideAddMember"></view>
  <view wx:if="{{showAddMember}}" class="modal">
    <view class="modal-title">添加成员</view>
    <view class="field-group">
      <text class="field-label">用户名</text>
      <input class="field-input" value="{{addUsername}}" placeholder="对方的登录用户名" bindinput="onAddInput" />
    </view>
    <view class="field-group">
      <text class="field-label">角色</text>
      <picker mode="selector" range="{{addRoleLabels}}" value="{{addRoleIndex}}" bindchange="onAddRole">
        <view class="field-input picker-val">{{addRoleLabels[addRoleIndex]}} ▾</view>
      </picker>
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideAddMember">取消</button>
      <button class="btn-primary" loading="{{adding}}" bindtap="confirmAddMember">添加</button>
    </view>
  </view>

  <!-- 重命名文件夹 -->
  <view wx:if="{{showRenameFolder}}" class="mask" bindtap="hideRenameFolder"></view>
  <view wx:if="{{showRenameFolder}}" class="modal">
    <view class="modal-title">重命名文件夹</view>
    <view class="field-group">
      <text class="field-label">文件夹名称</text>
      <input class="field-input" value="{{renameFolderName}}" placeholder="输入新的名称" bindinput="onRenameFolderInput" />
    </view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideRenameFolder">取消</button>
      <button class="btn-primary" loading="{{renamingFolder}}" bindtap="confirmRenameFolder">保存</button>
    </view>
  </view>
</view>
