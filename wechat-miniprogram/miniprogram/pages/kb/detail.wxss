/* 玻璃拟态改造（浅色版） */
.card { padding: 24rpx; margin-bottom: 14rpx; background: #ffffff; border: 2rpx solid rgba(var(--brand-rgb, 10,109,255), 0.14); border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }

.kb-head .kb-top { display: flex; justify-content: space-between; align-items: center; }
.kb-name { flex: 1; font-size: 32rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.kb-tag { flex-shrink: 0; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 500; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, var(--brand-l, #2b96ff)); }
.kb-tag.shared { background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-d, #0060df); }
.kb-desc { margin-top: 8rpx; color: #667; font-size: 24rpx; }
.kb-sub { margin-top: 10rpx; color: #999; font-size: 23rpx; }
.kb-actions { display: flex; gap: 14rpx; margin-top: 18rpx; flex-wrap: wrap; }
.builtin-tip { margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-d, #0060df); font-size: 23rpx; line-height: 1.5; }

.archive-tip { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.9); border: 2rpx solid rgba(var(--brand-rgb, 10,109,255), 0.14); }
.archive-tip-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.archive-tip-title { color: var(--brand-d, #0060df); font-size: 24rpx; font-weight: 600; }
.archive-tip-sub { color: #5c6e84; font-size: 21rpx; line-height: 1.4; }
.archive-sync-btn { flex: none; }

.tabs { display: flex; gap: 10rpx; margin-bottom: 18rpx; padding: 8rpx; border-radius: 20rpx; background: rgba(230,236,245, 0.7); }
.tabs view { flex: 1; padding: 16rpx 0; text-align: center; border-radius: 16rpx; color: #5c6e84; font-size: 25rpx; font-weight: 500; }
.tabs .active { color: #fff; background: linear-gradient(135deg, var(--brand-l, #2b96ff), var(--brand-d, #0060df)); font-weight: 700; }

.btn-primary { background: linear-gradient(135deg, var(--brand-l, #2b96ff), var(--brand-d, #0060df)); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-green { background: var(--brand-l, #2b96ff); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-gray { background: rgba(238, 242, 240, 0.8); color: #40566e; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-full { width: 100%; margin-top: 16rpx; height: 76rpx; line-height: 76rpx; }

.doc-name { font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); }
.doc-meta { margin-top: 6rpx; color: #999; font-size: 23rpx; }
.doc-btns { display: flex; gap: 30rpx; margin-top: 14rpx; }
.link-green { color: var(--brand-l, var(--brand-l, #2b96ff)); font-size: 25rpx; font-weight: 600; }
.link-gray { color: #6b7c90; font-size: 25rpx; }
.link-red { color: #d9534f; font-size: 25rpx; font-weight: 600; }

.qa-input { width: 100%; min-height: 140rpx; padding: 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; background: #ffffff; box-sizing: border-box; }
.answer-title { font-size: 26rpx; font-weight: 700; color: var(--ink-2, #243b55); margin-bottom: 10rpx; }
.answer-body { font-size: 27rpx; color: #334; line-height: 1.7; white-space: pre-wrap; }
.answer-actions { margin-top: 16rpx; }
.citations { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.cite-title { font-size: 24rpx; font-weight: 600; color: #5c6e84; margin-bottom: 10rpx; }
.cite-item { margin-bottom: 12rpx; }
.cite-name { color: var(--brand-l, var(--brand-l, #2b96ff)); font-size: 24rpx; font-weight: 600; }
.cite-snippet { color: #889; font-size: 23rpx; line-height: 1.5; }

.member { display: flex; align-items: center; gap: 16rpx; }
.member-info { flex: 1; }
.member-name { font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); }
.member-user { font-size: 22rpx; color: #999; }
.member-role { font-size: 23rpx; color: var(--brand-d, #0060df); background: rgba(var(--wash-rgb, 234,243,255), 0.85); border-radius: 8rpx; padding: 4rpx 14rpx; }

.empty { padding: 90rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }

.breadcrumb { display: flex; flex-wrap: wrap; align-items: center; padding: 6rpx 4rpx 16rpx; font-size: 24rpx; color: #6b7c90; }
.crumb { color: #6b7c90; }
.crumb.on { color: var(--brand-l, #2b96ff); font-weight: 600; }

.folder-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 18rpx; }
.folder-card { width: calc((100% - 28rpx) / 3); box-sizing: border-box; padding: 20rpx 14rpx; background: #ffffff; border: 2rpx solid rgba(var(--brand-rgb, 10,109,255), 0.14); border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; }
.folder-ico { font-size: 40rpx; line-height: 1; }
.folder-name { margin-top: 10rpx; font-size: 24rpx; font-weight: 600; color: var(--ink-2, #243b55); text-align: center; }
.folder-count { margin-top: 6rpx; font-size: 20rpx; color: #999; }
/* 搜索栏：输入即搜（300ms 防抖），清空恢复文件夹视图 */
.search-bar { position: relative; display: flex; align-items: center; margin: 16rpx 0 14rpx; }
.search-input { flex: 1; height: 68rpx; padding: 0 64rpx 0 28rpx; background: #ffffff; border: 2rpx solid rgba(var(--brand-rgb, 10,109,255), 0.14); border-radius: 34rpx; font-size: 26rpx; color: var(--ink-2, #243b55); }
.search-clear { position: absolute; right: 20rpx; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; font-size: 24rpx; color: #8a94a6; }
.search-tip { margin-bottom: 14rpx; font-size: 22rpx; color: #8a94a6; }
/* 文件夹操作行：「+ ▾」下拉菜单（新建/重命名/删除），锚定在触发按钮正下方 */
.folder-ops { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 6rpx 14rpx; }
.ops-title { font-size: 26rpx; font-weight: 700; color: #6b7c90; letter-spacing: 2rpx; }
.sec-act { font-size: 24rpx; font-weight: 600; color: var(--brand-l, #2b96ff); padding: 6rpx 18rpx; border-radius: 999rpx; background: rgba(var(--brand-rgb, 10,109,255), 0.08); }
.sec-act:active { background: rgba(var(--brand-rgb, 10,109,255), 0.16); }
.folder-ops .ops-right { position: relative; }
.folder-menu { position: absolute; top: 54rpx; right: 0; min-width: 230rpx; background: rgba(255,255,255,0.97); border: 2rpx solid rgba(var(--brand-rgb, 10,109,255), 0.14); border-radius: 16rpx; box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.14); z-index: 1002; overflow: hidden; }
.fmenu-item { padding: 22rpx 28rpx; font-size: 26rpx; color: var(--ink-2, #243b55); }
.fmenu-item:not(:last-child) { border-bottom: 1rpx solid rgba(var(--brand-rgb, 10,109,255), 0.08); }
.fmenu-item:active { background: rgba(var(--brand-rgb, 10,109,255), 0.06); }
.fmenu-danger { color: #d9534f; font-weight: 600; }
.fmenu-disabled { color: #b8c2cc; }
/* 下拉菜单透明背板：只捕获外部点击关闭菜单，不做视觉遮挡 */
.menu-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; background: transparent; }
/* 弹窗三层关系：mask=纯背板（点它关闭），modal=平级兄弟节点（自己固定定位+垂直居中）。
   早期把 modal 嵌在 mask 里、靠 catchtap="" 阻止冒泡，实测点输入框/按钮会冒泡触发
   mask 的关闭事件，弹窗一闪就没。平级后点 modal 内部不经过 mask，与 index 页一致。 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60, 0.35); z-index: 1000; }
.modal { position: fixed; left: 40rpx; right: 40rpx; top: 50%; transform: translateY(-50%); z-index: 1001; background: #ffffff; border: 2rpx solid rgba(var(--brand-rgb, 10,109,255), 0.14); border-radius: 20rpx; padding: 28rpx; box-sizing: border-box; box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.content-modal { max-height: 80vh; display: flex; flex-direction: column; }
.modal-title { font-size: 30rpx; font-weight: 700; color: var(--ink-2, #243b55); margin-bottom: 20rpx; }
.content-scroll { max-height: 56vh; }
.content-text { font-size: 25rpx; color: #334; line-height: 1.7; white-space: pre-wrap; }
.field-group { margin-bottom: 22rpx; }
.field-label { display: block; margin-bottom: 8rpx; font-size: 25rpx; color: #555; font-weight: 600; }
.field-input { width: 100%; height: 72rpx; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; background: #ffffff; box-sizing: border-box; }
.picker-val { line-height: 72rpx; color: var(--brand-l, var(--brand-l, #2b96ff)); }
.modal-btns { display: flex; gap: 16rpx; margin-top: 10rpx; }
.modal-btns button { flex: 1; height: 76rpx; line-height: 76rpx; margin: 0; font-size: 27rpx; }
.btn-cancel { background: rgba(245, 245, 245, 0.8); color: #666; border-radius: 12rpx; border: none; }

/* 文件夹选择器/标签编辑共用清单样式 */
.picker-list { max-height: 52vh; margin-bottom: 18rpx; }
.prow { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; border-bottom: 1rpx solid rgba(var(--brand-rgb, 10,109,255), 0.09); }
.prow:active { background: rgba(var(--brand-rgb, 10,109,255), 0.06); }
.prow-name { font-size: 27rpx; color: var(--ink-2, #243b55); }
.empty-mini { padding: 36rpx 28rpx; background: rgba(255, 255, 255, 0.60); border: 1rpx dashed rgba(var(--brand-rgb, 10,109,255), 0.22); border-radius: 20rpx; color: #8a94a6; font-size: 24rpx; line-height: 1.7; text-align: center; }

/* 编辑标签弹窗里「新建标签」的输入行 */
.tag-new-row { display: flex; align-items: center; gap: 14rpx; }
.tag-new-row .field-input { flex: 1; }
.btn-plain { background: rgba(255,255,255,0.55); color: var(--brand-d, #0060df); font-size: 24rpx; border-radius: 12rpx; border: 2rpx solid rgba(var(--brand-rgb, 10,109,255), 0.28); }
.tag-new-row .btn-plain { flex: none; height: 64rpx; line-height: 64rpx; margin: 0; }

/* 文档卡上的标签 chips */
.doc-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.doc-tag-chip { padding: 4rpx 14rpx; font-size: 20rpx; color: var(--brand-d, #0060df); background: rgba(var(--brand-rgb, 10,109,255), 0.10); border-radius: 999rpx; }

/* 回收站入口：点此切换回收站视图 */
.trash-row { display: flex; justify-content: flex-end; padding: 2rpx 4rpx 14rpx; }
.trash-link { font-size: 24rpx; font-weight: 600; color: var(--brand-l, #2b96ff); padding: 6rpx 18rpx; border-radius: 999rpx; background: rgba(var(--brand-rgb, 10,109,255), 0.08); }
.trash-link:active { background: rgba(var(--brand-rgb, 10,109,255), 0.16); }
.trash-view { margin-top: 4rpx; }
/* 回收站标题条（复用 .sec-head 视觉，避免引入 index 专有的 .sec 容器） */
.sec-head { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 4rpx 16rpx; }
.sec-title { font-size: 28rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.sec-count { font-size: 24rpx; color: #999; background: rgba(238,242,240,0.8); border-radius: 999rpx; padding: 4rpx 18rpx; }

/* 监理日记生成入口：仅资料库「监理日记」文件夹内显示 */
.diary-gen { border-color: rgba(var(--brand-rgb, 10,109,255), 0.28); }
.diary-gen-title { font-size: 28rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.diary-gen-sub { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: #6b7c90; }
.diary-gen-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.diary-date { padding: 12rpx 18rpx; border-radius: 12rpx; font-size: 24rpx; color: var(--brand-d, #0060df); background: rgba(var(--wash-rgb, 234,243,255), 0.85); }
.diary-gen-row .btn-primary { flex: none; margin: 0; }
