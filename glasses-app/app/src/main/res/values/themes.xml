<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 应用主主题（基于 Material3 DayNight，眼镜端强制深色高对比） -->
    <style name="Theme.Gdjl" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <!-- 文本默认高对比白色 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 登录页主题（浅色，便于表单输入） -->
    <style name="Theme.Gdjl.Login" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/surface</item>
    </style>

    <!-- 业务页统一主题（继承主主题，强制深色高对比，适配眼镜显示） -->
    <style name="Theme.Gdjl.Business" parent="Theme.Gdjl">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/background</item>
    </style>
</resources>
