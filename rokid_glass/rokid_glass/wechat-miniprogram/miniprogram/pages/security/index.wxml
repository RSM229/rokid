<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="密保问题" left="back" />

  <view class="header">
    <view class="title">密保问题</view>
    <view class="subtitle">忘记密码时，凭密保答案自助重置</view>
  </view>

  <view class="status">
    <text class="status-tag {{isSet ? 'ok' : 'no'}}">{{isSet ? '已设置' : '未设置'}}</text>
    <text class="status-hint">答案不区分大小写；已设置的答案不会回显，修改时需重新填写全部答案。</text>
  </view>

  <view class="form">
    <view class="form-item">
      <view class="label">当前密码 <text class="required">*</text></view>
      <input class="input" password placeholder="请输入当前登录密码" value="{{currentPassword}}" bindinput="onPasswordInput" />
    </view>

    <view class="form-item" wx:for="{{questions}}" wx:key="index">
      <view class="label">问题 {{index + 1}}</view>
      <input class="input" placeholder="如：我的小学名称" maxlength="256" value="{{item.question}}" data-index="{{index}}" bindinput="onQuestionInput" />
      <view class="label answer-label">答案</view>
      <input class="input" placeholder="请输入答案" maxlength="128" value="{{item.answer}}" data-index="{{index}}" bindinput="onAnswerInput" />
    </view>
  </view>

  <view class="ops">
    <button wx:if="{{questions.length < 3}}" class="btn-plain" bindtap="addQuestion">+ 添加一个问题</button>
    <button wx:if="{{questions.length > 1}}" class="btn-plain" bindtap="removeQuestion">删除最后一个</button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <button class="btn-primary" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="save">保存</button>
</view>
