<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="资料记录" left="back" />
  <tab-bar active="" />

  <!-- 顶部 tab：资料台账 / 问题清单 -->
  <view class="seg">
    <view class="seg-item {{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="switchTab">资料台账</view>
    <view class="seg-item {{tab === 'issues' ? 'active' : ''}}" data-tab="issues" bindtap="switchTab">问题清单</view>
  </view>

  <!-- ========== 台账 tab ========== -->
  <block wx:if="{{tab === 'records'}}">
    <view class="toolbar">
      <picker mode="selector" range="{{directionOptions}}" value="{{directionIndex}}" bindchange="onDirectionChange">
        <view class="type-filter">{{directionOptions[directionIndex]}} ▾</view>
      </picker>
      <button class="btn-primary" bindtap="createRec">+ 登记资料</button>
    </view>
    <view class="searchbar">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索资料名称 / 编号"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="searchRecords"
      />
    </view>

    <view wx:if="{{loading && !records.length}}" class="empty">加载中…</view>
    <view wx:elif="{{!records.length}}" class="empty">还没有资料记录，点上方「登记资料」</view>
    <view wx:for="{{records}}" wx:key="id" class="card rec" data-id="{{item.id}}" bindtap="editRec">
      <view class="rec-head">
        <text class="rec-badge {{item.dirClass}}">{{item.direction}}</text>
        <text class="rec-name">{{item.doc_name}}</text>
      </view>
      <view class="rec-meta">
        <text wx:if="{{item.doc_no}}">编号 {{item.doc_no}}</text>
        <text wx:if="{{item.unit}}">{{item.unit}}</text>
        <text wx:if="{{item.trans_date}}">{{item.trans_date}}</text>
        <text wx:if="{{item.handler}}" class="rec-handler">{{item.handler}}</text>
      </view>
      <view wx:if="{{item.remark}}" class="rec-remark">{{item.remark}}</view>
      <text class="rec-del" catchtap="delRec" data-id="{{item.id}}">删除</text>
    </view>
  </block>

  <!-- ========== 问题 tab ========== -->
  <block wx:if="{{tab === 'issues'}}">
    <view class="toolbar">
      <picker mode="selector" range="{{issueStatusOptions}}" value="{{issueStatusIndex}}" bindchange="onIssueStatusChange">
        <view class="type-filter">{{issueStatusOptions[issueStatusIndex]}} ▾</view>
      </picker>
      <button class="btn-primary" bindtap="createIssue">+ 发问题单</button>
    </view>

    <view wx:if="{{loading && !issues.length}}" class="empty">加载中…</view>
    <view wx:elif="{{!issues.length}}" class="empty">还没有问题单，点上方「发问题单」</view>
    <view wx:for="{{issues}}" wx:key="id" class="card issue" data-id="{{item.id}}" bindtap="editIssue">
      <view class="issue-head">
        <text class="issue-title">{{item.title}}</text>
        <text wx:if="{{item.issue_type}}" class="issue-type">{{item.issue_type}}</text>
        <text class="issue-badge {{item.statusClass}}">{{item.status}}</text>
      </view>
      <view class="issue-meta">
        <text wx:if="{{item.part}}">部位 {{item.part}}</text>
        <text wx:if="{{item.deadline}}" class="issue-deadline {{item.overdue ? 'overdue' : ''}}">截止 {{item.deadline}}</text>
      </view>
      <view wx:if="{{item.description}}" class="issue-desc">{{item.description}}</view>
      <text class="issue-del" catchtap="delIssue" data-id="{{item.id}}">删除</text>
    </view>
  </block>

  <!-- 登记资料 弹层表单 -->
  <view class="overlay" wx:if="{{showRecForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeRecForm"></view>
    <view class="overlay-panel work-form-panel">
      <view class="panel-header">
        <text class="panel-title">{{recForm.id ? '编辑资料' : '登记资料'}}</text>
      </view>
      <view class="form-group">
        <text class="form-label">方向 *</text>
        <picker mode="selector" range="{{directions}}" value="{{recDirIndex}}" bindchange="onRecDirChange">
          <view class="form-input picker-value">{{directions[recDirIndex]}}</view>
        </picker>
      </view>
      <view class="form-group"><text class="form-label">资料名称 *</text><input class="form-input" value="{{recForm.doc_name}}" data-field="doc_name" bindinput="onRecFormInput" placeholder="请输入资料名称" /></view>
      <view class="form-group"><text class="form-label">编号</text><input class="form-input" value="{{recForm.doc_no}}" data-field="doc_no" bindinput="onRecFormInput" placeholder="请输入编号（可选）" /></view>
      <view class="form-group"><text class="form-label">对方单位</text><input class="form-input" value="{{recForm.unit}}" data-field="unit" bindinput="onRecFormInput" placeholder="请输入对方单位（可选）" /></view>
      <view class="form-group">
        <text class="form-label">收发日期</text>
        <picker mode="date" value="{{recForm.trans_date}}" bindchange="onRecFormDateChange">
          <view class="form-input picker-value">{{recForm.trans_date || '请选择日期'}}</view>
        </picker>
      </view>
      <view class="form-group"><text class="form-label">经办人</text><input class="form-input" value="{{recForm.handler}}" data-field="handler" bindinput="onRecFormInput" placeholder="请输入经办人（可选）" /></view>
      <view class="form-group"><text class="form-label">备注</text><textarea class="form-textarea" value="{{recForm.remark}}" data-field="remark" bindinput="onRecFormInput" placeholder="备注（可选）" auto-height /></view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="closeRecForm">取消</button>
        <button class="btn-submit" loading="{{recSaving}}" bindtap="submitRecForm">保存</button>
      </view>
    </view>
  </view>

  <!-- 发问题单 弹层表单 -->
  <view class="overlay" wx:if="{{showIssueForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeIssueForm"></view>
    <view class="overlay-panel work-form-panel">
      <view class="panel-header">
        <text class="panel-title">{{issueForm.id ? '编辑问题单' : '发问题单'}}</text>
      </view>
      <view class="form-group"><text class="form-label">标题 *</text><input class="form-input" value="{{issueForm.title}}" data-field="title" bindinput="onIssueFormInput" placeholder="请输入问题标题" /></view>
      <view class="form-group">
        <text class="form-label">类型</text>
        <picker mode="selector" range="{{issueTypes}}" value="{{issueTypeIndex}}" bindchange="onIssueTypeChange">
          <view class="form-input picker-value">{{issueTypes[issueTypeIndex]}}</view>
        </picker>
      </view>
      <view class="form-group"><text class="form-label">部位</text><input class="form-input" value="{{issueForm.part}}" data-field="part" bindinput="onIssueFormInput" placeholder="请输入部位（可选）" /></view>
      <view class="form-group"><text class="form-label">问题描述</text><textarea class="form-textarea" value="{{issueForm.description}}" data-field="description" bindinput="onIssueFormInput" placeholder="请输入问题描述（可选）" auto-height /></view>
      <view class="form-group">
        <text class="form-label">状态</text>
        <picker mode="selector" range="{{issueStatuses}}" value="{{issueFormStatusIndex}}" bindchange="onIssueFormStatusChange">
          <view class="form-input picker-value">{{issueStatuses[issueFormStatusIndex]}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">截止日期</text>
        <picker mode="date" value="{{issueForm.deadline}}" bindchange="onIssueFormDateChange">
          <view class="form-input picker-value">{{issueForm.deadline || '请选择日期'}}</view>
        </picker>
      </view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="closeIssueForm">取消</button>
        <button class="btn-submit" loading="{{issueSaving}}" bindtap="submitIssueForm">保存</button>
      </view>
    </view>
  </view>
</view>
