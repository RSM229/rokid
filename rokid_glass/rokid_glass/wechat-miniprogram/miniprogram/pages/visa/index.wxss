/* 工程签证 — 沿用 meeting 页玻璃浅色 token */
.page { padding: 24rpx; }
.toolbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.status-filter {
  padding: 0 24rpx; height: 64rpx; line-height: 64rpx;
  font-size: 26rpx; color: var(--ink-2, #243b55);
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.25);
  border-radius: 12rpx;
}
.btn-primary {
  flex: 1; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0));
  color: #fff; font-size: 26rpx; border-radius: 12rpx; border: none;
}
.card { padding: 24rpx; margin-bottom: 14rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.empty { padding: 90rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }

/* 签证卡片 */
.visa-head { display: flex; align-items: center; gap: 12rpx; }
.visa-title { font-size: 29rpx; font-weight: 600; color: var(--ink-2, #243b55); flex: 1; }
.visa-status { flex-shrink: 0; font-size: 20rpx; padding: 2rpx 14rpx; border-radius: 999rpx; }
.s-draft { background: rgba(122,139,159,0.14); color: #7a8b9f; }
.s-pending { background: rgba(217,119,6,0.12); color: #d97706; }
.s-ok { background: rgba(47,158,99,0.12); color: #2f9e63; }
.s-bad { background: rgba(185,56,56,0.12); color: #b93838; }
.visa-meta { display: flex; gap: 20rpx; margin-top: 10rpx; font-size: 22rpx; color: #999; }
.visa-amount { margin-top: 10rpx; font-size: 32rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.visa-ops { display: flex; gap: 20rpx; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.10); }
.op { font-size: 24rpx; color: var(--ink-2, #243b55); font-weight: 600; }
.op-primary { color: var(--brand, #1677ff); }
.op-ok { color: #2f9e63; }
.op-danger { color: #b93838; }

/* 弹层（照抄 agent 页 overlay 体系） */
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 200; display: flex; align-items: flex-end; justify-content: center; }
.overlay-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60,0.35); }
.overlay-panel { position: relative; width: 100%; max-height: 85vh; background: linear-gradient(135deg, rgba(255,255,255,0.68), rgba(255,255,255,0.48)); backdrop-filter: blur(30rpx) saturate(1.8); -webkit-backdrop-filter: blur(30rpx) saturate(1.8); border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.16); border-radius: 32rpx 32rpx 0 0; padding: 40rpx 36rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), inset 0 -14rpx 30rpx rgba(var(--brand-rgb, 22,119,255), 0.10), 0 -8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); overflow-y: auto; box-sizing: border-box; }
.form-panel { max-height: 90vh; }
.panel-header { text-align: center; margin-bottom: 36rpx; }
.panel-title { display: block; font-size: 36rpx; font-weight: 700; color: var(--brand-deep, #0a2e5c); }
.panel-subtitle { display: block; font-size: 26rpx; color: #6b7c90; margin-top: 8rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink, #12253d); margin-bottom: 10rpx; }
.form-input { width: 100%; height: 76rpx; padding: 0 24rpx; border-radius: 16rpx; border: 1rpx solid rgba(255,255,255,0.72); background: rgba(255,255,255,0.46); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; min-height: 80rpx; padding: 16rpx 24rpx; border-radius: 16rpx; border: 1rpx solid rgba(255,255,255,0.72); background: rgba(255,255,255,0.46); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box; }
.picker-value { line-height: 76rpx; color: var(--ink, #12253d); }
.panel-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-cancel { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 30rpx; color: #6b7c90; background: rgba(255,255,255,0.50); text-align: center; }
.btn-submit { flex: 2; height: 80rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 30rpx; color: #fff; background: linear-gradient(135deg, var(--brand, #1677ff) 0%, var(--brand, #1677ff) 100%); text-align: center; }

/* 详情弹层 */
.detail-status-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.detail-amount { font-size: 36rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.detail-block { margin-bottom: 24rpx; }
.detail-label { font-size: 24rpx; font-weight: 600; color: var(--brand-l, #3b8cff); letter-spacing: 2rpx; margin-bottom: 8rpx; }
.detail-text { font-size: 26rpx; color: var(--ink, #12253d); line-height: 1.6; }
