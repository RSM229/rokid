<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="工程签证" left="back" />
  <tab-bar active="" />

  <view class="toolbar">
    <picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="status-filter">{{statusOptions[statusIndex]}} ▾</view>
    </picker>
    <button class="btn-primary" bindtap="openCreate">+ 新建签证</button>
  </view>

  <view wx:if="{{loading && !items.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">暂无{{statusOptions[statusIndex] === '全部' ? '' : statusOptions[statusIndex]}}签证，点上方「新建签证」</view>
  <view wx:for="{{items}}" wx:key="id" class="card visa" data-id="{{item.id}}" bindtap="openDetail">
    <view class="visa-head">
      <text class="visa-title">{{item.title}}</text>
      <text class="visa-status {{item.statusClass}}">{{item.status}}</text>
    </view>
    <view class="visa-meta">
      <text wx:if="{{item.visa_no}}">编号 {{item.visa_no}}</text>
      <text wx:if="{{item.apply_date}}">{{item.apply_date}}</text>
    </view>
    <view class="visa-amount">¥{{item.amountText}}</view>
    <!-- 卡片底部操作：按状态分流 -->
    <view class="visa-ops" wx:if="{{item.status === '草稿' || item.status === '已驳回'}}">
      <text class="op op-primary" catchtap="submit" data-id="{{item.id}}">提交审批</text>
      <text class="op" catchtap="openEdit" data-id="{{item.id}}">编辑</text>
      <text class="op op-danger" catchtap="del" data-id="{{item.id}}">删除</text>
    </view>
    <view class="visa-ops" wx:elif="{{item.status === '待审批'}}">
      <text class="op op-ok" catchtap="review" data-id="{{item.id}}" data-action="approve">批准</text>
      <text class="op op-danger" catchtap="review" data-id="{{item.id}}" data-action="reject">驳回</text>
    </view>
  </view>

  <!-- 新建/编辑弹层 -->
  <view class="overlay" wx:if="{{showForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeForm"></view>
    <view class="overlay-panel form-panel">
      <view class="panel-header">
        <text class="panel-title">{{editId ? '编辑签证' : '新建签证'}}</text>
      </view>
      <view class="form-group">
        <text class="form-label">标题 *</text>
        <input class="form-input" value="{{formTitle}}" data-field="formTitle" bindinput="onFormInput" placeholder="请输入签证标题" />
      </view>
      <view class="form-group">
        <text class="form-label">编号</text>
        <input class="form-input" value="{{formVisaNo}}" data-field="formVisaNo" bindinput="onFormInput" placeholder="如 QZ-2026-001" />
      </view>
      <view class="form-group">
        <text class="form-label">申请日期</text>
        <picker mode="date" value="{{formApplyDate}}" bindchange="onApplyDateChange">
          <view class="form-input picker-value">{{formApplyDate || '请选择日期'}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">签证原因</text>
        <textarea class="form-textarea" value="{{formReason}}" data-field="formReason" bindinput="onFormInput" placeholder="变更/签证发生的原因" auto-height />
      </view>
      <view class="form-group">
        <text class="form-label">签证内容</text>
        <textarea class="form-textarea" value="{{formContent}}" data-field="formContent" bindinput="onFormInput" placeholder="工程量、部位、做法等具体内容" auto-height />
      </view>
      <view class="form-group">
        <text class="form-label">金额（元）</text>
        <input class="form-input" type="digit" value="{{formAmount}}" data-field="formAmount" bindinput="onFormInput" placeholder="0.00" />
      </view>
      <view class="panel-actions">
        <button class="btn-cancel" bindtap="closeForm">取消</button>
        <button class="btn-submit" loading="{{saving}}" bindtap="save">保存</button>
      </view>
    </view>
  </view>

  <!-- 详情弹层（只读） -->
  <view class="overlay" wx:if="{{showDetail && detail}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeDetail"></view>
    <view class="overlay-panel form-panel">
      <view class="panel-header">
        <text class="panel-title">{{detail.title}}</text>
        <text class="panel-subtitle">{{detail.visa_no}} · {{detail.apply_date}}</text>
      </view>
      <view class="detail-status-row">
        <text class="visa-status {{detail.statusClass}}">{{detail.status}}</text>
        <text class="detail-amount">¥{{detail.amountText}}</text>
      </view>
      <view class="detail-block" wx:if="{{detail.reason}}">
        <view class="detail-label">签证原因</view>
        <view class="detail-text">{{detail.reason}}</view>
      </view>
      <view class="detail-block" wx:if="{{detail.content}}">
        <view class="detail-label">签证内容</view>
        <view class="detail-text">{{detail.content}}</view>
      </view>
      <view class="detail-block" wx:if="{{detail.approver || detail.approve_date || detail.approve_opinion}}">
        <view class="detail-label">审批信息</view>
        <view class="detail-text" wx:if="{{detail.approver}}">审批人：{{detail.approver}}</view>
        <view class="detail-text" wx:if="{{detail.approve_date}}">审批日期：{{detail.approve_date}}</view>
        <view class="detail-text" wx:if="{{detail.approve_opinion}}">审批意见：{{detail.approve_opinion}}</view>
      </view>
      <view class="panel-actions" wx:if="{{detail.status === '草稿' || detail.status === '已驳回'}}">
        <button class="btn-cancel" catchtap="del" data-id="{{detail.id}}">删除</button>
        <button class="btn-cancel" catchtap="openEdit" data-id="{{detail.id}}">编辑</button>
        <button class="btn-submit" catchtap="submit" data-id="{{detail.id}}">提交审批</button>
      </view>
      <view class="panel-actions" wx:elif="{{detail.status === '待审批'}}">
        <button class="btn-cancel" catchtap="review" data-id="{{detail.id}}" data-action="reject">驳回</button>
        <button class="btn-submit" catchtap="review" data-id="{{detail.id}}" data-action="approve">批准</button>
      </view>
      <view class="panel-actions" wx:else>
        <button class="btn-submit" bindtap="closeDetail">关闭</button>
      </view>
    </view>
  </view>
</view>
