/* 进度记录页 — 沿用 meeting 页卡片/工具栏/empty 体系，弹层参考 agent 页 overlay */
.page { padding: 24rpx; }
.toolbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.btn-primary {
  flex: 1; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0));
  color: #fff; font-size: 26rpx; border-radius: 12rpx; border: none;
}
.card { padding: 24rpx; margin-bottom: 14rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.empty { padding: 90rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }

/* 最新进度卡片 */
.latest-label { font-size: 26rpx; font-weight: 600; color: var(--brand-l, #3b8cff); letter-spacing: 2rpx; }
.latest-meta { margin-top: 6rpx; font-size: 22rpx; color: #999; }
.latest-body { display: flex; align-items: baseline; gap: 20rpx; margin-top: 16rpx; }
.latest-num { font-size: 72rpx; font-weight: 700; color: var(--brand, #1677ff); line-height: 1; }
.latest-unit { font-size: 28rpx; font-weight: 500; }
.latest-plan { font-size: 24rpx; color: #7a8b9f; }
.bar { margin-top: 20rpx; height: 16rpx; border-radius: 999rpx; background: rgba(var(--brand-rgb, 22,119,255), 0.12); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); }

/* 记录列表 */
.record-head { display: flex; align-items: center; }
.record-date { flex: 1; font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); }
.record-badge { flex-shrink: 0; font-size: 20rpx; padding: 2rpx 14rpx; border-radius: 999rpx; }
.record-part { margin-top: 10rpx; font-size: 24rpx; color: var(--ink-2, #243b55); }
.record-meta { margin-top: 8rpx; font-size: 22rpx; color: #999; }
.s-ok { background: rgba(47,158,99,0.12); color: #2f9e63; }
.s-bad { background: rgba(185,56,56,0.12); color: #b93838; }
.s-pending { background: rgba(217,119,6,0.12); color: #d97706; }

/* 弹层表单（结构参考 agent 页 overlay） */
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 200; display: flex; align-items: flex-end; justify-content: center; }
.overlay-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60,0.35); }
.overlay-panel {
  position: relative; width: 100%; max-height: 85vh; overflow-y: auto;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.96); border-radius: 32rpx 32rpx 0 0; box-sizing: border-box;
}
.panel-header { text-align: center; margin-bottom: 36rpx; }
.panel-title { font-size: 34rpx; font-weight: 700; color: var(--ink, #12253d); }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink, #12253d); margin-bottom: 10rpx; }
.form-input {
  width: 100%; height: 76rpx; padding: 0 24rpx; border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.72); background: rgba(255,255,255,0.46);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box;
}
.form-textarea {
  width: 100%; min-height: 80rpx; padding: 16rpx 24rpx; border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.72); background: rgba(255,255,255,0.46);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78); font-size: 28rpx; box-sizing: border-box;
}
.picker-value { line-height: 76rpx; color: var(--ink-2, #243b55); }
.panel-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-cancel { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 30rpx; color: #6b7c90; background: rgba(255,255,255,0.50); text-align: center; }
.btn-submit { flex: 2; height: 80rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 30rpx; color: #fff; background: linear-gradient(135deg, var(--brand, #1677ff) 0%, var(--brand, #1677ff) 100%); text-align: center; }
.del-row { margin-top: 24rpx; }
.btn-del { width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 30rpx; color: #b93838; background: rgba(185,56,56,0.08); text-align: center; }
