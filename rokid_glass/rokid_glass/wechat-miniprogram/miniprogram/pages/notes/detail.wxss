/* 玻璃拟态改造（浅色版） */
.page { padding: 24rpx; }
.title-input { width: 100%; height: 80rpx; padding: 0 20rpx; font-size: 32rpx; font-weight: 600; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16); border-radius: 14rpx; box-sizing: border-box; }
.content-input { width: 100%; min-height: 700rpx; margin-top: 16rpx; padding: 20rpx; font-size: 28rpx; line-height: 1.7; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16); border-radius: 14rpx; box-sizing: border-box; }
.btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btns button { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 28rpx; border-radius: 12rpx; border: none; }
.btn-primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; }
.btn-cancel { background: rgba(245, 245, 245, 0.8); color: #d9534f; }
