<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="笔记" left="back" />
  <tab-bar active="" />

  <view class="toolbar">
    <button class="btn-primary" bindtap="create">+ 新建笔记</button>
  </view>

  <view wx:if="{{loading && !notes.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!notes.length}}" class="empty">还没有笔记，点上方“新建笔记”</view>
  <view wx:for="{{notes}}" wx:key="id" class="card note" data-id="{{item.id}}" bindtap="open">
    <view class="note-title">{{item.title}}</view>
    <view class="note-time">{{item.updated_at}}</view>
    <text class="note-del" catchtap="del" data-id="{{item.id}}">删除</text>
  </view>
</view>
