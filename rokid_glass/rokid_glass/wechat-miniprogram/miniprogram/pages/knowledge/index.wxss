/* 玻璃拟态改造（浅色版） */

/* ===== Tab 栏 ===== */
.kb-entry { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 26rpx; margin-bottom: 20rpx; border-radius: 18rpx; background: linear-gradient(135deg, rgba(var(--deep-rgb, 10,46,92), 0.92), rgba(var(--brand-l-rgb, 59,140,255), 0.85)); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); box-shadow: 0 4rpx 14rpx rgba(var(--brand-l-rgb, 59,140,255), 0.25); }
.kb-entry-text { display: flex; flex-direction: column; gap: 8rpx; }
.kb-entry-title { color: #fff; font-size: 29rpx; font-weight: 700; }
.kb-entry-sub { color: rgba(255,255,255,0.34); font-size: 22rpx; }
.kb-entry-arrow { color: #fff; font-size: 44rpx; font-weight: 300; }
.mode-tabs { display: flex; gap: 10rpx; margin-bottom: 24rpx; padding: 8rpx; border-radius: 20rpx; background: rgba(230,236,245, 0.7); }
.mode-tabs view { flex: 1; padding: 18rpx 0; text-align: center; border-radius: 16rpx; color: #5c6e84; font-size: 26rpx; font-weight: 500; }
.mode-tabs .active { color: #fff; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(var(--brand-l-rgb, 59,140,255), 0.25); }

/* ===== 搜索区 ===== */
.search-box { padding: 20rpx 24rpx; margin-bottom: 16rpx; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16); }
.search-top { display: flex; gap: 12rpx; align-items: center; }
.search-field { flex: 1; height: 72rpx; padding: 0 20rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 28rpx; background: rgba(255,255,255,0.40); }
.btn-search { flex-shrink: 0; margin: 0; height: 72rpx; line-height: 72rpx; padding: 0 28rpx; }
.filter-row { margin-top: 14rpx; }
.filter-tag { display: inline-block; padding: 10rpx 22rpx; border-radius: 999rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 24rpx; font-weight: 500; }

/* ===== 工具栏 ===== */
.toolbar { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.btn-green { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-orange { background: #e6a23c; color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 26rpx; border-radius: 12rpx; border: none; }
.btn-full { width: 100%; margin-top: 16rpx; height: 72rpx; line-height: 72rpx; }
.btn-sm { font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 10rpx; }
.btn-cancel { background: rgba(245, 245, 245, 0.8); color: #666; font-size: 26rpx; border-radius: 12rpx; border: none; }

/* ===== 提示 ===== */
.tip { padding: 8rpx 4rpx 14rpx; color: #6b7c90; font-size: 24rpx; }

/* ===== 文档卡片 ===== */
.doc-card { padding: 24rpx; margin-bottom: 12rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(255,255,255,0.60); border-radius: 14rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.doc-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.doc-title { flex: 1; font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); line-height: 1.4; }
.doc-tag { flex-shrink: 0; padding: 4rpx 14rpx; border-radius: 8rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 22rpx; font-weight: 500; }
.doc-sub { margin-top: 8rpx; color: #999; font-size: 23rpx; }
.doc-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.doc-status { padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 500; }
.doc-status.ok { background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, var(--brand-l, #3b8cff)); }
.doc-status.warn { background: rgba(254, 243, 226, 0.85); color: #e6a23c; }
.doc-btns { display: flex; gap: 28rpx; }

.list-header { padding: 10rpx 4rpx; color: var(--ink-2, #243b55); font-size: 26rpx; font-weight: 600; margin-bottom: 8rpx; }
.link-green { color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 25rpx; font-weight: 600; }
.link-gray { color: #6b7c90; font-size: 25rpx; }
.link-red { color: #d9534f; font-size: 25rpx; font-weight: 600; }

/* ===== 空状态 ===== */
.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; }
.empty-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.empty-text { color: #999; font-size: 26rpx; }

/* ===== 知识图谱 ===== */
.stats-grid { display: flex; gap: 14rpx; margin-bottom: 20rpx; }
.stat-item { flex: 1; padding: 24rpx 12rpx; text-align: center; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(255,255,255,0.60); border-radius: 14rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.stat-num { display: block; font-size: 42rpx; font-weight: 800; color: var(--brand-l, var(--brand-l, #3b8cff)); }
.stat-lbl { display: block; margin-top: 6rpx; font-size: 22rpx; color: #999; }

.section-card { padding: 24rpx; margin-bottom: 16rpx; background: rgba(255,255,255,0.32); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 14rpx; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 12rpx 36rpx rgba(var(--shadow-rgb, 20,70,140), 0.16); }
.sec-head { margin-bottom: 8rpx; }
.sec-title { font-size: 28rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.sec-desc { margin-bottom: 16rpx; color: #999; font-size: 24rpx; line-height: 1.5; }
.sec-textarea { width: 100%; min-height: 180rpx; padding: 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; line-height: 1.6; background: rgba(255,255,255,0.40); box-sizing: border-box; }
.sec-input { width: 100%; height: 72rpx; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; margin-top: 12rpx; background: rgba(255,255,255,0.40); box-sizing: border-box; }
.result-tip { margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 10rpx; font-size: 24rpx; line-height: 1.5; }
.result-tip.ok { background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, var(--brand-l, #3b8cff)); }

/* ===== 弹窗 ===== */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60, 0.35); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.modal { width: 100%; max-height: 85vh; background: rgba(255,255,255,0.34); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 20rpx; overflow: hidden; box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.modal-title { padding: 28rpx 28rpx 0; font-size: 30rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.modal-body { padding: 24rpx 28rpx; max-height: 60vh; overflow-y: auto; }
.modal-btns { display: flex; gap: 16rpx; padding: 16rpx 28rpx 28rpx; }
.modal-btns button { flex: 1; height: 72rpx; line-height: 72rpx; margin: 0; }

.field-group { margin-bottom: 22rpx; }
.field-label { display: block; margin-bottom: 8rpx; font-size: 25rpx; color: #555; font-weight: 600; }
.field-input { width: 100%; height: 72rpx; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; background: rgba(255,255,255,0.40); box-sizing: border-box; }
.picker-val { line-height: 72rpx; color: var(--brand-l, var(--brand-l, #3b8cff)); }
.field-hint { display: block; margin-top: 6rpx; font-size: 22rpx; color: #bbb; }
.file-info { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--brand-l, var(--brand-l, #3b8cff)); font-weight: 500; }

.file-scroll { max-height: 260rpx; border: 2rpx solid rgba(255, 255, 255, 0.8); border-radius: 10rpx; padding: 8rpx 12rpx; }
.file-row { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.06); }
.file-row:last-child { border-bottom: none; }
.file-name { flex: 1; font-size: 24rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.file-size { flex-shrink: 0; margin-left: 12rpx; font-size: 22rpx; color: #bbb; }

/* ===== 验收指引 ===== */
.sug-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.sug-tag { padding: 12rpx 24rpx; border-radius: 999rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 24rpx; font-weight: 500; }
.sug-tag:active { opacity: 0.8; }
.guide-block { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.guide-title { margin-bottom: 14rpx; font-size: 28rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.guide-step { display: flex; gap: 16rpx; align-items: flex-start; margin-bottom: 14rpx; }
.step-num { flex-shrink: 0; width: 38rpx; height: 38rpx; border-radius: 50%; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 22rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.step-text { flex: 1; font-size: 26rpx; color: var(--ink-2, #243b55); line-height: 1.6; }
.guide-point { margin-bottom: 10rpx; font-size: 25rpx; color: #4a5c74; line-height: 1.6; }
.guide-point.warn { color: #c77414; }
