.doc-head, .doc-body { padding: 24rpx; margin-bottom: 16rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.doc-title { font-size: 32rpx; font-weight: 700; color: var(--ink-2, #243b55); line-height: 1.5; overflow-wrap: break-word; }
.doc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 14rpx; font-size: 24rpx; overflow-wrap: anywhere; }
.tag { padding: 4rpx 14rpx; border-radius: 8rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, #3b8cff); font-size: 22rpx; }
.muted, .hint { color: #6b7c90; }
.hint { margin-bottom: 18rpx; font-size: 24rpx; line-height: 1.5; }
.doc-line { display: block; color: var(--ink-2, #243b55); font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.empty { padding: 80rpx 40rpx; text-align: center; color: #6b7c90; font-size: 26rpx; }
.footer { padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom)); }
.ghost { color: var(--brand-d, #0b5fd0); background: rgba(var(--wash-rgb, 234,243,255), 0.85); border-radius: 12rpx; font-size: 27rpx; }
