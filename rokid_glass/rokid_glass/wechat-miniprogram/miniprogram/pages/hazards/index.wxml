<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="隐患台账" left="back" />
  <tab-bar active="" />

  <view wx:if="{{loading && !hazards.length}}" class="empty">正在加载隐患…</view>
  <view wx:elif="{{!hazards.length}}" class="empty">当前项目暂无隐患记录</view>
  <view wx:for="{{hazards}}" wx:key="id" class="card hazard {{focusId === item.id ? 'focused' : ''}}">
    <block wx:if="{{item.image_url && item.rectification_image_url}}">
      <view class="photo-strip">
        <image class="photo" src="{{item.image_url}}" mode="aspectFill" data-id="{{item.id}}" data-url="{{item.image_url}}" catchtap="preview"></image>
        <image class="photo" src="{{item.rectification_image_url}}" mode="aspectFill" data-id="{{item.id}}" data-url="{{item.rectification_image_url}}" catchtap="preview"></image>
      </view>
    </block>
    <image wx:elif="{{item.image_url}}" class="photo" src="{{item.image_url}}" mode="aspectFill" data-id="{{item.id}}" data-url="{{item.image_url}}" catchtap="preview"></image>
    <image wx:elif="{{item.rectification_image_url}}" class="photo" src="{{item.rectification_image_url}}" mode="aspectFill" data-id="{{item.id}}" data-url="{{item.rectification_image_url}}" catchtap="preview"></image>
    <view class="hazard-content">
      <view class="head">
        <view class="hazard-title">{{item.top1_risk || item.risk_category || '现场隐患'}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="muted">#{{item.id}} · {{item.section}} {{item.location}}</view>
      <view wx:if="{{item.evidence_text}}" class="evidence">依据：{{item.evidence_text}}</view>

      <view wx:if="{{item.expanded}}" class="detail">
        <view wx:if="{{item.detailLoading}}" class="muted">加载中…</view>
        <block wx:elif="{{item.detail}}">
          <view wx:if="{{item.detail.top1_risk}}" class="detail-row"><text class="detail-label">隐患描述</text><text class="detail-text">{{item.detail.top1_risk}}</text></view>
          <view wx:if="{{item.detail.risk_status}}" class="detail-row"><text class="detail-label">风险状态</text><text class="detail-text">{{item.detail.risk_status}}</text></view>
          <view wx:if="{{item.detail.rectification_doc_id}}" class="detail-row doc-link" data-id="{{item.detail.rectification_doc_id}}" catchtap="openDoc">
            <text class="detail-label">整改通知单</text>
            <text class="link">#{{item.detail.rectification_doc_id}} {{item.detail.rectification_doc_title}} ›</text>
          </view>
          <view wx:if="{{item.detail.deadline}}" class="detail-row"><text class="detail-label">整改期限</text><text class="detail-text">{{item.detail.deadline}}</text></view>
          <view wx:if="{{item.detail.recheck_passed === true || item.detail.recheck_passed === false}}" class="detail-row">
            <text class="detail-label">复查结果</text>
            <text class="detail-text {{item.detail.recheck_passed ? 'ok' : 'bad'}}">{{item.detail.recheck_passed ? '复查合格' : '驳回整改'}}</text>
          </view>
          <view wx:if="{{item.detail.recheck_remark}}" class="detail-row"><text class="detail-label">复查意见</text><text class="detail-text">{{item.detail.recheck_remark}}</text></view>
          <view wx:if="{{item.detail.media && item.detail.media.length}}" class="media-block">
            <view class="media-title">关联影像</view>
            <view class="media-list">
              <image wx:for="{{item.detail.media}}" wx:for-item="media" wx:key="id" class="media-thumb" src="{{media.url}}" mode="aspectFill" data-id="{{item.id}}" data-url="{{media.url}}" catchtap="preview"></image>
            </view>
          </view>
        </block>
      </view>

      <view class="actions">
        <button size="mini" data-id="{{item.id}}" bindtap="toggleDetail">{{item.expanded ? '收起详情' : '详情'}}</button>
        <button wx:if="{{item.status === '已提报'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" bindtap="createRectification">生成整改单</button>
        <button wx:if="{{item.status === '待复查'}}" class="primary" size="mini" data-id="{{item.id}}" data-passed="true" loading="{{actionId === item.id}}" bindtap="recheck">复查合格</button>
        <button wx:if="{{item.status === '待复查'}}" size="mini" data-id="{{item.id}}" data-passed="false" loading="{{actionId === item.id}}" bindtap="recheck">驳回</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showDeadline}}" class="mask" bindtap="closeDeadline"></view>
  <view wx:if="{{showDeadline}}" class="sheet">
    <view class="sheet-head">
      <view class="title">设置整改期限</view>
      <text class="close" bindtap="closeDeadline">×</text>
    </view>
    <view class="muted" style="margin: 16rpx 0;">将生成整改通知单并进入整改流程</view>
    <picker mode="date" value="{{rectDeadline}}" bindchange="onDeadlineChange">
      <view class="field">整改期限：{{rectDeadline}} ▾</view>
    </picker>
    <button class="primary" style="margin-top: 26rpx;" loading="{{actionId === rectHazardId}}" disabled="{{actionId === rectHazardId}}" bindtap="confirmRect">生成整改通知单</button>
  </view>
</view>
