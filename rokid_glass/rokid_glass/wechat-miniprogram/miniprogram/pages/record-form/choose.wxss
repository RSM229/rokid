.page { display: flex; flex-direction: column; height: 100vh; background: #f5f7fa; }
.body { flex: 1; padding: 24rpx; box-sizing: border-box; }
.tip {
  font-size: 24rpx; color: #7a8b9f; line-height: 1.6;
  padding: 8rpx 8rpx 20rpx;
}
.form-item {
  display: flex; align-items: center;
  padding: 28rpx 24rpx; margin-bottom: 16rpx;
  background: #fff; border-radius: 16rpx;
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.12);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.form-main { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.form-name { font-size: 30rpx; font-weight: 600; color: var(--ink, #12253d); }
.form-no { font-size: 22rpx; color: #a3b1c2; }
.form-arrow { font-size: 40rpx; color: #c2ccd9; margin-left: 16rpx; }
.bottom-gap { height: 60rpx; }
