/* 玻璃拟态改造（浅色版） */
.filter-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.filter { padding: 16rpx 22rpx; border-radius: 16rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(255,255,255,0.60); }
.task.focused { outline: 4rpx solid #d9a441; }
.task-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.task-title { flex: 1; font-size: 31rpx; font-weight: 650; }
.priority { padding: 5rpx 14rpx; border-radius: 14rpx; color: #7d5b18; background: rgba(255, 241, 204, 0.85); font-size: 22rpx; }

.tags { display: flex; gap: 12rpx; margin: 18rpx 0; }
.tags text { padding: 6rpx 14rpx; border-radius: 12rpx; color: var(--brand, #1677ff); background: rgba(var(--wash-rgb, 234,243,255), 0.8); font-size: 22rpx; }
.description { margin-bottom: 16rpx; color: #334a64; line-height: 1.6; }
.actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; }
.actions button { margin: 0; }

/* 列表卡片反复渲染，去模糊保性能 */
.card { background: rgba(255,255,255,0.34); backdrop-filter: none; -webkit-backdrop-filter: none; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); }
