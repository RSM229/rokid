<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="待办事项" left="back" />
  <tab-bar active="" />

  <view class="filter-row">
    <picker mode="selector" range="{{statuses}}" value="{{statusIndex}}" bindchange="onFilterChange">
      <view class="filter">状态：{{statuses[statusIndex]}} ▾</view>
    </picker>
    <text class="muted">共 {{tasks.length}} 项</text>
  </view>

  <view wx:if="{{loading && !tasks.length}}" class="empty">正在加载派单…</view>
  <view wx:elif="{{!tasks.length}}" class="empty">当前没有符合条件的派单</view>
  <view wx:for="{{tasks}}" wx:key="id" class="card task {{focusId === item.id ? 'focused' : ''}}">
    <view class="task-head">
      <view class="task-title">{{item.title}}</view>
      <view class="priority" style="{{item.priority === '紧急' ? 'color:#fff;background:#b93838' : item.priority === '高' ? 'color:#9d2e2e;background:#fee3e3' : ''}}">{{item.priority}}</view>
    </view>
    <view class="tags"><text>{{item.category}}</text><text>{{item.status}}</text></view>
    <view wx:if="{{item.description}}" class="description">{{item.description}}</view>
    <view wx:if="{{item.assigner_name}}" class="muted">派发人：{{item.assigner_name}}</view>
    <view wx:if="{{item.section || item.location}}" class="muted">地点：{{item.section}} {{item.location}}</view>
    <view wx:if="{{item.deadline}}" class="muted">截止：{{item.deadline}}</view>
    <view class="actions">
      <button wx:if="{{item.status === '待接单'}}" size="mini" data-id="{{item.id}}" disabled="{{actionId}}" bindtap="reject">拒绝</button>
      <button wx:if="{{item.status === '待接单'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="accept">接单</button>
      <button wx:if="{{item.status === '已接单'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="start">开始</button>
      <button wx:if="{{item.status === '进行中'}}" size="mini" data-id="{{item.id}}" bindtap="capture">上传取证</button>
      <button wx:if="{{item.status === '进行中'}}" class="primary" size="mini" data-id="{{item.id}}" loading="{{actionId === item.id}}" disabled="{{actionId}}" bindtap="complete">完成</button>
      <button size="mini" open-type="share" data-id="{{item.id}}">分享</button>
    </view>
  </view>
</view>
