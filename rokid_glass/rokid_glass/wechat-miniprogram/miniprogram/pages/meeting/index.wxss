/* 会议纪要列表页 — 沿用 notes 页玻璃浅色 token */
.page { padding: 24rpx; }
.toolbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.type-filter {
  padding: 0 24rpx; height: 64rpx; line-height: 64rpx;
  font-size: 26rpx; color: var(--ink-2, #243b55);
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.25);
  border-radius: 12rpx;
}
.btn-primary {
  flex: 1; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0));
  color: #fff; font-size: 26rpx; border-radius: 12rpx; border: none;
}
.card { padding: 24rpx; margin-bottom: 14rpx; background: rgba(255,255,255,0.34); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.empty { padding: 90rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }

.pending { margin-bottom: 20rpx; }
.pending-head { font-size: 26rpx; font-weight: 600; color: var(--brand-l, #3b8cff); margin-bottom: 12rpx; letter-spacing: 2rpx; }
.pending-item {
  padding: 20rpx 24rpx; margin-bottom: 10rpx;
  background: rgba(255,255,255,0.9);
  border-left: 6rpx solid #d97706;
  border-radius: 12rpx;
}
.pending-topic { font-size: 28rpx; color: var(--ink, #12253d); font-weight: 500; }
.pending-meta { display: flex; gap: 16rpx; margin-top: 8rpx; font-size: 22rpx; align-items: center; }
.pending-owner { color: var(--ink-2, #243b55); }
.pending-deadline { color: #7a8b9f; }
.pending-deadline.overdue { color: #b93838; font-weight: 600; }
.pending-status { margin-left: auto; padding: 2rpx 14rpx; border-radius: 999rpx; font-size: 20rpx; }
.s-todo { background: rgba(217,119,6,0.12); color: #d97706; }
.s-doing { background: rgba(var(--brand-rgb, 22,119,255),0.12); color: var(--brand, #1677ff); }
.pending-from { margin-top: 6rpx; font-size: 20rpx; color: #a3b1c2; }

.meeting { position: relative; }
.meeting-head { display: flex; align-items: center; gap: 12rpx; padding-right: 90rpx; }
.meeting-title { font-size: 29rpx; font-weight: 600; color: var(--ink-2, #243b55); flex: 1; }
.meeting-type {
  flex-shrink: 0; font-size: 20rpx; padding: 2rpx 14rpx; border-radius: 999rpx;
  background: rgba(var(--brand-rgb, 22,119,255),0.12); color: var(--brand, #1677ff);
}
.meeting-meta { display: flex; gap: 20rpx; margin-top: 10rpx; font-size: 22rpx; color: #999; }
.meeting-foot { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.meeting-topics { font-size: 22rpx; color: #d97706; }
.meeting-topics.done { color: #a3b1c2; }
.meeting-ai {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 999rpx;
  background: rgba(155,81,224,0.12); color: #9b51e0;
}
.meeting-del { position: absolute; top: 24rpx; right: 24rpx; color: #d9534f; font-size: 24rpx; font-weight: 600; }
