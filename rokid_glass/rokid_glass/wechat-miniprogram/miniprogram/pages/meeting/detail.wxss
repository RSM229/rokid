/* 会议纪要编辑页 — GD-B-217 表单 + 议题编辑器 + AI 整理弹层 */
.page { display: flex; flex-direction: column; height: 100vh; background: #ffffff; }
.body { flex: 1; padding: 24rpx; box-sizing: border-box; }
.card {
  padding: 24rpx; margin-bottom: 20rpx;
  background: rgba(255,255,255,0.9);
  border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14);
  border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.type-row { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 20rpx; }
.lbl { font-size: 26rpx; color: var(--ink, #12253d); font-weight: 500; }
.req { color: #b93838; }
.picker-val {
  box-sizing: border-box; width: 100%; height: 84rpx; line-height: 84rpx;
  padding: 0 24rpx; font-size: 28rpx; color: var(--ink, #12253d);
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.25);
  border-radius: 16rpx;
}
.picker-val.empty { color: #a3b1c2; }

.sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.sec-title { font-size: 26rpx; font-weight: 600; color: var(--brand-l, #3b8cff); letter-spacing: 2rpx; }
.sec-add { font-size: 24rpx; color: var(--brand, #1677ff); font-weight: 600; }
.empty-tip { padding: 30rpx 0; text-align: center; color: #a3b1c2; font-size: 24rpx; }

.topic {
  padding: 20rpx; margin-bottom: 16rpx;
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.18);
  border-radius: 16rpx;
}
.topic-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.topic-no {
  width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center;
  font-size: 22rpx; color: #fff; border-radius: 50%;
  background: var(--brand, #1677ff);
}
.topic-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.s-todo { background: rgba(217,119,6,0.12); color: #d97706; }
.s-doing { background: rgba(var(--brand-rgb, 22,119,255),0.12); color: var(--brand, #1677ff); }
.s-done { background: rgba(22,163,74,0.12); color: #16a34a; }
.topic-del { margin-left: auto; color: #d9534f; font-size: 24rpx; }
.t-input, .t-area {
  box-sizing: border-box; width: 100%;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.2);
  border-radius: 12rpx; padding: 0 20rpx;
  font-size: 26rpx; color: var(--ink, #12253d);
  margin-bottom: 12rpx;
}
.t-input { height: 76rpx; }
.t-area { height: 140rpx; padding: 16rpx 20rpx; line-height: 1.5; }
.topic-row { display: flex; gap: 12rpx; }
.topic-row .half { flex: 1; }
.topic-row .picker-val { height: 76rpx; line-height: 76rpx; font-size: 26rpx; }

.content-area {
  box-sizing: border-box; width: 100%; height: 300rpx;
  margin-top: 16rpx; padding: 20rpx 24rpx;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.25);
  border-radius: 16rpx; font-size: 28rpx; line-height: 1.6;
  color: var(--ink, #12253d);
}

.actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.btn-ai {
  flex: 1; font-size: 28rpx; border-radius: 16rpx; border: none;
  color: #9b51e0; background: rgba(155,81,224,0.1);
}
.btn-save {
  flex: 2; font-size: 28rpx; border-radius: 16rpx; border: none; color: #fff;
  background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0));
}
.bottom-gap { height: 60rpx; }

/* AI 整理弹层 */
.overlay { position: fixed; inset: 0; z-index: 90; }
.overlay-mask { position: absolute; inset: 0; background: rgba(10, 25, 47, 0.45); }
.ai-panel {
  position: absolute; left: 32rpx; right: 32rpx; bottom: 48rpx;
  padding: 32rpx; border-radius: 24rpx;
  background: rgba(255,255,255,0.96);
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.25);
}
.ai-title { font-size: 30rpx; font-weight: 600; color: var(--ink, #12253d); }
.ai-tip { margin-top: 12rpx; font-size: 22rpx; color: #7a8b9f; line-height: 1.5; }
.ai-input {
  box-sizing: border-box; width: 100%; height: 320rpx;
  margin-top: 20rpx; padding: 20rpx;
  border: 1rpx solid rgba(var(--brand-rgb, 22,119,255), 0.25);
  border-radius: 16rpx; font-size: 26rpx; line-height: 1.5;
}
.ai-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-cancel { flex: 1; font-size: 28rpx; border-radius: 16rpx; background: #f1f5f9; color: #5f6b7a; border: none; }
.btn-go { flex: 1; font-size: 28rpx; border-radius: 16rpx; border: none; color: #fff; background: linear-gradient(135deg, #b07fe8, #9b51e0); }
