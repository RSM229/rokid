<!--
  账号安全（目录页）· 2026-10-12 晚重构

  用户指令：本页只放三个目录，具体内容收进对应目录 ——
    1. 身份信息   → identity   （用户名 / 手机号 / 公司，只读）
    2. 微信绑定   → binding    （绑定状态 / 微信资料 / 解绑）
    3. 登录凭据   → credentials（登录密码 / 密保问题）

  本页自身只做三件事：登录检查、拉绑定状态（给「微信绑定」行做摘要徽标）、跳转。
  历史路径：「我的」→ settings 顶部 → 独立本页 → 拆为三个目录。
-->
<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="账号安全" left="back" />

  <view class="section">
    <view class="cell entry-item entry-tint" bindtap="openIdentity">
      <view class="entry-main">
        <view class="entry-icon ic-id"></view>
        <view class="entry-text">
          <text class="entry-title">身份信息</text>
          <text class="entry-desc">用户名{{user.phone ? ' · 手机号' : ''}}{{user.company_name ? ' · 公司' : ''}}</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell entry-item entry-tint" bindtap="openBinding">
      <view class="entry-main">
        <view class="entry-icon ic-wx"></view>
        <view class="entry-text">
          <text class="entry-title">微信绑定</text>
          <text class="entry-desc" wx:if="{{wxBound === true}}">已绑定，可直接用微信一键登录</text>
          <text class="entry-desc" wx:elif="{{wxBound === false}}">未绑定，退出后重新登录即会绑定</text>
          <text class="entry-desc" wx:else>绑定状态读取失败，稍后自动重试</text>
        </view>
      </view>
      <view class="cell-right">
        <text class="bind-tag {{wxBound === true ? 'on' : (wxBound === false ? 'off' : 'unknown')}}">{{wxBound === true ? '已绑定' : (wxBound === false ? '未绑定' : '未知')}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
    <view class="cell entry-item entry-tint" bindtap="openCredentials">
      <view class="entry-main">
        <view class="entry-icon ic-key"></view>
        <view class="entry-text">
          <text class="entry-title">登录凭据</text>
          <text class="entry-desc">登录密码 · 密保问题</text>
        </view>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>
</view>
