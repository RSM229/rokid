<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="加入项目" left="back" />

  <view class="header">
    <view class="title">加入项目</view>
    <view class="subtitle">填写项目负责人发放的项目邀请码，加入对应项目并获取岗位</view>
  </view>

  <view class="form">
    <view class="form-item">
      <view class="label">项目邀请码 <text class="required">*</text></view>
      <input class="input" placeholder="请输入项目邀请码" value="{{code}}" bindinput="onInput" data-field="code" />
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{result}}" class="success">
    已加入项目「{{result.project_name}}」，岗位：{{result.role_label}}
  </view>

  <view class="notice">项目邀请码由项目负责人在 Web 管理后台为本项目生成，邀请码内含项目与岗位信息。注册账号本身不带任何项目权限，须加入项目后才能在手机端使用对应功能。</view>

  <button class="btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">加入项目</button>
</view>
