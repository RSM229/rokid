<view class="page tab-host" style="{{themeStyle}}">
  <glass-nav-bar title="资源投入" left="back" />
  <tab-bar active="" />

  <!-- 顶部统计条：近 N 日人工合计 + 机械投入前 3 -->
  <view class="stats card" wx:if="{{summary}}">
    <view class="stats-row">
      <view class="stats-cell">
        <text class="stats-num">{{summary.labor_total}}</text>
        <text class="stats-lbl">近 {{summary.days}} 日人工合计（人）</text>
      </view>
      <view class="stats-cell">
        <text class="stats-num">{{summary.machine_top.length || 0}}</text>
        <text class="stats-lbl">在用机械种类</text>
      </view>
    </view>
    <view class="stats-machines" wx:if="{{machineTopText}}">机械前三：{{machineTopText}}</view>
  </view>

  <view class="toolbar">
    <view class="toolbar-title">投入记录</view>
    <button class="btn-primary" bindtap="openCreate">+ 记录投入</button>
  </view>

  <view wx:if="{{loading && !items.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有投入记录，点上方「记录投入」</view>
  <view wx:for="{{items}}" wx:key="id" class="card record" data-id="{{item.id}}" bindtap="openEdit">
    <view class="record-head">
      <text class="record-date">{{item.record_date}}</text>
      <text class="record-labor">人工 {{item.labor_count}} 人</text>
    </view>
    <view class="record-meta">
      <text>机械 {{item.machines.length}} 项</text>
      <text>材料 {{item.materials.length}} 项</text>
    </view>
    <view class="record-detail" wx:if="{{item.labor_detail}}">{{item.labor_detail}}</view>
    <view class="record-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
  </view>

  <!-- 记录/编辑弹层 -->
  <view class="overlay" wx:if="{{showForm}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeForm"></view>
    <view class="overlay-panel form-panel">
      <view class="panel-header">
        <text class="panel-title">{{editId ? '编辑投入' : '记录投入'}}</text>
      </view>

      <view class="form-group">
        <text class="form-label">日期 *</text>
        <picker mode="date" value="{{formDate}}" bindchange="onDateChange">
          <view class="form-input picker-value">{{formDate || '请选择日期'}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">人工数量（人）*</text>
        <input class="form-input" type="number" value="{{formLaborCount}}" data-field="formLaborCount" bindinput="onFormInput" placeholder="请输入出勤人数" />
      </view>
      <view class="form-group">
        <text class="form-label">工种说明</text>
        <input class="form-input" value="{{formLaborDetail}}" data-field="formLaborDetail" bindinput="onFormInput" placeholder="如：木工 5、钢筋工 8" />
      </view>

      <!-- 机械动态行 -->
      <view class="form-group">
        <view class="row-head">
          <text class="form-label">机械（{{formMachines.length}}）</text>
          <text class="row-add" bindtap="addMachine">+ 添加机械</text>
        </view>
        <view class="empty-tip" wx:if="{{!formMachines.length}}">暂无机械，点右上角「添加机械」</view>
        <view wx:for="{{formMachines}}" wx:key="index" class="dyna-row">
          <input class="form-input grow" value="{{item.name}}" placeholder="机械名称" data-index="{{index}}" data-field="name" bindinput="onMachineInput" />
          <input class="form-input num" type="number" value="{{item.count}}" placeholder="台数" data-index="{{index}}" data-field="count" bindinput="onMachineInput" />
          <text class="row-del" data-index="{{index}}" bindtap="removeMachine">删除</text>
        </view>
      </view>

      <!-- 材料动态行 -->
      <view class="form-group">
        <view class="row-head">
          <text class="form-label">材料（{{formMaterials.length}}）</text>
          <text class="row-add" bindtap="addMaterial">+ 添加材料</text>
        </view>
        <view class="empty-tip" wx:if="{{!formMaterials.length}}">暂无材料，点右上角「添加材料」</view>
        <view wx:for="{{formMaterials}}" wx:key="index" class="mat-row">
          <view class="dyna-row">
            <input class="form-input grow" value="{{item.name}}" placeholder="材料名称" data-index="{{index}}" data-field="name" bindinput="onMaterialInput" />
            <text class="row-del" data-index="{{index}}" bindtap="removeMaterial">删除</text>
          </view>
          <view class="dyna-row">
            <input class="form-input grow" value="{{item.spec}}" placeholder="规格型号" data-index="{{index}}" data-field="spec" bindinput="onMaterialInput" />
            <input class="form-input num" type="digit" value="{{item.quantity}}" placeholder="数量" data-index="{{index}}" data-field="quantity" bindinput="onMaterialInput" />
            <input class="form-input unit" value="{{item.unit}}" placeholder="单位" data-index="{{index}}" data-field="unit" bindinput="onMaterialInput" />
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" value="{{formRemark}}" data-field="formRemark" bindinput="onFormInput" placeholder="备注（可选）" auto-height />
      </view>

      <view class="panel-actions">
        <button wx:if="{{editId}}" class="btn-danger" bindtap="del">删除</button>
        <button class="btn-cancel" bindtap="closeForm">取消</button>
        <button class="btn-submit" loading="{{saving}}" bindtap="save">保存</button>
      </view>
    </view>
  </view>
</view>
