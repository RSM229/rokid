/* 玻璃拟态改造（浅色版） */
.card { padding: 24rpx; margin-bottom: 14rpx; background: rgba(255,255,255,0.34); backdrop-filter: none; -webkit-backdrop-filter: none; border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }

.kb-head .kb-top { display: flex; justify-content: space-between; align-items: center; }
.kb-name { flex: 1; font-size: 32rpx; font-weight: 700; color: var(--ink-2, #243b55); }
.kb-tag { flex-shrink: 0; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 500; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-l, var(--brand-l, #3b8cff)); }
.kb-tag.shared { background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-d, #0b5fd0); }
.kb-desc { margin-top: 8rpx; color: #667; font-size: 24rpx; }
.kb-sub { margin-top: 10rpx; color: #999; font-size: 23rpx; }
.kb-actions { display: flex; gap: 14rpx; margin-top: 18rpx; flex-wrap: wrap; }
.builtin-tip { margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: rgba(var(--wash-rgb, 234,243,255), 0.85); color: var(--brand-d, #0b5fd0); font-size: 23rpx; line-height: 1.5; }

.tabs { display: flex; gap: 10rpx; margin-bottom: 18rpx; padding: 8rpx; border-radius: 20rpx; background: rgba(230,236,245, 0.7); }
.tabs view { flex: 1; padding: 16rpx 0; text-align: center; border-radius: 16rpx; color: #5c6e84; font-size: 25rpx; font-weight: 500; }
.tabs .active { color: #fff; background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); font-weight: 700; }

.btn-primary { background: linear-gradient(135deg, var(--brand-l, #3b8cff), var(--brand-d, #0b5fd0)); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-green { background: var(--brand-l, #3b8cff); color: #fff; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-gray { background: rgba(238, 242, 240, 0.8); color: #40566e; font-size: 24rpx; border-radius: 12rpx; border: none; }
.btn-full { width: 100%; margin-top: 16rpx; height: 76rpx; line-height: 76rpx; }

.doc-name { font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); }
.doc-meta { margin-top: 6rpx; color: #999; font-size: 23rpx; }
.doc-btns { display: flex; gap: 30rpx; margin-top: 14rpx; }
.link-green { color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 25rpx; font-weight: 600; }
.link-gray { color: #6b7c90; font-size: 25rpx; }
.link-red { color: #d9534f; font-size: 25rpx; font-weight: 600; }

.qa-input { width: 100%; min-height: 140rpx; padding: 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; background: rgba(255,255,255,0.40); box-sizing: border-box; }
.answer-title { font-size: 26rpx; font-weight: 700; color: var(--ink-2, #243b55); margin-bottom: 10rpx; }
.answer-body { font-size: 27rpx; color: #334; line-height: 1.7; white-space: pre-wrap; }
.answer-actions { margin-top: 16rpx; }
.citations { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--deep-rgb, 10,46,92), 0.08); }
.cite-title { font-size: 24rpx; font-weight: 600; color: #5c6e84; margin-bottom: 10rpx; }
.cite-item { margin-bottom: 12rpx; }
.cite-name { color: var(--brand-l, var(--brand-l, #3b8cff)); font-size: 24rpx; font-weight: 600; }
.cite-snippet { color: #889; font-size: 23rpx; line-height: 1.5; }

.member { display: flex; align-items: center; gap: 16rpx; }
.member-info { flex: 1; }
.member-name { font-size: 28rpx; font-weight: 600; color: var(--ink-2, #243b55); }
.member-user { font-size: 22rpx; color: #999; }
.member-role { font-size: 23rpx; color: var(--brand-d, #0b5fd0); background: rgba(var(--wash-rgb, 234,243,255), 0.85); border-radius: 8rpx; padding: 4rpx 14rpx; }

.empty { padding: 90rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }

.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,40,60, 0.35); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.modal { width: 100%; background: rgba(255,255,255,0.34); backdrop-filter: blur(40rpx) saturate(1.8); -webkit-backdrop-filter: blur(40rpx) saturate(1.8); border: 2rpx solid rgba(var(--brand-rgb, 22,119,255), 0.14); border-radius: 20rpx; padding: 28rpx; box-sizing: border-box; box-shadow: 0 8rpx 32rpx rgba(var(--deep-rgb, 10,46,92), 0.12); }
.content-modal { max-height: 80vh; display: flex; flex-direction: column; }
.modal-title { font-size: 30rpx; font-weight: 700; color: var(--ink-2, #243b55); margin-bottom: 20rpx; }
.content-scroll { max-height: 56vh; }
.content-text { font-size: 25rpx; color: #334; line-height: 1.7; white-space: pre-wrap; }
.field-group { margin-bottom: 22rpx; }
.field-label { display: block; margin-bottom: 8rpx; font-size: 25rpx; color: #555; font-weight: 600; }
.field-input { width: 100%; height: 72rpx; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,0.34); border-radius: 12rpx; font-size: 26rpx; background: rgba(255,255,255,0.40); box-sizing: border-box; }
.picker-val { line-height: 72rpx; color: var(--brand-l, var(--brand-l, #3b8cff)); }
.modal-btns { display: flex; gap: 16rpx; margin-top: 10rpx; }
.modal-btns button { flex: 1; height: 76rpx; line-height: 76rpx; margin: 0; font-size: 27rpx; }
.btn-cancel { background: rgba(245, 245, 245, 0.8); color: #666; border-radius: 12rpx; border: none; }
