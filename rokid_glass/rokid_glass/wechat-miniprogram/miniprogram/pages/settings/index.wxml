<!--
  设置（二级页）· 2026-10-12 新建

  由来：「我的」原先 21 个区块平铺在一页，其中通用设置 / 通知与权限 / 关于
  既不是用户每天要看的信息（不像 Hero 与「我的工作」），又占掉大半屏高度。
  本次把这三组整体迁到本页，「我的」只留一行的设置入口。

  2026-10-12 晚：账号组再度拆出独立页 pages/account-security（用户要求
  「我的」页给出「账号安全 / 设置」两个并列入口），本页只留通用配置。

  本页承载两类内容：
    1. 列表项：通用设置（主题配色 / 眼镜端扫码登录）、通知与权限、关于
    2. 两个浮层：主题配色抽屉、眼镜端扫码登录弹层 —— 它们由本页的入口唤起，
       所以 wxml / wxss / ts 一并搬来，不留在「我的」当死代码。
-->
<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="设置" left="back" />

  <!-- ① 通用设置：外观与眼镜端联动 -->
  <view class="group-title">通用设置</view>
  <view class="section">
    <view class="cell entry-tint" bindtap="openTheme">
      <view class="cell-main">
        <text class="cell-label">主题配色</text>
        <text class="cell-sub">挑一个顺眼的颜色，整个小程序都会跟着变</text>
      </view>
      <view class="cell-right">
        <view class="theme-dot" style="background: {{themePreview}}"></view>
        <text class="cell-value muted">{{themeName}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
    <view class="cell" bindtap="openQrLogin">
      <view class="cell-main">
        <text class="cell-label">眼镜端扫码登录</text>
        <text class="cell-sub">用 Rokid 眼镜扫描二维码登录</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- ② 通知与权限：订阅 + 授权 + 隐私，原先四类混在一段 -->
  <view class="group-title">通知与权限</view>
  <view class="section">
    <view class="cell">
      <text class="cell-label">通知订阅状态</text>
      <text class="cell-value">已订阅 {{noticeSubscribed}}/{{noticeTotal}} 项</text>
    </view>
    <view class="cell" bindtap="subscribeNotices" data-group="task">
      <text class="cell-label">订阅派单与隐患通知</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="subscribeNotices" data-group="approval">
      <text class="cell-label">订阅审批通知</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="openPermissionSettings">
      <text class="cell-label">权限管理与撤回授权</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="openPrivacyGuide">
      <text class="cell-label">隐私保护指引</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- ③ 关于 -->
  <view class="group-title">关于</view>
  <view class="section">
    <view class="cell">
      <text class="cell-label">版本</text>
      <!-- 运行时取微信「关于」信息，不再写死（写死的字面量必然随发版过期） -->
      <text class="cell-value muted">{{version}}</text>
    </view>
    <view class="cell" bindtap="openHelp">
      <text class="cell-label">使用帮助</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 主题配色抽屉 -->
  <view class="overlay theme-overlay" wx:if="{{showTheme}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeTheme"></view>
    <view class="theme-sheet">
      <view class="ts-head">
        <text class="ts-title">主题配色</text>
        <text class="ts-sub">挑一个顺眼的颜色，整个小程序都会跟着变</text>
      </view>

      <view class="ts-preview">
        <view class="tsp-card">
          <view class="tsp-row">
            <view class="tsp-avatar"></view>
            <view class="tsp-lines">
              <view class="tsp-line"></view>
              <view class="tsp-line short"></view>
            </view>
          </view>
          <view class="tsp-chips">
            <view class="tsp-chip active"></view>
            <view class="tsp-chip"></view>
          </view>
          <view class="tsp-btn">主按钮</view>
        </view>
      </view>

      <view class="ts-row">
        <text class="ts-label">色相</text>
        <view class="ts-hue-wrap">
          <view class="ts-hue-rainbow"></view>
          <slider
            class="ts-hue"
            min="0"
            max="360"
            value="{{themeH}}"
            block-size="22"
            block-color="{{themePreview}}"
            activeColor="transparent"
            backgroundColor="transparent"
            bindchanging="onThemeSlide"
            bindchange="onThemeSlideEnd"
            data-key="h"
          />
        </view>
      </view>

      <view class="ts-row">
        <text class="ts-label">饱和</text>
        <slider
          class="ts-slider"
          min="0"
          max="100"
          value="{{themeS}}"
          block-size="20"
          block-color="{{themePreview}}"
          activeColor="{{themePreview}}"
          backgroundColor="rgba(20,40,60,0.10)"
          bindchanging="onThemeSlide"
          bindchange="onThemeSlideEnd"
          data-key="s"
        />
      </view>

      <view class="ts-row">
        <text class="ts-label">明度</text>
        <slider
          class="ts-slider"
          min="15"
          max="85"
          value="{{themeL}}"
          block-size="20"
          block-color="{{themePreview}}"
          activeColor="{{themePreview}}"
          backgroundColor="rgba(20,40,60,0.10)"
          bindchanging="onThemeSlide"
          bindchange="onThemeSlideEnd"
          data-key="l"
        />
      </view>

      <view class="ts-presets">
        <view
          class="ts-preset {{item.active ? 'on' : ''}}"
          wx:for="{{presets}}"
          wx:key="name"
          style="background: {{item.color}}"
          data-index="{{index}}"
          bindtap="pickPreset"
        ></view>
      </view>

      <view class="ts-actions">
        <view class="ts-btn ghost" bindtap="restoreDefaultTheme">恢复默认</view>
        <view class="ts-btn solid" bindtap="closeTheme">完成</view>
      </view>
    </view>
  </view>

  <!-- 眼镜端扫码登录弹层 -->
  <view class="overlay" wx:if="{{showQr}}" catchtouchmove="true">
    <view class="overlay-mask" bindtap="closeQrLogin"></view>
    <view class="qr-panel">
      <view class="qr-title">眼镜端扫码登录</view>
      <view class="qr-sub">用 Rokid 眼镜扫描下方二维码登录</view>
      <view class="qr-box">
        <image wx:if="{{qrImage}}" class="qr-img" src="{{qrImage}}" mode="aspectFit"></image>
        <view wx:else class="qr-placeholder">{{qrLoading ? '正在生成二维码...' : ''}}</view>
        <canvas canvas-id="{{qrCanvasId}}" id="qrCanvas" class="qr-canvas"></canvas>
      </view>
      <button class="qr-refresh" size="mini" loading="{{qrLoading}}" bindtap="refreshQr">刷新二维码</button>
      <button class="qr-close" size="mini" bindtap="closeQrLogin">关闭</button>
    </view>
  </view>
</view>
