<view class="page" style="{{themeStyle}}">
  <glass-nav-bar title="文书详情" left="back" />

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:elif="{{doc}}">
    <view class="card header">
      <view class="doc-title">{{doc.title || doc.doc_type || '文书'}}</view>
      <view class="status">{{doc.status}}</view>
      <view class="muted" wx:if="{{doc.doc_number}}">编号：{{doc.doc_number}}</view>
      <view class="muted" wx:if="{{doc.doc_type}}">类型：{{doc.doc_type}}</view>
    </view>

    <!-- 文书详情：直接铺开正文/影像/补填/签认履历（2026-10-15 定稿：内容优先，PDF/Word 收进底部按钮） -->
    <view class="card">
      <view class="row" wx:if="{{doc.section}}">
          <text class="label">施工区域</text>
          <text>{{doc.section}}</text>
        </view>
        <view class="row" wx:if="{{doc.location}}">
          <text class="label">位置</text>
          <text>{{doc.location}}</text>
        </view>
        <view class="row" wx:if="{{doc.weather}}">
          <text class="label">天气</text>
          <text>{{doc.weather}}</text>
        </view>
        <view class="row" wx:if="{{doc.created_at}}">
          <text class="label">创建时间</text>
          <text>{{doc.created_at}}</text>
        </view>
        <view class="row" wx:if="{{doc.updated_at}}">
          <text class="label">更新时间</text>
          <text>{{doc.updated_at}}</text>
        </view>

        <block wx:if="{{fields.length}}">
          <view class="card-title" style="margin-top:20rpx;">文书内容</view>
          <view class="row" wx:for="{{fields}}" wx:key="key">
            <text class="label">{{item.key}}</text>
            <text class="field-value">{{item.value}}</text>
          </view>
        </block>

        <view class="card-title" style="margin-top:20rpx;" wx:if="{{images.length}}">关联影像</view>
        <view class="images" wx:if="{{images.length}}">
          <image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="thumb" />
        </view>

        <view class="card-title" style="margin-top:20rpx;" wx:if="{{doc.status === '草稿' && contentEditor.length}}">补填 / 修订日志</view>
        <view wx:if="{{doc.status === '草稿' && contentEditor.length}}">
          <view wx:for="{{contentEditor}}" wx:key="key"><text>{{item.label}}</text><textarea style="width:100%;min-height:70rpx;margin:12rpx 0;" value="{{item.value}}" data-key="{{item.key}}" bindinput="onContentInput" maxlength="-1" /></view>
          <button bindtap="saveContent">保存修订（已有签认需重签）</button>
        </view>

        <view class="card-title" style="margin-top:20rpx;">签认履历</view>
        <view wx:for="{{signHistory}}" wx:key="index">{{item.label}}：{{item.signer}} · {{item.signed_at}} · {{item.current ? '当前版本' : '历史版本'}}</view>
        <view wx:if="{{!signHistory.length}}">尚未签认</view>
    </view>

    <!-- 文件导出：与工作记录详情同款 doc-btn 样式，PDF/Word 并排 -->
    <view class="doc-btn-row">
      <button class="doc-btn ghost" bindtap="onPdfTap" loading="{{generatingPdf}}">{{hasPdf ? '查看 PDF' : '生成 PDF'}}</button>
      <button class="doc-btn ghost" bindtap="openWord">导出 Word</button>
    </view>

    <!-- 业务动作：签认 / 审批（同款 doc-btn 样式） -->
    <view class="actions">
      <button wx:if="{{doc.status !== '已归档'}}" class="doc-btn" bindtap="openSign">本人签认 / 项目用章</button>
      <button wx:if="{{doc.status === '草稿'}}" class="doc-btn" loading="{{submitting}}" bindtap="submit">提交审批</button>
      <button wx:if="{{canApprove}}" class="doc-btn" loading="{{approving}}" bindtap="approve">审批通过</button>
      <button wx:if="{{canApprove}}" class="doc-btn ghost" loading="{{approving}}" bindtap="reject">驳回</button>
    </view>
  </block>

  <view class="empty" wx:elif="{{!loading}}">
    <text>文书不存在或已删除</text>
  </view>

  <view wx:if="{{showSign}}" style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;display:flex;align-items:center;padding:30rpx;box-sizing:border-box;">
    <view class="card" style="width:100%;">
      <view class="card-title">签认 / 用章授权</view>
      <picker range="{{signSlots}}" range-key="label" value="{{signSlotIndex}}" bindchange="onSignSlot"><view style="padding:20rpx;">签认位置：{{signSlots[signSlotIndex].label}}</view></picker>
      <picker range="{{signatures}}" range-key="name" value="{{signSignatureIndex}}" bindchange="onSignSignature"><view style="padding:20rpx;">签章：{{signatures[signSignatureIndex].name || '请先上传个人签名'}}</view></picker>
      <input password value="{{signPassword}}" bindinput="onSignPassword" placeholder="签章使用密码" style="padding:20rpx;" />
      <button loading="{{signing}}" bindtap="confirmSign">确认本人授权签认</button>
      <button bindtap="uploadPersonalSignature">上传个人签名 PNG（先设密码）</button>
      <button bindtap="closeSign">取消</button>
    </view>
  </view>
</view>
