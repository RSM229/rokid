<view class="guide-root" wx:if="{{mode === 'intro'}}">
  <view class="skip-btn" bindtap="finish" wx:if="{{current < slides.length - 1}}">跳过</view>

  <swiper class="guide-swiper" current="{{current}}" bindchange="onSlideChange">
    <swiper-item wx:for="{{slides}}" wx:key="title">
      <view class="slide">
        <view class="slide-icon">{{item.icon}}</view>
        <view class="slide-title">{{item.title}}</view>
        <view class="slide-desc">{{item.desc}}</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="dots">
    <view wx:for="{{slides}}" wx:key="title" class="dot {{index === current ? 'on' : ''}}"></view>
  </view>

  <view class="actions">
    <button wx:if="{{current === slides.length - 1}}" class="primary-btn" bindtap="finish">开始使用</button>
    <button wx:else class="ghost-btn" bindtap="next">下一步</button>
  </view>
</view>

<scroll-view wx:else class="help-root" scroll-y="true">
  <view class="help-sec" wx:for="{{helpSections}}" wx:key="title">
    <view class="help-h">{{item.title}}</view>
    <view class="help-li" wx:for="{{item.items}}" wx:for-item="li" wx:key="*this">{{li}}</view>
  </view>
  <view class="help-links">
    <button class="link-btn" bindtap="goKnowledge">前往知识库查验收指引</button>
    <button class="link-btn" bindtap="goSettings">前往设置看隐私指引</button>
  </view>
  <view class="help-foot">遇到问题可联系项目管理员，或在「我的」中查看账号安全。</view>
</scroll-view>
