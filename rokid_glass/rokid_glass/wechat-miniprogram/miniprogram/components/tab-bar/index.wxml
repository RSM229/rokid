<view class="tabbar">
  <view
    class="tab-item {{active === item.key ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="key"
    data-key="{{item.key}}"
    data-url="{{item.url}}"
    bindtap="onTap"
  >
    <view class="tab-icon {{item.icon}}"></view>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
