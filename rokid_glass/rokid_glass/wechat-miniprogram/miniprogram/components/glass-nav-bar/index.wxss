/* 蓝玻璃导航栏（与工作台 agent 页一致） */
.gnb {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(135deg, rgba(var(--deep-rgb, 10,46,92), 0.88) 0%, rgba(var(--deep-rgb, 10,46,92), 0.80) 100%);
  backdrop-filter: blur(34rpx) saturate(1.8);
  -webkit-backdrop-filter: blur(34rpx) saturate(1.8);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 2rpx 12rpx rgba(var(--deep-rgb, 10,46,92), 0.18);
}
.gnb-inner {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
}
.gnb-title-wrap {
  display: flex;
  align-items: center;
  max-width: 70%;
  justify-content: center;
}
.gnb-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gnb-left {
  position: absolute;
  left: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.18);
}
.gnb-left:active {
  background: rgba(255, 255, 255, 0.32);
}
.gnb-right {
  position: absolute;
  right: 28rpx;
  display: flex;
  align-items: center;
  height: 56rpx;
}
.gnb-icon {
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.gnb-ic-menu {
  width: 36rpx;
  height: 30rpx;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201024%201024%22%3E%3Cpath%20fill=%22%23ffffff%22%20d=%22M128%20224h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32m0%20256h768q32%200%2032%2032t-32%2032H128q-32%200-32-32t32-32%22/%3E%3C/svg%3E");
}
.gnb-ic-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
}
