<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".app.CXRLApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RenewCXRLSample">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".activities.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.session.CxrSessionActivity"
            android:exported="false"
            android:label="@string/screen_title_session"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample" />

        <activity
            android:name=".activities.pending.PendingSessionsActivity"
            android:exported="false"
            android:label="待定记录"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample" />

        <activity
            android:name=".activities.pending.PendingSessionDetailActivity"
            android:exported="false"
            android:label="待定记录详情"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample" />

        <activity
            android:name=".activities.HazardRecordsActivity"
            android:exported="false"
            android:label="隐患记录"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample" />

        <activity
            android:name=".activities.WorkRecordsActivity"
            android:exported="false"
            android:label="工作记录"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample" />

        <activity
            android:name=".MessageReceiveActivity"
            android:exported="false"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample" />

        <activity
            android:name=".VideoReceiveActivity"
            android:exported="false"
            android:keepScreenOn="true"
            android:theme="@style/Theme.RenewCXRLSample" />
    </application>

</manifest>
