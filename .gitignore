*.zip
*.deb
*.rpm
*.exe
*.msi
*.dmg
*.iso
*.tar.gz
*.tgz
**/gradle-*-all.zip

# ===== 前端构建产物/备份（本地 build 后上传服务器，不入库）=====
# web-admin 的 dist、dist_ws、dist_build、dist_ag、dist_auto_*、dist_prev_*、dist_stale_* 等全部变体
web-admin/dist*/
**/dist_bak_*/
**/dist_old_*/

# ===== 保留示例 zip（如不需要可删掉这行）=====
!rokid_glass/rokid_glass/glasses-app/cxrlsampe.zip

# ===== 运行日志与测试产物（本地产出，不入库）=====
# 说明：tmp/ 不做整目录忽略——仓库约定那里可能放需要提交的开发脚本，
# 因此只忽略下面这些确定是运行产物的目录。
logs/
cloud-backend/logs/
outputs/
*.log