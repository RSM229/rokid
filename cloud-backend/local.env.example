# Copy to .local/backend.env and fill server-side credentials. Never commit that file.
# App ID must match the mini-program opened in WeChat developer tools.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Real text model (OpenAI-compatible endpoint).
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_BASE_URL=
DEFAULT_LLM_MODEL_ID=

# Real Huagong image recognition service.
DEFAULT_VLM_API_KEY=
DEFAULT_VLM_BASE_URL=
DEFAULT_VLM_MODEL_ID=hazard_vlm_detection
AI_CENTER_ORG_ID=
AI_CENTER_ENVIRONMENT=test

# Optional real speech services; required when testing speech features.
DEFAULT_STT_API_KEY=
DEFAULT_STT_BASE_URL=
DEFAULT_STT_MODEL_ID=
DEFAULT_TTS_API_KEY=
DEFAULT_TTS_BASE_URL=
DEFAULT_TTS_MODEL_ID=
DEFAULT_TTS_VOICE=

# Required only for SMS operations. Local launcher never falls back to mock SMS.
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_SIGN=
SMS_TENCENT_TEMPLATE_ID=
